@model IEnumerable<CommonUnderstanding.Models.BeliefSystem>

@{
    ViewData["Title"] = "Belief Systems";
}

<div class="container mt-4">
    <div class="row">
        <div class="col-md-12">
            <h1 class="mb-4">
                <i class="bi bi-brightness-high"></i> Belief Systems
            </h1>
            <p class="lead">
                Explore different belief systems and discover common ground through AI-powered analysis.
            </p>
        </div>
    </div>

    <div class="row mb-4">
        <div class="col-md-12">
            <a asp-action="Create" class="btn btn-primary">
                <i class="bi bi-plus-circle"></i> Add New Belief System
            </a>
            @if (Model.Any())
            {
                <a asp-action="Compare" class="btn btn-success ms-2">
                    <i class="bi bi-diagram-3"></i> Compare Belief Systems
                </a>
                <a asp-action="Comparisons" class="btn btn-info ms-2">
                    <i class="bi bi-list-check"></i> View All Comparisons
                </a>
            }
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (!Model.Any())
    {
        <div class="alert alert-info">
            <h4 class="alert-heading">Get Started</h4>
            <p>No belief systems have been added yet. Create your first belief system to begin mapping common understanding.</p>
            <hr>
            <p class="mb-0">Examples: Buddhism, Stoicism, Humanism, Christianity, Scientific Materialism, etc.</p>
        </div>
    }
    else
    {
        <div class="row">
            @foreach (var item in Model)
            {
                <div class="col-md-4 mb-4">
                    <div class="card h-100">
                        <div class="card-body">
                            <h5 class="card-title">@item.Name</h5>
                            <p class="card-text">
                                @(item.Description.Length > 150 
                                    ? item.Description.Substring(0, 150) + "..." 
                                    : item.Description)
                            </p>
                            <p class="text-muted small">
                                <i class="bi bi-calendar"></i> Added @item.CreatedAt.ToString("MMM dd, yyyy")
                            </p>
                        </div>
                        <div class="card-footer bg-transparent">
                            <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">
                                <i class="bi bi-eye"></i> View Details
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
