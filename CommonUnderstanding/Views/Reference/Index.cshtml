@model ReferenceFrameworkIndexModel
@{
    ViewData["Title"] = "Reference Library";
}

<nav aria-label="breadcrumb" class="cu-breadcrumb mb-2">
    <ol class="breadcrumb mb-0">
        <li class="breadcrumb-item"><a asp-controller="Dashboard" asp-action="Index">Dashboard</a></li>
        <li class="breadcrumb-item active" aria-current="page">Reference Library</li>
    </ol>
</nav>

<div class="d-flex flex-wrap justify-content-between align-items-end gap-3 mb-4">
    <div>
        <span class="cu-workspace-tag"><i class="bi bi-journal-check"></i> Normative sources</span>
        <h1 class="cu-page-heading mt-2 mb-1">Reference frameworks</h1>
        <p class="text-muted mb-0">Versioned legal, policy, scientific, organizational, and ethical corpora.</p>
    </div>
    <a asp-action="Import" class="btn cu-btn-primary">
        <i class="bi bi-file-earmark-arrow-up me-1"></i>Import framework
    </a>
</div>

@if (TempData["Success"] is string success)
{
    <div class="alert alert-success" role="status">@success</div>
}

@if (Model.Frameworks.Count == 0)
{
    <div class="cu-info-band d-flex align-items-center gap-3">
        <i class="bi bi-journal-plus fs-3"></i>
        <div>
            <strong>No reference frameworks are available.</strong>
            <div class="small">Import a PDF, HTML, or text source to begin.</div>
        </div>
    </div>
}
else
{
    <div class="row g-3">
        @foreach (var framework in Model.Frameworks)
        {
            var isOwner = framework.Owners.Any(owner => owner.UserId == Model.CurrentUserId);
            <div class="col-md-6 col-xl-4">
                <article class="cu-card cu-panel-card h-100">
                    <div class="cu-card-header d-flex justify-content-between gap-2">
                        <span><i class="bi bi-book me-1"></i>@framework.Name</span>
                        <span class="badge text-bg-@(framework.IsShared ? "success" : "secondary")">
                            @(framework.IsShared ? "Shared" : "Private")
                        </span>
                    </div>
                    <div class="cu-card-body d-flex flex-column">
                        <div class="d-flex flex-wrap gap-2 small text-muted mb-2">
                            <span>@framework.SourceType</span>
                            <span>v@framework.Version</span>
                            @if (isOwner)
                            {
                                <span><i class="bi bi-person-check"></i> Owner</span>
                            }
                        </div>
                        <p class="flex-grow-1 mb-3">@(string.IsNullOrWhiteSpace(framework.Description) ? "No description supplied." : framework.Description)</p>
                        <div class="d-flex justify-content-between align-items-center small mb-3">
                            <span>@framework.Propositions.Count propositions</span>
                            <span class="text-muted">@framework.ImportedAt.ToLocalTime().ToString("d")</span>
                        </div>
                        <a asp-action="Details" asp-route-id="@framework.Id" class="btn btn-sm btn-outline-primary align-self-start">
                            Open <i class="bi bi-arrow-right ms-1"></i>
                        </a>
                    </div>
                </article>
            </div>
        }
    </div>
}
