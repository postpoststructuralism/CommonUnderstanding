@model ReferenceFrameworkDetailsModel
@{
    ViewData["Title"] = Model.Framework.Name;
    var framework = Model.Framework;
}

<nav aria-label="breadcrumb" class="cu-breadcrumb mb-3">
    <ol class="breadcrumb mb-0">
        <li class="breadcrumb-item"><a asp-action="Index">Reference Library</a></li>
        <li class="breadcrumb-item active" aria-current="page">@framework.Name</li>
    </ol>
</nav>

@if (TempData["Error"] is string error)
{
    <div class="alert alert-danger" role="alert">@error</div>
}

<div class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-4">
    <div>
        <div class="d-flex flex-wrap gap-2 mb-2">
            <span class="badge text-bg-primary">@framework.SourceType</span>
            <span class="badge text-bg-light border">Version @framework.Version</span>
            <span class="badge text-bg-@(framework.IsShared ? "success" : "secondary")">@(framework.IsShared ? "Shared" : "Private")</span>
        </div>
        <h1 class="cu-page-heading mb-1">@framework.Name</h1>
        <p class="text-muted mb-0">@framework.Description</p>
    </div>
    <div class="text-end small text-muted">
        <div><i class="bi bi-file-earmark-text me-1"></i>@framework.SourceFileName</div>
        <div>@framework.Propositions.Count propositions</div>
    </div>
</div>

<div class="row g-3">
    <div class="col-lg-8">
        <section aria-labelledby="propositions-heading">
            <h2 id="propositions-heading" class="cu-section-heading mb-3">Reference propositions</h2>
            <div class="list-group">
                @foreach (var proposition in framework.Propositions)
                {
                    <div class="list-group-item py-3">
                        <div class="d-flex gap-3">
                            <span class="badge rounded-pill text-bg-light border align-self-start">@(proposition.SortOrder + 1)</span>
                            <div>
                                <div>@proposition.Text</div>
                                @if (!string.IsNullOrWhiteSpace(proposition.Assessment))
                                {
                                    <div class="small text-muted mt-2">@proposition.Assessment</div>
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>
        </section>
    </div>

    <div class="col-lg-4">
        <aside class="cu-card cu-panel-card mb-3">
            <div class="cu-card-header"><i class="bi bi-intersect me-1"></i>Score against framework</div>
            <div class="cu-card-body">
                <form asp-action="Score" asp-route-id="@framework.Id" method="post">
                    <div class="mb-3">
                        <label for="propositionId" class="form-label">Analytical proposition ID</label>
                        <input id="propositionId" name="propositionId" type="number" min="1" class="form-control" />
                    </div>
                    <div class="text-center text-muted small mb-3">or</div>
                    <div class="mb-3">
                        <label for="socialArgumentId" class="form-label">Social argument ID</label>
                        <input id="socialArgumentId" name="socialArgumentId" type="text" class="form-control" />
                    </div>
                    <button type="submit" class="btn btn-primary w-100">
                        <i class="bi bi-calculator me-1"></i>Calculate fit
                    </button>
                </form>
            </div>
        </aside>

        @if (Model.FitResult is { } result)
        {
            <aside class="cu-card cu-panel-card">
                <div class="cu-card-header">Fit result</div>
                <div class="cu-card-body">
                    <div class="row text-center g-2 mb-3">
                        <div class="col-6">
                            <div class="fs-3 fw-semibold text-success">@result.FitScore.ToString("P0")</div>
                            <div class="small text-muted">Fit</div>
                        </div>
                        <div class="col-6">
                            <div class="fs-3 fw-semibold text-danger">@result.TensionScore.ToString("P0")</div>
                            <div class="small text-muted">Tension</div>
                        </div>
                    </div>
                    <div class="small mb-3">
                        @result.SupportCount supporting, @result.TensionCount tensions, @result.UnclassifiedCount unclassified
                    </div>
                    @foreach (var match in (result.StrongestMatches ?? []).Take(5))
                    {
                        var badge = match.RelationshipType == ReferenceRelationshipType.Supports
                            ? "success"
                            : match.RelationshipType == ReferenceRelationshipType.Tensions ? "danger" : "secondary";
                        <div class="border-top py-2 small">
                            <span class="badge text-bg-@badge">@match.RelationshipType</span>
                            <span class="text-muted ms-1">@match.Similarity.ToString("P0")</span>
                            <div class="mt-1">@match.Text</div>
                        </div>
                    }
                </div>
            </aside>
        }
    </div>
</div>