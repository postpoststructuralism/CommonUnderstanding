@model CommonUnderstanding.Controllers.SharedItemListViewModel
@using CommonUnderstanding.Models
@{
    ViewData["Title"] = "Shared With Me";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="cu-page-heading mb-1">
            <i class="bi bi-inbox me-2"></i>Shared With Me
        </h1>
        <p class="text-muted mb-0">Content your connections have shared with you</p>
    </div>
    <a asp-action="SharedByMe" class="btn btn-outline-primary btn-sm">
        <i class="bi bi-share me-1"></i>View My Shares
    </a>
</div>

@if (!Model.Items.Any())
{
    <div class="cu-card text-center py-5">
        <i class="bi bi-inbox display-3 text-muted mb-3 d-block"></i>
        <h3>Nothing shared yet</h3>
        <p class="text-muted">When connections share arguments or analyses with you, they'll appear here.</p>
        <a asp-controller="Connections" asp-action="Index" class="btn btn-primary mt-2">
            <i class="bi bi-people me-1"></i>Find Connections
        </a>
    </div>
}
else
{
    <div class="row g-3">
        @foreach (var vm in Model.Items)
        {
            var typeIcon = vm.Item.ItemType switch
            {
                SharedItemType.Argument        => "bi-diagram-3",
                SharedItemType.Analysis        => "bi-bar-chart-steps",
                SharedItemType.EmergentReport  => "bi-lightbulb",
                SharedItemType.ConvergenceMap  => "bi-intersect",
                _                              => "bi-file-earmark"
            };
            <div class="col-12 col-md-6 col-xl-4">
                <div class="cu-card h-100">
                    <div class="cu-card-header d-flex justify-content-between align-items-center">
                        <span class="small text-muted">
                            <i class="bi @typeIcon me-1"></i>@vm.Item.ItemType
                        </span>
                        <span class="small text-muted">@vm.Item.SharedAt.ToString("MMM d, yyyy")</span>
                    </div>
                    <div class="cu-card-body">
                        <h3 class="h6 mb-1">@vm.Item.ItemTitle</h3>
                        <p class="small text-muted mb-2">
                            Shared by <strong>@vm.SharingUserName</strong>
                        </p>
                        @if (!string.IsNullOrWhiteSpace(vm.Item.Message))
                        {
                            <p class="small fst-italic border-start border-3 ps-2 text-muted mb-2">
                                "@vm.Item.Message"
                            </p>
                        }

                        <!-- Reactions -->
                        @if (vm.Reactions.Any())
                        {
                            <div class="d-flex flex-wrap gap-1 mb-2">
                                @foreach (var r in vm.Reactions.GroupBy(r => r.Emoji))
                                {
                                    <span class="badge bg-light text-dark border">@r.Key @r.Count()</span>
                                }
                            </div>
                        }

                        <!-- React form -->
                        <div class="d-flex gap-1 flex-wrap">
                            @foreach (var emoji in new[] { "👍", "🤔", "💡", "❓" })
                            {
                                <form asp-action="React" asp-controller="Sharing" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="sharedItemId" value="@vm.Item.Id" />
                                    <input type="hidden" name="emoji" value="@emoji" />
                                    <button type="submit" class="btn btn-sm btn-light border px-2">@emoji</button>
                                </form>
                            }

                            @if (vm.Item.ItemType == SharedItemType.Argument)
                            {
                                <a href="/Argument/Details/@vm.Item.ItemReferenceId"
                                   class="btn btn-sm btn-outline-primary ms-auto">
                                    View <i class="bi bi-arrow-right ms-1"></i>
                                </a>
                            }
                            else if (vm.Item.ItemType == SharedItemType.ConvergenceMap)
                            {
                                <a asp-controller="Convergence" asp-action="Map"
                                   asp-route-otherUserId="@vm.Item.SharedByUserId"
                                   class="btn btn-sm btn-outline-primary ms-auto">
                                    View Map <i class="bi bi-arrow-right ms-1"></i>
                                </a>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}
