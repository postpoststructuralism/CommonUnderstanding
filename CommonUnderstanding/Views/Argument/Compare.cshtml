@model IEnumerable<CommonUnderstanding.Models.Argument>
@using CommonUnderstanding.Models

@{
    ViewData["Title"] = "Compare Arguments";
    var comparisons = ViewBag.RecentComparisons as List<CommonUnderstanding.Models.ArgumentComparison>;
}

<!-- Breadcrumb -->
<nav aria-label="breadcrumb" class="cu-breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-controller="Dashboard" asp-action="Index">Dashboard</a></li>
        <li class="breadcrumb-item"><a asp-controller="Argument" asp-action="Index">Arguments</a></li>
        <li class="breadcrumb-item active" aria-current="page">Compare</li>
    </ol>
</nav>

<h1 class="cu-page-heading">
    <i class="bi bi-arrow-left-right"></i> Compare Arguments
</h1>

<div class="cu-card mb-4">
    <div class="cu-card-body">
        <p class="lead mb-1">Select two fully-analysed arguments to generate a head-to-head comparative analysis.</p>
        <p class="text-muted mb-0">The system will identify conflicting premises, shared ground, and the net epistemic direction between the two positions.</p>
    </div>
</div>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="bi bi-exclamation-triangle"></i> @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (!Model.Any())
{
    <div class="cu-card">
        <div class="cu-card-body text-center py-5">
            <i class="bi bi-inbox display-4 text-muted"></i>
            <p class="mt-3 text-muted">No fully-analysed arguments are available yet.</p>
            <a asp-action="Submit" class="btn btn-primary">Submit the first argument</a>
        </div>
    </div>
}
else
{
    <form method="post" asp-action="Compare">
        @Html.AntiForgeryToken()
        <div class="row g-4 mb-4">
            <div class="col-md-6">
                <label class="form-label fw-semibold">
                    <i class="bi bi-a-circle text-primary"></i> Argument A
                </label>
                <select name="argumentAId" id="argumentAId" class="form-select" required>
                    <option value="">— select argument A —</option>
                    @foreach (var arg in Model)
                    {
                        var conf = arg.AdjudicationSummary?.OverallConfidence;
                        var confLabel = conf.HasValue ? $" ({conf.Value:P0})" : "";
                        <option value="@arg.Id">@arg.Title@confLabel</option>
                    }
                </select>
            </div>
            <div class="col-md-6">
                <label class="form-label fw-semibold">
                    <i class="bi bi-b-circle text-danger"></i> Argument B
                </label>
                <select name="argumentBId" id="argumentBId" class="form-select" required>
                    <option value="">— select argument B —</option>
                    @foreach (var arg in Model)
                    {
                        var conf = arg.AdjudicationSummary?.OverallConfidence;
                        var confLabel = conf.HasValue ? $" ({conf.Value:P0})" : "";
                        <option value="@arg.Id">@arg.Title@confLabel</option>
                    }
                </select>
            </div>
        </div>

        <div id="same-arg-warning" class="alert alert-warning d-none" role="alert">
            <i class="bi bi-exclamation-triangle"></i> Please select two <strong>different</strong> arguments.
        </div>

        <button type="submit" id="submitBtn" class="btn btn-primary btn-lg">
            <i class="bi bi-arrow-left-right"></i> Run Comparative Analysis
        </button>
        <a asp-action="Index" class="btn btn-outline-secondary btn-lg ms-2">Cancel</a>
    </form>

    <hr class="my-5"/>
    <h2 class="h4 mb-3"><i class="bi bi-clock-history"></i> Recent Comparisons</h2>
    @if (comparisons != null && comparisons.Any())
    {
        <div class="list-group">
            @foreach (var c in comparisons)
            {
                <a asp-action="CompareView" asp-route-id="@c.Id"
                   class="list-group-item list-group-item-action d-flex justify-content-between align-items-center">
                    <div>
                        <span class="fw-semibold">@c.ArgumentA?.Title</span>
                        <span class="text-muted mx-2">vs.</span>
                        <span class="fw-semibold">@c.ArgumentB?.Title</span>
                    </div>
                    <div class="text-end">
                        @{
                            var (dirClass, dirLabel) = c.NetDirection switch
                            {
                                NetDirection.FavoursA   => ("text-primary", "Favours A"),
                                NetDirection.FavoursB   => ("text-danger",  "Favours B"),
                                NetDirection.Balanced   => ("text-success", "Balanced"),
                                _                        => ("text-muted",   "Insufficient data")
                            };
                        }
                        <span class="badge bg-secondary me-2">@c.CreatedAt.ToString("yyyy-MM-dd")</span>
                        <span class="@dirClass fw-semibold">@dirLabel</span>
                    </div>
                </a>
            }
        </div>
    }
    else
    {
        <p class="text-muted">No prior comparisons yet.</p>
    }
}

@section Scripts {
    <script>
        (function() {
            const selA = document.getElementById('argumentAId');
            const selB = document.getElementById('argumentBId');
            const warning = document.getElementById('same-arg-warning');
            const btn = document.getElementById('submitBtn');

            function checkSame() {
                const same = selA.value && selB.value && selA.value === selB.value;
                warning.classList.toggle('d-none', !same);
                btn.disabled = same;
            }

            selA.addEventListener('change', checkSame);
            selB.addEventListener('change', checkSame);
        })();
    </script>
}
