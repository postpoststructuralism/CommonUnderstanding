@model CommonUnderstanding.Controllers.AddEvidencePageModel

@{
    ViewData["Title"] = "Add Evidence";
}

<nav aria-label="breadcrumb" class="cu-breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-controller="EmergentConclusions" asp-action="Index">Emergent Conclusions</a></li>
        <li class="breadcrumb-item active" aria-current="page">Add Evidence</li>
    </ol>
</nav>

<div class="cu-workspace-hero mb-4">
    <div class="cu-workspace-hero-content">
        <span class="cu-workspace-tag"><i class="bi bi-journal-plus me-1"></i>Evidence gap</span>
        <h1>Add evidence</h1>
        <p class="cu-workspace-lead mb-0">Strengthen the proposition identified in <strong>@Model.ArgumentTitle</strong>.</p>
    </div>
</div>

<div class="cu-card">
    <div class="cu-card-header">Proposition</div>
    <div class="cu-card-body">
        <p class="fw-semibold mb-4">@Model.PropositionText</p>

        <form asp-action="AddEvidence" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" name="ArgumentId" value="@Model.ArgumentId" />
            <input type="hidden" name="PropositionId" value="@Model.PropositionId" />
            <input type="hidden" name="FindingKey" value="@Model.FindingKey" />
            <input type="hidden" name="ReturnUrl" value="@Model.ReturnUrl" />

            <div class="row g-3 mb-3">
                <div class="col-md-8">
                    <label class="form-label" for="citation">Citation</label>
                    <input id="citation" type="text" name="Citation" class="form-control"
                           placeholder="Author, title, journal, year" required autofocus />
                </div>
                <div class="col-md-4">
                    <label class="form-label" for="publicationYear">Publication year</label>
                    <input id="publicationYear" type="number" name="PublicationYear" class="form-control"
                           min="1800" max="2030" />
                </div>
                <div class="col-md-6">
                    <label class="form-label" for="sourceUri">Source URL</label>
                    <input id="sourceUri" type="url" name="SourceUri" class="form-control" />
                </div>
                <div class="col-md-6">
                    <label class="form-label" for="sourceName">Publisher or outlet</label>
                    <input id="sourceName" type="text" name="SourceName" class="form-control" maxlength="300" />
                </div>
                <div class="col-md-6">
                    <label class="form-label" for="doi">DOI</label>
                    <input id="doi" type="text" name="DOI" class="form-control" />
                </div>
                <div class="col-md-3">
                    <label class="form-label" for="tier">Evidence tier</label>
                    <select id="tier" name="Tier" class="form-select">
                        <option value="T1_SystematicReview">T1 - Systematic review</option>
                        <option value="T2_RCT">T2 - RCT / experiment</option>
                        <option value="T3_Observational">T3 - Observational</option>
                        <option value="T4_ExpertConsensus">T4 - Expert consensus</option>
                        <option value="T5_CaseStudy" selected>T5 - Case study</option>
                        <option value="T6_AnecdoteOpinion">T6 - Anecdote / opinion</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label" for="direction">Direction</label>
                    <select id="direction" name="Direction" class="form-select">
                        <option value="Supports">Supports</option>
                        <option value="Opposes">Opposes</option>
                        <option value="Neutral">Neutral</option>
                    </select>
                </div>
                <div class="col-md-4">
                    <label class="form-label" for="sampleSize">Sample size</label>
                    <input id="sampleSize" type="number" name="SampleSize" class="form-control" min="1" />
                </div>
                <div class="col-md-4">
                    <label class="form-label" for="replicationStatus">Replication</label>
                    <select id="replicationStatus" name="ReplicationStatus" class="form-select">
                        <option value="">Not specified</option>
                        <option value="unreplicated">Unreplicated</option>
                        <option value="partial">Partial</option>
                        <option value="replicated">Replicated</option>
                        <option value="contradicted">Contradicted</option>
                    </select>
                </div>
            </div>

            <div class="form-check mb-4">
                <input class="form-check-input" type="checkbox" name="AutoClassify" id="autoClassify" value="true" />
                <label class="form-check-label" for="autoClassify">
                    Auto-classify tier and direction using AI
                </label>
            </div>

            <div class="d-flex flex-wrap gap-2">
                <button type="submit" class="cu-btn-primary">
                    <i class="bi bi-save me-1"></i>Save evidence
                </button>
                @if (!string.IsNullOrWhiteSpace(Model.ReturnUrl))
                {
                    <a href="@Model.ReturnUrl" class="cu-btn-secondary">Cancel</a>
                }
                else
                {
                    <a asp-action="View" asp-route-id="@Model.ArgumentId" asp-route-tab="evidence" class="cu-btn-secondary">Cancel</a>
                }
            </div>
        </form>
    </div>
</div>