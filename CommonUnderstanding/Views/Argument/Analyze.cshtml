@{
    ViewData["Title"] = "Analyzing Argument";
    var argumentId = ViewBag.ArgumentId;
    var argumentTitle = ViewBag.ArgumentTitle;
}

<!-- Breadcrumb -->
<nav aria-label="breadcrumb" class="cu-breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-controller="Dashboard" asp-action="Index">Dashboard</a></li>
        <li class="breadcrumb-item"><a asp-action="Index">Arguments</a></li>
        <li class="breadcrumb-item active" aria-current="page">Analyzing…</li>
    </ol>
</nav>

<div class="row justify-content-center mt-5">
    <div class="col-lg-7 text-center">
        <div class="cu-card py-5">
            <div class="cu-card-body">
                <div id="spinnerIcon" class="spinner-border text-primary mb-4" style="width: 3rem; height: 3rem;" role="status">
                    <span class="visually-hidden">Analyzing…</span>
                </div>
                <div id="doneIcon" class="d-none mb-4">
                    <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" fill="currentColor" class="text-success" viewBox="0 0 16 16">
                        <path d="M16 8A8 8 0 1 1 0 8a8 8 0 0 1 16 0m-3.97-3.03a.75.75 0 0 0-1.08.022L7.477 9.417 5.384 7.323a.75.75 0 0 0-1.06 1.06L6.97 11.03a.75.75 0 0 0 1.079-.02l3.992-4.99a.75.75 0 0 0-.01-1.05z"/>
                    </svg>
                </div>
                <div id="errorIcon" class="d-none mb-4">
                    <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" fill="currentColor" class="text-danger" viewBox="0 0 16 16">
                        <path d="M16 8A8 8 0 1 1 0 8a8 8 0 0 1 16 0M5.354 4.646a.5.5 0 1 0-.708.708L7.293 8l-2.647 2.646a.5.5 0 0 0 .708.708L8 8.707l2.646 2.647a.5.5 0 0 0 .708-.708L8.707 8l2.647-2.646a.5.5 0 0 0-.708-.708L8 7.293z"/>
                    </svg>
                </div>

                <h3 class="mb-1">Analyzing Your Perspective</h3>
                @if (!string.IsNullOrEmpty(argumentTitle))
                {
                    <p class="text-muted mb-3"><em>@argumentTitle</em></p>
                }

                <!-- Progress bar -->
                <div class="progress mt-4" style="height: 10px;">
                    <div id="progressBar" class="progress-bar progress-bar-striped progress-bar-animated bg-primary"
                         role="progressbar" style="width: 2%; transition: width 0.4s ease;"></div>
                </div>
                <p id="statusLabel" class="text-muted small mt-3">Reading what you wrote…</p>

                <div id="fallbackPanel" class="alert alert-warning mt-3 d-none text-start small">
                    <strong>Partial fallback in use.</strong>
                    <span id="fallbackMessage">One or more AI stages timed out or hit rate limits, so the analysis is continuing with reduced-detail fallback logic.</span>
                </div>

                <!-- Chain-of-thought log -->
                <div id="chainLog" class="text-start mt-4 small" style="max-height: 220px; overflow-y: auto;">
                </div>

                <!-- Error panel (hidden until error) -->
                <div id="errorPanel" class="alert alert-danger mt-4 d-none text-start">
                    <strong>Error:</strong> <span id="errorMessage"></span>
                    <div class="mt-3">
                        <a href="@Url.Action("Analyze", new { id = argumentId })" class="btn btn-outline-danger btn-sm">Retry Analysis</a>
                        <a href="@Url.Action("Submit")" class="btn btn-outline-secondary btn-sm ms-2">Back to Submit</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
(function () {
    const bar      = document.getElementById('progressBar');
    const label    = document.getElementById('statusLabel');
    const chainLog = document.getElementById('chainLog');
    const spinner  = document.getElementById('spinnerIcon');
    const doneIcon = document.getElementById('doneIcon');
    const errorIcon = document.getElementById('errorIcon');
    const errorPanel = document.getElementById('errorPanel');
    const errorMsg  = document.getElementById('errorMessage');
    const fallbackPanel = document.getElementById('fallbackPanel');
    const fallbackMessage = document.getElementById('fallbackMessage');
    const streamUrl = '@Url.Action("AnalyzeStream", new { id = argumentId, force = (bool)(ViewBag.ForceReanalyze ?? false) })';
    const tracePrefix = '[ArgumentAnalyzeStream]';

    let lastEventAt = Date.now();
    let lastEventName = 'init';
    let watchdogHandle = null;
    const fallbackWarnings = new Set();

    function trace(message, details) {
        if (details !== undefined) {
            console.debug(tracePrefix, message, details);
        } else {
            console.debug(tracePrefix, message);
        }
    }

    function traceError(message, details) {
        if (details !== undefined) {
            console.error(tracePrefix, message, details);
        } else {
            console.error(tracePrefix, message);
        }
    }

    function markEvent(name, payload) {
        lastEventAt = Date.now();
        lastEventName = name;
        trace(`event=${name}`, payload);
    }

    function startWatchdog(evtSource) {
        watchdogHandle = window.setInterval(() => {
            const stalledForMs = Date.now() - lastEventAt;
            if (stalledForMs >= 15000) {
                trace('no SSE activity for 15s', {
                    lastEventName,
                    stalledForMs,
                    readyState: evtSource.readyState,
                    statusLabel: label.textContent
                });
            }
        }, 5000);
    }

    function stopWatchdog() {
        if (watchdogHandle !== null) {
            window.clearInterval(watchdogHandle);
            watchdogHandle = null;
        }
    }

    function showFallbackWarning(message) {
        if (fallbackWarnings.has(message)) return;
        fallbackWarnings.add(message);

        fallbackPanel.classList.remove('d-none');
        fallbackMessage.textContent = message;
        logStep(`<strong class="text-warning">Fallback:</strong> ${message}`, 'text-warning');
        trace('fallback-warning', { message });
    }

    function logStep(text, cssClass) {
        const ts = new Date().toLocaleTimeString();
        const el = document.createElement('div');
        el.className = cssClass || 'text-muted';
        el.innerHTML = `<span class="text-secondary">[${ts}]</span> ${text}`;
        chainLog.appendChild(el);
        chainLog.scrollTop = chainLog.scrollHeight;
    }

    logStep('Reading what you wrote…');
    trace('opening EventSource', { streamUrl });

    const evtSource = new EventSource(streamUrl);
    startWatchdog(evtSource);

    evtSource.onopen = function () {
        markEvent('open', { readyState: evtSource.readyState });
    };

    evtSource.addEventListener('debug', function (e) {
        try {
            const d = JSON.parse(e.data);
            markEvent('debug', d);

            const message = d.message || '';
            const details = d.details || {};
            const fallbackApplied = !!details.fallbackApplied;
            const timeoutEvent = message.toLowerCase().includes('timed out');

            if (fallbackApplied || timeoutEvent) {
                showFallbackWarning(
                    message === 'structure decomposition timed out'
                        ? 'Structure extraction hit a provider timeout. The analysis is continuing without full syllogism/assumption detail.'
                        : message === 'Adjudication narrative timed out'
                            ? 'Narrative generation hit a provider timeout. A rule-based adjudication summary is being used instead.'
                            : 'An AI stage timed out or failed. The pipeline is continuing with fallback logic.'
                );
            }
        } catch (err) {
            traceError('failed to parse debug event payload', { raw: e.data, err });
        }
    });

    evtSource.addEventListener('title', function (e) {
        try {
            const d = JSON.parse(e.data);
            markEvent('title', d);
            document.querySelector('h3.mb-1').textContent = d.title;
        } catch (err) {
            traceError('failed to parse title event payload', { raw: e.data, err });
        }
    });

    evtSource.addEventListener('progress', function (e) {
        try {
            const d = JSON.parse(e.data);
            markEvent('progress', d);
            const pct = Math.max(5, Math.round((d.step / d.total) * 100));
            bar.style.width = pct + '%';
            label.textContent = d.label;
            // Phase 1: Narrative style — no "Step N/5" prefix
            logStep(d.label);
        } catch (err) {
            traceError('failed to parse progress event payload', { raw: e.data, err });
        }
    });

    evtSource.addEventListener('complete', function (e) {
        stopWatchdog();
        const d = JSON.parse(e.data);
        markEvent('complete', d);
        evtSource.close();

        bar.style.width = '100%';
        bar.classList.remove('progress-bar-animated', 'progress-bar-striped');
        bar.classList.add('bg-success');
        label.textContent = 'Analysis complete — reviewing your results…';
        spinner.classList.add('d-none');
        doneIcon.classList.remove('d-none');

        logStep('<strong class="text-success">Analysis complete! Let\'s review what the AI found.</strong>', 'text-success');

        setTimeout(() => { window.location.href = d.redirectUrl; }, 800);
    });

    evtSource.addEventListener('error', function (e) {
        markEvent('error', {
            hasData: !!e.data,
            readyState: evtSource.readyState,
            statusLabel: label.textContent
        });

        // Check if it's a custom error event (with data) or a connection error
        if (e.data) {
            stopWatchdog();
            const d = JSON.parse(e.data);
            evtSource.close();

            bar.classList.remove('progress-bar-animated', 'progress-bar-striped');
            bar.classList.add('bg-danger');
            label.textContent = 'Analysis failed.';
            spinner.classList.add('d-none');
            errorIcon.classList.remove('d-none');
            errorPanel.classList.remove('d-none');
            errorMsg.textContent = d.message;

            logStep(`<strong class="text-danger">Error:</strong> ${d.message}`, 'text-danger');
        } else {
            // EventSource connection error (e.g., network issue) — it will retry automatically
            trace('connection-level EventSource error; browser may retry automatically', {
                readyState: evtSource.readyState,
                lastEventName
            });
            logStep('Connection interrupted — retrying…', 'text-warning');
        }
    });

    window.addEventListener('beforeunload', stopWatchdog);
})();
</script>
