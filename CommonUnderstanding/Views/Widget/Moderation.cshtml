@model Guid
@{
    ViewData["Title"] = "Moderation Queue";
    Layout = "_Layout";
}

<div class="container mt-4">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/">Home</a></li>
            <li class="breadcrumb-item"><a href="/WidgetPage/Dashboard">Widget Dashboard</a></li>
            <li class="breadcrumb-item active">Moderation</li>
        </ol>
    </nav>

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1><i class="bi bi-shield-check"></i> Moderation Queue</h1>
        <div class="btn-group">
            <button class="btn btn-outline-secondary filter-btn active" data-filter="">All</button>
            <button class="btn btn-outline-warning filter-btn" data-filter="pending">Pending</button>
            <button class="btn btn-outline-success filter-btn" data-filter="approved">Approved</button>
            <button class="btn btn-outline-danger filter-btn" data-filter="rejected">Rejected</button>
        </div>
    </div>

    <div id="loading" class="text-center py-5">
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">Loading...</span>
        </div>
    </div>

    <div id="queue-container"></div>
</div>

@section Styles {
    <style>
        .mod-item {
            transition: background-color 0.2s;
        }
        .mod-item:hover {
            background-color: var(--bs-light);
        }
        .mod-snippet {
            background: var(--bs-light);
            padding: 0.75rem;
            border-radius: 6px;
            border-left: 3px solid var(--bs-secondary);
            font-size: 0.9rem;
        }
        .confidence-bar {
            height: 4px;
            border-radius: 2px;
            background: var(--bs-gray-200);
            overflow: hidden;
        }
        .confidence-fill {
            height: 100%;
            border-radius: 2px;
            transition: width 0.3s;
        }
    </style>
}

@section Scripts {
    <script>
        const siteId = '@Model';

        document.addEventListener('DOMContentLoaded', () => {
            loadQueue('');

            document.querySelectorAll('.filter-btn').forEach(btn => {
                btn.addEventListener('click', () => {
                    document.querySelectorAll('.filter-btn').forEach(b => b.classList.remove('active'));
                    btn.classList.add('active');
                    loadQueue(btn.dataset.filter);
                });
            });
        });

        async function loadQueue(status) {
            const loading = document.getElementById('loading');
            const container = document.getElementById('queue-container');
            loading.style.display = 'block';

            try {
                const url = `/api/widget/sites/${siteId}/moderation${status ? '?status=' + status : ''}`;
                const resp = await fetch(url);
                if (!resp.ok) throw new Error('Failed to load queue');
                const items = await resp.json();

                loading.style.display = 'none';

                if (items.length === 0) {
                    container.innerHTML = `
                        <div class="text-center py-5">
                            <i class="bi bi-shield-check" style="font-size: 3rem; color: var(--bs-success);"></i>
                            <h4 class="mt-3">All Clear</h4>
                            <p class="text-muted">No items in this queue.</p>
                        </div>
                    `;
                    return;
                }

                container.innerHTML = items.map(item => `
                    <div class="card mod-item mb-2">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <div>
                                    <span class="badge bg-${item.status === 'pending' ? 'warning' : item.status === 'approved' ? 'success' : 'danger'}">
                                        ${item.status}
                                    </span>
                                    <span class="badge bg-secondary ms-1">${item.flagReason || 'manual'}</span>
                                </div>
                                <small class="text-muted">${new Date(item.createdAt).toLocaleString()}</small>
                            </div>

                            <div class="mod-snippet mb-2">${escapeHtml(item.commentSnippet)}</div>

                            ${item.aiConfidence !== null ? `
                                <div class="mb-2">
                                    <small class="text-muted">AI Confidence: ${(item.aiConfidence * 100).toFixed(0)}%</small>
                                    <div class="confidence-bar">
                                        <div class="confidence-fill bg-${item.aiConfidence > 0.7 ? 'danger' : item.aiConfidence > 0.4 ? 'warning' : 'info'}"
                                             style="width: ${item.aiConfidence * 100}%"></div>
                                    </div>
                                </div>
                            ` : ''}

                            ${item.status === 'pending' ? `
                                <div class="d-flex gap-2 mt-3">
                                    <button class="btn btn-success btn-sm" onclick="reviewItem('${item.id}', true)">
                                        <i class="bi bi-check-lg"></i> Approve
                                    </button>
                                    <button class="btn btn-danger btn-sm" onclick="reviewItem('${item.id}', false)">
                                        <i class="bi bi-x-lg"></i> Reject
                                    </button>
                                </div>
                            ` : ''}
                        </div>
                    </div>
                `).join('');
            } catch (err) {
                loading.innerHTML = `<div class="alert alert-danger">${err.message}</div>`;
            }
        }

        async function reviewItem(itemId, approved) {
            try {
                const resp = await fetch(
                    `/api/widget/sites/${siteId}/moderation/${itemId}/review?approved=${approved}`,
                    { method: 'POST' }
                );
                if (!resp.ok) throw new Error('Review failed');
                // Reload current filter
                const activeFilter = document.querySelector('.filter-btn.active')?.dataset.filter || '';
                loadQueue(activeFilter);
            } catch (err) {
                alert('Error: ' + err.message);
            }
        }

        function escapeHtml(text) {
            const div = document.createElement('div');
            div.textContent = text;
            return div.innerHTML;
        }
    </script>
}