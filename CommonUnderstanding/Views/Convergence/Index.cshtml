@model CommonUnderstanding.Controllers.ConvergenceDashboardViewModel
@{
    ViewData["Title"] = "Where We Agree";
}

<div class="d-flex justify-content-between align-items-end gap-3 mb-4 flex-wrap">
    <div>
        <h1 class="cu-page-heading mb-1">
            <i class="bi bi-intersect me-2"></i>Where We Agree
        </h1>
        <p class="text-muted mb-0">People ranked by how often you cast the same decisive vote on public contributions.</p>
    </div>
    <span class="small text-muted">Confidence-adjusted for sample size</span>
</div>

@if (!Model.Agreements.Any())
{
    <div class="cu-card text-center py-5">
        <i class="bi bi-bar-chart display-3 text-muted mb-3 d-block"></i>
        <h2 class="h4">No shared voting history yet</h2>
        <p class="text-muted mb-3">Vote on public contributions to compare your positions with other participants.</p>
        <a asp-controller="SocialView" asp-action="Feed" class="btn btn-primary">
            <i class="bi bi-clock-history me-1"></i>Browse Latest Contributions
        </a>
    </div>
}
else
{
    <div class="cu-card overflow-hidden">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th class="ps-4" scope="col">#</th>
                        <th scope="col">Participant</th>
                        <th scope="col">Agreement</th>
                        <th scope="col">Evidence</th>
                        <th class="text-end pe-4" scope="col"><span class="visually-hidden">Open comparison</span></th>
                    </tr>
                </thead>
                <tbody>
                    @for (var index = 0; index < Model.Agreements.Count; index++)
                    {
                        var agreement = Model.Agreements[index];
                        var percentage = agreement.AgreementRate * 100;
                        <tr>
                            <td class="ps-4 text-muted fw-semibold">@(index + 1)</td>
                            <td>
                                <a asp-action="Map" asp-route-otherUserId="@agreement.UserId" class="fw-semibold text-decoration-none">
                                    @agreement.DisplayName
                                </a>
                            </td>
                            <td style="min-width: 190px;">
                                <div class="d-flex align-items-center gap-2">
                                    <div class="progress flex-grow-1" style="height: 8px;" aria-label="@percentage.ToString("F0") percent agreement">
                                        <div class="progress-bar bg-success" style="width: @percentage.ToString("F0")%"></div>
                                    </div>
                                    <strong>@percentage.ToString("F0")%</strong>
                                </div>
                            </td>
                            <td class="small text-muted">
                                @agreement.AgreementCount agree, @agreement.DisagreementCount disagree
                                <span class="d-block">@agreement.ComparableVoteCount shared votes</span>
                            </td>
                            <td class="text-end pe-4">
                                <a asp-action="Map" asp-route-otherUserId="@agreement.UserId" class="btn btn-sm btn-outline-primary" title="View comparison">
                                    <i class="bi bi-arrow-right" aria-hidden="true"></i>
                                    <span class="visually-hidden">Compare with @agreement.DisplayName</span>
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
