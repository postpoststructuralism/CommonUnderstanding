@model CommonUnderstanding.Controllers.ConvergenceDashboardViewModel
@using CommonUnderstanding.Models
@{
    ViewData["Title"] = "Convergence";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="cu-page-heading mb-1">
            <i class="bi bi-intersect me-2"></i>Convergence Maps
        </h1>
        <p class="text-muted mb-0">Track where your understanding meets — and where it can grow</p>
    </div>
    <a asp-controller="Connections" asp-action="Index" class="btn btn-outline-primary">
        <i class="bi bi-people me-1"></i>Manage Connections
    </a>
</div>

@if (!Model.Maps.Any())
{
    <div class="cu-card text-center py-5">
        <i class="bi bi-intersect display-3 text-muted mb-3 d-block"></i>
        <h3>No convergence maps yet</h3>
        <p class="text-muted">Connect with other users to start mapping shared understanding.</p>
        <a asp-controller="Connections" asp-action="Index" class="btn btn-primary mt-2">
            <i class="bi bi-person-plus me-1"></i>Find Connections
        </a>
    </div>
}
else
{
    <div class="row g-3">
        @foreach (var summary in Model.Maps)
        {
            var scoreClass = summary.Map.OverallConvergenceScore >= 60 ? "success"
                           : summary.Map.OverallConvergenceScore >= 35 ? "warning"
                           : "danger";
            var trendIcon = summary.Trend > 0 ? "bi-arrow-up-circle-fill text-success"
                          : summary.Trend < 0 ? "bi-arrow-down-circle-fill text-danger"
                          : "bi-dash-circle text-secondary";

            <div class="col-12 col-md-6 col-xl-4">
                <div class="cu-card h-100">
                    <div class="cu-card-header d-flex justify-content-between align-items-center">
                        <h2 class="h6 mb-0">
                            <i class="bi bi-person-circle me-1"></i>@summary.OtherUserName
                        </h2>
                        <span class="badge bg-@scoreClass">@summary.Map.OverallConvergenceScore.ToString("F0")/100</span>
                    </div>
                    <div class="cu-card-body">
                        <!-- Score gauge -->
                        <div class="mb-3">
                            <div class="d-flex justify-content-between small text-muted mb-1">
                                <span>Convergence</span>
                                <span class="@(summary.Trend > 0 ? "text-success" : summary.Trend < 0 ? "text-danger" : "text-secondary")">
                                    <i class="bi @trendIcon me-1"></i>
                                    @(summary.Trend >= 0 ? "+" : "")@summary.Trend.ToString("F1")
                                </span>
                            </div>
                            <div class="progress" style="height:8px;">
                                <div class="progress-bar bg-@scoreClass"
                                     role="progressbar"
                                     style="width:@summary.Map.OverallConvergenceScore%">
                                </div>
                            </div>
                        </div>

                        <!-- Stats -->
                        <div class="row text-center g-2 mb-3">
                            <div class="col-6">
                                <div class="p-2 bg-light rounded">
                                    <div class="fw-bold text-success">@summary.SharedCount</div>
                                    <div class="small text-muted">Shared propositions</div>
                                </div>
                            </div>
                            <div class="col-6">
                                <div class="p-2 bg-light rounded">
                                    <div class="fw-bold text-danger">@summary.DisputedCount</div>
                                    <div class="small text-muted">Disputed</div>
                                </div>
                            </div>
                        </div>

                        <p class="small text-muted mb-3">
                            Updated @summary.Map.LastRefreshedAt.ToString("MMM d, yyyy HH:mm")
                        </p>

                        <div class="d-flex gap-2">
                            <a asp-action="Map" asp-route-otherUserId="@summary.OtherUserId"
                               class="btn btn-primary btn-sm flex-grow-1">
                                <i class="bi bi-map me-1"></i>View Map
                            </a>
                            <a asp-action="Expand" asp-route-otherUserId="@summary.OtherUserId"
                               class="btn btn-outline-success btn-sm flex-grow-1">
                                <i class="bi bi-arrows-expand me-1"></i>Expand
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}
