@model CommonUnderstanding.Services.Social.UserAgreementDetail
@{
    ViewData["Title"] = $"Agreement with {Model.DisplayName}";
    var percentage = Model.AgreementRate * 100;
    var agreements = Model.Comparisons.Where(comparison => comparison.Agrees).ToList();
    var disagreements = Model.Comparisons.Where(comparison => !comparison.Agrees).ToList();
}

<div class="d-flex justify-content-between align-items-start gap-3 mb-4 flex-wrap">
    <div>
        <a asp-action="Index" class="small text-decoration-none">
            <i class="bi bi-arrow-left me-1"></i>Where We Agree
        </a>
        <h1 class="cu-page-heading mt-2 mb-1">You and @Model.DisplayName</h1>
        <p class="text-muted mb-0">A comparison of your decisive votes on the same public contributions.</p>
    </div>
    <div class="text-end">
        <div class="display-6 fw-bold text-success">@percentage.ToString("F0")%</div>
        <div class="small text-muted">agreement across @Model.ComparableVoteCount shared votes</div>
    </div>
</div>

@if (Model.ComparableVoteCount == 0)
{
    <div class="cu-card text-center py-5">
        <i class="bi bi-bar-chart display-3 text-muted mb-3 d-block"></i>
        <h2 class="h4">No comparable votes yet</h2>
        <p class="text-muted mb-0">You have not both cast a decisive vote on the same public contribution.</p>
    </div>
}
else
{
    <div class="row g-3 mb-4">
        <div class="col-6">
            <div class="border-start border-4 border-success ps-3 py-2">
                <div class="fs-3 fw-bold">@Model.AgreementCount</div>
                <div class="text-muted">Agreements</div>
            </div>
        </div>
        <div class="col-6">
            <div class="border-start border-4 border-danger ps-3 py-2">
                <div class="fs-3 fw-bold">@Model.DisagreementCount</div>
                <div class="text-muted">Disagreements</div>
            </div>
        </div>
    </div>

    <section class="mb-5" aria-labelledby="agreements-heading">
        <h2 id="agreements-heading" class="h4 mb-3"><i class="bi bi-check-circle text-success me-2"></i>Where you agree</h2>
        @if (agreements.Count == 0)
        {
            <p class="text-muted">No matching decisive votes in the current comparison.</p>
        }
        else
        {
            <div class="list-group">
                @foreach (var comparison in agreements)
                {
                    <a asp-controller="SocialView" asp-action="Detail" asp-route-id="@comparison.ArgumentId"
                       class="list-group-item list-group-item-action d-flex justify-content-between align-items-center gap-3">
                        <span>
                            <strong class="d-block">@comparison.ArgumentTitle</strong>
                            <span class="small text-muted">You both voted @comparison.CurrentUserVote.ToString().ToLowerInvariant()</span>
                        </span>
                        <i class="bi bi-arrow-right text-muted" aria-hidden="true"></i>
                    </a>
                }
            </div>
        }
    </section>

    <section aria-labelledby="disagreements-heading">
        <h2 id="disagreements-heading" class="h4 mb-3"><i class="bi bi-x-circle text-danger me-2"></i>Where you disagree</h2>
        @if (disagreements.Count == 0)
        {
            <p class="text-muted">No opposing decisive votes in the current comparison.</p>
        }
        else
        {
            <div class="list-group">
                @foreach (var comparison in disagreements)
                {
                    <a asp-controller="SocialView" asp-action="Detail" asp-route-id="@comparison.ArgumentId"
                       class="list-group-item list-group-item-action d-flex justify-content-between align-items-center gap-3">
                        <span>
                            <strong class="d-block">@comparison.ArgumentTitle</strong>
                            <span class="small text-muted">
                                You voted @comparison.CurrentUserVote.ToString().ToLowerInvariant();
                                @Model.DisplayName voted @comparison.OtherUserVote.ToString().ToLowerInvariant()
                            </span>
                        </span>
                        <i class="bi bi-arrow-right text-muted" aria-hidden="true"></i>
                    </a>
                }
            </div>
        }
    </section>
}
