@model IEnumerable<CommonUnderstanding.Models.PersistedEmergentReport>

@{
    ViewData["Title"] = "Emergent Conclusions History";
    var reports = Model?.ToList() ?? new List<CommonUnderstanding.Models.PersistedEmergentReport>();
}

<!-- Page Header -->
<div class="d-flex justify-content-between align-items-start mb-4">
    <div>
        <h1 class="cu-page-heading mb-1">
            <i class="bi bi-clock-history me-2"></i>Analysis History
        </h1>
        <p class="text-muted mb-0">
            Saved snapshots of Emergent Conclusions reports over time.
        </p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-arrow-left me-1"></i>Back to Current
        </a>
        <a asp-action="Save" class="btn btn-outline-success btn-sm">
            <i class="bi bi-bookmark-plus me-1"></i>Save New Snapshot
        </a>
    </div>
</div>

@if (!reports.Any())
{
    <div class="cu-card text-center py-5">
        <i class="bi bi-clock display-3 text-muted mb-3 d-block"></i>
        <h3 class="text-muted">No Snapshots Yet</h3>
        <p class="text-muted mb-4">
            Save a snapshot from the main Emergent Conclusions page to start tracking changes over time.
        </p>
        <a asp-action="Save" class="btn btn-primary">
            <i class="bi bi-bookmark-plus me-1"></i>Save First Snapshot
        </a>
    </div>
}
else
{
    <div class="cu-card p-0">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Date &amp; Time</th>
                        <th class="text-center">Mode</th>
                        <th class="text-center">Arguments</th>
                        <th class="text-center">Propositions</th>
                        <th class="text-center">Evidence</th>
                        <th class="text-center">Avg Confidence</th>
                        <th class="text-center text-danger">Blindspots</th>
                        <th class="text-center text-success">Harmonies</th>
                        <th class="text-center text-warning">Untested</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var r in reports)
                    {
                        <tr>
                            <td>
                                <small class="fw-semibold">@r.GeneratedAt.ToString("MMM d, yyyy")</small>
                                <br /><small class="text-muted">@r.GeneratedAt.ToString("HH:mm") UTC</small>
                            </td>
                            <td class="text-center">
                                @if (r.IsDeepAnalysis)
                                {
                                    <span class="badge bg-primary"><i class="bi bi-cpu me-1"></i>Deep</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Standard</span>
                                }
                            </td>
                            <td class="text-center">@r.TotalArguments</td>
                            <td class="text-center">@r.TotalPropositions</td>
                            <td class="text-center">@r.TotalEvidenceItems</td>
                            <td class="text-center">
                                <span class="@(r.AverageConfidence >= 0.6 ? "text-success" : r.AverageConfidence >= 0.4 ? "text-warning" : "text-danger") fw-semibold">
                                    @r.AverageConfidence.ToString("P0")
                                </span>
                            </td>
                            <td class="text-center">
                                <span class="badge bg-danger rounded-pill">@r.BlindspotCount</span>
                            </td>
                            <td class="text-center">
                                <span class="badge bg-success rounded-pill">@r.HarmonyCount</span>
                            </td>
                            <td class="text-center">
                                @if (r.CriticalAssumptionsUntested > 0)
                                {
                                    <span class="badge bg-warning text-dark rounded-pill">@r.CriticalAssumptionsUntested</span>
                                }
                                else
                                {
                                    <span class="text-muted">—</span>
                                }
                            </td>
                            <td class="text-end">
                                @if (!string.IsNullOrEmpty(r.ExecutiveSummary))
                                {
                                    <button type="button" class="btn btn-outline-primary btn-sm btn-view-summary"
                                            data-report-date="@r.GeneratedAt.ToString("MMM d, yyyy HH:mm")"
                                            data-summary="@System.Web.HttpUtility.HtmlAttributeEncode(r.ExecutiveSummary)">
                                        <i class="bi bi-file-text me-1"></i>Summary
                                    </button>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <p class="text-muted small mt-2">
        <i class="bi bi-info-circle me-1"></i>
        Showing the last @reports.Count snapshot(s). Snapshots are saved manually from the main analysis page.
    </p>
}

<!-- ── SUMMARY MODAL ─────────────────────────────────────────────────────────── -->
<div class="modal fade" id="summaryModal" tabindex="-1" aria-labelledby="summaryModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="summaryModalLabel">
                    <i class="bi bi-file-text me-2"></i>Executive Summary
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body" id="summaryModalBody">
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    document.querySelectorAll('.btn-view-summary').forEach(function (btn) {
        btn.addEventListener('click', function () {
            var date    = btn.getAttribute('data-report-date');
            var summary = btn.getAttribute('data-summary');
            document.getElementById('summaryModalLabel').textContent = 'Executive Summary — ' + date + ' UTC';
            var paras = summary.split('\n').filter(function (p) { return p.trim().length > 0; });
            var html  = paras.map(function (p) { return '<p class="text-muted">' + p + '</p>'; }).join('');
            document.getElementById('summaryModalBody').innerHTML = html || '<p class="text-muted">No summary available.</p>';
            new bootstrap.Modal(document.getElementById('summaryModal')).show();
        });
    });
</script>
}
