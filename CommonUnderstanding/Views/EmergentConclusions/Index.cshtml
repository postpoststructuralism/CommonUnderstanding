@model CommonUnderstanding.Models.EmergentConclusionsReport
@using CommonUnderstanding.Models
@using CommonUnderstanding.Services
@inject IEmergentFindingActionService FindingActions

@{
    ViewData["Title"] = "Emergent Conclusions";
    var socialArgumentIds = ViewData["SocialArgumentIds"] as IReadOnlyDictionary<int, Guid>
        ?? new Dictionary<int, Guid>();
    var socialArgumentIdsByNode = ViewData["SocialArgumentIdsByNode"] as IReadOnlyDictionary<int, Guid>
        ?? new Dictionary<int, Guid>();

    string CategoryIcon(EmergentCategory cat) => cat switch
    {
        EmergentCategory.AssumptionCascade       => "bi-layers",
        EmergentCategory.EvidenceDesert          => "bi-exclamation-diamond",
        EmergentCategory.SilentContradiction     => "bi-lightning-charge",
        EmergentCategory.UnaddressedRebuttal     => "bi-shield-exclamation",
        EmergentCategory.ConfidenceIllusion      => "bi-eye-slash",
        EmergentCategory.ConvergentGround        => "bi-intersect",
        EmergentCategory.ComplementaryChains     => "bi-link-45deg",
        EmergentCategory.EmergentConsensus       => "bi-graph-up-arrow",
        EmergentCategory.CrossDomainReinforcement=> "bi-diagram-3",
        EmergentCategory.SharedValueCore         => "bi-heart",
        _                                        => "bi-lightbulb"
    };

    string CategoryLabel(EmergentCategory cat) => cat switch
    {
        EmergentCategory.AssumptionCascade       => "Assumption Cascade",
        EmergentCategory.EvidenceDesert          => "Evidence Desert",
        EmergentCategory.SilentContradiction     => "Silent Contradiction",
        EmergentCategory.UnaddressedRebuttal     => "Unaddressed Rebuttal",
        EmergentCategory.ConfidenceIllusion      => "Confidence Illusion",
        EmergentCategory.ConvergentGround        => "Convergent Ground",
        EmergentCategory.ComplementaryChains     => "Complementary Chains",
        EmergentCategory.EmergentConsensus       => "Emergent Consensus",
        EmergentCategory.CrossDomainReinforcement=> "Cross-Domain Reinforcement",
        EmergentCategory.SharedValueCore         => "Shared Value Core",
        _                                        => cat.ToString()
    };

    string SignificanceBadge(double sig) => sig switch
    {
        >= 0.75 => "danger",
        >= 0.50 => "warning",
        >= 0.25 => "info",
        _       => "secondary"
    };

    string SignificanceLabel(double sig) => sig switch
    {
        >= 0.75 => "High",
        >= 0.50 => "Medium",
        >= 0.25 => "Low",
        _       => "Minimal"
    };

    string CategoryDescription(EmergentCategory cat) => cat switch
    {
        EmergentCategory.AssumptionCascade => "A critical assumption is shared across arguments without being tested.",
        EmergentCategory.EvidenceDesert => "An important proposition has little or no empirical evidence.",
        EmergentCategory.SilentContradiction => "Claims conflict without a direct comparison or resolution.",
        EmergentCategory.UnaddressedRebuttal => "A strong counterargument has not received a substantive response.",
        EmergentCategory.ConfidenceIllusion => "A confidence score is stronger than the available evidence quality supports.",
        EmergentCategory.ConvergentGround => "Different stakeholders accept premises that can support productive dialogue.",
        EmergentCategory.ComplementaryChains => "Separate reasoning chains reinforce one another and may support a synthesis.",
        EmergentCategory.EmergentConsensus => "Positions are converging around a proposition across the community.",
        EmergentCategory.CrossDomainReinforcement => "Arguments from different domains provide mutually reinforcing support.",
        EmergentCategory.SharedValueCore => "Stakeholders with different positions appeal to a common underlying value.",
        _ => "A cross-argument pattern detected in the shared knowledge graph."
    };

    var findingCount = Model.Blindspots.Count + Model.Harmonies.Count;
    var highImpactCount = Model.Blindspots.Concat(Model.Harmonies).Count(f => f.Significance >= 0.75);
    var filter = Context.Request.Query["filter"].ToString();
    var validFilters = new[] { "findings", "high-impact", "evidence", "work" };
    if (!validFilters.Contains(filter)) filter = "";
    var uncoveredEvidenceGaps = Model.UncoveredEvidenceGaps
        .Where(gap => !Model.Blindspots.Any(finding => finding.Category == EmergentCategory.EvidenceDesert
            && finding.InvolvedNodeIds.Contains(gap.NodeId)))
        .ToList();
    var visibleBlindspots = Model.Blindspots
        .Where(finding => filter != "high-impact" || finding.Significance >= 0.75).ToList();
    var visibleHarmonies = filter is "high-impact"
        ? Model.Harmonies.Where(finding => finding.Significance >= 0.75).ToList()
        : Model.Harmonies;
    var showUncoveredGaps = filter is "work" or "";
}

<div class="cu-workspace-hero mb-4">
    <div class="cu-workspace-hero-content">
        <div>
            <span class="cu-workspace-tag"><i class="bi bi-lightbulb"></i> Emergent Conclusions</span>
            <h1 class="cu-page-heading mt-3 mb-2">Improve the shared understanding</h1>
            <p class="cu-workspace-lead mb-2">
                These findings show where the community's reasoning needs evidence, testing, response, or collaboration.
                Choose a finding and take the suggested next step; the next analysis will show whether the gap narrowed.
            </p>
            @if (Model.HasSufficientData)
            {
                <small class="text-muted">
                    Generated @Model.GeneratedAt.ToString("MMM d, yyyy HH:mm") UTC ·
                    @(Model.IsDeepAnalysis ? "Deep analysis" : "Standard analysis")
                </small>
            }
        </div>
        <div class="cu-workspace-actions">
            <a asp-action="Index" asp-route-refresh="true" class="cu-btn-primary"
               onclick="this.setAttribute('aria-disabled', 'true'); this.style.pointerEvents='none';">
                <i class="bi bi-arrow-clockwise"></i> Refresh analysis
            </a>
            <a asp-action="DeepAnalysis" class="cu-btn-secondary" title="Run AI-enhanced semantic detection">
                <i class="bi bi-cpu"></i> Deep analysis
            </a>
            <a asp-action="History" class="cu-btn-secondary">
                <i class="bi bi-clock-history"></i> History
            </a>
            @if (Model.IsDeepAnalysis)
            {
                <span class="badge bg-primary">AI-enhanced</span>
            }
        </div>
    </div>
</div>

<div class="cu-info-band mb-4">
    <div class="row g-3 w-100">
        <div class="col-md-4"><strong>1. Choose a finding</strong><span class="d-block text-muted small">Start with a high-impact item.</span></div>
        <div class="col-md-4"><strong>2. Take the linked action</strong><span class="d-block text-muted small">Add evidence, test, compare, or collaborate.</span></div>
        <div class="col-md-4"><strong>3. Refresh the analysis</strong><span class="d-block text-muted small">Check whether the finding changed.</span></div>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle me-1"></i>@TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="bi bi-exclamation-triangle me-1"></i>@TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<!-- Insufficient Data State -->
@if (!Model.HasSufficientData)
{
    <div class="cu-card text-center py-5">
        <i class="bi bi-hourglass-split display-3 text-muted mb-3 d-block"></i>
        <h3 class="text-muted">Not Enough Data Yet</h3>
        <p class="text-muted mb-4">@Model.InsufficientDataReason</p>
        <a asp-controller="Argument" asp-action="Submit" class="btn btn-primary">
            <i class="bi bi-plus-circle me-1"></i>Submit an Argument
        </a>
    </div>
    return;
}

<!-- ══════════════════════════════════════════════════════════════════════════
     GRAPH HEALTH SUMMARY
══════════════════════════════════════════════════════════════════════════════ -->
<div class="row g-3 mb-4">
    <div class="col-6 col-lg-3">
        <a href="?filter=findings" class="cu-card cu-metric-card h-100 d-block text-decoration-none @(filter == "findings" ? "border-primary" : "")" aria-label="Show open findings" aria-current="@(filter == "findings" ? "true" : null)">
            <div class="cu-metric-label">Open findings</div>
            <div class="cu-metric-value text-primary">@findingCount</div>
            <div class="cu-metric-note">Items ready for review</div>
        </a>
    </div>
    <div class="col-6 col-lg-3">
        <a href="?filter=high-impact" class="cu-card cu-metric-card h-100 d-block text-decoration-none @(filter == "high-impact" ? "border-danger" : "")" aria-label="Show high-impact findings" aria-current="@(filter == "high-impact" ? "true" : null)">
            <div class="cu-metric-label">High-impact findings</div>
            <div class="cu-metric-value text-danger">@highImpactCount</div>
            <div class="cu-metric-note">Estimated impact of 75% or more</div>
        </a>
    </div>
    <div class="col-6 col-lg-3">
        <a href="?filter=evidence" class="cu-card cu-metric-card h-100 d-block text-decoration-none @(filter == "evidence" ? "border-warning" : "")" aria-label="Show graph nodes without evidence" aria-current="@(filter == "evidence" ? "true" : null)">
            <div class="cu-metric-label">Graph nodes without evidence</div>
            <div class="cu-metric-value text-warning">@Model.GraphHealth.NodesWithoutEvidence</div>
            <div class="cu-metric-note">Public nodes awaiting evidence</div>
        </a>
    </div>
    <div class="col-6 col-lg-3">
        <a href="?filter=work" class="cu-card cu-metric-card h-100 d-block text-decoration-none @(filter == "work" ? "border-success" : "")" aria-label="Show all open graph work" aria-current="@(filter == "work" ? "true" : null)">
            <div class="cu-metric-label">Open graph work</div>
            <div class="cu-metric-value text-success">@Model.OpenGraphWorkCount</div>
            <div class="cu-metric-note">Findings and uncovered evidence gaps</div>
        </a>
    </div>
</div>

@if (filter != "")
{
    <div class="d-flex align-items-center gap-3 mb-3" role="status">
        <span class="fw-semibold">Showing @(filter switch { "findings" => "open findings", "high-impact" => "high-impact findings", "evidence" => "nodes without evidence", _ => "open graph work" })</span>
        <a href="@Context.Request.Path" class="text-decoration-underline">Clear filter</a>
    </div>
}

<!-- Graph Status Bar -->
<div class="cu-card mb-4 p-3">
    <div class="d-flex justify-content-between align-items-center mb-2">
        <small class="fw-semibold text-muted text-uppercase">Knowledge Graph Status</small>
        <small class="text-muted">Average confidence: @(Model.GraphHealth.AverageConfidence.ToString("P0"))</small>
    </div>
    @{
        int totalNodes = Model.GraphHealth.SettledCount + Model.GraphHealth.ContestedCount
                        + Model.GraphHealth.UnknownCount + Model.GraphHealth.UnevaluatedCount;
        double settledPct    = totalNodes > 0 ? (double)Model.GraphHealth.SettledCount    / totalNodes * 100 : 0;
        double contestedPct  = totalNodes > 0 ? (double)Model.GraphHealth.ContestedCount  / totalNodes * 100 : 0;
        double unknownPct    = totalNodes > 0 ? (double)Model.GraphHealth.UnknownCount     / totalNodes * 100 : 0;
        double unevaluatedPct= totalNodes > 0 ? (double)Model.GraphHealth.UnevaluatedCount / totalNodes * 100 : 0;
    }
    <div class="progress" style="height:16px;">
        <div class="progress-bar bg-success" style="width:@settledPct.ToString("0.0")%" title="Settled: @Model.GraphHealth.SettledCount">Settled</div>
        <div class="progress-bar bg-danger"  style="width:@contestedPct.ToString("0.0")%" title="Contested: @Model.GraphHealth.ContestedCount">Contested</div>
        <div class="progress-bar bg-warning text-dark" style="width:@unknownPct.ToString("0.0")%" title="Unknown: @Model.GraphHealth.UnknownCount">Unknown</div>
        <div class="progress-bar bg-secondary" style="width:@unevaluatedPct.ToString("0.0")%" title="Unevaluated: @Model.GraphHealth.UnevaluatedCount">Unevaluated</div>
    </div>
    <div class="d-flex flex-wrap gap-3 mt-2">
        <small><span class="badge bg-success">@Model.GraphHealth.SettledCount Settled</span></small>
        <small><span class="badge bg-danger">@Model.GraphHealth.ContestedCount Contested</span></small>
        <small><span class="badge bg-warning text-dark">@Model.GraphHealth.UnknownCount Unknown</span></small>
        <small><span class="badge bg-secondary">@Model.GraphHealth.UnevaluatedCount Unevaluated</span></small>
        @if (Model.GraphHealth.HighStrengthRebuttals > 0)
        {
            <small class="ms-md-auto"><span class="badge bg-danger"><i class="bi bi-shield-exclamation me-1"></i>@Model.GraphHealth.HighStrengthRebuttals High-Strength Rebuttal(s)</span></small>
        }
    </div>
</div>

<!-- ══════════════════════════════════════════════════════════════════════════
     MAIN LAYOUT: BLINDSPOTS | HARMONIES
══════════════════════════════════════════════════════════════════════════════ -->

@if (!string.IsNullOrEmpty(Model.ExecutiveSummary))
{
    <div class="cu-card mb-4 border-start border-primary border-3">
        <div class="d-flex align-items-center mb-2 cursor-pointer"
             data-bs-toggle="collapse" data-bs-target="#execSummaryBody" aria-expanded="true"
             style="cursor:pointer;">
            <h5 class="mb-0 fw-semibold">
                <i class="bi bi-file-text me-2 text-primary"></i>Executive Summary
            </h5>
            <span class="badge bg-primary ms-2 small">LLM-generated</span>
            <i class="bi bi-chevron-up ms-auto"></i>
        </div>
        <div id="execSummaryBody">
            @foreach (var para in Model.ExecutiveSummary.Split('\n', StringSplitOptions.RemoveEmptyEntries))
            {
                <p class="text-muted mb-2 small">@para</p>
            }
        </div>
    </div>
}

@if (filter == "evidence")
{
    <section id="filtered-results">
        <h2 class="h4 mb-3">Graph nodes without evidence</h2>
        @if (!Model.UncoveredEvidenceGaps.Any())
        {
            <p class="text-muted">No public graph nodes without evidence remain in this report.</p>
        }
        else
        {
            <div class="row g-3">
            @foreach (var gap in Model.UncoveredEvidenceGaps)
            {
                var finding = Model.Blindspots.FirstOrDefault(item => item.Category == EmergentCategory.EvidenceDesert
                    && item.InvolvedNodeIds.Contains(gap.NodeId));
                <div class="col-12 col-md-6">
                    <div class="cu-card h-100 border-start border-warning border-3">
                        <h3 class="h6 fw-semibold">@gap.Text</h3>
                        @if (finding != null)
                        {
                            <a href="?filter=work#@finding.FindingKey" class="text-decoration-underline">View evidence finding</a>
                        }
                        else if (socialArgumentIdsByNode.TryGetValue(gap.NodeId, out var socialId))
                        {
                            <a asp-controller="SocialView" asp-action="Detail" asp-route-id="@socialId">View related contribution</a>
                        }
                    </div>
                </div>
            }
            </div>
        }
    </section>
}
else if (!visibleBlindspots.Any() && !visibleHarmonies.Any() && (!showUncoveredGaps || !uncoveredEvidenceGaps.Any()))
{
    <div class="cu-card text-center py-5">
        <i class="bi bi-check2-all display-3 text-success mb-3 d-block"></i>
        <h3 class="text-muted">No matching items</h3>
        <p class="text-muted">
            There are no items in this view of the current report.
        </p>
    </div>
}
else
{
<div class="row g-4" id="filtered-results">
    <!-- ─────────────────────────────────────────────────────────────────────
         LEFT: BLINDSPOTS
    ───────────────────────────────────────────────────────────────────────── -->
    @if (visibleBlindspots.Any())
    {
    <div class="col-12">
        <div class="d-flex align-items-center mb-3">
            <h2 class="h4 mb-0 text-danger fw-semibold">
                <i class="bi bi-binoculars me-2"></i>Blindspots
            </h2>
            @if (visibleBlindspots.Any())
            {
                <span class="badge bg-danger ms-2">@visibleBlindspots.Count</span>
            }
            <span class="ms-auto text-muted small">Ordered by significance</span>
        </div>

        @if (!visibleBlindspots.Any())
        {
            <div class="cu-card text-center py-4">
                <i class="bi bi-check-circle text-success fs-1 mb-2 d-block"></i>
                <p class="text-muted mb-0">No blindspots detected in the current inventory.</p>
            </div>
        }
        else
        {
            <div class="row g-3">
            @foreach (var finding in visibleBlindspots)
            {
                var returnUrl = $"{Context.Request.PathBase}{Context.Request.Path}{Context.Request.QueryString}#{finding.FindingKey}";
                var primaryAction = FindingActions.GetPrimaryAction(finding, returnUrl);
                var linkedArgument = finding.InvolvedArgumentIds
                    .Where(socialArgumentIds.ContainsKey)
                    .Select(id => (Guid?)socialArgumentIds[id])
                    .FirstOrDefault();
                var nodeLinkedArgument = finding.InvolvedNodeIds
                    .Where(socialArgumentIdsByNode.ContainsKey)
                    .Select(id => (Guid?)socialArgumentIdsByNode[id])
                    .FirstOrDefault();
                <div class="col-12 col-md-6">
                <article class="cu-card h-100 border-start border-danger border-3" id="@finding.FindingKey">
                    <div class="d-flex justify-content-between align-items-start mb-2">
                        <div class="d-flex align-items-center gap-2 flex-wrap">
                            <span class="badge bg-danger bg-opacity-10 text-danger border border-danger border-opacity-25 px-2">
                                <i class="bi @CategoryIcon(finding.Category) me-1"></i>@CategoryLabel(finding.Category)
                            </span>
                            <span class="badge bg-@SignificanceBadge(finding.Significance)">
                                @SignificanceLabel(finding.Significance) significance
                            </span>
                        </div>
                        <div class="text-end ms-2">
                            <small class="text-muted d-block" title="How confident the system is that this pattern exists; not the truth of the proposition.">Detection confidence</small>
                            <small class="fw-semibold">@SignificanceLabel(finding.Confidence)</small>
                        </div>
                    </div>

                    <h6 class="fw-semibold mb-1">@finding.Title</h6>
                    <p class="small mb-2">@CategoryDescription(finding.Category)</p>
                    <p class="text-muted small mb-2">@finding.Description</p>

                    @if (finding.InvolvedArgumentTitles.Any())
                    {
                        <div class="mb-2">
                            <small class="text-muted fw-semibold">Affected Arguments:</small>
                            <div class="d-flex flex-wrap gap-1 mt-1">
                                @foreach (var (argId, argTitle) in finding.InvolvedArgumentIds
                                    .Zip(finding.InvolvedArgumentTitles, (id, title) => (id, title)))
                                {
                                    @if (socialArgumentIds.TryGetValue(argId, out var socialArgumentId))
                                    {
                                        <a asp-controller="SocialView" asp-action="Detail" asp-route-id="@socialArgumentId"
                                           class="badge bg-secondary text-decoration-none text-white small" aria-label="View @argTitle on SocialView">
                                            @(argTitle.Length > 40 ? argTitle[..37] + "…" : argTitle)
                                        </a>
                                    }
                                }
                            </div>
                        </div>
                    }

                    @if (!string.IsNullOrEmpty(finding.SuggestedAction))
                    {
                        <div class="alert alert-warning alert-sm py-2 px-3 mb-0 mt-2" role="alert">
                            <small><i class="bi bi-arrow-right-circle me-1"></i><strong>Suggested action:</strong> @finding.SuggestedAction</small>
                        </div>
                    }

                    <div class="d-flex flex-wrap align-items-center gap-2 mt-3">
                        @if (linkedArgument.HasValue)
                        {
                            <a asp-controller="SocialView" asp-action="Detail" asp-route-id="@linkedArgument.Value"
                                         class="cu-btn-secondary"><i class="bi bi-box-arrow-up-right me-1"></i>View argument on SocialView</a>
                        }
                        else if (nodeLinkedArgument.HasValue)
                        {
                            <a asp-controller="SocialView" asp-action="Detail" asp-route-id="@nodeLinkedArgument.Value"
                               class="cu-btn-secondary"><i class="bi bi-box-arrow-up-right me-1"></i>View related contribution on SocialView</a>
                        }
                        @if (primaryAction.Enabled)
                        {
                            <a href="@Url.Action(primaryAction.Action, primaryAction.Controller, primaryAction.RouteValues)"
                               class="cu-btn-primary" title="@primaryAction.Description">
                                <i class="bi @primaryAction.Icon"></i> @primaryAction.Label
                            </a>
                        }
                        else
                        {
                            <button type="button" class="cu-btn-secondary" disabled title="@primaryAction.DisabledReason">
                                <i class="bi @primaryAction.Icon"></i> @primaryAction.Label
                            </button>
                            <small class="text-muted">@primaryAction.DisabledReason</small>
                        }
                    </div>

                    <!-- Significance meter -->
                    <div class="mt-2">
                        <div class="d-flex justify-content-between">
                            <small class="text-muted">Estimated impact</small>
                            <small class="text-muted">@SignificanceLabel(finding.Significance)</small>
                        </div>
                        <div class="progress" style="height:4px;">
                            <div class="progress-bar bg-danger" style="width:@((finding.Significance * 100).ToString("0"))%"></div>
                        </div>
                    </div>
                </article>
                </div>
            }
            </div>
        }
    </div>
    }

    <!-- ─────────────────────────────────────────────────────────────────────
         RIGHT: HARMONIES
    ───────────────────────────────────────────────────────────────────────── -->
    @if (visibleHarmonies.Any())
    {
    <div class="col-12">
        <div class="d-flex align-items-center mb-3">
            <h2 class="h4 mb-0 text-success fw-semibold">
                <i class="bi bi-union me-2"></i>Harmonies
            </h2>
            @if (visibleHarmonies.Any())
            {
                <span class="badge bg-success ms-2">@visibleHarmonies.Count</span>
            }
            <span class="ms-auto text-muted small">Ordered by significance</span>
        </div>

        @if (!visibleHarmonies.Any())
        {
            <div class="cu-card text-center py-4">
                <i class="bi bi-info-circle text-info fs-1 mb-2 d-block"></i>
                <p class="text-muted mb-0">No harmonies detected yet. Add stakeholder positions and run comparisons to surface common ground.</p>
            </div>
        }
        else
        {
            <div class="row g-3">
            @foreach (var finding in visibleHarmonies)
            {
                var returnUrl = $"{Context.Request.PathBase}{Context.Request.Path}{Context.Request.QueryString}#{finding.FindingKey}";
                var primaryAction = FindingActions.GetPrimaryAction(finding, returnUrl);
                var linkedArgument = finding.InvolvedArgumentIds
                    .Where(socialArgumentIds.ContainsKey)
                    .Select(id => (Guid?)socialArgumentIds[id])
                    .FirstOrDefault();
                var nodeLinkedArgument = finding.InvolvedNodeIds
                    .Where(socialArgumentIdsByNode.ContainsKey)
                    .Select(id => (Guid?)socialArgumentIdsByNode[id])
                    .FirstOrDefault();
                <div class="col-12 col-md-6">
                <article class="cu-card h-100 border-start border-success border-3" id="@finding.FindingKey">
                    <div class="d-flex justify-content-between align-items-start mb-2">
                        <div class="d-flex align-items-center gap-2 flex-wrap">
                            <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25 px-2">
                                <i class="bi @CategoryIcon(finding.Category) me-1"></i>@CategoryLabel(finding.Category)
                            </span>
                            <span class="badge bg-@SignificanceBadge(finding.Significance)">
                                @SignificanceLabel(finding.Significance) significance
                            </span>
                        </div>
                        <div class="text-end ms-2">
                            <small class="text-muted d-block" title="How confident the system is that this pattern exists; not the truth of the proposition.">Detection confidence</small>
                            <small class="fw-semibold">@SignificanceLabel(finding.Confidence)</small>
                        </div>
                    </div>

                    <h6 class="fw-semibold mb-1">@finding.Title</h6>
                    <p class="small mb-2">@CategoryDescription(finding.Category)</p>
                    <p class="text-muted small mb-2">@finding.Description</p>

                    @if (finding.InvolvedArgumentTitles.Any())
                    {
                        <div class="mb-2">
                            <small class="text-muted fw-semibold">Related Arguments:</small>
                            <div class="d-flex flex-wrap gap-1 mt-1">
                                @foreach (var (argId, argTitle) in finding.InvolvedArgumentIds
                                    .Zip(finding.InvolvedArgumentTitles, (id, title) => (id, title)))
                                {
                                    @if (socialArgumentIds.TryGetValue(argId, out var socialArgumentId))
                                    {
                                        <a asp-controller="SocialView" asp-action="Detail" asp-route-id="@socialArgumentId"
                                           class="badge bg-secondary text-decoration-none text-white small" aria-label="View @argTitle on SocialView">
                                            @(argTitle.Length > 40 ? argTitle[..37] + "…" : argTitle)
                                        </a>
                                    }
                                }
                            </div>
                        </div>
                    }

                    @if (!string.IsNullOrEmpty(finding.OpportunityDescription))
                    {
                        <div class="alert alert-success alert-sm py-2 px-3 mb-0 mt-2" role="alert">
                            <small><i class="bi bi-arrow-right-circle me-1"></i><strong>Opportunity:</strong> @finding.OpportunityDescription</small>
                        </div>
                    }

                    <div class="d-flex flex-wrap align-items-center gap-2 mt-3">
                        @if (linkedArgument.HasValue)
                        {
                            <a asp-controller="SocialView" asp-action="Detail" asp-route-id="@linkedArgument.Value"
                                         class="cu-btn-secondary"><i class="bi bi-box-arrow-up-right me-1"></i>View argument on SocialView</a>
                        }
                        else if (nodeLinkedArgument.HasValue)
                        {
                            <a asp-controller="SocialView" asp-action="Detail" asp-route-id="@nodeLinkedArgument.Value"
                               class="cu-btn-secondary"><i class="bi bi-box-arrow-up-right me-1"></i>View related contribution on SocialView</a>
                        }
                        @if (primaryAction.Enabled)
                        {
                            <a href="@Url.Action(primaryAction.Action, primaryAction.Controller, primaryAction.RouteValues)"
                               class="cu-btn-primary" title="@primaryAction.Description">
                                <i class="bi @primaryAction.Icon"></i> @primaryAction.Label
                            </a>
                        }
                        else
                        {
                            <button type="button" class="cu-btn-secondary" disabled title="@primaryAction.DisabledReason">
                                <i class="bi @primaryAction.Icon"></i> @primaryAction.Label
                            </button>
                            <small class="text-muted">@primaryAction.DisabledReason</small>
                        }
                    </div>

                    <!-- Significance meter -->
                    <div class="mt-2">
                        <div class="d-flex justify-content-between">
                            <small class="text-muted">Estimated impact</small>
                            <small class="text-muted">@SignificanceLabel(finding.Significance)</small>
                        </div>
                        <div class="progress" style="height:4px;">
                            <div class="progress-bar bg-success" style="width:@((finding.Significance * 100).ToString("0"))%"></div>
                        </div>
                    </div>
                </article>
                </div>
            }
            </div>
        }
    </div>
    }
    @if (showUncoveredGaps && uncoveredEvidenceGaps.Any())
    {
        <section class="col-12">
            <h2 class="h4 mb-3">Additional evidence gaps <span class="badge bg-warning text-dark">@uncoveredEvidenceGaps.Count</span></h2>
            <div class="row g-3">
            @foreach (var gap in uncoveredEvidenceGaps)
            {
                <div class="col-12 col-md-6">
                    <div class="cu-card h-100 border-start border-warning border-3">
                        <h3 class="h6 fw-semibold">@gap.Text</h3>
                        @if (socialArgumentIdsByNode.TryGetValue(gap.NodeId, out var socialId))
                        {
                            <a asp-controller="SocialView" asp-action="Detail" asp-route-id="@socialId">View related contribution</a>
                        }
                    </div>
                </div>
            }
            </div>
        </section>
    }
</div>
}

<!-- ── EXPLANATION FOOTER ───────────────────────────────────────────────────── -->
<div class="cu-card mt-4 bg-light">
    <h5 class="fw-semibold mb-2"><i class="bi bi-question-circle me-2"></i>How to read this page</h5>
    <div class="row g-3">
        <div class="col-md-6">
            <h6 class="text-danger"><i class="bi bi-binoculars me-1"></i>Blindspots</h6>
            <ul class="small text-muted mb-0">
                <li><strong>Assumption Cascade</strong> — critical assumptions shared across arguments that have never been tested</li>
                <li><strong>Evidence Desert</strong> — high-stakes propositions with no empirical evidence</li>
                <li><strong>Confidence Illusion</strong> — confidence scores unsupported by evidence quality</li>
                <li><strong>Unaddressed Rebuttal</strong> — strong counter-arguments no one has engaged with</li>
                <li><strong>Silent Contradiction</strong> — propositions that logically conflict without being formally compared (Deep Analysis)</li>
            </ul>
        </div>
        <div class="col-md-6">
            <h6 class="text-success"><i class="bi bi-union me-1"></i>Harmonies</h6>
            <ul class="small text-muted mb-0">
                <li><strong>Convergent Ground</strong> — opposing stakeholders who accept the same specific premises</li>
                <li><strong>Complementary Chains</strong> — arguments that reinforce rather than compete with each other</li>
                <li><strong>Emergent Consensus</strong> — propositions the community is naturally converging on</li>
                <li><strong>Shared Value Core</strong> — underlying values that appear across stakeholder reasoning (Deep Analysis)</li>
                <li><strong>Cross-Domain Reinforcement</strong> — arguments from different domains that mutually support each other (Deep Analysis)</li>
            </ul>
        </div>
    </div>
    <p class="small text-muted mt-3 mb-0">
        <i class="bi bi-info-circle me-1"></i>
        This analysis reads only from existing data — it does not modify any arguments or propositions.
        Use <strong>Deep Analysis</strong> to run LLM-enhanced semantic detection (requires a configured Gemini API key).
    </p>
</div>

<!-- ── DIALOGUE MODAL ───────────────────────────────────────────────────────── -->
<div class="modal fade" id="dialogueModal" tabindex="-1" aria-labelledby="dialogueModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="dialogueModalLabel">
                    <i class="bi bi-people me-2"></i>Dialogue Facilitation Guide
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body" id="dialogueModalBody">
                <div class="text-center py-4">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">Loading...</span>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    // Leverage button → Dialogue Guide modal
    document.querySelectorAll('.btn-leverage').forEach(function (btn) {
        btn.addEventListener('click', function () {
            var title       = btn.getAttribute('data-harmony-title');
            var opportunity = btn.getAttribute('data-harmony-opportunity');
            var modal       = new bootstrap.Modal(document.getElementById('dialogueModal'));
            var body        = document.getElementById('dialogueModalBody');
            document.getElementById('dialogueModalLabel').textContent = 'Dialogue Guide: ' + title;
            body.innerHTML  = '<div class="text-center py-4"><div class="spinner-border text-primary"><span class="visually-hidden">Loading…</span></div></div>';
            modal.show();

            var token = document.querySelector('input[name="__RequestVerificationToken"]');
            fetch('@Url.Action("GenerateDialogue", "EmergentConclusions")', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': token ? token.value : ''
                },
                body: JSON.stringify({ harmonyTitle: title, opportunityDescription: opportunity })
            })
            .then(function (r) { return r.ok ? r.json() : Promise.reject(r.status); })
            .then(function (guide) {
                var html = '<h6 class="fw-semibold mb-3">' + guide.title + '</h6><ol class="list-group list-group-flush">';
                guide.steps.forEach(function (s) {
                    html += '<li class="list-group-item"><strong class="d-block mb-1">Step ' + s.step + ': ' + s.label + '</strong><span class="text-muted">' + s.text + '</span></li>';
                });
                html += '</ol>';
                body.innerHTML = html;
            })
            .catch(function () {
                body.innerHTML = '<div class="alert alert-danger">Failed to generate dialogue guide. Please try again.</div>';
            });
        });
    });
</script>
}
