<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - A Common Understanding</title>
    
    <!-- Bootstrap 5.3.3 -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    
    <!-- Bootstrap Icons 1.11.3 -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    
    <!-- FontAwesome 6.4.2 -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css">

    <!-- Custom Design System CSS -->
    <link rel="stylesheet" href="~/css/portal.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/CommonUnderstanding.styles.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <!-- HEADER -->
    <header class="cu-header">
        <div class="container-fluid">
            <div class="cu-logo-section">
                <img src="~/images/app-logo.svg" alt="A Common Understanding" class="cu-logo" />
                <div class="cu-site-title">
                    <h1>A Common Understanding</h1>
                    <span class="subtitle">Belief intelligence for people and teams</span>
                </div>
            </div>
            <button class="cu-lang-toggle" onclick="toggleLanguage()" title="Français">
                <i class="fas fa-globe"></i> FR
            </button>
        </div>
    </header>

    <!-- NAVIGATION -->
    <nav class="cu-nav navbar navbar-expand-lg navbar-dark">
        <div class="container-fluid">
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#cuNavbarContent" 
                    aria-controls="cuNavbarContent" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="cuNavbarContent">
                <ul class="navbar-nav me-auto align-items-center gap-1">

                    <!-- PUBLIC ZONE -->
                    <li class="nav-item">
                        <a class="nav-link fw-semibold @(ViewContext.RouteData.Values["controller"]?.ToString() == "SocialView" && ViewContext.RouteData.Values["action"]?.ToString() == "Feed" ? "active" : "")"
                           asp-controller="SocialView" asp-action="Feed">
                            <i class="bi bi-fire"></i> Feed
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="btn cu-btn-submit ms-1 me-2"
                           asp-controller="Argument" asp-action="Submit">
                            <i class="bi bi-plus-lg me-1"></i>Submit
                        </a>
                    </li>

                    <!-- PUBLIC / PRIVATE DIVIDER -->
                    <li class="nav-item d-none d-lg-flex align-items-center px-1">
                        <span class="cu-nav-divider"></span>
                    </li>

                    <!-- PRIVATE ZONE: My Work -->
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle @(new[]{"Argument","CommonUnderstanding","EmergentConclusions","Convergence","Discovery","Connections","CollaborativeSession"}.Contains(ViewContext.RouteData.Values["controller"]?.ToString()) ? "active" : "")"
                           href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                            <i class="bi bi-person-workspace"></i> My Work
                        </a>
                        <ul class="dropdown-menu cu-dropdown-workspace">
                            <li><h6 class="dropdown-header cu-dropdown-section">Analysis</h6></li>
                            <li>
                                <a class="dropdown-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Argument" && ViewContext.RouteData.Values["action"]?.ToString() == "Index" ? "active" : "")" asp-controller="Argument" asp-action="Index">
                                    <i class="bi bi-diagram-3 me-2"></i>My Arguments
                                </a>
                            </li>
                            <li>
                                <a class="dropdown-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "CommonUnderstanding" ? "active" : "")" asp-controller="CommonUnderstanding" asp-action="Index">
                                    <i class="bi bi-diagram-2 me-2"></i>Common Understanding
                                </a>
                            </li>
                            <li>
                                <a class="dropdown-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "EmergentConclusions" ? "active" : "")" asp-controller="EmergentConclusions" asp-action="Index">
                                    <i class="bi bi-lightbulb me-2"></i>Emergent Conclusions
                                </a>
                            </li>
                            <li>
                                <a class="dropdown-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Convergence" ? "active" : "")" asp-controller="Convergence" asp-action="Index">
                                    <i class="bi bi-intersect me-2"></i>Convergence
                                </a>
                            </li>
                            <li><hr class="dropdown-divider"></li>
                            <li><h6 class="dropdown-header cu-dropdown-section">People</h6></li>
                            <li>
                                <a class="dropdown-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Discovery" && ViewContext.RouteData.Values["action"]?.ToString() == "Profile" ? "active" : "")" asp-controller="Discovery" asp-action="Profile">
                                    <i class="bi bi-person me-2"></i>Belief Profile
                                </a>
                            </li>
                            <li>
                                <a class="dropdown-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Connections" ? "active" : "")" asp-controller="Connections" asp-action="Index">
                                    <i class="bi bi-people me-2"></i>Connections
                                </a>
                            </li>
                            <li>
                                <a class="dropdown-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "CollaborativeSession" ? "active" : "")" asp-controller="CollaborativeSession" asp-action="Index">
                                    <i class="bi bi-diagram-3-fill me-2"></i>Sessions
                                </a>
                            </li>
                        </ul>
                    </li>

                    <!-- PRIVATE ZONE: Explore (published arguments) -->
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle @(new[]{"SocialView","Reference"}.Contains(ViewContext.RouteData.Values["controller"]?.ToString()) ? "active" : "")"
                           href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                            <i class="bi bi-compass"></i> Explore
                        </a>
                        <ul class="dropdown-menu cu-dropdown-workspace">
                            <li><h6 class="dropdown-header cu-dropdown-section">Published Arguments</h6></li>
                            <li>
                                <a class="dropdown-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "SocialView" && ViewContext.RouteData.Values["action"]?.ToString() == "ChainBuilder" ? "active" : "")" asp-controller="SocialView" asp-action="ChainBuilder">
                                    <i class="bi bi-diagram-3 me-2"></i>Chain Builder
                                </a>
                            </li>
                            <li>
                                <a class="dropdown-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "SocialView" && ViewContext.RouteData.Values["action"]?.ToString() == "WorldviewComposer" ? "active" : "")" asp-controller="SocialView" asp-action="WorldviewComposer">
                                    <i class="bi bi-globe2 me-2"></i>Worldview Composer
                                </a>
                            </li>
                            <li>
                                <a class="dropdown-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "SocialView" && ViewContext.RouteData.Values["action"]?.ToString() == "DebateRoom" ? "active" : "")" asp-controller="SocialView" asp-action="DebateRoom">
                                    <i class="bi bi-mic me-2"></i>Debate Room
                                </a>
                            </li>
                            <li><hr class="dropdown-divider"></li>
                            <li>
                                <a class="dropdown-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Reference" ? "active" : "")" asp-controller="Reference" asp-action="Index">
                                    <i class="bi bi-book me-2"></i>Reference Library
                                </a>
                            </li>
                        </ul>
                    </li>

                </ul>

                <!-- Identity nav (right side) -->
                <ul class="navbar-nav ms-auto align-items-center">
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        var displayName = User.FindFirst(System.Security.Claims.ClaimTypes.Name)?.Value ?? "User";
                        var userId = User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value ?? "";
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle d-flex align-items-center gap-1" href="#"
                               role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                <i class="bi bi-person-circle"></i>
                                <span>@displayName</span>
                            </a>
                            <ul class="dropdown-menu dropdown-menu-end">
                                <li>
                                    <div class="dropdown-item-text small text-muted">
                                        <div class="fw-semibold mb-1">Your Profile ID</div>
                                        <div class="d-flex align-items-center gap-1">
                                            <code id="profileIdCode" class="small text-break" style="font-size:0.7rem">@userId</code>
                                            <button class="btn btn-sm btn-outline-secondary py-0 px-1" style="font-size:0.7rem"
                                                    onclick="navigator.clipboard.writeText('@userId');this.textContent='✓';setTimeout(()=>this.textContent='Copy',1500)"
                                                    title="Copy your Profile ID to share with connections">Copy</button>
                                        </div>
                                        <div class="text-muted" style="font-size:0.65rem">Share this with others to connect</div>
                                    </div>
                                </li>
                                <li><hr class="dropdown-divider"></li>
                                <li>
                                    <a class="dropdown-item" asp-controller="Discovery" asp-action="Profile">
                                        <i class="bi bi-person me-1"></i>My Belief Profile
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item" asp-controller="Connections" asp-action="Index">
                                        <i class="bi bi-people me-1"></i>My Connections
                                    </a>
                                </li>
                                <li><hr class="dropdown-divider"></li>
                                <li>
                                    <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="dropdown-item text-danger">
                                            <i class="bi bi-box-arrow-right me-1"></i>Sign Out
                                        </button>
                                    </form>
                                </li>
                            </ul>
                        </li>
                    }
                    else
                    {
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Account" asp-action="Login">
                                <i class="bi bi-box-arrow-in-right me-1"></i>Sign In
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Account" asp-action="Register">
                                <i class="bi bi-person-plus me-1"></i>Register
                            </a>
                        </li>
                    }
                </ul>
            </div>
        </div>
    </nav>

    <!-- MAIN CONTENT -->
    <div class="cu-main-content container-fluid">
        <main role="main">
            @RenderBody()
        </main>
    </div>

    <!-- FOOTER -->
    <footer class="cu-footer">
        <div class="container-fluid">
            <div class="cu-footer-content">
                <div class="cu-footer-logo">
                    <img src="~/images/app-logo.svg" alt="A Common Understanding" class="cu-wordmark" />
                </div>
                <div class="cu-footer-info">
                    <p>
                        <i class="bi bi-compass"></i>
                        <strong>A Common Understanding</strong> - Strategic clarity across beliefs, values, and decisions
                    </p>
                    <p class="small">
                        &copy; @DateTime.Now.Year A Common Understanding |
                        Private AI-assisted analysis for research, facilitation, and decision support
                    </p>
                </div>
                <div class="cu-footer-links">
                    <a asp-controller="Home" asp-action="Privacy">
                        <i class="fas fa-shield-alt"></i> Privacy
                    </a>
                    <a href="#">
                        <i class="fas fa-file-contract"></i> Terms
                    </a>
                    <a href="#">
                        <i class="fas fa-envelope"></i> Contact
                    </a>
                </div>
            </div>
        </div>
    </footer>

    <!-- Scripts -->
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/@@microsoft/signalr@latest/dist/browser/signalr.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    
    <script>
        (function attachAiFetchTracing() {
            const nativeFetch = window.fetch;
            if (!nativeFetch) return;

            window.fetch = async function (...args) {
                const response = await nativeFetch.apply(this, args);
                const encodedTrace = response.headers.get('X-AI-Trace');

                if (encodedTrace) {
                    try {
                        const trace = JSON.parse(atob(encodedTrace));
                        const requestUrl = typeof args[0] === 'string'
                            ? args[0]
                            : args[0]?.url || '(unknown url)';

                        console.groupCollapsed(`[AI Trace] ${requestUrl}`);
                        trace.forEach((entry, index) => {
                            console.log(`#${index + 1}`, {
                                provider: entry.provider,
                                model: entry.model,
                                streaming: entry.isStreaming,
                                prompt: entry.promptPreview,
                                timestampUtc: entry.timestampUtc
                            });
                        });
                        console.groupEnd();
                    } catch (error) {
                        console.warn('Failed to parse AI trace header.', error);
                    }
                }

                return response;
            };
        })();

        // Language Toggle Function
        function toggleLanguage() {
            // i18n not yet implemented — stub to prevent alert() in production
            console.info('[i18n] Language toggle not yet implemented.');
        }

        
    </script>
    
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
