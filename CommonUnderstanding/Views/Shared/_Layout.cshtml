<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - A Common Understanding</title>
    
    <!-- Bootstrap 5.3.3 -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    
    <!-- Bootstrap Icons 1.11.3 -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    
    <!-- FontAwesome 6.4.2 -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css">
    
    <!-- Custom GC Design System CSS -->
    <link rel="stylesheet" href="~/css/portal.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/CommonUnderstanding.styles.css" asp-append-version="true" />
</head>
<body>
    <!-- GC HEADER -->
    <header class="gc-header">
        <div class="container-fluid">
            <div class="gc-logo-section">
                <img src="~/images/sig-blk-en.svg" alt="Government of Canada" class="gc-logo" />
                <div class="gc-site-title">
                    <h1>A Common Understanding</h1>
                    <span class="subtitle">Evidence-Based Decision Platform</span>
                </div>
            </div>
            <button class="gc-lang-toggle" onclick="toggleLanguage()" title="Français">
                <i class="fas fa-globe"></i> FR
            </button>
        </div>
    </header>

    <!-- GC NAVIGATION -->
    <nav class="gc-nav navbar navbar-expand-lg navbar-dark">
        <div class="container-fluid">
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#gcNavbarContent" 
                    aria-controls="gcNavbarContent" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="gcNavbarContent">
                <ul class="navbar-nav me-auto">
                    <li class="nav-item">
                        <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Dashboard" ? "active" : "")" 
                           asp-controller="Dashboard" asp-action="Index">
                            <i class="bi bi-speedometer2"></i> Dashboard
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Argument" ? "active" : "")"
                           asp-controller="Argument" asp-action="Index">
                            <i class="bi bi-diagram-3"></i> Arguments
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "CommonUnderstanding" ? "active" : "")"
                           asp-controller="CommonUnderstanding" asp-action="Index">
                            <i class="bi bi-diagram-2"></i> Common Understanding
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "EmergentConclusions" ? "active" : "")"
                           asp-controller="EmergentConclusions" asp-action="Index">
                            <i class="bi bi-lightbulb"></i> Emergent Conclusions
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Reference" ? "active" : "")"
                           asp-controller="Reference" asp-action="Index">
                            <i class="bi bi-book"></i> Reference
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Settings" ? "active" : "")"
                           asp-controller="Settings" asp-action="Index">
                            <i class="bi bi-gear"></i> Settings
                            <span id="navAiStatusDot" title="AI Status"
                                  style="display:inline-block;width:7px;height:7px;border-radius:50%;background:#6b7280;margin-left:4px;vertical-align:middle;"></span>
                        </a>
                    </li>
                </ul>
            </div>
        </div>
    </nav>

    <!-- MAIN CONTENT -->
    <div class="gc-main-content container-fluid">
        <main role="main">
            @RenderBody()
        </main>
    </div>

    <!-- GC FOOTER -->
    <footer class="gc-footer">
        <div class="container-fluid">
            <div class="gc-footer-content">
                <div class="gc-footer-logo">
                    <img src="~/images/wmms-blk.svg" alt="Symbol of the Government of Canada" class="gc-wordmark" />
                </div>
                <div class="gc-footer-info">
                    <p>
                        <i class="bi bi-heart-fill text-danger"></i>
                        <strong>Common Understanding</strong> - Finding what binds us together
                    </p>
                    <p class="small">
                        &copy; @DateTime.Now.Year Government of Canada | 
                        Powered by Semantic Kernel & Ollama | 
                        Version 1.0.0
                    </p>
                </div>
                <div class="gc-footer-links">
                    <a asp-controller="Home" asp-action="Privacy">
                        <i class="fas fa-shield-alt"></i> Privacy
                    </a>
                    <a href="#">
                        <i class="fas fa-file-contract"></i> Terms
                    </a>
                    <a href="#">
                        <i class="fas fa-envelope"></i> Contact
                    </a>
                </div>
            </div>
        </div>
    </footer>

    <!-- Scripts -->
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/@@microsoft/signalr@latest/dist/browser/signalr.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    
    <script>
        // AI status dot in nav — polls every 30s
        (async function updateNavAiDot() {
            try {
                const r = await fetch('/api/AIStatus/status');
                const d = await r.json();
                const dot = document.getElementById('navAiStatusDot');
                if (!dot) return;
                if (d.ollamaConnected && d.modelLoaded) dot.style.background = '#198754';
                else if (d.ollamaConnected)              dot.style.background = '#ffc107';
                else                                     dot.style.background = '#dc3545';
                dot.title = d.ollamaConnected ? (d.modelLoaded ? 'AI: Ready' : 'AI: Partial') : 'AI: Offline';
            } catch { /* silent fail */ }
            setTimeout(updateNavAiDot, 30000);
        })();

        // Language Toggle Function
        function toggleLanguage() {
            // Placeholder for future i18n implementation
            const currentLang = document.documentElement.lang;
            const newLang = currentLang === 'en' ? 'fr' : 'en';
            
            // Update button text
            const langBtn = document.querySelector('.gc-lang-toggle');
            langBtn.innerHTML = newLang === 'en' ? '<i class="fas fa-globe"></i> FR' : '<i class="fas fa-globe"></i> EN';
            
            // This would typically trigger a language switch
            console.log('Language toggle clicked. Future implementation will switch to: ' + newLang);
            
            // Show notification
            alert('Language toggle functionality will be implemented with full i18n support.');
        }

        // Add active state to current navigation item
        document.addEventListener('DOMContentLoaded', function() {
            const currentPath = window.location.pathname;
            document.querySelectorAll('.gc-nav .nav-link').forEach(link => {
                if (link.getAttribute('href') === currentPath) {
                    link.classList.add('active');
                }
            });
        });
    </script>
    
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
