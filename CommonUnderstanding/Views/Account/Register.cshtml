@{
    ViewData["Title"] = "Register";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="cu-auth-shell row g-4 align-items-stretch">
    <div class="col-lg-6">
        <section class="cu-auth-brand h-100">
            <span class="cu-home-kicker">
                <i class="bi bi-person-plus"></i>
                New Account
            </span>
            <h1>Create a workspace for deeper worldview discovery.</h1>
            <p>
                Start with an adaptive profile, benchmark it against canonical systems, and collaborate with
                others from a single polished platform.
            </p>

            <div class="cu-auth-points">
                <div class="cu-auth-point">
                    <span class="cu-auth-point-icon"><i class="bi bi-person-vcard"></i></span>
                    <div>
                        <strong>Profile mapping</strong>
                        <p>Capture a more nuanced view of values, priorities, and worldview structure from day one.</p>
                    </div>
                </div>
                <div class="cu-auth-point">
                    <span class="cu-auth-point-icon"><i class="bi bi-globe-americas"></i></span>
                    <div>
                        <strong>Canonical benchmarks</strong>
                        <p>Compare against established traditions in philosophy, religion, and political thought.</p>
                    </div>
                </div>
                <div class="cu-auth-point">
                    <span class="cu-auth-point-icon"><i class="bi bi-people"></i></span>
                    <div>
                        <strong>Shared-ground workflows</strong>
                        <p>Connect with others, run sessions, and spot durable areas of agreement faster.</p>
                    </div>
                </div>
            </div>
        </section>
    </div>

    <div class="col-lg-6 col-xl-5 ms-xl-auto">
        <div class="cu-card cu-auth-card h-100">
            <div class="cu-card-header">
                <span class="cu-home-panel-label">Create Account</span>
                <h2>Start with a polished workspace</h2>
                <p class="text-muted mb-0">Create your profile, save comparisons, and invite others into the conversation.</p>
            </div>
            <div class="cu-card-body">
                @if (!ViewData.ModelState.IsValid)
                {
                    <div class="alert alert-danger py-2">
                        @foreach (var err in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                        {
                            <div><i class="bi bi-exclamation-circle me-1"></i>@err.ErrorMessage</div>
                        }
                    </div>
                }

                <form method="post" asp-action="Register">
                    @Html.AntiForgeryToken()

                    <div class="mb-3">
                        <label class="form-label fw-semibold" for="username">Username</label>
                        <input id="username" name="username" type="text" class="form-control"
                               autocomplete="username" autofocus required
                               placeholder="Used to log in" />
                        <div class="form-text">Lowercase letters, numbers, and no spaces.</div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold" for="displayName">Display Name</label>
                        <input id="displayName" name="displayName" type="text" class="form-control"
                               autocomplete="name" required
                               placeholder="Shown to other users" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold" for="password">Password</label>
                        <input id="password" name="password" type="password" class="form-control"
                               autocomplete="new-password" required
                               placeholder="At least 8 characters" />
                    </div>

                    <div class="mb-4">
                        <label class="form-label fw-semibold" for="confirmPassword">Confirm Password</label>
                        <input id="confirmPassword" name="confirmPassword" type="password" class="form-control"
                               autocomplete="new-password" required placeholder="Repeat your password" />
                    </div>

                    <button type="submit" class="btn btn-primary w-100">
                        <i class="bi bi-person-check me-1"></i>Create Account &amp; Start
                    </button>
                </form>
            </div>
            <div class="cu-card-footer text-center small text-muted">
                Already have an account?
                <a asp-action="Login" class="text-decoration-none fw-semibold">Sign in</a>
            </div>
        </div>
    </div>
</div>
