@{
    ViewData["Title"] = "Access Denied";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="row justify-content-center mt-5">
    <div class="col-12 col-sm-8 col-md-5 text-center">
        <i class="bi bi-shield-lock display-1 text-danger mb-3 d-block"></i>
        <h1 class="h3">Access Denied</h1>
        <p class="text-muted">You don't have permission to view that page.</p>
        <a asp-controller="Dashboard" asp-action="Index" class="btn btn-primary me-2">
            <i class="bi bi-house me-1"></i>Dashboard
        </a>
        <a asp-controller="Account" asp-action="Login" class="btn btn-outline-secondary">
            <i class="bi bi-box-arrow-in-right me-1"></i>Sign In
        </a>
    </div>
</div>
