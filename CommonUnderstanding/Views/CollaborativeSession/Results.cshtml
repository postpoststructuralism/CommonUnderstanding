@model CommonUnderstanding.Controllers.CollaborativeSessionResultsViewModel
@using CommonUnderstanding.Models
@{
    ViewData["Title"] = $"Results: {Model.Session.Title}";
}

<div class="d-flex justify-content-between align-items-start mb-4 flex-wrap gap-2">
    <div>
        <h1 class="gc-page-heading mb-1">
            <i class="bi bi-bar-chart-steps me-2"></i>Session Results
        </h1>
        <p class="text-muted mb-0">@Model.Session.Title</p>
    </div>
    <div class="d-flex gap-2">
        @if (Model.HasConvergenceMap)
        {
            <a asp-controller="Convergence" asp-action="Index" class="btn btn-outline-primary btn-sm">
                <i class="bi bi-intersect me-1"></i>View Convergence Map
            </a>
        }
        <a asp-action="Details" asp-route-id="@Model.Session.Id" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-arrow-left me-1"></i>Back to Session
        </a>
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(Model.Session.ExecutiveSummary))
{
    <div class="gc-card mb-4 border-primary border-opacity-50">
        <div class="gc-card-header">
            <h2 class="h5 mb-0"><i class="bi bi-journal-text me-2 text-primary"></i>Executive Summary</h2>
        </div>
        <div class="gc-card-body">
            <p class="mb-0">@Model.Session.ExecutiveSummary</p>
        </div>
    </div>
}

@if (Model.Report is not null)
{
    <!-- Harmonies -->
    @if (Model.Report.Harmonies.Any())
    {
        <div class="gc-card mb-4">
            <div class="gc-card-header">
                <h2 class="h5 mb-0">
                    <i class="bi bi-heart-fill me-2 text-success"></i>Harmonies Found
                    <span class="badge bg-success ms-2">@Model.Report.Harmonies.Count</span>
                </h2>
            </div>
            <div class="gc-card-body">
                <div class="row g-3">
                    @foreach (var h in Model.Report.Harmonies)
                    {
                        <div class="col-12 col-md-6">
                            <div class="p-3 border border-success border-opacity-25 rounded bg-success bg-opacity-5">
                                <div class="d-flex justify-content-between mb-1">
                                    <strong class="small">@h.Title</strong>
                                    <span class="badge bg-success">@h.Significance.ToString("F2")</span>
                                </div>
                                <p class="small text-muted mb-1">@h.Description</p>
                                @if (!string.IsNullOrWhiteSpace(h.OpportunityDescription))
                                {
                                    <p class="small fst-italic border-start border-success border-3 ps-2 mb-0">
                                        @h.OpportunityDescription
                                    </p>
                                }
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    }

    <!-- Blindspots -->
    @if (Model.Report.Blindspots.Any())
    {
        <div class="gc-card mb-4">
            <div class="gc-card-header">
                <h2 class="h5 mb-0">
                    <i class="bi bi-eye-slash me-2 text-warning"></i>Shared Blindspots
                    <span class="badge bg-warning text-dark ms-2">@Model.Report.Blindspots.Count</span>
                </h2>
            </div>
            <div class="gc-card-body">
                <div class="row g-3">
                    @foreach (var b in Model.Report.Blindspots)
                    {
                        <div class="col-12 col-md-6">
                            <div class="p-3 border border-warning border-opacity-25 rounded bg-warning bg-opacity-5">
                                <div class="d-flex justify-content-between mb-1">
                                    <strong class="small">@b.Title</strong>
                                    <span class="badge bg-warning text-dark">@b.Significance.ToString("F2")</span>
                                </div>
                                <p class="small text-muted mb-1">@b.Description</p>
                                @if (!string.IsNullOrWhiteSpace(b.SuggestedAction))
                                {
                                    <p class="small border-start border-warning border-3 ps-2 mb-0">
                                        <strong>Action:</strong> @b.SuggestedAction
                                    </p>
                                }
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    }

    <!-- Graph health -->
    @if (Model.Report.GraphHealth is not null)
    {
        var health = Model.Report.GraphHealth;
        <div class="gc-card">
            <div class="gc-card-header">
                <h2 class="h5 mb-0"><i class="bi bi-heart-pulse me-2 text-info"></i>Joint Graph Health</h2>
            </div>
            <div class="gc-card-body">
                <div class="row text-center g-3">
                    <div class="col-6 col-md-3">
                        <div class="fw-bold display-6 text-primary">@health.TotalArguments</div>
                        <div class="small text-muted">Arguments</div>
                    </div>
                    <div class="col-6 col-md-3">
                        <div class="fw-bold display-6 text-secondary">@health.TotalPropositions</div>
                        <div class="small text-muted">Propositions</div>
                    </div>
                    <div class="col-6 col-md-3">
                        <div class="fw-bold display-6 text-success">@health.SettledCount</div>
                        <div class="small text-muted">Settled</div>
                    </div>
                    <div class="col-6 col-md-3">
                        <div class="fw-bold display-6 text-warning">@health.ContestedCount</div>
                        <div class="small text-muted">Contested</div>
                    </div>
                </div>
            </div>
        </div>
    }
}
else
{
    <div class="alert alert-info">
        <i class="bi bi-info-circle me-1"></i>Results are not yet available. Run the joint analysis first.
    </div>
}
