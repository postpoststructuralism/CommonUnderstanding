@{
    var schema = ViewBag.Schema as CommonUnderstanding.Services.SchemaSummary;
    var nodes = ViewBag.Nodes as List<CommonUnderstanding.Services.SchemaNodeDetail> ?? new();
    var dialecticalPairs = ViewBag.DialecticalPairs as List<CommonUnderstanding.Services.DialecticalPair> ?? new();
    ViewData["Title"] = $"Schema: {schema?.Label}";
}

<style>
    .container { max-width: 1200px; margin: 0 auto; padding: 24px; }

    .schema-header {
        background: #fff;
        border: 1px solid var(--cu-border-light);
        border-radius: var(--cu-border-radius);
        padding: 24px;
        margin-bottom: 24px;
        box-shadow: var(--cu-shadow-xs);
    }

    .schema-header h1 { font-size: 24px; font-weight: 600; color: var(--cu-primary-blue); margin-bottom: 8px; }
    .schema-header .description { color: var(--cu-text-muted); font-size: 14px; margin-bottom: 16px; }

    .schema-meta {
        display: flex;
        gap: 24px;
        flex-wrap: wrap;
    }

    .schema-meta-item {
        display: flex;
        flex-direction: column;
        gap: 2px;
    }

    .schema-meta-item .label { font-size: 11px; color: var(--cu-text-muted); text-transform: uppercase; letter-spacing: 0.5px; }
    .schema-meta-item .value { font-size: 18px; font-weight: 600; color: var(--cu-primary-blue); }

    .section-title {
        font-size: 16px;
        font-weight: 600;
        color: var(--cu-primary-blue);
        margin: 24px 0 12px;
        padding-bottom: 8px;
        border-bottom: 1px solid var(--cu-border-light);
    }

    .node-table {
        width: 100%;
        border-collapse: collapse;
        background: #fff;
        border: 1px solid var(--cu-border-light);
        border-radius: var(--cu-border-radius);
        overflow: hidden;
        box-shadow: var(--cu-shadow-xs);
    }

    .node-table th {
        background: var(--cu-background);
        padding: 10px 14px;
        text-align: left;
        font-size: 11px;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        color: var(--cu-text-muted);
        border-bottom: 1px solid var(--cu-border-light);
    }

    .node-table td {
        padding: 10px 14px;
        font-size: 13px;
        color: var(--cu-text-dark);
        border-bottom: 1px solid var(--cu-border-light);
    }

    .node-table tr:hover td { background: rgba(var(--cu-secondary-rgb), 0.04); }
    .node-table tr:last-child td { border-bottom: none; }

    .node-link {
        color: var(--cu-secondary-blue);
        text-decoration: none;
    }

    .node-link:hover { text-decoration: underline; color: var(--cu-primary-blue); }

    .pair-card {
        background: #fff;
        border: 1px solid var(--cu-border-light);
        border-radius: var(--cu-border-radius);
        padding: 14px;
        margin-bottom: 8px;
        box-shadow: var(--cu-shadow-xs);
    }

    .pair-card .pair-title { font-size: 13px; font-weight: 500; color: var(--cu-primary-blue); margin-bottom: 4px; }
    .pair-card .pair-meta { font-size: 11px; color: var(--cu-text-muted); display: flex; gap: 12px; }

    .back-link {
        display: inline-block;
        margin-bottom: 16px;
        color: var(--cu-secondary-blue);
        text-decoration: none;
        font-size: 13px;
    }

    .back-link:hover { text-decoration: underline; color: var(--cu-primary-blue); }
</style>

<div class="container">
    <a href="/UnderstandingGraph" class="back-link">← Back to Schema Explorer</a>

    @if (schema != null)
    {
        <div class="schema-header">
            <a asp-action="Evolution" asp-route-schemaId="@schema.Id" class="float-end small"><i class="bi bi-clock-history me-1"></i>View region history</a>
            <h1>@schema.Label</h1>
            @if (!string.IsNullOrEmpty(schema.Description))
            {
                <div class="description">@schema.Description</div>
            }
            <div class="schema-meta">
                <div class="schema-meta-item">
                    <span class="label">Members</span>
                    <span class="value">@schema.MemberCount</span>
                </div>
                <div class="schema-meta-item">
                    <span class="label">Coherence</span>
                    <span class="value" style="color: @(schema.Coherence > 0.6 ? "var(--accent-green)" : schema.Coherence > 0.3 ? "var(--accent-orange)" : "var(--accent-red)")">@schema.Coherence.ToString("F3")</span>
                </div>
                <div class="schema-meta-item">
                    <span class="label">Stability</span>
                    <span class="value">@schema.Stability.ToString("F3")</span>
                </div>
                <div class="schema-meta-item">
                    <span class="label">Method</span>
                    <span class="value" style="font-size:14px;">@schema.DiscoveryMethod</span>
                </div>
                <div class="schema-meta-item">
                    <span class="label">Factor Index</span>
                    <span class="value">@(schema.FactorIndex?.ToString() ?? "N/A")</span>
                </div>
                <div class="schema-meta-item">
                    <span class="label">Discovered</span>
                    <span class="value" style="font-size:14px;">@schema.DiscoveredAt.ToString("yyyy-MM-dd")</span>
                </div>
            </div>
        </div>

        <h2 class="section-title">Member Nodes</h2>
        @if (nodes.Count == 0)
        {
            <p style="color:var(--text-secondary);">No member nodes.</p>
        }
        else
        {
            <table class="node-table">
                <thead>
                    <tr>
                        <th>Proposition</th>
                        <th>Weight</th>
                        <th>Confidence</th>
                        <th>Centrality</th>
                        <th>Dialectical Temp</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var n in nodes)
                    {
                        <tr>
                            <td><a href="/UnderstandingGraph/Node/@n.NodeId" class="node-link">@n.CanonicalText</a></td>
                            <td>@n.Weight.ToString("F3")</td>
                            <td>@n.Confidence.ToString("F3")</td>
                            <td>@n.DegreeCentrality.ToString("F3")</td>
                            <td>@n.DialecticalTemperature.ToString("F3")</td>
                        </tr>
                    }
                </tbody>
            </table>
        }

        @if (dialecticalPairs.Any(p => p.SourceId == nodes.FirstOrDefault()?.NodeId || p.TargetId == nodes.FirstOrDefault()?.NodeId))
        {
            <h2 class="section-title">Related Dialectical Pairs</h2>
            @foreach (var pair in dialecticalPairs.Where(p => nodes.Any(n => n.NodeId == p.SourceId || n.NodeId == p.TargetId)))
            {
                <div class="pair-card">
                    <div class="pair-title">
                        <a href="/UnderstandingGraph/Node/@pair.SourceId" class="node-link">@pair.SourceLabel</a>
                        ↔
                        <a href="/UnderstandingGraph/Node/@pair.TargetId" class="node-link">@pair.TargetLabel</a>
                    </div>
                    <div class="pair-meta">
                        <span>Type: @pair.Relationship</span>
                        <span>Weight: @pair.Weight.ToString("F2")</span>
                    </div>
                </div>
            }
        }
    }
    else
    {
        <p style="color:var(--text-secondary);">Schema not found.</p>
    }
</div>

@{
    var schemaLabel = schema?.Label ?? "this schema";
    if (schemaLabel.Length > 80) { schemaLabel = schemaLabel[..77] + "…"; }
}
@await Html.PartialAsync("_InlineContribution",
    (ContextLabel: schemaLabel, ContextType: "Schema", ContextId: (schema?.Id ?? 0).ToString()))

@section Scripts {
<script src="~/js/inline-contribution.js"></script>
}