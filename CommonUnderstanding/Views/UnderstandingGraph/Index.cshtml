@using CommonUnderstanding.Models
@using CommonUnderstanding.Services
@{
    ViewData["Title"] = "Understanding Graph — Schema Explorer";
    var stats = ViewBag.Statistics as QuickStats;
    var isHomePage = ViewBag.IsHomePage as bool? ?? false;
}

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/vis-network/9.1.6/dist/vis-network.min.css" />
<style>
    .graph-container {
        display: flex;
        height: calc(100vh - 60px);
        gap: 0;
        min-height: 0;
    }

    /* ── Sidebar ── */
    .sidebar {
        width: 380px;
        min-width: 380px;
        background: #fff;
        border-right: 1px solid var(--cu-border-light);
        display: flex;
        flex-direction: column;
        overflow: hidden;
    }

    .sidebar-header {
        padding: 16px 20px;
        border-bottom: 1px solid var(--cu-border-light);
        background: linear-gradient(135deg, rgba(var(--cu-secondary-rgb), 0.06), rgba(var(--cu-accent-rgb), 0.04));
    }

    .sidebar-header h1 {
        font-size: 18px;
        font-weight: 600;
        color: var(--cu-primary-blue);
    }

    .sidebar-header p {
        font-size: 12px;
        color: var(--cu-text-muted);
        margin-top: 4px;
    }

    .sidebar-tabs {
        display: flex;
        border-bottom: 1px solid var(--cu-border-light);
        background: #fff;
    }

    .sidebar-tab {
        flex: 1;
        padding: 10px;
        text-align: center;
        font-size: 12px;
        font-weight: 500;
        color: var(--cu-text-muted);
        cursor: pointer;
        border-bottom: 2px solid transparent;
        transition: all 0.2s;
        background: none;
        border-top: none;
        border-left: none;
        border-right: none;
    }

    .sidebar-tab:hover { color: var(--cu-primary-blue); }
    .sidebar-tab.active {
        color: var(--cu-secondary-blue);
        border-bottom-color: var(--cu-secondary-blue);
    }

    .sidebar-content {
        flex: 1;
        overflow-y: auto;
        padding: 12px;
    }

    /* ── Sidebar cards ── */
    .sidebar .card {
        background: #fff;
        border: 1px solid var(--cu-border-light);
        border-radius: 0.9rem;
        padding: 14px;
        margin-bottom: 10px;
        cursor: pointer;
        transition: border-color 0.2s, transform 0.1s;
        box-shadow: var(--cu-shadow-xs);
    }

    .sidebar .card:hover {
        border-color: var(--cu-secondary-blue);
        transform: translateX(2px);
        box-shadow: var(--cu-shadow-sm);
    }

    .sidebar .card-title {
        font-size: 14px;
        font-weight: 600;
        color: var(--cu-primary-blue);
        margin-bottom: 6px;
    }

    .sidebar .card-meta {
        font-size: 11px;
        color: var(--cu-text-muted);
        display: flex;
        gap: 12px;
        flex-wrap: wrap;
    }

    .sidebar .card-meta span {
        display: inline-flex;
        align-items: center;
        gap: 4px;
    }

    /* ── Stats bar ── */
    .stats-bar {
        display: flex;
        gap: 16px;
        padding: 10px 20px;
        background: linear-gradient(135deg, rgba(var(--cu-secondary-rgb), 0.06), rgba(var(--cu-accent-rgb), 0.04));
        border-bottom: 1px solid var(--cu-border-light);
        font-size: 12px;
    }

    .stat-item {
        display: flex;
        align-items: center;
        gap: 6px;
    }

    .stat-value {
        font-weight: 600;
        color: var(--cu-primary-blue);
    }

    .stat-label {
        color: var(--cu-text-muted);
    }

    /* ── Visualization ── */
    .visualization {
        flex: 1;
        position: relative;
        background: #fcfaf6;
        display: flex;
        flex-direction: column;
        min-height: 0;
    }

    #graph-network {
        width: 100%;
        flex: 1;
        min-height: 0;
        overflow: hidden;
    }

    /* ── Graph loading overlay ── */
    .graph-loading {
        position: absolute;
        inset: 0;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        background: rgba(252, 250, 246, 0.92);
        z-index: 10;
        pointer-events: none;
        transition: opacity 0.5s ease;
    }
    .graph-loading.hidden {
        opacity: 0;
        pointer-events: none;
    }
    .graph-loading .spinner-ring {
        --color-1: var(--cu-secondary-blue, #0f766e);
        --size: 1px;
        width: calc(48 * var(--size));
        height: calc(48 * var(--size));
        display: inline-block;
        position: relative;
    }
    .graph-loading .spinner-ring::after,
    .graph-loading .spinner-ring::before {
        content: '';
        box-sizing: border-box;
        width: calc(48 * var(--size));
        height: calc(48 * var(--size));
        border-radius: 50%;
        border: calc(2 * var(--size)) solid var(--color-1);
        position: absolute;
        left: 0;
        top: 0;
        animation: animloader 2s linear infinite;
    }
    .graph-loading .spinner-ring::after {
        animation-delay: 1s;
    }
    @@keyframes animloader {
        0% {
            transform: scale(0);
            opacity: 1;
        }
        100% {
            transform: scale(1);
            opacity: 0;
        }
    }
    .graph-loading .spinner-label {
        margin-top: 16px;
        font-size: 13px;
        font-weight: 500;
        color: var(--cu-text-muted, #667487);
        letter-spacing: 0.3px;
        animation: spinner-fade-text 2s ease-in-out infinite;
    }
    @@keyframes animloader {
        0% {
            transform: scale(0);
            opacity: 1;
        }
        100% {
            transform: scale(1);
            opacity: 0;
        }
    }

    /* ── Graph Controls ── */
    .graph-controls {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 8px 16px;
        background: #fff;
        border-bottom: 1px solid var(--cu-border-light);
        font-size: 12px;
        flex-wrap: wrap;
    }

    .graph-controls label {
        color: var(--cu-text-muted);
        font-weight: 500;
        white-space: nowrap;
    }

    .graph-controls select,
    .graph-controls input[type="range"] {
        background: #fff;
        border: 1px solid var(--cu-border-light);
        border-radius: 0.5rem;
        color: var(--cu-text-dark);
        padding: 4px 8px;
        font-size: 12px;
        outline: none;
    }

    .graph-controls select:focus { border-color: var(--cu-secondary-blue); }

    .graph-controls .ctrl-group {
        display: flex;
        align-items: center;
        gap: 6px;
    }

    .graph-controls .ctrl-toggle {
        display: inline-flex;
        align-items: center;
        gap: 4px;
        padding: 4px 10px;
        border: 1px solid var(--cu-border-light);
        border-radius: 0.5rem;
        background: #fff;
        color: var(--cu-text-muted);
        cursor: pointer;
        font-size: 12px;
        transition: all 0.2s;
    }

    .graph-controls .ctrl-toggle:hover {
        border-color: var(--cu-secondary-blue);
        color: var(--cu-primary-blue);
    }

    .graph-controls .ctrl-toggle.active {
        background: rgba(var(--cu-secondary-rgb), 0.1);
        border-color: var(--cu-secondary-blue);
        color: var(--cu-secondary-blue);
    }

    /* ── Legend ── */
    .graph-legend {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 6px 16px;
        background: #fff;
        border-bottom: 1px solid var(--cu-border-light);
        font-size: 11px;
        flex-wrap: wrap;
    }

    .legend-item {
        display: inline-flex;
        align-items: center;
        gap: 4px;
        color: var(--cu-text-muted);
    }

    .legend-dot {
        width: 10px;
        height: 10px;
        border-radius: 50%;
        display: inline-block;
    }

    .vis-tooltip {
        position: absolute;
        visibility: hidden;
        z-index: 1000;
        pointer-events: none;
        white-space: nowrap;
        background: #fff !important;
        border: 1px solid var(--cu-border-light) !important;
        border-radius: 0.6rem !important;
        color: var(--cu-text-dark) !important;
        font-size: 12px !important;
        padding: 8px 12px !important;
        box-shadow: var(--cu-shadow-sm) !important;
    }

    .graph-hover-popup {
        position: absolute;
        z-index: 200;
        pointer-events: auto;
        opacity: 0;
        transform: translateY(6px);
        transition: opacity 0.18s ease-out, transform 0.18s ease-out;
        background: #ffffff;
        border: 1px solid var(--cu-border-light, #e2e8f0);
        border-radius: 1rem;
        box-shadow: 0 12px 40px rgba(22, 33, 49, 0.15), 0 4px 12px rgba(22, 33, 49, 0.08);
        padding: 16px 18px;
        min-width: 240px;
        max-width: 340px;
        cursor: pointer;
        font-family: inherit;
    }

    .graph-hover-popup.visible {
        opacity: 1;
        transform: translateY(0);
    }

    .graph-hover-popup::after {
        content: '';
        position: absolute;
        bottom: -8px;
        left: 50%;
        transform: translateX(-50%);
        width: 0;
        height: 0;
        border-left: 8px solid transparent;
        border-right: 8px solid transparent;
        border-top: 8px solid #ffffff;
        filter: drop-shadow(0 2px 2px rgba(22, 33, 49, 0.08));
    }

    .graph-hover-popup .popup-label {
        font-size: 14px;
        font-weight: 600;
        color: var(--cu-primary-blue, #162131);
        line-height: 1.4;
        margin-bottom: 10px;
        display: -webkit-box;
        -webkit-line-clamp: 3;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    .graph-hover-popup .popup-meta { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; }
    .graph-hover-popup .popup-badge { display: inline-flex; align-items: center; font-size: 11px; font-weight: 600; padding: 3px 10px; border-radius: 999px; letter-spacing: 0.3px; }
    .graph-hover-popup .popup-badge.settled { background: rgba(5, 150, 105, 0.1); color: #059669; }
    .graph-hover-popup .popup-badge.contested { background: rgba(217, 119, 6, 0.1); color: #d97706; }
    .graph-hover-popup .popup-badge.unevaluated { background: rgba(102, 116, 135, 0.1); color: #667487; }
    .graph-hover-popup .popup-confidence { font-size: 11px; color: var(--cu-text-muted, #667487); display: flex; align-items: center; gap: 4px; }
    .graph-hover-popup .popup-confidence-bar { width: 48px; height: 4px; border-radius: 2px; background: #e2e8f0; overflow: hidden; }
    .graph-hover-popup .popup-confidence-fill { height: 100%; border-radius: 2px; background: linear-gradient(90deg, #0f766e, #059669); transition: width 0.3s ease; }
    .graph-hover-popup .popup-cta { margin-top: 10px; font-size: 11px; font-weight: 500; color: var(--cu-secondary-blue, #0f766e); display: flex; align-items: center; gap: 4px; opacity: 0.8; }
    .graph-hover-popup .popup-cta i { font-size: 10px; }
    }

    /* ── Search ── */
    .search-box {
        padding: 12px 20px;
        border-bottom: 1px solid var(--cu-border-light);
    }

    .search-box input {
        width: 100%;
        padding: 8px 12px;
        background: #fff;
        border: 1px solid var(--cu-border-light);
        border-radius: 0.9rem;
        color: var(--cu-text-dark);
        font-size: 13px;
        outline: none;
    }

    .search-box input:focus {
        border-color: var(--cu-secondary-blue);
        box-shadow: 0 0 0 4px rgba(var(--cu-secondary-rgb), 0.12);
    }

    .search-box input::placeholder {
        color: var(--cu-text-muted);
    }

    /* ── Scrollbar ── */
    .sidebar-content::-webkit-scrollbar {
        width: 6px;
    }
    .sidebar-content::-webkit-scrollbar-track {
        background: transparent;
    }
    .sidebar-content::-webkit-scrollbar-thumb {
        background: var(--cu-border-light);
        border-radius: 3px;
    }

    /* ── Slide-in Node Detail Panel ── */
    .node-detail-panel {
        position: absolute;
        top: 0;
        right: 0;
        width: 420px;
        max-width: 90vw;
        height: 100%;
        background: #fff;
        border-left: 1px solid var(--cu-border-light);
        box-shadow: -4px 0 24px rgba(0,0,0,0.12);
        z-index: 100;
        display: flex;
        flex-direction: column;
        animation: slideInRight 0.25s ease-out;
        overflow: hidden;
    }
    @@keyframes slideInRight {
        from { transform: translateX(100%); }
        to { transform: translateX(0); }
    }
    .node-detail-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 16px 20px;
        border-bottom: 1px solid var(--cu-border-light);
        background: linear-gradient(135deg, rgba(var(--cu-secondary-rgb), 0.06), rgba(var(--cu-accent-rgb), 0.04));
    }
    .node-detail-header h3 {
        font-size: 16px;
        font-weight: 600;
        color: var(--cu-primary-blue);
        margin: 0;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
        max-width: 320px;
    }
    .node-detail-close {
        background: none;
        border: none;
        font-size: 24px;
        color: var(--cu-text-muted);
        cursor: pointer;
        padding: 0;
        line-height: 1;
        transition: color 0.15s;
    }
    .node-detail-close:hover { color: var(--cu-primary-blue); }
    .node-detail-body {
        flex: 1;
        overflow-y: auto;
        padding: 16px 20px;
        font-size: 13px;
        line-height: 1.6;
    }
    .node-detail-body .meta-row {
        display: flex;
        justify-content: space-between;
        padding: 6px 0;
        border-bottom: 1px solid var(--cu-border-light);
    }
    .node-detail-body .meta-label {
        color: var(--cu-text-muted);
        font-size: 11px;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }
    .node-detail-body .meta-value {
        font-weight: 600;
        color: var(--cu-primary-blue);
        font-size: 13px;
    }
    .node-detail-body .section-label {
        font-size: 12px;
        font-weight: 600;
        color: var(--cu-secondary-blue);
        margin: 16px 0 8px;
        padding-bottom: 4px;
        border-bottom: 1px solid var(--cu-border-light);
    }
    .node-detail-actions {
        padding: 12px 20px;
        border-top: 1px solid var(--cu-border-light);
        text-align: center;
    }
</style>

<!-- ── Pipeline Action Panel ── -->
@if (!isHomePage)
{
<div class="pipeline-panel" style="display:flex;align-items:center;gap:10px;padding:10px 20px;background:linear-gradient(135deg,rgba(var(--cu-secondary-rgb),0.08),rgba(var(--cu-accent-rgb),0.06));border-bottom:1px solid var(--cu-border-light);flex-wrap:wrap;">
    <span style="font-size:13px;font-weight:600;color:var(--cu-primary-blue);white-space:nowrap;">🧪 Analysis Pipeline</span>
    <button class="btn btn-sm btn-outline-secondary pipeline-btn" data-action="run-pipeline" style="border-radius:0.7rem;font-size:12px;display:inline-flex;align-items:center;gap:4px;" onclick="runPipeline('run-pipeline')">
        <i class="bi bi-play-fill"></i> Full Pipeline
    </button>
    <button class="btn btn-sm btn-outline-secondary pipeline-btn" data-action="run-discovery" style="border-radius:0.7rem;font-size:12px;display:inline-flex;align-items:center;gap:4px;" onclick="runPipeline('run-discovery')">
        <i class="bi bi-diagram-3"></i> Discover Schemas
    </button>
    <button class="btn btn-sm btn-outline-secondary pipeline-btn" data-action="run-synthesis" style="border-radius:0.7rem;font-size:12px;display:inline-flex;align-items:center;gap:4px;" onclick="runPipeline('run-synthesis')">
        <i class="bi bi-arrow-left-right"></i> Synthesize
    </button>
    <button class="btn btn-sm btn-outline-primary pipeline-btn" data-action="rebuild" style="border-radius:0.7rem;font-size:12px;display:inline-flex;align-items:center;gap:4px;border-color:var(--cu-accent);color:var(--cu-accent);" onclick="runPipeline('rebuild')">
        <i class="bi bi-arrow-repeat"></i> Rebuild Graph
    </button>
    <span id="pipeline-status" style="font-size:12px;color:var(--cu-text-muted);margin-left:auto;">Ready</span>
</div>
}

<div class="graph-container">
    <!-- Sidebar — hidden on homepage -->
    @if (!isHomePage)
    {
    <div class="sidebar">
        <div class="sidebar-header">
            <h1>🔬 Schema Explorer</h1>
            <p>Emergent conceptual structures from the Understanding Graph</p>
        </div>

        <div class="stats-bar">
            <div class="stat-item">
                <span class="stat-value" id="stat-nodes">@(stats?.NodeCount ?? 0)</span>
                <span class="stat-label">nodes</span>
            </div>
            <div class="stat-item">
                <span class="stat-value" id="stat-schemas">@(stats?.SchemaCount ?? 0)</span>
                <span class="stat-label">schemas</span>
            </div>
            <div class="stat-item">
                <span class="stat-value" id="stat-syntheses">@(stats?.SynthesisCount ?? 0)</span>
                <span class="stat-label">syntheses</span>
            </div>
        </div>

        <div class="search-box">
            <input type="text" id="search-input" placeholder="Search nodes..." />
        </div>

        <div class="sidebar-tabs">
            <button class="sidebar-tab active" data-tab="schemas">Schemas</button>
            <button class="sidebar-tab" data-tab="syntheses">Syntheses</button>
            <button class="sidebar-tab" data-tab="bridges">Bridges</button>
            <button class="sidebar-tab" data-tab="blindspots">Blindspots</button>
        </div>

        <div class="sidebar-content" id="sidebar-content">
            <!-- Schemas tab -->
            <div class="tab-content" id="tab-schemas">
                <div style="text-align:center;padding:40px 20px;color:var(--cu-text-muted);">
                    <div style="font-size:32px;margin-bottom:12px;">⏳</div>
                    <p>Loading schemas...</p>
                </div>
            </div>

            <!-- Syntheses tab -->
            <div class="tab-content" id="tab-syntheses" style="display:none;">
                <div style="text-align:center;padding:40px 20px;color:var(--cu-text-muted);">
                    <div style="font-size:32px;margin-bottom:12px;">⏳</div>
                    <p>Loading syntheses...</p>
                </div>
            </div>

            <!-- Bridges tab -->
            <div class="tab-content" id="tab-bridges" style="display:none;">
                <div style="text-align:center;padding:40px 20px;color:var(--cu-text-muted);">
                    <div style="font-size:32px;margin-bottom:12px;">⏳</div>
                    <p>Loading bridges...</p>
                </div>
            </div>

            <!-- Blindspots tab -->
            <div class="tab-content" id="tab-blindspots" style="display:none;">
                <div style="text-align:center;padding:40px 20px;color:var(--cu-text-muted);">
                    <div style="font-size:32px;margin-bottom:12px;">⏳</div>
                    <p>Loading blindspots...</p>
                </div>
            </div>
        </div>
    </div>
    }

    <!-- Visualization -->
    <div class="visualization">
        @if (!isHomePage)
        {
        <div class="graph-controls">
            <div class="ctrl-group">
                <label>Color by:</label>
                <select id="color-metric">
                    <option value="default">Default</option>
                    <option value="dialecticalTemperature">Dialectical Temp</option>
                    <option value="controversyScore">Controversy</option>
                    <option value="confidence">Confidence</option>
                    <option value="schemaEntropy">Schema Entropy</option>
                    <option value="degreeCentrality">Centrality</option>
                </select>
            </div>
            <div class="ctrl-group">
                <label>Min weight:</label>
                <input type="range" id="weight-filter" min="0" max="1" step="0.05" value="0" />
                <span id="weight-label" style="color:var(--cu-text-muted);min-width:24px;">0</span>
            </div>
            <div class="ctrl-group">
                <button class="ctrl-toggle active" id="toggle-physics" title="Toggle physics simulation">
                    <i class="bi bi-activity"></i> Physics
                </button>
                <button class="ctrl-toggle" id="toggle-labels" title="Toggle edge labels">
                    <i class="bi bi-fonts"></i> Labels
                </button>
                <button class="ctrl-toggle" id="reset-view" title="Reset graph view">
                    <i class="bi bi-arrow-counterclockwise"></i> Reset
                </button>
            </div>
        </div>
        <div class="graph-legend" id="graph-legend">
            <span class="legend-item"><span class="legend-dot" style="background:var(--cu-secondary-blue);"></span> High Confidence</span>
            <span class="legend-item"><span class="legend-dot" style="background:var(--cu-primary-blue);"></span> Normal</span>
            <span class="legend-item"><span class="legend-dot" style="background:var(--cu-accent);"></span> Controversial</span>
            <span class="legend-item"><span class="legend-dot" style="background:#c0392b;"></span> High Temp</span>
            <span class="legend-item"><span class="legend-dot" style="background:#8e44ad;"></span> High Entropy</span>
            <span class="legend-item" style="margin-left:auto;">
                <span class="badge" style="background:rgba(var(--cu-secondary-rgb),0.12);color:var(--cu-secondary-blue);">Settled</span>
                <span class="badge" style="background:rgba(192,122,63,0.12);color:var(--cu-accent);">Contested</span>
                <span class="badge" style="background:var(--cu-border-light);color:var(--cu-text-muted);">Unevaluated</span>
            </span>
        </div>
        }
        <div id="graph-network">
            <div class="graph-loading" id="graph-loading">
            <div class="spinner-ring"></div>
            <div class="spinner-label">Mapping understanding…</div>
        </div>
        </div>
        <div id="graph-hover-popup" class="graph-hover-popup" style="display:none;">
            <div class="popup-label" id="popup-label"></div>
            <div class="popup-meta">
                <span class="popup-badge" id="popup-badge"></span>
                <span class="popup-confidence">
                    <span class="popup-confidence-bar"><span class="popup-confidence-fill" id="popup-confidence-fill"></span></span>
                    <span id="popup-confidence-text"></span>
                </span>
            </div>
            <div class="popup-cta"><span>View details</span><i class="bi bi-arrow-right"></i></div>
        </div>
    </div>

    <!-- Slide-in Node Detail Panel (loads via AJAX — no full page navigation) -->
    <div id="node-detail-panel" class="node-detail-panel" style="display:none;">
        <div class="node-detail-header">
            <h3 id="node-detail-title">Node Detail</h3>
            <button class="node-detail-close" onclick="closeNodeDetail()" title="Close">×</button>
        </div>
        <div class="node-detail-body" id="node-detail-body">
            <div style="text-align:center;padding:40px;color:var(--cu-text-muted);">
                <div class="spinner"></div>
                <p style="margin-top:12px;">Loading...</p>
            </div>
        </div>
        <div class="node-detail-actions">
            <a id="node-detail-full-link" href="#" class="btn btn-sm btn-outline-primary" style="border-radius:0.7rem;">Open Full Page →</a>
        </div>
    </div>
</div>

@await Html.PartialAsync("_InlineContribution",
    (ContextLabel: "the understanding graph", ContextType: "MapRegion", ContextId: "schema-explorer"))

<script src="https://cdnjs.cloudflare.com/ajax/libs/vis-network/9.1.6/dist/vis-network.min.js"></script>
<script>
    // ── Three-tier loading state ──
    let network = null;
    let nodes = new vis.DataSet([]);
    let edges = new vis.DataSet([]);
    let allNodes = [];
    let allEdges = [];
    let physicsEnabled = false;
    let physicsResumeTimer = null;
    const MAX_TOTAL_NODES = 2000;           // cap total DOM nodes for smooth rendering
    const VIEWPORT_ZOOM_THRESHOLD = 0.6;    // only fetch real data when zoomed in this far
    const VIEWPORT_FETCH_DEBOUNCE_MS = 250; // rate-limit viewport fetches
    let skeletonNodeIds = new Set();        // IDs from the static skeleton
    let loadedRealNodeIds = new Set();      // IDs fetched via viewport or interaction
    let hoverCache = new Map();             // nodeId -> { id, label, status, confidence }
    let viewportFetchTimer = null;
    let lastViewportFetchNodes = new Set(); // track what we last fetched to skip duplicates

    // ── Tab switching (safe: sidebar may be hidden on homepage) ──
    document.querySelectorAll('.sidebar-tab').forEach(tab => {
        tab.addEventListener('click', () => {
            document.querySelectorAll('.sidebar-tab').forEach(t => t.classList.remove('active'));
            tab.classList.add('active');
            document.querySelectorAll('.tab-content').forEach(tc => tc.style.display = 'none');
            const target = document.getElementById('tab-' + tab.dataset.tab);
            if (target) target.style.display = '';
        });
    });

    // ── Search (safe: search box may be hidden on homepage) ──
    const searchInput = document.getElementById('search-input');
    if (searchInput) {
        searchInput.addEventListener('input', (e) => {
            const q = e.target.value.toLowerCase();
            if (!q) {
                resetView();
                return;
            }
            const matchingIds = allNodes
                .filter(n => n.label.toLowerCase().includes(q))
                .map(n => n.id);
            highlightNodes(matchingIds);
        });
    }

    // ── Draw network instantly (empty canvas, no data yet) ──
    function drawNetwork() {
        const container = document.getElementById('graph-network');
        const options = {
            physics: {
                enabled: false,  // enabled after data loads and kept running while idle
                minVelocity: 0,
                solver: 'forceAtlas2Based',
                forceAtlas2Based: {
                    gravitationalConstant: -50,
                    centralGravity: 0.003,
                    springLength: 200,
                    springConstant: 0.03,
                    damping: 0.4
                },
                // Keep vis from moving the camera during layout.
                stabilization: { iterations: 200, fit: false }
            },
            layout: {
                improvedLayout: true
            },
            edges: {
                smooth: { type: 'continuous' },
                font: { size: 9, color: '#667487', strokeWidth: 0 }
            },
            nodes: {
                font: { size: 0, color: '#17202f', strokeWidth: 0 },
                borderWidth: 1.5,
                size: 12,
                shape: 'dot'
            },
            interaction: {
                hover: true,
                tooltipDelay: 200,
                navigationButtons: true,
                keyboard: true
            },
            groups: {
                Settled: { color: { background: '#059669', border: '#34d399' } },
                Contested: { color: { background: '#d97706', border: '#f59e0b' } },
                Unknown: { color: { background: '#667487', border: '#8b95a5' } },
                Unevaluated: { color: { background: '#0f766e', border: '#14b8a6' } }
            }
        };

        network = new vis.Network(container, { nodes, edges }, options);

        network.on('click', (params) => {
            if (params.nodes.length > 0) {
                const nodeId = params.nodes[0];
                const node = allNodes.find(n => n.id === nodeId);
                if (!node) return;
                @if (isHomePage)
                {
                <text>
                navigateToSocialArgument(node);
                return;
                </text>
                }
                showNodeDetail(nodeId);
            }
        });

        network.on('doubleClick', (params) => {
            if (params.nodes.length > 0) {
                window.location.href = '/UnderstandingGraph/Node/' + params.nodes[0];
            }
        });

        // ── Hover: show the original popup card ──
        let hoverTimer = null;
        let hoveredNodeId = null;
        network.on('hoverNode', (params) => {
            const nodeId = params.node;
            if (hoverTimer) clearTimeout(hoverTimer);
            hoveredNodeId = nodeId;
            hoverTimer = setTimeout(() => showHoverPopup(nodeId), 400);
        });
        network.on('blurNode', () => {
            if (hoverTimer) clearTimeout(hoverTimer);
            hoveredNodeId = null;
            hideHoverPopup();
        });

        const hoverPopup = document.getElementById('graph-hover-popup');
        if (hoverPopup) {
            hoverPopup.addEventListener('click', (event) => {
                event.stopPropagation();
                if (!hoveredNodeId) return;
                const node = nodes.get(hoveredNodeId);
                if (node) navigateToSocialArgument(node);
            });
        }

        // ── Viewport-aware loading: fetch real data when zoomed in ──
        network.on('zoom', () => scheduleViewportFetch());
        network.on('dragEnd', () => scheduleViewportFetch());

        // Pause movement while the user manipulates the graph, then resume
        // once interaction has stopped. minVelocity: 0 keeps the resumed
        // simulation from automatically settling and shutting itself down.
        const pausePhysicsForInteraction = () => {
            if (physicsResumeTimer) clearTimeout(physicsResumeTimer);
            if (network && physicsEnabled) network.stopSimulation();
        };
        const resumePhysicsAfterInteraction = () => {
            if (physicsResumeTimer) clearTimeout(physicsResumeTimer);
            physicsResumeTimer = setTimeout(() => {
                if (network && physicsEnabled) network.startSimulation();
            }, 750);
        };
        container.addEventListener('pointerdown', pausePhysicsForInteraction);
        container.addEventListener('pointerup', resumePhysicsAfterInteraction);
        container.addEventListener('pointercancel', resumePhysicsAfterInteraction);
        container.addEventListener('wheel', () => {
            pausePhysicsForInteraction();
            resumePhysicsAfterInteraction();
        }, { passive: true });
    }

    function showHoverPopup(nodeId) {
        const popup = document.getElementById('graph-hover-popup');
        const node = nodes.get(nodeId);
        if (!popup || !node || !network) return;

        document.getElementById('popup-label').textContent = node.fullLabel || node.label || '(unnamed)';
        const status = (node.group || 'Unevaluated').toLowerCase();
        const badge = document.getElementById('popup-badge');
        badge.textContent = status;
        badge.className = 'popup-badge ' + (status === 'settled' ? 'settled' : status === 'contested' ? 'contested' : 'unevaluated');
        const confidence = node.confidence || 0;
        document.getElementById('popup-confidence-fill').style.width = (confidence * 100) + '%';
        document.getElementById('popup-confidence-text').textContent = (confidence * 100).toFixed(0) + '%';

        const containerRect = document.getElementById('graph-network').getBoundingClientRect();
        const visualizationRect = popup.parentElement.getBoundingClientRect();
        const canvasPosition = network.getPositions([nodeId])[nodeId];
        if (!canvasPosition) return;
        const domPosition = network.canvasToDOM(canvasPosition);
        const popupWidth = popup.offsetWidth || 280;
        const popupHeight = popup.offsetHeight || 100;
        let left = containerRect.left - visualizationRect.left + domPosition.x - popupWidth / 2;
        let top = containerRect.top - visualizationRect.top + domPosition.y - popupHeight - 20;
        left = Math.max(10, Math.min(left, visualizationRect.width - popupWidth - 10));
        if (top < 10) top = containerRect.top - visualizationRect.top + domPosition.y + 20;
        popup.style.left = left + 'px';
        popup.style.top = top + 'px';
        popup.style.display = 'block';
        requestAnimationFrame(() => popup.classList.add('visible'));
    }

    function hideHoverPopup() {
        const popup = document.getElementById('graph-hover-popup');
        if (!popup) return;
        popup.classList.remove('visible');
        setTimeout(() => {
            if (!popup.classList.contains('visible')) {
                popup.style.display = 'none';
            }
        }, 180);
    }

    async function navigateToSocialArgument(node) {
        let socialArgumentId = node.socialArgumentId || null;
        try {
            const argumentIds = JSON.parse(node.argumentIdsJson || '[]');
            const firstId = argumentIds[0];
            if (!socialArgumentId && typeof firstId === 'string' && /^[0-9a-f-]{36}$/i.test(firstId)) {
                socialArgumentId = firstId;
            }
        } catch (err) {
            // The API can still resolve real graph nodes with malformed argument metadata.
        }

        if (!socialArgumentId) {
            const cached = hoverCache.get(node.id);
            if (cached && cached.socialArgumentId) {
                socialArgumentId = cached.socialArgumentId;
            } else {
                try {
                    const response = await fetch(`/api/understanding-graph/node/${node.id}/preview`);
                    if (response.ok) {
                        const preview = await response.json();
                        hoverCache.set(node.id, preview);
                        socialArgumentId = preview.socialArgumentId;
                    }
                } catch (err) {
                    // Fall through to the label resolver.
                }
            }
        }

        if (socialArgumentId) window.location.href = '/SocialView/Detail/' + socialArgumentId;
    }

    // ── Schedule a debounced viewport fetch ──
    function scheduleViewportFetch() {
        if (viewportFetchTimer) clearTimeout(viewportFetchTimer);
        viewportFetchTimer = setTimeout(() => doViewportFetch(), VIEWPORT_FETCH_DEBOUNCE_MS);
    }

    async function doViewportFetch() {
        if (!network) return;
        var scale = network.getScale();
        // Only fetch real data when zoomed in past threshold
        if (scale < VIEWPORT_ZOOM_THRESHOLD) return;

        // Compute visible bounding box in canvas coordinates
        var viewPos = network.getViewPosition();
        var canvasWidth = network.canvas.frame.canvas.clientWidth;
        var canvasHeight = network.canvas.frame.canvas.clientHeight;
        var topLeft = network.DOMtoCanvas({ x: 0, y: 0 });
        var bottomRight = network.DOMtoCanvas({ x: canvasWidth, y: canvasHeight });

        // Find all skeleton nodes currently visible in the viewport
        var visibleIds = [];
        var allNodeData = nodes.get();
        for (var i = 0; i < allNodeData.length; i++) {
            var n = allNodeData[i];
            // Skip nodes already loaded as real data
            if (loadedRealNodeIds.has(n.id)) continue;
            // Check if node position falls within viewport
            if (n.x >= topLeft.x && n.x <= bottomRight.x && n.y >= topLeft.y && n.y <= bottomRight.y) {
                visibleIds.push(n.id);
            }
        }

        if (visibleIds.length === 0) return;

        // Skip if same set of nodes as last fetch
        var idKey = visibleIds.sort().join(',');
        if (idKey === lastViewportFetchNodes.join(',')) return;
        lastViewportFetchNodes = visibleIds;

        // Cap to remaining capacity
        var remaining = MAX_TOTAL_NODES - loadedRealNodeIds.size - skeletonNodeIds.size;
        if (remaining <= 0) return;
        if (visibleIds.length > remaining) visibleIds = visibleIds.slice(0, remaining);

        try {
            var leafRes = await fetch('/api/understanding-graph/leaves', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    rootNodeIds: Array.from(skeletonNodeIds),
                    maxNodes: remaining,
                    viewportNodeIds: visibleIds
                })
            });
            if (!leafRes.ok) return;
            var leafData = await leafRes.json();

            if (leafData.nodes && leafData.nodes.length > 0) {
                var leafMappedNodes = leafData.nodes.map(mapNode);
                var leafMappedEdges = (leafData.edges || []).map(mapEdge);

                // Dedup before adding
                var existingIds = new Set(allNodes.map(function(n) { return n.id; }));
                var existingEdgeIds = new Set(allEdges.map(function(e) { return e.id; }));

                var newNodes = leafMappedNodes.filter(function(n) { return !existingIds.has(n.id); });
                var newEdges = leafMappedEdges.filter(function(e) { return !existingEdgeIds.has(e.id); });

                newNodes.forEach(function(n) { allNodes.push(n); loadedRealNodeIds.add(n.id); });
                newEdges.forEach(function(e) { allEdges.push(e); });

                // Incremental merge — never setData() which would discard the skeleton
                nodes.add(newNodes);
                edges.add(newEdges);
            }
        } catch (err) {
            console.warn('Viewport fetch failed (non-critical):', err);
        }
    }

    // ── Load manifest → skeleton → render ──
    async function loadGraph() {
        // Keep the loading spinner visible until all graph data is ready.
        var loadingEl = document.getElementById('graph-loading');

        // Reset state for fresh load
        physicsEnabled = false;
        try {
            // Tier 1: Fetch skeleton manifest (cached in sessionStorage for instant reloads)
            var manifest = null;
            var cachedManifest = sessionStorage.getItem('skel_manifest');
            if (cachedManifest) {
                try { manifest = JSON.parse(cachedManifest); } catch(e) { /* stale — refetch */ }
            }
            if (!manifest || !manifest.version || manifest.version === 'none') {
                var manifestRes = await fetch('/api/understanding-graph/skeleton-manifest');
                if (!manifestRes.ok) throw new Error('Manifest API returned ' + manifestRes.status);
                manifest = await manifestRes.json();
                if (manifest && manifest.version && manifest.version !== 'none') {
                    try { sessionStorage.setItem('skel_manifest', JSON.stringify(manifest)); } catch(e) { /* quota exceeded — ignore */ }
                }
            }

            // Tier 2: Fetch static skeleton JSON (zero DB cost — served as static file, cached in sessionStorage)
            var skeletonData = null;
            var skelCacheKey = 'skel_data_' + manifest.version;
            var cachedSkel = sessionStorage.getItem(skelCacheKey);
            if (cachedSkel) {
                try { skeletonData = JSON.parse(cachedSkel); } catch(e) { /* stale */ }
            }
            if (!skeletonData && manifest.version && manifest.version !== 'none') {
                var skelRes = await fetch(manifest.url);
                if (skelRes.ok) {
                    skeletonData = await skelRes.json();
                    try { sessionStorage.setItem(skelCacheKey, JSON.stringify(skeletonData)); } catch(e) { /* quota exceeded */ }
                }
            }

            // ── Render skeleton ──
            if (skeletonData && skeletonData.nodes) {
                var skNodes = skeletonData.nodes.map(mapStaticNode);
                var skEdges = (skeletonData.edges || []).map(mapStaticEdge);
                skNodes.forEach(function(n) { allNodes.push(n); skeletonNodeIds.add(n.id); });
                skEdges.forEach(function(e) { allEdges.push(e); });
                nodes.add(skNodes);
                edges.add(skEdges);

                var statNodes = document.getElementById('stat-nodes');
                if (statNodes) statNodes.textContent = skeletonData.nodes.length || 0;
            }

            // Start with a wide, fixed camera so the visible physics layout
            // never begins close-up. Do not fit the camera again after this.
            network.moveTo({ position: { x: 0, y: 0 }, scale: 0.10, animation: false });
            if (loadingEl) loadingEl.classList.add('hidden');

            // Show labels once data is loaded
            nodes.forEach(n => {
                nodes.update({ id: n.id, font: { size: 10, color: '#17202f', strokeWidth: 0 } });
            });

            // Keep the layout moving while the camera stays fixed.
            enablePhysics();
        } catch (err) {
            console.error('Failed to load graph:', err);
            if (loadingEl) {
                loadingEl.classList.remove('hidden');
                loadingEl.innerHTML = '<div style="text-align:center;color:#dc2626;"><p>\u26a0\ufe0f Failed to load graph</p><p style="font-size:12px;">Check that the server is running and the database is accessible.</p></div>';
            }
        }
    }

    // ── Enable physics after all data is loaded ──
    function enablePhysics() {
        if (physicsEnabled) return;
        physicsEnabled = true;
        if (network) {
            network.setOptions({ physics: { enabled: true } });
            network.startSimulation();
        }
    }

    // ── Map static (pre-baked) node data to vis format ──
    function mapStaticNode(n) {
        // Handle both PascalCase and camelCase skeleton serializers.
        var id = n.id !== undefined ? n.id : n.Id;
        var label = n.label || n.Label || '(unnamed)';
        var confidence = n.confidence !== undefined ? n.confidence : (n.Confidence !== undefined ? n.Confidence : 0);
        var degreeCentrality = n.degreeCentrality !== undefined ? n.degreeCentrality : (n.DegreeCentrality !== undefined ? n.DegreeCentrality : 0);
        var status = n.status || n.Status || 'Unknown';
        var evidenceCount = n.evidenceCount !== undefined ? n.evidenceCount : (n.EvidenceCount !== undefined ? n.EvidenceCount : 0);
        var argumentIdsJson = n.argumentIdsJson || n.ArgumentIdsJson || '[]';
        // Scatter nodes randomly in a 600px box so physics can spread them naturally.
        // The skeleton's circular positions are ignored — vis-network does the real layout.
        var x = (Math.random() - 0.5) * 600;
        var y = (Math.random() - 0.5) * 600;
        return {
            id: id,
            label: label.length > 30 ? label.substring(0, 30) + '\u2026' : label,
            value: Math.max(5, (degreeCentrality || 0.1) * 30),
            color: getNodeColor({ confidence: confidence, status: status, dialecticalTemperature: n.dialecticalTemperature || n.DialecticalTemperature || 0, controversyScore: n.controversyScore || n.ControversyScore || 0, schemaEntropy: n.schemaEntropy || n.SchemaEntropy || 0 }),
            group: status,
            argumentIdsJson: argumentIdsJson,
            socialArgumentId: n.socialArgumentId || n.SocialArgumentId || null,
            fullLabel: label,
            confidence: confidence,
            x: x,
            y: y
        };
    }

    function mapStaticEdge(e) {
        // Handle both PascalCase (skeleton JSON) and camelCase (synthetic filler)
        var id = e.id !== undefined ? e.id : e.Id;
        var sourceId = e.sourceId !== undefined ? e.sourceId : e.SourceId;
        var targetId = e.targetId !== undefined ? e.targetId : e.TargetId;
        var edgeType = e.edgeType || e.EdgeType || 'supports';
        var weight = e.weight !== undefined ? e.weight : (e.Weight !== undefined ? e.Weight : 0.5);
        return {
            id: id,
            from: sourceId,
            to: targetId,
            label: edgeType,
            value: Math.max(0.5, weight),
            color: {
                color: '#0f766e',
                opacity: Math.min(1, Math.max(0.2, weight || 0.3))
            },
            width: Math.max(0.5, (weight || 0.5) * 3)
        };
    }

    // ── Map raw node/edge data to vis format (used for real data from API) ──
    function mapNode(n) {
        const label = n.label || '(unnamed)';
        return {
            id: n.id,
            label: label.length > 30 ? label.substring(0, 30) + '\u2026' : label,
            value: Math.max(5, (n.degreeCentrality || 0.1) * 30),
            color: getNodeColor(n),
            group: n.status || 'Unknown',
            argumentIdsJson: n.argumentIdsJson || '[]',
            socialArgumentId: n.socialArgumentId || null,
            fullLabel: label,
            confidence: n.confidence ?? 0
        };
    }

    function mapEdge(e) {
        return {
            id: e.id,
            from: e.sourceId,
            to: e.targetId,
            label: e.edgeType,
            value: Math.max(0.5, e.weight),
            color: {
                color: '#0f766e',
                opacity: Math.min(1, Math.max(0.2, e.weight || 0.3))
            },
            width: Math.max(0.5, (e.weight || 0.5) * 3)
        };
    }

    function getNodeColor(n) {
        if (n.dialecticalTemperature > 0.7) return { background: '#dc2626', border: '#f87171', highlight: { background: '#f87171', border: '#dc2626' } };
        if (n.controversyScore > 0.6) return { background: '#d97706', border: '#f59e0b', highlight: { background: '#f59e0b', border: '#d97706' } };
        if (n.confidence > 0.7) return { background: '#059669', border: '#34d399', highlight: { background: '#34d399', border: '#059669' } };
        if (n.schemaEntropy > 0.5) return { background: '#7c3aed', border: '#a78bfa', highlight: { background: '#a78bfa', border: '#7c3aed' } };
        return { background: '#0f766e', border: '#14b8a6', highlight: { background: '#14b8a6', border: '#0f766e' } };
    }

    // ── Helpers ──
    // Strip any existing alpha suffix from a hex color (e.g. '#05966922' -> '#059669')
    function stripAlpha(hex) {
        if (!hex || typeof hex !== 'string') return hex;
        // If it's an 8-char hex like #RRGGBBAA, strip the AA
        if (/^#[0-9a-f]{8}$/i.test(hex)) return hex.substring(0, 7);
        // If it's longer than 7 chars (multiple alpha appends), take first 7
        if (hex.startsWith('#') && hex.length > 7) return hex.substring(0, 7);
        return hex;
    }

    // Get the original (non-dimmed) color for a node from allNodes
    function getOriginalNodeColor(nodeId) {
        const orig = allNodes.find(n => n.id === nodeId);
        return orig ? orig.color : { background: '#0f766e', border: '#14b8a6' };
    }

    // ── Highlight / Focus ──
    function highlightNodes(nodeIds) {
        const idSet = new Set(nodeIds);
        // Batch update nodes — always reference original colors from allNodes
        const nodeUpdates = [];
        allNodes.forEach(n => {
            const origColor = n.color;
            const bg = stripAlpha(origColor.background || '#0f766e');
            const border = stripAlpha(origColor.border || '#14b8a6');
            if (idSet.has(n.id)) {
                nodeUpdates.push({ id: n.id, color: { background: bg, border: border } });
            } else {
                // Use hex with low alpha for dimmed nodes
                nodeUpdates.push({ id: n.id, color: { background: bg + '22', border: border + '44' } });
            }
        });
        nodes.update(nodeUpdates);

        const edgeUpdates = [];
        edges.forEach(e => {
            if (idSet.has(e.from) && idSet.has(e.to)) {
                edgeUpdates.push({ id: e.id, color: { color: '#0f766e', opacity: 0.8 } });
            } else {
                edgeUpdates.push({ id: e.id, color: { color: '#0f766e', opacity: 0.05 } });
            }
        });
        edges.update(edgeUpdates);
    }

    function resetView() {
        // Restore all nodes to original colors from allNodes
        const nodeUpdates = [];
        allNodes.forEach(n => {
            nodeUpdates.push({ id: n.id, color: n.color });
        });
        nodes.update(nodeUpdates);

        const edgeUpdates = [];
        allEdges.forEach(e => {
            edgeUpdates.push({ id: e.id, color: e.color });
        });
        edges.update(edgeUpdates);

        if (network) {
            network.fit({
                animation: { duration: 400, easingFunction: 'easeInOutQuad' },
                offset: 40
            });
        }
    }

    function focusSchema(schemaId, label) {
        fetch(`/api/understanding-graph/schema/${schemaId}/nodes`)
            .then(r => r.json())
            .then(nodes => {
                const ids = nodes.map(n => n.nodeId);
                highlightNodes(ids);
                if (network && ids.length > 0) {
                    network.fit({ nodes: ids, animation: true });
                }
            })
            .catch(err => console.error('focusSchema error:', err));
    }

    function focusNode(nodeId) {
        highlightNodes([nodeId]);
        if (network) {
            network.focus(nodeId, { scale: 2, animation: true });
        }
    }

    function focusSynthesis(synthesisId) {
        // Navigate to synthesis detail
        window.location.href = '/UnderstandingGraph/Navigator?synthesisId=' + synthesisId;
    }

    function showNodeDetail(nodeId) {
        // Show slide-in panel immediately with loading state
        const panel = document.getElementById('node-detail-panel');
        const body = document.getElementById('node-detail-body');
        const title = document.getElementById('node-detail-title');
        const fullLink = document.getElementById('node-detail-full-link');
        
        // Set the full page link
        fullLink.href = '/UnderstandingGraph/Node/' + nodeId;
        
        // Show panel with loading spinner
        title.textContent = 'Loading...';
        body.innerHTML = '<div style="text-align:center;padding:40px;color:var(--cu-text-muted);"><div class="spinner"></div><p style="margin-top:12px;">Loading node details...</p></div>';
        panel.style.display = 'flex';
        
        // Fetch node details via AJAX (fast — no full page reload)
        fetch('/api/understanding-graph/node/' + nodeId)
            .then(r => {
                if (!r.ok) throw new Error('Node not found');
                return r.json();
            })
            .then(node => {
                title.textContent = node.canonicalText && node.canonicalText.length > 50 
                    ? node.canonicalText.substring(0, 50) + '…' 
                    : (node.canonicalText || 'Node ' + nodeId);
                
                const statusBadge = node.status === 'Settled' 
                    ? '<span class="badge" style="background:rgba(15,118,110,0.12);color:#0f766e;">Settled</span>'
                    : node.status === 'Contested'
                    ? '<span class="badge" style="background:rgba(192,122,63,0.12);color:#c07a3f;">Contested</span>'
                    : '<span class="badge" style="background:rgba(102,116,135,0.12);color:#667487;">' + (node.status || 'Unknown') + '</span>';
                
                body.innerHTML = 
                    '<p style="font-size:14px;color:var(--cu-primary-blue);margin-bottom:16px;">' + escHtml(node.canonicalText || '') + '</p>' +
                    '<div class="meta-row"><span class="meta-label">Status</span><span class="meta-value">' + statusBadge + '</span></div>' +
                    '<div class="meta-row"><span class="meta-label">Confidence</span><span class="meta-value">' + (node.confidence || 0).toFixed(3) + '</span></div>' +
                    '<div class="meta-row"><span class="meta-label">Degree Centrality</span><span class="meta-value">' + (node.degreeCentrality || 0).toFixed(3) + '</span></div>' +
                    '<div class="meta-row"><span class="meta-label">Betweenness</span><span class="meta-value">' + (node.betweennessCentrality || 0).toFixed(3) + '</span></div>' +
                    '<div class="meta-row"><span class="meta-label">Clustering</span><span class="meta-value">' + (node.clusteringCoefficient || 0).toFixed(3) + '</span></div>' +
                    '<div class="meta-row"><span class="meta-label">PageRank</span><span class="meta-value">' + (node.pageRank || 0).toFixed(3) + '</span></div>' +
                    '<div class="meta-row"><span class="meta-label">Dialectical Temp</span><span class="meta-value">' + (node.dialecticalTemperature || 0).toFixed(3) + '</span></div>' +
                    '<div class="meta-row"><span class="meta-label">Controversy</span><span class="meta-value">' + (node.controversyScore || 0).toFixed(3) + '</span></div>' +
                    '<div class="meta-row"><span class="meta-label">Evidence Count</span><span class="meta-value">' + (node.evidenceCount || 0) + '</span></div>' +
                    (node.schemaMemberships && node.schemaMemberships.length > 0 
                        ? '<div class="section-label">Schema Memberships</div>' + 
                          node.schemaMemberships.map(m => 
                            '<div class="meta-row"><span><a href="/UnderstandingGraph/Schema/' + m.schemaId + '" style="color:var(--cu-secondary-blue);">' + escHtml(m.schemaLabel || 'Schema ' + m.schemaId) + '</a></span><span style="font-size:12px;color:var(--cu-text-muted);">Weight: ' + (m.weight || 0).toFixed(3) + '</span></div>'
                          ).join('')
                        : '') +
                    (node.outboundEdges && node.outboundEdges.length > 0
                        ? '<div class="section-label">Outbound Edges (' + node.outboundEdges.length + ')</div>' +
                          node.outboundEdges.slice(0, 10).map(e =>
                            '<div class="meta-row"><span style="font-size:12px;">→ ' + escHtml(e.targetNode?.canonicalText || 'Node ' + e.targetNodeId) + '</span><span style="font-size:11px;color:var(--cu-text-muted);">' + escHtml(e.relationship || '') + ' (' + (e.weight || 0).toFixed(2) + ')</span></div>'
                          ).join('') +
                          (node.outboundEdges.length > 10 ? '<p style="font-size:11px;color:var(--cu-text-muted);text-align:center;">+ ' + (node.outboundEdges.length - 10) + ' more — <a href=\'/UnderstandingGraph/Node/' + nodeId + '\'>see full page</a></p>' : '')
                        : '') +
                    (node.inboundEdges && node.inboundEdges.length > 0
                        ? '<div class="section-label">Inbound Edges (' + node.inboundEdges.length + ')</div>' +
                          node.inboundEdges.slice(0, 10).map(e =>
                            '<div class="meta-row"><span style="font-size:12px;">← ' + escHtml(e.sourceNode?.canonicalText || 'Node ' + e.sourceNodeId) + '</span><span style="font-size:11px;color:var(--cu-text-muted);">' + escHtml(e.relationship || '') + ' (' + (e.weight || 0).toFixed(2) + ')</span></div>'
                          ).join('') +
                          (node.inboundEdges.length > 10 ? '<p style="font-size:11px;color:var(--cu-text-muted);text-align:center;">+ ' + (node.inboundEdges.length - 10) + ' more — <a href=\'/UnderstandingGraph/Node/' + nodeId + '\'>see full page</a></p>' : '')
                        : '');
            })
            .catch(err => {
                console.error('Failed to load node detail:', err);
                title.textContent = 'Error';
                body.innerHTML = '<p style="color:#dc2626;">Failed to load node details. <a href=\'/UnderstandingGraph/Node/' + nodeId + '\'>Open full page instead</a>.</p>';
            });
    }
    
    function closeNodeDetail() {
        document.getElementById('node-detail-panel').style.display = 'none';
    }

    // ── Color by metric ──
    function recolorByMetric(metric) {
        if (!allNodes.length) return;
        const updated = allNodes.map(n => {
            let color;
            if (metric === 'default') {
                color = getNodeColor(n);
            } else {
                const val = n[metric] || 0;
                // Heatmap: blue (0) → purple (0.25) → orange (0.5) → red (0.75+)
                const t = Math.min(1, Math.max(0, val));
                const r = Math.min(255, Math.round(t * 2 * 255));
                const g = Math.round((1 - Math.abs(t - 0.5) * 2) * 150);
                const b = Math.round((1 - t) * 255);
                const bg = `rgb(${r},${g},${b})`;
                color = { background: bg, border: bg, highlight: { background: bg, border: bg } };
            }
            // Also update allNodes so resetView can restore correctly
            n.color = color;
            return { id: n.id, color: color };
        });
        nodes.update(updated);
    }

    // ── Weight filter ──
    function applyWeightFilter(minWeight) {
        if (!allEdges.length) return;
        const filtered = allEdges.filter(e => (e.value || 0) >= minWeight);
        const filteredIds = new Set(filtered.map(e => e.id));
        const visibleIds = new Set();
        filtered.forEach(e => { visibleIds.add(e.from); visibleIds.add(e.to); });

        edges.clear();
        edges.add(filtered);

        // Dim orphaned nodes via color alpha — always reference allNodes originals
        const updates = [];
        allNodes.forEach(n => {
            const origColor = n.color;
            const bg = stripAlpha(origColor.background || '#0f766e');
            const border = stripAlpha(origColor.border || '#14b8a6');
            if (visibleIds.has(n.id)) {
                updates.push({ id: n.id, color: { background: bg, border: border } });
            } else {
                updates.push({ id: n.id, color: { background: bg + '15', border: border + '15' } });
            }
        });
        nodes.update(updates);
    }

    // ── Controls setup ──
    document.addEventListener('DOMContentLoaded', () => {
        // ── Draw the empty canvas IMMEDIATELY — zero lag ──
        drawNetwork();

        // Color metric dropdown (may not exist on homepage)
        const colorMetric = document.getElementById('color-metric');
        if (colorMetric) {
            colorMetric.addEventListener('change', (e) => {
                recolorByMetric(e.target.value);
            });
        }

        // Weight filter slider (may not exist on homepage)
        const weightFilter = document.getElementById('weight-filter');
        if (weightFilter) {
            weightFilter.addEventListener('input', (e) => {
                const val = parseFloat(e.target.value);
                const weightLabel = document.getElementById('weight-label');
                if (weightLabel) weightLabel.textContent = val.toFixed(2);
                applyWeightFilter(val);
            });
        }

        // Toggle physics (may not exist on homepage)
        const togglePhysics = document.getElementById('toggle-physics');
        if (togglePhysics) {
            togglePhysics.addEventListener('click', (e) => {
                const btn = e.currentTarget;
                const enabled = btn.classList.toggle('active');
                if (network) {
                    network.setOptions({ physics: { enabled: enabled } });
                    if (enabled) network.startSimulation();
                    else network.stopSimulation();
                }
            });
        }

        // Toggle edge labels (may not exist on homepage)
        const toggleLabels = document.getElementById('toggle-labels');
        if (toggleLabels) {
            toggleLabels.addEventListener('click', (e) => {
                const btn = e.currentTarget;
                const show = btn.classList.toggle('active');
                if (network) {
                    edges.forEach(edge => {
                        edges.update({ id: edge.id, label: show ? edge.label : '' });
                    });
                }
            });
        }

        // Reset view (may not exist on homepage)
        const resetViewBtn = document.getElementById('reset-view');
        if (resetViewBtn) {
            resetViewBtn.addEventListener('click', () => {
                const cm = document.getElementById('color-metric');
                const wf = document.getElementById('weight-filter');
                const wl = document.getElementById('weight-label');
                const tp = document.getElementById('toggle-physics');
                const tl = document.getElementById('toggle-labels');
                if (cm) cm.value = 'default';
                if (wf) wf.value = '0';
                if (wl) wl.textContent = '0';
                if (tp) tp.classList.remove('active');
                if (tl) tl.classList.remove('active');
                recolorByMetric('default');
                applyWeightFilter(0);
                if (network) {
                    // Physics stays off — all positions are pre-baked and fixed
                    network.fit({ animation: true });
                }
            });
        }

        // Start loading data AFTER canvas is rendered
        loadGraph();
        loadSidebarData();
    });

    // ── Lazy-load sidebar data (only if sidebar is present) ──
    async function loadSidebarData() {
        // Skip if sidebar elements don't exist (e.g., homepage)
        if (!document.getElementById('stat-schemas')) return;

        try {
            const [schemas, syntheses, bridges, blindspots] = await Promise.all([
                fetch('/api/understanding-graph/schemas').then(r => r.json()),
                fetch('/api/understanding-graph/syntheses').then(r => r.json()),
                fetch('/api/understanding-graph/bridge-nodes?count=10').then(r => r.json()),
                fetch('/api/understanding-graph/blindspots?count=10').then(r => r.json())
            ]);

            // Update stats
            document.getElementById('stat-schemas').textContent = schemas.length;
            document.getElementById('stat-syntheses').textContent = syntheses.length;

            // Render schemas tab
            renderSchemasTab(schemas);
            // Render syntheses tab
            renderSynthesesTab(syntheses);
            // Render bridges tab
            renderBridgesTab(bridges);
            // Render blindspots tab
            renderBlindspotsTab(blindspots);
        } catch (err) {
            console.error('Failed to load sidebar data:', err);
        }
    }

    function renderSchemasTab(schemas) {
        const el = document.getElementById('tab-schemas');
        if (!schemas || schemas.length === 0) {
            el.innerHTML = '<div style="text-align:center;padding:40px 20px;color:var(--cu-text-muted);"><div style="font-size:40px;margin-bottom:12px;">🧠</div><p>No schemas discovered yet.</p><p style="font-size:12px;margin-top:8px;">Run the discovery pipeline to detect emergent conceptual structures.</p></div>';
            return;
        }
        el.innerHTML = schemas.map(s => `
            <div class="card" onclick="focusSchema(${s.id}, '${s.label.replace(/'/g, "\\'")}')">
                <div class="card-title">${escHtml(s.label)}</div>
                <div class="card-meta">
                    <span>📦 ${s.memberCount} members</span>
                    <span>🎯 ${s.coherence.toFixed(2)} coherence</span>
                    <span>📊 ${s.discoveryMethod}</span>
                    ${s.stability > 0 ? `<span>⚡ ${s.stability.toFixed(2)} stability</span>` : ''}
                </div>
            </div>
        `).join('');
    }

    function renderSynthesesTab(syntheses) {
        const el = document.getElementById('tab-syntheses');
        if (!syntheses || syntheses.length === 0) {
            el.innerHTML = '<div style="text-align:center;padding:40px 20px;color:var(--cu-text-muted);"><div style="font-size:40px;margin-bottom:12px;">⚖️</div><p>No dialectical syntheses yet.</p></div>';
            return;
        }
        el.innerHTML = syntheses.map(s => `
            <div class="card" onclick="focusSynthesis(${s.id})">
                <div class="card-title">Synthesis (Depth ${s.depth})</div>
                <div class="card-meta">
                    <span>➡️ ${escHtml(s.synthesisLabel)}</span>
                    <span>📦 ${s.parentNodeIds.length} parents</span>
                    <span class="badge ${s.isAccepted ? 'badge-green' : 'badge-orange'}">${s.isAccepted ? 'Accepted' : 'Pending'}</span>
                </div>
            </div>
        `).join('');
    }

    function renderBridgesTab(bridges) {
        const el = document.getElementById('tab-bridges');
        if (!bridges || bridges.length === 0) {
            el.innerHTML = '<div style="text-align:center;padding:40px 20px;color:var(--cu-text-muted);"><div style="font-size:40px;margin-bottom:12px;">🌉</div><p>No bridge nodes found.</p></div>';
            return;
        }
        el.innerHTML = bridges.map(b => {
            const labels = (b.schemaLabels || []).slice(0, 3).map(l => `<span class="badge badge-blue">${escHtml(l)}</span>`).join('');
            const extra = (b.schemaLabels || []).length > 3 ? `<span class="badge">+${b.schemaLabels.length - 3}</span>` : '';
            return `
            <div class="card" onclick="focusNode(${b.nodeId})">
                <div class="card-title">${escHtml(b.canonicalText)}</div>
                <div class="card-meta">
                    <span>🔗 ${b.schemaCount} schemas</span>
                    <span>📊 BC ${b.betweennessCentrality.toFixed(3)}</span>
                    <span>🌡️ ${b.dialecticalTemperature.toFixed(2)}</span>
                </div>
                <div style="margin-top:6px;display:flex;gap:4px;flex-wrap:wrap;">${labels}${extra}</div>
            </div>`;
        }).join('');
    }

    function renderBlindspotsTab(blindspots) {
        const el = document.getElementById('tab-blindspots');
        if (!blindspots || blindspots.length === 0) {
            el.innerHTML = '<div style="text-align:center;padding:40px 20px;color:var(--cu-text-muted);"><div style="font-size:40px;margin-bottom:12px;">👁️</div><p>No blindspots detected.</p></div>';
            return;
        }
        el.innerHTML = blindspots.map(b => `
            <div class="card" onclick="focusNode(${b.nodeId})">
                <div class="card-title">${escHtml(b.canonicalText)}</div>
                <div class="card-meta">
                    <span>🌡️ ${b.dialecticalTemperature.toFixed(2)} temp</span>
                    <span>⚡ ${b.controversyScore.toFixed(2)} controversy</span>
                </div>
                <div style="margin-top:6px;font-size:11px;color:var(--cu-text-muted);">${escHtml(b.reason)}</div>
            </div>
        `).join('');
    }

    function escHtml(str) {
        const div = document.createElement('div');
        div.textContent = str || '';
        return div.innerHTML;
    }

    // ── Pipeline Actions ──
    async function runPipeline(action) {
        const statusEl = document.getElementById('pipeline-status');
        const buttons = document.querySelectorAll('.pipeline-btn');
        buttons.forEach(b => b.disabled = true);
        statusEl.textContent = '⏳ Running...';

        try {
            const resp = await fetch('/api/understanding-graph/' + action, { method: 'POST' });
            const result = await resp.json();
            if (result.success) {
                statusEl.textContent = '✅ ' + (result.message || 'Complete');
                setTimeout(() => location.reload(), 1500);
            } else {
                statusEl.textContent = '❌ ' + (result.message || 'Failed');
            }
        } catch (err) {
            statusEl.textContent = '❌ Error: ' + err.message;
        } finally {
            buttons.forEach(b => b.disabled = false);
        }
    }
</script>

@section Scripts {
<script src="~/js/inline-contribution.js"></script>
}