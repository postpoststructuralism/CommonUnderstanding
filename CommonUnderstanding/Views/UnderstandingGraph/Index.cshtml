@using CommonUnderstanding.Models
@using CommonUnderstanding.Services
@{
    ViewData["Title"] = "Understanding Graph — Schema Explorer";
    var stats = ViewBag.Statistics as QuickStats;
    var isHomePage = ViewBag.IsHomePage as bool? ?? false;
}

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/vis-network/9.1.6/dist/vis-network.min.css" />
<style>
    .graph-container {
        display: flex;
        height: calc(100vh - 60px);
        gap: 0;
        min-height: 0;
    }

    /* ── Sidebar ── */
    .sidebar {
        width: 380px;
        min-width: 380px;
        background: #fff;
        border-right: 1px solid var(--cu-border-light);
        display: flex;
        flex-direction: column;
        overflow: hidden;
    }

    .sidebar-header {
        padding: 16px 20px;
        border-bottom: 1px solid var(--cu-border-light);
        background: linear-gradient(135deg, rgba(var(--cu-secondary-rgb), 0.06), rgba(var(--cu-accent-rgb), 0.04));
    }

    .sidebar-header h1 {
        font-size: 18px;
        font-weight: 600;
        color: var(--cu-primary-blue);
    }

    .sidebar-header p {
        font-size: 12px;
        color: var(--cu-text-muted);
        margin-top: 4px;
    }

    .sidebar-tabs {
        display: flex;
        border-bottom: 1px solid var(--cu-border-light);
        background: #fff;
    }

    .sidebar-tab {
        flex: 1;
        padding: 10px;
        text-align: center;
        font-size: 12px;
        font-weight: 500;
        color: var(--cu-text-muted);
        cursor: pointer;
        border-bottom: 2px solid transparent;
        transition: all 0.2s;
        background: none;
        border-top: none;
        border-left: none;
        border-right: none;
    }

    .sidebar-tab:hover { color: var(--cu-primary-blue); }
    .sidebar-tab.active {
        color: var(--cu-secondary-blue);
        border-bottom-color: var(--cu-secondary-blue);
    }

    .sidebar-content {
        flex: 1;
        overflow-y: auto;
        padding: 12px;
    }

    /* ── Sidebar cards ── */
    .sidebar .card {
        background: #fff;
        border: 1px solid var(--cu-border-light);
        border-radius: 0.9rem;
        padding: 14px;
        margin-bottom: 10px;
        cursor: pointer;
        transition: border-color 0.2s, transform 0.1s;
        box-shadow: var(--cu-shadow-xs);
    }

    .sidebar .card:hover {
        border-color: var(--cu-secondary-blue);
        transform: translateX(2px);
        box-shadow: var(--cu-shadow-sm);
    }

    .sidebar .card-title {
        font-size: 14px;
        font-weight: 600;
        color: var(--cu-primary-blue);
        margin-bottom: 6px;
    }

    .sidebar .card-meta {
        font-size: 11px;
        color: var(--cu-text-muted);
        display: flex;
        gap: 12px;
        flex-wrap: wrap;
    }

    .sidebar .card-meta span {
        display: inline-flex;
        align-items: center;
        gap: 4px;
    }

    /* ── Stats bar ── */
    .stats-bar {
        display: flex;
        gap: 16px;
        padding: 10px 20px;
        background: linear-gradient(135deg, rgba(var(--cu-secondary-rgb), 0.06), rgba(var(--cu-accent-rgb), 0.04));
        border-bottom: 1px solid var(--cu-border-light);
        font-size: 12px;
    }

    .stat-item {
        display: flex;
        align-items: center;
        gap: 6px;
    }

    .stat-value {
        font-weight: 600;
        color: var(--cu-primary-blue);
    }

    .stat-label {
        color: var(--cu-text-muted);
    }

    /* ── Visualization ── */
    .visualization {
        flex: 1;
        position: relative;
        background: #fcfaf6;
        display: flex;
        flex-direction: column;
        min-height: 0;
    }

    #graph-network {
        width: 100%;
        flex: 1;
        min-height: 0;
        overflow: hidden;
    }

    /* ── Graph loading overlay ── */
    .graph-loading {
        position: absolute;
        inset: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        background: rgba(252, 250, 246, 0.85);
        z-index: 10;
        pointer-events: none;
        transition: opacity 0.3s;
    }
    .graph-loading.hidden {
        opacity: 0;
    }
    .graph-loading .spinner {
        width: 40px;
        height: 40px;
        border: 3px solid var(--cu-border-light);
        border-top-color: var(--cu-secondary-blue);
        border-radius: 50%;
        animation: spin 0.8s linear infinite;
    }
    @@keyframes spin {
        to { transform: rotate(360deg); }
    }

    /* ── Graph Controls ── */
    .graph-controls {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 8px 16px;
        background: #fff;
        border-bottom: 1px solid var(--cu-border-light);
        font-size: 12px;
        flex-wrap: wrap;
    }

    .graph-controls label {
        color: var(--cu-text-muted);
        font-weight: 500;
        white-space: nowrap;
    }

    .graph-controls select,
    .graph-controls input[type="range"] {
        background: #fff;
        border: 1px solid var(--cu-border-light);
        border-radius: 0.5rem;
        color: var(--cu-text-dark);
        padding: 4px 8px;
        font-size: 12px;
        outline: none;
    }

    .graph-controls select:focus { border-color: var(--cu-secondary-blue); }

    .graph-controls .ctrl-group {
        display: flex;
        align-items: center;
        gap: 6px;
    }

    .graph-controls .ctrl-toggle {
        display: inline-flex;
        align-items: center;
        gap: 4px;
        padding: 4px 10px;
        border: 1px solid var(--cu-border-light);
        border-radius: 0.5rem;
        background: #fff;
        color: var(--cu-text-muted);
        cursor: pointer;
        font-size: 12px;
        transition: all 0.2s;
    }

    .graph-controls .ctrl-toggle:hover {
        border-color: var(--cu-secondary-blue);
        color: var(--cu-primary-blue);
    }

    .graph-controls .ctrl-toggle.active {
        background: rgba(var(--cu-secondary-rgb), 0.1);
        border-color: var(--cu-secondary-blue);
        color: var(--cu-secondary-blue);
    }

    /* ── Legend ── */
    .graph-legend {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 6px 16px;
        background: #fff;
        border-bottom: 1px solid var(--cu-border-light);
        font-size: 11px;
        flex-wrap: wrap;
    }

    .legend-item {
        display: inline-flex;
        align-items: center;
        gap: 4px;
        color: var(--cu-text-muted);
    }

    .legend-dot {
        width: 10px;
        height: 10px;
        border-radius: 50%;
        display: inline-block;
    }

    .vis-tooltip {
        background: #fff !important;
        border: 1px solid var(--cu-border-light) !important;
        border-radius: 0.6rem !important;
        color: var(--cu-text-dark) !important;
        font-size: 12px !important;
        padding: 8px 12px !important;
        box-shadow: var(--cu-shadow-sm) !important;
    }

    /* ── Search ── */
    .search-box {
        padding: 12px 20px;
        border-bottom: 1px solid var(--cu-border-light);
    }

    .search-box input {
        width: 100%;
        padding: 8px 12px;
        background: #fff;
        border: 1px solid var(--cu-border-light);
        border-radius: 0.9rem;
        color: var(--cu-text-dark);
        font-size: 13px;
        outline: none;
    }

    .search-box input:focus {
        border-color: var(--cu-secondary-blue);
        box-shadow: 0 0 0 4px rgba(var(--cu-secondary-rgb), 0.12);
    }

    .search-box input::placeholder {
        color: var(--cu-text-muted);
    }

    /* ── Scrollbar ── */
    .sidebar-content::-webkit-scrollbar {
        width: 6px;
    }
    .sidebar-content::-webkit-scrollbar-track {
        background: transparent;
    }
    .sidebar-content::-webkit-scrollbar-thumb {
        background: var(--cu-border-light);
        border-radius: 3px;
    }

    /* ── Slide-in Node Detail Panel ── */
    .node-detail-panel {
        position: absolute;
        top: 0;
        right: 0;
        width: 420px;
        max-width: 90vw;
        height: 100%;
        background: #fff;
        border-left: 1px solid var(--cu-border-light);
        box-shadow: -4px 0 24px rgba(0,0,0,0.12);
        z-index: 100;
        display: flex;
        flex-direction: column;
        animation: slideInRight 0.25s ease-out;
        overflow: hidden;
    }
    @@keyframes slideInRight {
        from { transform: translateX(100%); }
        to { transform: translateX(0); }
    }
    .node-detail-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 16px 20px;
        border-bottom: 1px solid var(--cu-border-light);
        background: linear-gradient(135deg, rgba(var(--cu-secondary-rgb), 0.06), rgba(var(--cu-accent-rgb), 0.04));
    }
    .node-detail-header h3 {
        font-size: 16px;
        font-weight: 600;
        color: var(--cu-primary-blue);
        margin: 0;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
        max-width: 320px;
    }
    .node-detail-close {
        background: none;
        border: none;
        font-size: 24px;
        color: var(--cu-text-muted);
        cursor: pointer;
        padding: 0;
        line-height: 1;
        transition: color 0.15s;
    }
    .node-detail-close:hover { color: var(--cu-primary-blue); }
    .node-detail-body {
        flex: 1;
        overflow-y: auto;
        padding: 16px 20px;
        font-size: 13px;
        line-height: 1.6;
    }
    .node-detail-body .meta-row {
        display: flex;
        justify-content: space-between;
        padding: 6px 0;
        border-bottom: 1px solid var(--cu-border-light);
    }
    .node-detail-body .meta-label {
        color: var(--cu-text-muted);
        font-size: 11px;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }
    .node-detail-body .meta-value {
        font-weight: 600;
        color: var(--cu-primary-blue);
        font-size: 13px;
    }
    .node-detail-body .section-label {
        font-size: 12px;
        font-weight: 600;
        color: var(--cu-secondary-blue);
        margin: 16px 0 8px;
        padding-bottom: 4px;
        border-bottom: 1px solid var(--cu-border-light);
    }
    .node-detail-actions {
        padding: 12px 20px;
        border-top: 1px solid var(--cu-border-light);
        text-align: center;
    }
</style>

<!-- ── Pipeline Action Panel ── -->
@if (!isHomePage)
{
<div class="pipeline-panel" style="display:flex;align-items:center;gap:10px;padding:10px 20px;background:linear-gradient(135deg,rgba(var(--cu-secondary-rgb),0.08),rgba(var(--cu-accent-rgb),0.06));border-bottom:1px solid var(--cu-border-light);flex-wrap:wrap;">
    <span style="font-size:13px;font-weight:600;color:var(--cu-primary-blue);white-space:nowrap;">🧪 Analysis Pipeline</span>
    <button class="btn btn-sm btn-outline-secondary pipeline-btn" data-action="run-pipeline" style="border-radius:0.7rem;font-size:12px;display:inline-flex;align-items:center;gap:4px;" onclick="runPipeline('run-pipeline')">
        <i class="bi bi-play-fill"></i> Full Pipeline
    </button>
    <button class="btn btn-sm btn-outline-secondary pipeline-btn" data-action="run-discovery" style="border-radius:0.7rem;font-size:12px;display:inline-flex;align-items:center;gap:4px;" onclick="runPipeline('run-discovery')">
        <i class="bi bi-diagram-3"></i> Discover Schemas
    </button>
    <button class="btn btn-sm btn-outline-secondary pipeline-btn" data-action="run-synthesis" style="border-radius:0.7rem;font-size:12px;display:inline-flex;align-items:center;gap:4px;" onclick="runPipeline('run-synthesis')">
        <i class="bi bi-arrow-left-right"></i> Synthesize
    </button>
    <button class="btn btn-sm btn-outline-primary pipeline-btn" data-action="rebuild" style="border-radius:0.7rem;font-size:12px;display:inline-flex;align-items:center;gap:4px;border-color:var(--cu-accent);color:var(--cu-accent);" onclick="runPipeline('rebuild')">
        <i class="bi bi-arrow-repeat"></i> Rebuild Graph
    </button>
    <span id="pipeline-status" style="font-size:12px;color:var(--cu-text-muted);margin-left:auto;">Ready</span>
</div>
}

