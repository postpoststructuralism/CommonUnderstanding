@{
    var node = ViewBag.Node as CommonUnderstanding.Models.UnderstandingNode;
    var memberships = ViewBag.Memberships as List<CommonUnderstanding.Services.NodeSchemaMembership> ?? new();
    ViewData["Title"] = $"Node: {node?.CanonicalText}";
}

<style>
    .container { max-width: 1000px; margin: 0 auto; padding: 24px; }

    .node-header {
        background: #fff;
        border: 1px solid var(--cu-border-light);
        border-radius: var(--cu-border-radius);
        padding: 24px;
        margin-bottom: 24px;
        box-shadow: var(--cu-shadow-xs);
    }

    .node-header h1 { font-size: 22px; font-weight: 600; color: var(--cu-primary-blue); margin-bottom: 12px; }

    .node-content {
        background: #fff;
        border: 1px solid var(--cu-border-light);
        border-radius: var(--cu-border-radius);
        padding: 16px;
        margin-bottom: 16px;
        font-size: 14px;
        line-height: 1.6;
        color: var(--cu-text-muted);
        white-space: pre-wrap;
        box-shadow: var(--cu-shadow-xs);
    }

    .meta-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
        gap: 12px;
        margin-top: 16px;
    }

    .meta-item {
        background: var(--cu-background);
        border: 1px solid var(--cu-border-light);
        border-radius: 0.6rem;
        padding: 10px 14px;
    }

    .meta-item .label { font-size: 10px; color: var(--cu-text-muted); text-transform: uppercase; letter-spacing: 0.5px; }
    .meta-item .value { font-size: 16px; font-weight: 600; color: var(--cu-primary-blue); margin-top: 2px; }

    .section-title {
        font-size: 16px;
        font-weight: 600;
        color: var(--cu-primary-blue);
        margin: 24px 0 12px;
        padding-bottom: 8px;
        border-bottom: 1px solid var(--cu-border-light);
    }

    .membership-card {
        background: #fff;
        border: 1px solid var(--cu-border-light);
        border-radius: var(--cu-border-radius);
        padding: 14px;
        margin-bottom: 8px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        box-shadow: var(--cu-shadow-xs);
    }

    .membership-card .schema-name {
        color: var(--cu-secondary-blue);
        font-weight: 500;
        text-decoration: none;
    }

    .membership-card .schema-name:hover { text-decoration: underline; color: var(--cu-primary-blue); }

    .back-link {
        display: inline-block;
        margin-bottom: 16px;
        color: var(--cu-secondary-blue);
        text-decoration: none;
        font-size: 13px;
    }

    .back-link:hover { text-decoration: underline; color: var(--cu-primary-blue); }

    .badge {
        display: inline-block;
        padding: 2px 8px;
        border-radius: 10px;
        font-size: 10px;
        font-weight: 600;
    }

    .badge-green { background: rgba(15,118,110,0.12); color: var(--cu-secondary-blue); }
    .badge-orange { background: rgba(192,122,63,0.12); color: var(--cu-accent); }
    .badge-red { background: rgba(192,57,43,0.12); color: #c0392b; }
    .badge-blue { background: rgba(22,33,49,0.08); color: var(--cu-primary-blue); }
</style>

<div class="container">
    <a href="/UnderstandingGraph" class="back-link">← Back to Schema Explorer</a>

    @if (node != null)
    {
        <div class="node-header">
            <a asp-action="Evolution" asp-route-nodeId="@node.Id" class="float-end small"><i class="bi bi-clock-history me-1"></i>View history</a>
            <h1>@node.CanonicalText</h1>

            <div class="node-content">@node.CanonicalText</div>

            <div class="meta-grid">
                <div class="meta-item">
                    <div class="label">Status</div>
                    <div class="value">
                        <span class="badge @(node.Status == CommonUnderstanding.Models.PropositionStatus.Settled ? "badge-green" : node.Status == CommonUnderstanding.Models.PropositionStatus.Contested ? "badge-orange" : "badge-blue")">
                            @node.Status
                        </span>
                    </div>
                </div>
                <div class="meta-item">
                    <div class="label">Confidence</div>
                    <div class="value" style="color: @(node.Confidence > 0.7 ? "var(--accent-green)" : node.Confidence > 0.4 ? "var(--accent-orange)" : "var(--accent-red)")">@node.Confidence.ToString("F3")</div>
                </div>
                <div class="meta-item">
                    <div class="label">Degree Centrality</div>
                    <div class="value">@node.DegreeCentrality.ToString("F3")</div>
                </div>
                <div class="meta-item">
                    <div class="label">Betweenness</div>
                    <div class="value">@node.BetweennessCentrality.ToString("F3")</div>
                </div>
                <div class="meta-item">
                    <div class="label">Clustering</div>
                    <div class="value">@node.ClusteringCoefficient.ToString("F3")</div>
                </div>
                <div class="meta-item">
                    <div class="label">PageRank</div>
                    <div class="value">@node.PageRank.ToString("F3")</div>
                </div>
                <div class="meta-item">
                    <div class="label">Eigenvector</div>
                    <div class="value">@node.EigenvectorCentrality.ToString("F3")</div>
                </div>
                <div class="meta-item">
                    <div class="label">Dialectical Temp</div>
                    <div class="value" style="color: @(node.DialecticalTemperature > 0.6 ? "var(--accent-red)" : node.DialecticalTemperature > 0.3 ? "var(--accent-orange)" : "var(--accent-green)")">@node.DialecticalTemperature.ToString("F3")</div>
                </div>
                <div class="meta-item">
                    <div class="label">Controversy</div>
                    <div class="value" style="color: @(node.ControversyScore > 0.5 ? "var(--accent-red)" : "var(--text-primary)")">@node.ControversyScore.ToString("F3")</div>
                </div>
                <div class="meta-item">
                    <div class="label">Schema Entropy</div>
                    <div class="value">@node.SchemaEntropy.ToString("F3")</div>
                </div>
                <div class="meta-item">
                    <div class="label">Evidence Count</div>
                    <div class="value">@node.EvidenceCount</div>
                </div>
                <div class="meta-item">
                    <div class="label">Created</div>
                    <div class="value" style="font-size:14px;">@node.FirstSeenAt.ToString("yyyy-MM-dd")</div>
                </div>
            </div>
        </div>

        <h2 class="section-title">Schema Memberships</h2>
        @if (memberships.Count == 0)
        {
            <p style="color:var(--text-secondary);">Not assigned to any schema.</p>
        }
        else
        {
            @foreach (var m in memberships)
            {
                <div class="membership-card">
                    <div>
                        <a href="/UnderstandingGraph/Schema/@m.SchemaId" class="schema-name">@m.SchemaLabel</a>
                    </div>
                    <div style="display:flex;gap:12px;align-items:center;">
                        <span style="font-size:12px;color:var(--text-secondary);">Weight: @m.Weight.ToString("F3")</span>
                    </div>
                </div>
            }
        }
    }
    else
    {
        <p style="color:var(--text-secondary);">Node not found.</p>
    }
</div>

@{
    var nodeLabel = node?.CanonicalText ?? "this node";
    if (nodeLabel.Length > 80) { nodeLabel = nodeLabel[..77] + "…"; }
}
@await Html.PartialAsync("_InlineContribution",
    (ContextLabel: nodeLabel, ContextType: "Node", ContextId: (node?.Id ?? 0).ToString()))

@section Scripts {
<script src="~/js/inline-contribution.js"></script>
}