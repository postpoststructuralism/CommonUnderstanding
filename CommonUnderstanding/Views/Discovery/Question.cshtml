@model CommonUnderstanding.Models.UserInteraction

@{
    ViewData["Title"] = "Discovery Question";
    var profile = ViewBag.Profile as CommonUnderstanding.Models.UserProfile;
    var progressPercent = (int)ViewBag.ProgressPercent;
}

<div class="container mt-4">
    <div class="row">
        <div class="col-md-10 offset-md-1">
            <!-- Progress Bar -->
            <div class="card mb-3">
                <div class="card-body py-2">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <span class="small">
                            <i class="bi bi-person-circle"></i> <strong>@profile.Name</strong>
                        </span>
                        <span class="small text-muted">
                            Question @(profile.InteractionCount + 1) • Stage: @profile.Stage
                        </span>
                    </div>
                    <div class="progress" style="height: 8px;">
                        <div class="progress-bar bg-success" role="progressbar" 
                             style="width: @progressPercent%;" 
                             aria-valuenow="@progressPercent" aria-valuemin="0" aria-valuemax="100">
                        </div>
                    </div>
                    <div class="small text-muted mt-1 text-end">
                        Model Confidence: @((profile.CurrentBeliefSnapshot?.OverallConfidence ?? 0).ToString("P0"))
                    </div>
                </div>
            </div>

            @if (TempData["ShowProfilePrompt"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    <h5 class="alert-heading"><i class="bi bi-trophy"></i> Milestone Reached!</h5>
                    <p class="mb-0">
                        You've completed @profile.InteractionCount questions. 
                        <a asp-action="Profile" class="alert-link">View your evolving profile</a> to see what we've learned so far!
                    </p>
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }

            <!-- AI Processing Status Card -->
            <div id="aiStatusCard" class="card border-primary mb-3 d-none">
                <div class="card-body">
                    <div class="d-flex align-items-start">
                        <div class="spinner-border text-primary me-3 flex-shrink-0" role="status" style="width: 2rem; height: 2rem;">
                            <span class="visually-hidden">Processing...</span>
                        </div>
                        <div class="flex-grow-1">
                            <h6 class="card-title mb-2">
                                <i class="bi bi-cpu"></i> AI is analyzing your response...
                            </h6>
                            <div id="aiStatusText" class="mb-2">Starting analysis...</div>
                            <div class="progress" style="height: 6px;">
                                <div id="aiStatusProgress" class="progress-bar progress-bar-striped progress-bar-animated bg-primary" 
                                     role="progressbar" style="width: 0%"></div>
                            </div>
                            <div id="aiInsights" class="mt-3 small text-muted"></div>
                        </div>
                    </div>
                </div>
            </div>

            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    @TempData["Error"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }

            <!-- Question Card -->
            <div class="card shadow-lg">
                <div class="card-header bg-primary text-white">
                    <h4 class="mb-0">
                        @(Model.Type switch
                        {
                            CommonUnderstanding.Models.InteractionType.MoralDilemma => "🤔 Moral Dilemma",
                            CommonUnderstanding.Models.InteractionType.ScaleQuestion => "📊 Scale Question",
                            CommonUnderstanding.Models.InteractionType.ValueRanking => "🎯 Value Ranking",
                            CommonUnderstanding.Models.InteractionType.EmotionalPrompt => "❤️ Scenario",
                            _ => "💭 Question"
                        })
                    </h4>
                </div>
                <div class="card-body p-4">
                    @if (!string.IsNullOrEmpty(Model.Content.Context))
                    {
                        <div class="alert alert-light border scenario-context mb-4">
                            <div class="scenario-text">
                                @foreach (var paragraph in Model.Content.Context.Split("\n\n"))
                                {
                                    <p>@paragraph</p>
                                }
                            </div>
                        </div>
                    }

                    <h5 class="question-text mb-4">
                        @Model.Content.Question
                    </h5>

                    <form asp-action="SubmitResponse" method="post" id="responseForm">
                        @Html.AntiForgeryToken()
                        @if (Model.Content.Format == CommonUnderstanding.Models.InteractionFormat.MultipleChoice)
                        {
                            <div class="mb-4">
                                <div class="list-group">
                                    @for (int i = 0; i < Model.Content.Options.Count; i++)
                                    {
                                        var option = Model.Content.Options[i];
                                        <label class="list-group-item list-group-item-action choice-option">
                                            <input type="radio" name="selectedOption" value="@option" 
                                                   id="option@i" class="form-check-input me-2" required>
                                            @option
                                        </label>
                                    }
                                </div>
                            </div>
                            <div class="mb-3">
                                <details class="text-muted">
                                    <summary style="cursor: pointer;" class="small">
                                        <i class="bi bi-plus-circle"></i> Want to add more context? (completely optional)
                                    </summary>
                                    <textarea class="form-control mt-2" name="responseText" id="responseText" 
                                              rows="2" placeholder="Any additional thoughts..."></textarea>
                                </details>
                            </div>
                        }
                        else if (Model.Content.Format == CommonUnderstanding.Models.InteractionFormat.Scale)
                        {
                            <div class="mb-4">
                                <div class="d-flex justify-content-between mb-2">
                                    <span class="text-muted">@Model.Content.MinLabel</span>
                                    <span class="text-muted">@Model.Content.MaxLabel</span>
                                </div>
                                <input type="range" class="form-range" 
                                       name="numericValue" id="scaleValue" 
                                       min="@Model.Content.MinValue" max="@Model.Content.MaxValue" 
                                       value="@((Model.Content.MinValue + Model.Content.MaxValue) / 2)" 
                                       oninput="updateScaleValue(this.value)" required />
                                <div class="text-center mt-2">
                                    <h3><span id="scaleDisplay" class="badge bg-primary">5</span></h3>
                                </div>
                            </div>
                            <div class="mb-3">
                                <details class="text-muted">
                                    <summary style="cursor: pointer;" class="small">
                                        <i class="bi bi-plus-circle"></i> Want to explain? (optional)
                                    </summary>
                                    <textarea class="form-control mt-2" name="responseText" id="responseText" 
                                              rows="2" placeholder="Why did you choose this rating?"></textarea>
                                </details>
                            </div>
                        }
                        else if (Model.Content.Format == CommonUnderstanding.Models.InteractionFormat.Ranking)
                        {
                            <div class="mb-3">
                                <p class="text-muted">Drag to reorder from most to least important:</p>
                                <div id="rankingList" class="list-group">
                                    @foreach (var option in Model.Content.Options)
                                    {
                                        <div class="list-group-item" draggable="true">
                                            <i class="bi bi-grip-vertical"></i> @option
                                        </div>
                                    }
                                </div>
                            </div>
                            <input type="hidden" name="response" id="rankingResponse" required />
                            <div class="mb-3">
                                <details class="text-muted">
                                    <summary style="cursor: pointer;" class="small">
                                        <i class="bi bi-plus-circle"></i> Want to explain your ranking? (optional)
                                    </summary>
                                    <textarea class="form-control mt-2" name="responseText" id="responseText" 
                                              rows="2" placeholder="Why did you rank them this way?"></textarea>
                                </details>
                            </div>
                        }
                        else
                        {
                            <div class="mb-3">
                                <label for="response" class="form-label">Your Response:</label>
                                <textarea class="form-control" name="response" id="response" 
                                          rows="5" required autofocus
                                          placeholder="Share your thoughts honestly and openly..."></textarea>
                                <div class="form-text">
                                    Take your time. There are no right or wrong answers.
                                </div>
                            </div>
                        }

                        <div class="d-flex justify-content-between align-items-center">
                            <a asp-action="Profile" class="btn btn-outline-secondary">
                                <i class="bi bi-person"></i> View Profile
                            </a>
                            <button type="submit" class="btn btn-primary btn-lg" id="submitBtn">
                                <span id="submitText">Continue <i class="bi bi-arrow-right"></i></span>
                                <span id="loadingText" class="d-none">
                                    <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                                    AI is analyzing your response...
                                </span>
                            </button>
                        </div>
                    </form>
                </div>
            </div>

            <div class="text-center mt-3">
                <small class="text-muted">
                    <i class="bi bi-lock"></i> Your responses are analyzed privately and securely
                </small>
            </div>
        </div>
    </div>
</div>

<style>
    .scenario-context {
        background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);
    }
    
    .scenario-text {
        line-height: 1.8;
        font-size: 1.05rem;
    }

    .question-text {
        font-size: 1.3rem;
        font-weight: 500;
        color: #2c3e50;
        line-height: 1.6;
    }

    .choice-option {
        cursor: pointer;
        transition: all 0.2s ease;
        border: 2px solid transparent;
        margin-bottom: 0.5rem;
    }

    .choice-option:hover {
        background-color: #f8f9fa;
        border-color: #0d6efd;
    }

    .choice-option:has(input:checked) {
        background-color: #e7f1ff;
        border-color: #0d6efd;
        font-weight: 500;
    }

    .list-group-item {
        cursor: move;
        user-select: none;
    }

    .list-group-item.dragging {
        opacity: 0.5;
    }
</style>

@section Scripts {
    <script>
        let connection = null;
        const aiMessages = [
            "Detecting emotional undertones...",
            "Mapping values to belief dimensions...",
            "Identifying reasoning patterns...",
            "Comparing with previous responses...",
            "Calculating confidence intervals...",
            "Updating probabilistic model...",
            "Synthesizing new insights..."
        ];
        
        // Initialize SignalR connection for activity monitoring
        async function initializeSignalR() {
            try {
                console.log('🔌 Initializing SignalR connection to /discoveryHub...');
                connection = new signalR.HubConnectionBuilder()
                    .withUrl("/discoveryHub")
                    .withAutomaticReconnect()
                    .configureLogging(signalR.LogLevel.Information)
                    .build();

                // Note: We're NOT using SignalR for form submission in this view,
                // just for receiving activity updates from background processing

                await connection.start();
                console.log("✅ SignalR connected successfully for activity monitoring");
                console.log("Connection state:", connection.state);
                
                // Assign to window so activity monitor can use it
                window.discoveryConnection = connection;
                console.log("✅ window.discoveryConnection assigned");
            } catch (err) {
                console.error("❌ SignalR connection failed:", err);
                console.log("Activity monitor will not show real-time updates");
            }
        }

        function showAIStatus(message, progress) {
            const statusCard = document.getElementById('aiStatusCard');
            const statusText = document.getElementById('aiStatusText');
            const statusProgress = document.getElementById('aiStatusProgress');
            const insights = document.getElementById('aiInsights');
            
            statusCard.classList.remove('d-none');
            statusText.textContent = message;
            statusProgress.style.width = progress + '%';
            
            // Add random insight message based on progress
            if (progress > 10 && progress < 90 && Math.random() > 0.7) {
                const randomMsg = aiMessages[Math.floor(Math.random() * aiMessages.length)];
                insights.innerHTML = '<i class="bi bi-lightbulb"></i> ' + randomMsg;
            }
        }

        function hideAIStatus() {
            const statusCard = document.getElementById('aiStatusCard');
            statusCard.classList.add('d-none');
        }

        // Show loading state on form submit
        document.getElementById('responseForm').addEventListener('submit', function(e) {
            const submitBtn = document.getElementById('submitBtn');
            submitBtn.disabled = true;
            document.getElementById('submitText')?.classList.add('d-none');
            document.getElementById('loadingText')?.classList.remove('d-none');
            
            // Use regular form submission (not SignalR)
            console.log("Submitting via normal form post");
            // Let the form submit naturally (don't prevent default)
        });

        function updateScaleValue(value) {
            document.getElementById('scaleDisplay').textContent = value;
        }

        // Initialize scale display
        @if (Model.Content.Format == CommonUnderstanding.Models.InteractionFormat.Scale)
        {
            <text>
            const initialValue = (@Model.Content.MinValue + @Model.Content.MaxValue) / 2;
            updateScaleValue(initialValue);
            </text>
        }

        // Ranking drag and drop
        @if (Model.Content.Format == CommonUnderstanding.Models.InteractionFormat.Ranking)
        {
            <text>
            const list = document.getElementById('rankingList');
            let draggedItem = null;

            list.querySelectorAll('.list-group-item').forEach(item => {
                item.addEventListener('dragstart', function() {
                    draggedItem = this;
                    this.classList.add('dragging');
                });

                item.addEventListener('dragend', function() {
                    this.classList.remove('dragging');
                    updateRankingValue();
                });

                item.addEventListener('dragover', function(e) {
                    e.preventDefault();
                    const afterElement = getDragAfterElement(list, e.clientY);
                    if (afterElement == null) {
                        list.appendChild(draggedItem);
                    } else {
                        list.insertBefore(draggedItem, afterElement);
                    }
                });
            });

            function getDragAfterElement(container, y) {
                const draggableElements = [...container.querySelectorAll('.list-group-item:not(.dragging)')];
                return draggableElements.reduce((closest, child) => {
                    const box = child.getBoundingClientRect();
                    const offset = y - box.top - box.height / 2;
                    if (offset < 0 && offset > closest.offset) {
                        return { offset: offset, element: child };
                    } else {
                        return closest;
                    }
                }, { offset: Number.NEGATIVE_INFINITY }).element;
            }

            function updateRankingValue() {
                const items = [...list.querySelectorAll('.list-group-item')];
                const ranking = items.map(item => item.textContent.trim().replace('☰ ', ''));
                document.getElementById('rankingResponse').value = ranking.join(' > ');
            }

            // Set initial value
            updateRankingValue();
            </text>
        }
        
        // Initialize SignalR on page load (for activity monitoring only)
        document.addEventListener('DOMContentLoaded', function() {
            initializeSignalR();
        });

        // Listen for convergence events from the background processor
        function setupConvergenceListener() {
            if (connection) {
                connection.on("DiscoveryConverged", function(data) {
                    console.log("🎯 Convergence detected:", data);
                    showConvergenceToast(data);
                });

                connection.on("PersonalityInsight", function(data) {
                    console.log("💡 Personality insight:", data);
                    showInsightToast(data);
                });
            }
        }

        function showConvergenceToast(data) {
            // Create a toast notification
            const toastHtml = `
                <div class="toast-container position-fixed bottom-0 end-0 p-3" style="z-index: 9999;">
                    <div class="toast show" role="alert" id="convergenceToast">
                        <div class="toast-header bg-success text-white">
                            <i class="bi bi-check-circle-fill me-2"></i>
                            <strong class="me-auto">Discovery Complete!</strong>
                            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="toast"></button>
                        </div>
                        <div class="toast-body">
                            <p>${data.reason || "Your belief profile has been mapped!"}</p>
                            <p class="small text-muted">Confidence: ${(data.confidence * 100).toFixed(0)}% • ${data.interactionCount} questions</p>
                            <a href="/Discovery/Profile" class="btn btn-success btn-sm mt-2">
                                <i class="bi bi-person-badge"></i> View Your Profile
                            </a>
                        </div>
                    </div>
                </div>`;
            
            document.body.insertAdjacentHTML('beforeend', toastHtml);
            
            // Auto-hide after 15 seconds
            setTimeout(() => {
                const toast = document.getElementById('convergenceToast');
                if (toast) toast.remove();
            }, 15000);
        }

        function showInsightToast(data) {
            const categoryColors = {
                'Compassion': 'bg-danger',
                'Pragmatism': 'bg-secondary',
                'Justice': 'bg-warning text-dark',
                'Freedom': 'bg-info text-dark',
                'Traditional': 'bg-primary',
                'Decision Style': 'bg-dark',
                'Complexity': 'bg-purple',
                'Consistency': 'bg-teal',
                'Engagement': 'bg-success',
                'Balance': 'bg-indigo',
                'Milestone': 'bg-warning'
            };
            const colorClass = categoryColors[data.category] || 'bg-info';
            
            const toastHtml = `
                <div class="toast-container position-fixed top-0 end-0 p-3" style="z-index: 9998;">
                    <div class="toast show insight-toast" role="alert">
                        <div class="toast-header ${colorClass} text-white">
                            <i class="bi bi-lightbulb-fill me-2"></i>
                            <strong class="me-auto">${data.category || 'Insight'}</strong>
                            <small class="text-white-50">just now</small>
                            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="toast"></button>
                        </div>
                        <div class="toast-body">
                            ${data.message}
                        </div>
                    </div>
                </div>`;
            
            document.body.insertAdjacentHTML('beforeend', toastHtml);
            
            // Auto-hide after 8 seconds
            setTimeout(() => {
                const toasts = document.querySelectorAll('.insight-toast');
                const lastToast = toasts[toasts.length - 1];
                if (lastToast) lastToast.remove();
            }, 8000);
        }

        // Wire up convergence listener after connection
        const originalInit = initializeSignalR;
        initializeSignalR = async function() {
            await originalInit();
            setupConvergenceListener();
        };
    </script>
}
