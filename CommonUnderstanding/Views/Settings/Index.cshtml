@{
    ViewData["Title"] = "Settings";
}

<nav aria-label="breadcrumb" class="cu-breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-controller="Dashboard" asp-action="Index">Dashboard</a></li>
        <li class="breadcrumb-item active" aria-current="page">Settings</li>
    </ol>
</nav>

<h1 class="cu-page-heading">
    <i class="bi bi-gear me-1"></i> Settings
</h1>

<div class="row g-4">
    <div class="col-lg-8">
        <!-- AI Provider Status (moved from floating panel) -->
        <div class="cu-card mb-4">
            <div class="cu-card-header">
                <i class="fas fa-robot me-1"></i> AI Provider
                <span id="aiStatusDot" class="ms-2"
                      style="display:inline-block;width:10px;height:10px;border-radius:50%;background:#6b7280;"></span>
                <span id="aiStatusText" class="ms-1 small text-muted">Checking…</span>
            </div>
            <div class="cu-card-body">
                <div id="aiStatusRows">
                    <div class="d-flex justify-content-between align-items-center border-start border-4 border-secondary rounded px-3 py-2 mb-2 bg-light">
                        <div>
                            <div class="fw-semibold">Gemini API</div>
                            <div class="small text-muted" id="geminiConfigured">Loading…</div>
                        </div>
                        <span id="geminiIndicator" class="badge bg-secondary">—</span>
                    </div>
                    <div class="d-flex justify-content-between align-items-center border-start border-4 border-secondary rounded px-3 py-2 mb-2 bg-light">
                        <div>
                            <div class="fw-semibold">Current Model</div>
                            <div class="small text-muted" id="currentModel">Loading…</div>
                        </div>
                        <span id="modelIndicator" class="badge bg-secondary">—</span>
                    </div>
                </div>

                <!-- Model Switcher -->
                <div class="mt-3">
                    <label class="form-label fw-semibold">Switch Model</label>
                    <div class="d-flex gap-2">
                        <select class="form-select" id="modelSelector">
                            <option value="">Loading available models…</option>
                        </select>
                        <button class="btn btn-primary flex-shrink-0" onclick="switchModel()">
                            Apply
                        </button>
                    </div>
                </div>

                <!-- Agent Switcher -->
                <div class="mt-3">
                    <label class="form-label fw-semibold">Agent Backend</label>
                    <div class="d-flex gap-2">
                        <select class="form-select" id="agentSelector">
                            <option value="gemini">Gemini (Google AI)</option>
                            <option value="azureopenai">Azure OpenAI</option>
                            <option value="none">None / Disabled</option>
                        </select>
                        <button class="btn btn-outline-secondary flex-shrink-0" onclick="switchAgent()">
                            Apply
                        </button>
                    </div>
                </div>

                <!-- Actions -->
                <div class="d-flex gap-2 mt-3 flex-wrap">
                    <button class="btn btn-outline-primary" onclick="testConnection()">
                        <i class="bi bi-arrow-repeat me-1"></i> Test Connection
                    </button>
                    <button class="btn btn-outline-secondary" onclick="refreshStatus()">
                        <i class="bi bi-arrow-clockwise me-1"></i> Refresh Status
                    </button>
                </div>

                <div id="settingsMessageBox" class="mt-3" style="display:none;"></div>
                <div class="text-muted small mt-2">
                    Last refreshed: <span id="lastUpdated">never</span>
                </div>
            </div>
        </div>

        <!-- Performance Metrics -->
        <div class="cu-card mb-4">
            <div class="cu-card-header">
                <i class="bi bi-bar-chart me-1"></i> Performance
            </div>
            <div class="cu-card-body">
                <div class="row text-center">
                    <div class="col-6 col-md-3 mb-3">
                        <div class="fw-bold fs-4" id="responseTime">—</div>
                        <div class="text-muted small">Response Time (ms)</div>
                    </div>
                    <div class="col-6 col-md-3 mb-3">
                        <div class="fw-bold fs-4" id="uptime">—</div>
                        <div class="text-muted small">Uptime</div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Right sidebar: Help -->
    <div class="col-lg-4">
        <div class="cu-card mb-4">
            <div class="cu-card-header"><i class="bi bi-info-circle me-1"></i> Setup Help</div>
            <div class="cu-card-body small">
                <p><strong>Gemini API not configured?</strong></p>
                <ol class="ps-3">
                    <li>Get a free API key from <a href="https://aistudio.google.com/app/apikey" target="_blank" rel="noopener noreferrer">Google AI Studio</a></li>
                    <li>Add the key to <code>appsettings.json</code> under <code>Gemini:ApiKey</code></li>
                    <li>Set <code>Gemini:ModelName</code> to your preferred model (e.g. <code>gemini-2.0-flash</code>)</li>
                    <li>Click <em>Test Connection</em> above</li>
                </ol>
                <p class="mt-3"><strong>Using Azure OpenAI?</strong></p>
                <p class="text-muted">Switch the Agent Backend to "Azure OpenAI" and configure the endpoint in <code>appsettings.json</code>.</p>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    // ── Reuse logic from _AIControlPanel but wired to this page's elements ──

    async function refreshStatus() {
        const start = performance.now();
        try {
            const r = await fetch('/api/AIStatus/status');
            const data = await r.json();
            const ms = Math.round(performance.now() - start);

            document.getElementById('lastUpdated').textContent = new Date().toLocaleTimeString();
            document.getElementById('responseTime').textContent = ms;
            document.getElementById('geminiConfigured').textContent = data.geminiConfigured ? 'API key configured' : 'API key not set';
            document.getElementById('currentModel').textContent = data.modelName ?? '—';

            const geminiOk = !!data.geminiConfigured;
            const modelOk  = !!data.modelAvailable;

            setIndicator('geminiIndicator', geminiOk ? 'success' : 'danger', geminiOk ? 'Configured' : 'Not configured');
            setIndicator('modelIndicator',  modelOk  ? 'success' : 'warning', modelOk  ? 'Loaded' : 'Not loaded');

            const dot = document.getElementById('aiStatusDot');
            const txt = document.getElementById('aiStatusText');
            if (geminiOk && modelOk) {
                dot.style.background = '#198754'; txt.textContent = 'Ready';
            } else if (geminiOk) {
                dot.style.background = '#ffc107'; txt.textContent = 'Partial';
            } else {
                dot.style.background = '#dc3545'; txt.textContent = 'Offline';
            }

            // Populate model selector
            if (data.availableModels && data.availableModels.length > 0) {
                const sel = document.getElementById('modelSelector');
                sel.innerHTML = data.availableModels.map(m =>
                    `<option value="${m}" ${m === data.modelName ? 'selected' : ''}>${m}</option>`
                ).join('');
            }

            if (data.agent) {
                document.getElementById('agentSelector').value = data.agent;
            }

            if (data.uptime) document.getElementById('uptime').textContent = data.uptime;

        } catch(e) {
            showSettingsMessage('danger', 'Failed to fetch status: ' + e.message);
        }
    }

    function setIndicator(id, type, label) {
        const el = document.getElementById(id);
        el.className = `badge bg-${type}`;
        el.textContent = label;
        const row = el.closest('.border-start');
        if (row) {
            row.classList.remove('border-success', 'border-danger', 'border-warning', 'border-secondary');
            row.classList.add(`border-${type}`);
        }
    }

    async function testConnection() {
        showSettingsMessage('info', '⏳ Testing connection…');
        await refreshStatus();
        const txt = document.getElementById('aiStatusText').textContent;
        if (txt === 'Ready') showSettingsMessage('success', '✓ Connection successful');
        else showSettingsMessage('warning', '⚠ Gemini API key is not configured. Add it to appsettings.json under Gemini:ApiKey.');
    }

    async function switchModel() {
        const model = document.getElementById('modelSelector').value;
        if (!model) return;
        try {
            const r = await fetch('/api/AIStatus/switch-model', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ modelName: model })
            });
            if (r.ok) {
                showSettingsMessage('success', `✓ Switched to model: ${model}`);
                refreshStatus();
            } else {
                showSettingsMessage('danger', 'Failed to switch model.');
            }
        } catch(e) {
            showSettingsMessage('danger', 'Error: ' + e.message);
        }
    }

    async function switchAgent() {
        const agent = document.getElementById('agentSelector').value;
        try {
            const r = await fetch('/api/AIStatus/switch-agent', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ agent })
            });
            showSettingsMessage(r.ok ? 'success' : 'danger',
                r.ok ? `✓ Switched to: ${agent}` : 'Failed to switch agent.');
        } catch(e) {
            showSettingsMessage('danger', 'Error: ' + e.message);
        }
    }

    function showSettingsMessage(type, text) {
        const box = document.getElementById('settingsMessageBox');
        box.style.display = 'block';
        box.className = `alert alert-${type} py-2 small`;
        box.textContent = text;
        if (type === 'success' || type === 'info') {
            setTimeout(() => { box.style.display = 'none'; }, 4000);
        }
    }

    // Auto-refresh on page load
    document.addEventListener('DOMContentLoaded', refreshStatus);
</script>
}
