@{
    ViewData["Title"] = "Settings";
}

<nav aria-label="breadcrumb" class="cu-breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-controller="Dashboard" asp-action="Index">Dashboard</a></li>
        <li class="breadcrumb-item active" aria-current="page">Settings</li>
    </ol>
</nav>

<h1 class="cu-page-heading">
    <i class="bi bi-gear me-1"></i> Settings
</h1>

<div class="row g-4">
    <div class="col-lg-8">
        <!-- AI Compute Status -->
        <div class="cu-card mb-4">
            <div class="cu-card-header d-flex align-items-center justify-content-between">
                <span>
                    <i class="fas fa-robot me-1"></i> AI Compute Status
                    <span id="aiStatusDot" class="ms-2"
                          style="display:inline-block;width:10px;height:10px;border-radius:50%;background:#6b7280;"></span>
                    <span id="aiStatusText" class="ms-1 small text-muted">Checking…</span>
                </span>
                <button class="btn btn-sm btn-outline-secondary" onclick="refreshStatus()">
                    <i class="bi bi-arrow-clockwise"></i>
                </button>
            </div>
            <div class="cu-card-body">

                <!-- Fallback chain -->
                <div class="mb-3">
                    <div class="small text-muted text-uppercase fw-semibold mb-1" style="font-size:0.7rem;letter-spacing:0.05em;">Fallback Chain</div>
                    <div id="fallbackChain" class="d-flex gap-2 flex-wrap">
                        <span class="badge bg-secondary">Loading…</span>
                    </div>
                </div>

                <!-- Provider rows -->
                <div id="aiStatusRows" class="d-flex flex-column gap-2 mb-3">
                    <div class="d-flex justify-content-between align-items-center border-start border-4 border-secondary rounded px-3 py-2 bg-light" id="rowOpenRouter">
                        <div>
                            <div class="fw-semibold">OpenRouter <span class="text-muted fw-normal small" id="openRouterModel"></span></div>
                            <div class="small text-muted" id="openRouterDetail">Loading…</div>
                        </div>
                        <span id="openRouterIndicator" class="badge bg-secondary">—</span>
                    </div>
                    <div class="d-flex justify-content-between align-items-center border-start border-4 border-secondary rounded px-3 py-2 bg-light" id="rowGemini">
                        <div>
                            <div class="fw-semibold">Gemini <span class="text-muted fw-normal small" id="geminiModel"></span></div>
                            <div class="small text-muted" id="geminiDetail">Loading…</div>
                        </div>
                        <span id="geminiIndicator" class="badge bg-secondary">—</span>
                    </div>
                    <div class="d-flex justify-content-between align-items-center border-start border-4 border-secondary rounded px-3 py-2 bg-light" id="rowOllama">
                        <div>
                            <div class="fw-semibold">Ollama <span class="text-muted fw-normal small" id="ollamaModel"></span></div>
                            <div class="small text-muted" id="ollamaDetail">Loading…</div>
                        </div>
                        <span id="ollamaIndicator" class="badge bg-secondary">—</span>
                    </div>
                </div>

                <!-- OpenRouter model switcher -->
                <div class="mt-3">
                    <label class="form-label fw-semibold small">Active OpenRouter Model</label>
                    <div class="d-flex gap-2">
                        <select class="form-select form-select-sm" id="modelSelector">
                            <option value="">Loading available models…</option>
                        </select>
                        <button class="btn btn-sm btn-primary flex-shrink-0" onclick="switchModel()">
                            Apply
                        </button>
                    </div>
                    <div class="text-muted mt-1" style="font-size:0.72rem;">Only free-tier models are listed.</div>
                </div>

                <!-- Actions -->
                <div class="d-flex gap-2 mt-3 flex-wrap">
                    <button class="btn btn-outline-primary btn-sm" onclick="testConnection()">
                        <i class="bi bi-arrow-repeat me-1"></i> Test Connection
                    </button>
                </div>

                <div id="settingsMessageBox" class="mt-3" style="display:none;"></div>
                <div class="text-muted small mt-2">
                    Last refreshed: <span id="lastUpdated">never</span>
                </div>
            </div>
        </div>

        <!-- Performance Metrics -->
        <div class="cu-card mb-4">
            <div class="cu-card-header">
                <i class="bi bi-bar-chart me-1"></i> Performance
            </div>
            <div class="cu-card-body">
                <div class="row text-center">
                    <div class="col-6 col-md-3 mb-3">
                        <div class="fw-bold fs-4" id="responseTime">—</div>
                        <div class="text-muted small">Last Response (ms)</div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Right sidebar: Help -->
    <div class="col-lg-4">
        <div class="cu-card mb-4">
            <div class="cu-card-header"><i class="bi bi-info-circle me-1"></i> Setup Help</div>
            <div class="cu-card-body small">
                <p><strong>Gemini API not configured?</strong></p>
                <ol class="ps-3">
                    <li>Get a free API key from <a href="https://aistudio.google.com/app/apikey" target="_blank" rel="noopener noreferrer">Google AI Studio</a></li>
                    <li>Add the key to <code>appsettings.json</code> under <code>Gemini:ApiKey</code></li>
                    <li>Set <code>Gemini:ModelName</code> to your preferred model (e.g. <code>gemini-2.0-flash</code>)</li>
                    <li>Click <em>Test Connection</em> above</li>
                </ol>
                <p class="mt-3"><strong>Using Azure OpenAI?</strong></p>
                <p class="text-muted">Switch the Agent Backend to "Azure OpenAI" and configure the endpoint in <code>appsettings.json</code>.</p>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    async function refreshStatus() {
        const start = performance.now();
        try {
            const r = await fetch('/api/AIStatus/status');
            const data = await r.json();
            const ms = Math.round(performance.now() - start);

            document.getElementById('lastUpdated').textContent = new Date().toLocaleTimeString();
            const rtEl = document.getElementById('responseTime');
            if (rtEl) rtEl.textContent = ms;

            // ── Fallback chain badges ──────────────────────────────────────
            const chainEl = document.getElementById('fallbackChain');
            if (data.fallbackChain && data.fallbackChain.length > 0) {
                chainEl.innerHTML = data.fallbackChain.map((p, i) =>
                    `<span class="badge bg-primary">${i + 1}. ${p}</span>`
                ).join('<span class="text-muted small align-self-center">→</span>');
            }

            // ── OpenRouter ────────────────────────────────────────────────
            const or = data.openRouter;
            document.getElementById('openRouterModel').textContent = or.model ? `(${or.model})` : '';
            document.getElementById('openRouterDetail').textContent =
                or.configured ? `${or.availableModels?.length ?? 0} free models available` : 'API key not set';
            setIndicator('openRouterIndicator', 'rowOpenRouter',
                or.configured ? 'success' : 'secondary',
                or.configured ? 'Configured' : 'Not configured');

            // Populate model selector
            const sel = document.getElementById('modelSelector');
            if (or.availableModels && or.availableModels.length > 0) {
                sel.innerHTML = or.availableModels.map(m =>
                    `<option value="${m}" ${m === or.model ? 'selected' : ''}>${m}</option>`
                ).join('');
            } else {
                sel.innerHTML = '<option value="">No free models available</option>';
            }

            // ── Gemini ────────────────────────────────────────────────────
            const gm = data.gemini;
            document.getElementById('geminiModel').textContent = gm.model ? `(${gm.model})` : '';
            document.getElementById('geminiDetail').textContent =
                gm.configured ? 'API key configured' : 'API key not set';
            setIndicator('geminiIndicator', 'rowGemini',
                gm.configured ? 'success' : 'secondary',
                gm.configured ? 'Configured' : 'Not configured');

            // ── Ollama ────────────────────────────────────────────────────
            const ol = data.ollama;
            document.getElementById('ollamaModel').textContent = ol.model ? `(${ol.model})` : '';
            document.getElementById('ollamaDetail').textContent = ol.endpoint ?? 'http://localhost:11434';
            // Ollama reachability is determined at kernel build time; mark as info
            setIndicator('ollamaIndicator', 'rowOllama', 'secondary', 'Local');

            // ── Overall dot ───────────────────────────────────────────────
            const dot = document.getElementById('aiStatusDot');
            const txt = document.getElementById('aiStatusText');
            const status = (data.systemStatus ?? '').toLowerCase();
            if (status === 'ready') {
                dot.style.background = '#198754'; txt.textContent = 'Ready';
            } else if (status === 'no-cloud-keys') {
                dot.style.background = '#ffc107'; txt.textContent = 'No cloud keys';
            } else {
                dot.style.background = '#dc3545'; txt.textContent = 'Error';
            }

        } catch (e) {
            showSettingsMessage('danger', 'Failed to fetch status: ' + e.message);
        }
    }

    function setIndicator(badgeId, rowId, type, label) {
        const badge = document.getElementById(badgeId);
        badge.className = `badge bg-${type}`;
        badge.textContent = label;
        const row = document.getElementById(rowId);
        if (row) {
            row.classList.remove('border-success', 'border-danger', 'border-warning', 'border-secondary', 'border-primary');
            row.classList.add(`border-${type}`);
        }
    }

    async function testConnection() {
        showSettingsMessage('info', '⏳ Testing connection…');
        try {
            const r = await fetch('/api/AIStatus/test', { method: 'POST' });
            const data = await r.json();
            if (data.success) showSettingsMessage('success', '✓ ' + (data.message ?? 'Connection successful'));
            else showSettingsMessage('warning', '⚠ ' + (data.message ?? 'Connection failed'));
        } catch (e) {
            showSettingsMessage('danger', 'Error: ' + e.message);
        }
        await refreshStatus();
    }

    async function switchModel() {
        const model = document.getElementById('modelSelector').value;
        if (!model) return;
        try {
            const r = await fetch('/api/AIStatus/switch-model', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ modelName: model })
            });
            const data = await r.json();
            showSettingsMessage(r.ok ? 'success' : 'danger',
                r.ok ? `✓ Switched to: ${model}` : (data.message ?? 'Failed to switch model.'));
            if (r.ok) refreshStatus();
        } catch (e) {
            showSettingsMessage('danger', 'Error: ' + e.message);
        }
    }

    function showSettingsMessage(type, text) {
        const box = document.getElementById('settingsMessageBox');
        box.style.display = 'block';
        box.className = `alert alert-${type} py-2 small mb-0`;
        box.textContent = text;
        if (type === 'success' || type === 'info') {
            setTimeout(() => { box.style.display = 'none'; }, 4000);
        }
    }

    document.addEventListener('DOMContentLoaded', refreshStatus);
</script>
}
