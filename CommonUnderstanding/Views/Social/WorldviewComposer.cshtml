@model CommonUnderstanding.Models.Social.WorldviewInsight
@using System.Text.Json
@{
    ViewData["Title"] = "Your Worldview";
    var chartJson = JsonSerializer.Serialize(new
    {
        foundations = Model.MoralFoundations,
        user = new { x = Model.UserX, y = Model.UserY },
        peers = Model.Peers.Select(peer => new { x = peer.X, y = peer.Y, label = peer.Label, similarity = peer.Similarity })
    });
}

@section Styles {
<style>
    .worldview-shell { max-width: 1180px; margin: 0 auto; }
    .worldview-intro { display:grid; grid-template-columns:minmax(0,1.7fr) minmax(240px,.7fr); gap:2rem; align-items:end; padding:2rem 0 1.5rem; border-bottom:1px solid var(--bs-border-color); }
    .worldview-kicker { color:#0f766e; font-size:.78rem; font-weight:800; letter-spacing:.12em; text-transform:uppercase; }
    .worldview-title { font-family:Georgia, 'Times New Roman', serif; font-size:clamp(2.3rem,5vw,4.7rem); line-height:.98; letter-spacing:0; margin:.7rem 0 1rem; max-width:850px; }
    .worldview-deck { font-size:1.08rem; color:var(--bs-secondary-color); max-width:720px; }
    .evidence-strip { display:grid; grid-template-columns:repeat(3,1fr); gap:1px; background:var(--bs-border-color); border:1px solid var(--bs-border-color); }
    .evidence-stat { background:var(--bs-body-bg); padding:1rem; }
    .evidence-stat strong { display:block; font-family:Georgia, 'Times New Roman', serif; font-size:1.8rem; }
    .evidence-stat span { color:var(--bs-secondary-color); font-size:.78rem; }
    .worldview-grid { display:grid; grid-template-columns:minmax(0,1.2fr) minmax(320px,.8fr); gap:2rem; padding:2rem 0; }
    .section-heading { font-family:Georgia, 'Times New Roman', serif; font-size:1.55rem; margin-bottom:1rem; }
    .portrait-copy { white-space:pre-line; font-size:1.02rem; line-height:1.75; }
    .insight-panel { border-top:3px solid #0f766e; padding-top:1rem; margin-bottom:2rem; }
    .chart-wrap { position:relative; min-height:340px; }
    .value-list { display:grid; gap:.8rem; }
    .value-row { display:grid; grid-template-columns:130px 1fr 48px; gap:.75rem; align-items:center; font-size:.86rem; }
    .value-track { height:7px; background:var(--bs-tertiary-bg); overflow:hidden; }
    .value-fill { display:block; height:100%; background:#0f766e; }
    .match-list { display:grid; gap:1px; background:var(--bs-border-color); border:1px solid var(--bs-border-color); }
    .match-row { background:var(--bs-body-bg); padding:1rem; }
    .match-score { font-family:Georgia, 'Times New Roman', serif; font-size:1.35rem; color:#0f766e; }
    .argument-row { padding:1rem 0; border-top:1px solid var(--bs-border-color); }
    .argument-row a { color:inherit; text-decoration:none; }
    .argument-row a:hover { color:#0f766e; }
    .prevalence-list { display:grid; gap:1px; background:var(--bs-border-color); border:1px solid var(--bs-border-color); }
    .prevalence-row { background:var(--bs-body-bg); padding:1rem; }
    .prevalence-measures { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:1rem; margin-top:.8rem; }
    .prevalence-label { display:block; color:var(--bs-secondary-color); font-size:.72rem; text-transform:uppercase; letter-spacing:.06em; }
    .prevalence-value { display:block; font-family:Georgia, 'Times New Roman', serif; font-size:1.08rem; }
    .support-track { height:7px; background:var(--bs-tertiary-bg); margin:.45rem 0; overflow:hidden; }
    .support-fill { display:block; height:100%; background:#0f766e; }
    .empty-state { padding:2rem; border:1px solid var(--bs-border-color); background:var(--bs-tertiary-bg); }
    @@media (max-width: 800px) { .worldview-intro,.worldview-grid { grid-template-columns:1fr; } .chart-wrap { min-height:290px; } }
    @@media (max-width: 520px) { .evidence-strip,.prevalence-measures { grid-template-columns:1fr; } .value-row { grid-template-columns:100px 1fr 42px; } }
</style>
}

<main class="worldview-shell">
    <header class="worldview-intro">
        <div>
            <div class="worldview-kicker">Personal belief portrait</div>
            <h1 class="worldview-title">How your ideas hang together</h1>
            <p class="worldview-deck">A synthesis of what you have said in discovery and what you have chosen to argue, mapped against the wider community and enduring traditions.</p>
        </div>
        <div class="evidence-strip" aria-label="Evidence used">
            <div class="evidence-stat"><strong>@Model.InteractionCount</strong><span>discovery responses</span></div>
            <div class="evidence-stat"><strong>@Model.SubmittedArgumentCount</strong><span>submitted arguments</span></div>
            <div class="evidence-stat"><strong>@Model.ProfileConfidence.ToString("P0")</strong><span>model confidence</span></div>
        </div>
    </header>

    @if (!Model.HasBeliefProfile)
    {
        <div class="empty-state my-4">
            <div class="worldview-kicker">@Model.SubmittedArgumentCount argument-based evidence</div>
            <h2 class="section-heading">What your arguments reveal so far</h2>
            <div class="portrait-copy mb-4">@Model.Summary</div>
            <a class="cu-btn-primary" asp-controller="Discovery" asp-action="Start"><i class="bi bi-compass"></i> Continue belief discovery</a>
        </div>

        @if (Model.Arguments.Count > 0)
        {
            <section class="insight-panel my-4">
                <div class="worldview-kicker">Direct evidence</div>
                <h2 class="section-heading">Ideas included in this analysis</h2>
                @foreach (var argument in Model.Arguments)
                {
                    <article class="argument-row">
                        <a asp-controller="@argument.DetailController" asp-action="@argument.DetailAction" asp-route-id="@argument.Id"><strong>@argument.Title</strong></a>
                        <p class="text-secondary small mb-1">@argument.Claim</p>
                        @foreach (var value in argument.Values.Take(4)) { <span class="badge text-bg-light me-1">@value</span> }
                    </article>
                }
            </section>
        }

        @if (Model.CommunityViews.Count > 0)
        {
            <partial name="~/Views/Shared/_WorldviewCommunityViews.cshtml" model="Model.CommunityViews" />
        }
    }
    else
    {
        <div class="worldview-grid">
            <section>
                <div class="insight-panel">
                    <div class="worldview-kicker">Synthesis</div>
                    <h2 class="section-heading">Your worldview in words</h2>
                    <div class="portrait-copy">@Model.Summary</div>
                </div>

                <div class="insight-panel">
                    <div class="worldview-kicker">Community map</div>
                    <h2 class="section-heading">Where you sit among others</h2>
                    <p class="text-secondary">@Model.MappingNarrative</p>
                    <div class="chart-wrap"><canvas id="communityMap"></canvas></div>
                </div>

                <div class="insight-panel">
                    <div class="worldview-kicker">Direct evidence</div>
                    <h2 class="section-heading">Ideas you have put forward</h2>
                    @if (Model.Arguments.Count == 0)
                    {
                        <p class="text-secondary">No submitted arguments yet. Your portrait currently rests on belief discovery alone.</p>
                    }
                    @foreach (var argument in Model.Arguments)
                    {
                        <article class="argument-row">
                            <a asp-controller="@argument.DetailController" asp-action="@argument.DetailAction" asp-route-id="@argument.Id"><strong>@argument.Title</strong></a>
                            <p class="text-secondary small mb-1">@argument.Claim</p>
                            @foreach (var value in argument.Values.Take(4)) { <span class="badge text-bg-light me-1">@value</span> }
                        </article>
                    }
                </div>

                @if (Model.CommunityViews.Count > 0)
                {
                    <partial name="~/Views/Shared/_WorldviewCommunityViews.cshtml" model="Model.CommunityViews" />
                }
            </section>

            <aside>
                <div class="insight-panel">
                    <div class="worldview-kicker">Moral emphasis</div>
                    <h2 class="section-heading">Foundation profile</h2>
                    <div class="chart-wrap"><canvas id="foundationChart"></canvas></div>
                </div>

                <div class="insight-panel">
                    <div class="worldview-kicker">Priorities</div>
                    <h2 class="section-heading">Values carrying the most weight</h2>
                    <div class="value-list">
                        @foreach (var value in Model.TopValues)
                        {
                            <div class="value-row">
                                <span>@value.Name</span>
                                <span class="value-track"><span class="value-fill" style="width:@(Math.Clamp(value.Importance / 10.0, 0, 1).ToString("P0"))"></span></span>
                                <span>@value.Importance.ToString("F1")</span>
                            </div>
                        }
                    </div>
                </div>

                <div class="insight-panel">
                    <div class="worldview-kicker">Intellectual neighbors</div>
                    <h2 class="section-heading">Traditions with familiar contours</h2>
                    <div class="match-list">
                        @foreach (var match in Model.CanonicalMatches)
                        {
                            <div class="match-row">
                                <div class="d-flex justify-content-between gap-2"><strong>@match.Name</strong><span class="match-score">@match.Match.ToString("P0")</span></div>
                                <div class="text-secondary small">@match.Category</div>
                                @if (match.SharedValues.Length > 0) { <div class="small mt-2">Shared: @string.Join(", ", match.SharedValues)</div> }
                            </div>
                        }
                    </div>
                </div>
            </aside>
        </div>
    }
</main>

@section Scripts {
@if (Model.HasBeliefProfile)
{
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
<script>
    (() => {
        const data = @Html.Raw(chartJson);
        const ink = getComputedStyle(document.body).color;
        const grid = 'rgba(127,127,127,.2)';
        new Chart(document.getElementById('foundationChart'), {
            type: 'radar',
            data: { labels: ['Care','Fairness','Loyalty','Authority','Sanctity','Liberty'], datasets: [{ data: data.foundations, borderColor:'#0f766e', backgroundColor:'rgba(15,118,110,.16)', pointBackgroundColor:'#0f766e' }] },
            options: { maintainAspectRatio:false, scales:{ r:{ min:0,max:10,ticks:{display:false},grid:{color:grid},pointLabels:{color:ink} } }, plugins:{legend:{display:false}} }
        });
        const peerPoints = data.peers.map(peer => ({ x:peer.x, y:peer.y, label:peer.label, similarity:peer.similarity }));
        new Chart(document.getElementById('communityMap'), {
            type:'scatter',
            data:{ datasets:[
                { label:'Community', data:peerPoints, pointRadius:6, backgroundColor:'rgba(100,116,139,.45)' },
                { label:'You', data:[data.user], pointRadius:10, pointHoverRadius:12, backgroundColor:'#dc2626', borderColor:'#fff', borderWidth:2 }
            ]},
            options:{ maintainAspectRatio:false, scales:{ x:{min:-1,max:1,title:{display:true,text:@Html.Raw(JsonSerializer.Serialize(Model.HorizontalAxis))},grid:{color:grid},ticks:{color:ink}}, y:{min:-1,max:1,title:{display:true,text:@Html.Raw(JsonSerializer.Serialize(Model.VerticalAxis))},grid:{color:grid},ticks:{color:ink}} }, plugins:{ tooltip:{callbacks:{label:ctx => ctx.datasetIndex === 1 ? 'You' : `${ctx.raw.label}: ${(ctx.raw.similarity * 100).toFixed(0)}% similar`}} } }
        });
    })();
</script>
}
}
