@using CommonUnderstanding.Models
@model CommonUnderstanding.Models.Social.ClaimStateViewModel

@{
    var focus = Model.FocusArgument;
    var source = Model.SourceArgument;
    var claims = source?.Claims.OrderBy(c => c.Id).ToList() ?? new();
    var premises = claims.SelectMany(c => c.Premises).OrderBy(p => p.SortOrder).ToList();
    var syllogisms = claims.SelectMany(c => c.Syllogisms).OrderBy(s => s.SortOrder).ToList();
    var assumptions = claims.SelectMany(c => c.Assumptions).ToList();
    var qualifiers = claims.SelectMany(c => c.Qualifiers).ToList();
    var rebuttals = claims.SelectMany(c => c.Rebuttals).ToList();
    var contested = Model.OpposingArguments.Count > 0 || Model.Adjudication?.Recommendation is DecisionRecommendation.Investigate or DecisionRecommendation.Defer;
    var stateLabel = Model.Adjudication is null ? "Unresolved" : contested ? "Contested" : "Provisionally settled";
    var currentUnderstanding = Model.Adjudication?.ReasoningTrace ?? focus.ResolutionText ?? focus.WarrantText;
    var contextLabel = Model.Proposition.Text.Length > 80 ? Model.Proposition.Text[..77] + "..." : Model.Proposition.Text;
}

<link rel="stylesheet" href="~/css/social-detail.css" asp-append-version="true" />

<div class="claim-detail container-fluid">
    <nav class="detail-breadcrumb" aria-label="breadcrumb">
        <a asp-controller="UnderstandingGraph" asp-action="Index">Live Map</a><span>/</span>
        <a asp-controller="SocialView" asp-action="Feed">Contributions</a><span>/</span><span>Claim detail</span>
    </nav>

    <header class="detail-header">
        <div class="detail-title">
            <div class="title-meta"><span class="state-badge">@stateLabel</span><span>Updated @focus.UpdatedAt.ToString("MMM d, yyyy")</span></div>
            <h1>@Model.Proposition.Text</h1>
            <p>@currentUnderstanding</p>
        </div>
        <div class="metric-strip" aria-label="Analysis summary">
            <div><strong>@premises.Count</strong><span>Premises</span></div>
            <div><strong>@Model.Evidence.Count</strong><span>Evidence</span></div>
            <div><strong>@assumptions.Count(a => a.IsCritical)</strong><span>Critical gaps</span></div>
            <div><strong>@(Model.Adjudication?.OverallConfidence.ToString("P0") ?? "--")</strong><span>Confidence</span></div>
            <div><strong>@(Model.Adjudication?.Recommendation.ToString() ?? "Pending")</strong><span>Recommendation</span></div>
        </div>
    </header>

    <div class="detail-layout">
        <main class="analysis-main">
            @if (source is not null)
            {
                <section class="analysis-panel">
                    <div class="panel-heading"><h2>AI argument analysis</h2><span>Source analysis #@source.Id</span></div>
                    <div class="claim-block"><span>Central claim</span><strong>@(claims.FirstOrDefault()?.Text ?? Model.Proposition.Text)</strong></div>
                    @if (premises.Count > 0)
                    {
                        <div class="subsection-heading"><h3>Premises</h3><span>@premises.Count identified</span></div>
                        @foreach (var (premise, index) in premises.Select((item, index) => (item, index + 1)))
                        {
                            <article class="premise-row">
                                <span class="row-index">@index</span>
                                <div>
                                    <p>@premise.Text</p>
                                    @if (!string.IsNullOrWhiteSpace(premise.ProvisionalAssessment))
                                    {
                                        <div class="ai-assessment"><i class="bi bi-cpu"></i><span><strong>AI assessment @(premise.ProvisionalConfidence?.ToString("P0") ?? "")</strong>@premise.ProvisionalAssessment</span></div>
                                    }
                                </div>
                                <div class="premise-status"><strong>@premise.ConfidenceScore.ToString("P0")</strong><span>@premise.Status</span><small>@premise.EvidenceItems.Count evidence</small></div>
                            </article>
                        }
                    }
                </section>

                @if (syllogisms.Count > 0)
                {
                    <section class="analysis-panel">
                        <div class="panel-heading"><h2>Logical structure</h2><span>@syllogisms.Count inference chains</span></div>
                        <div class="logic-grid">
                            @foreach (var (syllogism, index) in syllogisms.Select((item, index) => (item, index + 1)))
                            {
                                <article class="logic-chain">
                                    <header><strong>@index. @syllogism.InferenceType</strong><span class="@(syllogism.IsValidForm ? "valid" : "issue")">@(syllogism.IsValidForm ? "Valid form" : "Issue detected")</span></header>
                                    <dl><dt>Major</dt><dd>@syllogism.MajorPremise</dd><dt>Minor</dt><dd>@syllogism.MinorPremise</dd><dt>Therefore</dt><dd><strong>@syllogism.Conclusion</strong></dd></dl>
                                    @if (!string.IsNullOrWhiteSpace(syllogism.FallaciesDetected)) { <p class="fallacy"><i class="bi bi-exclamation-triangle"></i>@syllogism.FallaciesDetected</p> }
                                </article>
                            }
                        </div>
                    </section>
                }

                @if (assumptions.Count > 0 || qualifiers.Count > 0 || rebuttals.Count > 0)
                {
                    <section class="analysis-panel">
                        <div class="panel-heading"><h2>Conditions and challenges</h2><span>Limits of the argument</span></div>
                        <div class="condition-grid">
                            <div><h3>Hidden assumptions <span>@assumptions.Count</span></h3>@foreach (var item in assumptions) { <p>@if (item.IsCritical) { <strong>Critical</strong> } @item.Text</p> }</div>
                            <div><h3>Qualifiers <span>@qualifiers.Count</span></h3>@foreach (var item in qualifiers) { <p>@if (!string.IsNullOrWhiteSpace(item.QualifierType)) { <strong>@item.QualifierType</strong> } @item.Text</p> }</div>
                            <div><h3>Rebuttals <span>@rebuttals.Count</span></h3>@foreach (var item in rebuttals) { <p>@if (!string.IsNullOrWhiteSpace(item.Strength)) { <strong>@item.Strength</strong> } @item.Text</p> }</div>
                        </div>
                    </section>
                }

                @if (!string.IsNullOrWhiteSpace(Model.Adjudication?.DetailedNarrative))
                {
                    <section class="analysis-panel narrative-panel">
                        <div class="panel-heading"><h2>Full agent narrative</h2><span>Adjudication analysis</span></div>
                        @foreach (var paragraph in Model.Adjudication.DetailedNarrative.Split("\n\n", StringSplitOptions.RemoveEmptyEntries)) { <p>@paragraph.Trim()</p> }
                    </section>
                }
            }
            else
            {
                <section class="analysis-panel empty-analysis"><i class="bi bi-cpu"></i><div><h2>No source AI analysis</h2><p>This contribution was created directly on the map and is not linked to an analyzed argument.</p></div></section>
            }

            <section class="analysis-panel">
                <div class="panel-heading"><h2>Evidence</h2><span>@Model.Evidence.Count linked items</span></div>
                @if (Model.Evidence.Count == 0) { <p class="compact-empty">No evidence has been linked yet.</p> }
                @foreach (var evidence in Model.Evidence)
                {
                    <article class="evidence-row">
                        <span class="direction @evidence.Direction.ToString().ToLowerInvariant()">@(evidence.Direction == EvidenceDirection.Opposes ? "Challenges" : evidence.Direction)</span>
                        <div><p>@evidence.Citation</p><small>@evidence.Tier.ToString().Replace("_", " ")</small></div>
                        @if (!string.IsNullOrWhiteSpace(evidence.SourceUri)) { <a href="@evidence.SourceUri" target="_blank" rel="noopener noreferrer" title="Open source"><i class="bi bi-box-arrow-up-right"></i></a> }
                    </article>
                }
            </section>
        </main>

        <aside class="detail-sidebar">
            <section class="side-panel">
                <div class="panel-heading"><h2>Arguments in context</h2></div>
                <h3 class="support-label">Supports</h3>
                @if (Model.SupportingArguments.Count == 0) { <p class="compact-empty">None linked.</p> }
                @foreach (var argument in Model.SupportingArguments) { <a class="argument-link" asp-action="Detail" asp-route-id="@argument.Id"><strong>@argument.Title</strong><span>@argument.WarrantText</span></a> }
                <h3 class="challenge-label">Challenges</h3>
                @if (Model.OpposingArguments.Count == 0) { <p class="compact-empty">None linked.</p> }
                @foreach (var argument in Model.OpposingArguments) { <a class="argument-link" asp-action="Detail" asp-route-id="@argument.Id"><strong>@argument.Title</strong><span>@argument.WarrantText</span></a> }
            </section>

            <section class="side-panel">
                <div class="panel-heading"><h2>Open questions</h2><span>@Model.RemainingQuestions.Count</span></div>
                @if (Model.RemainingQuestions.Count == 0 && string.IsNullOrWhiteSpace(Model.Adjudication?.NextSteps)) { <p class="compact-empty">No unresolved questions identified.</p> }
                @foreach (var question in Model.RemainingQuestions) { <p class="question">@if (question.IsCritical) { <strong>Critical</strong> } @question.Text</p> }
                @if (!string.IsNullOrWhiteSpace(Model.Adjudication?.NextSteps)) { <p class="question"><strong>Next</strong> @Model.Adjudication.NextSteps</p> }
            </section>

            <section class="side-panel">
                <div class="panel-heading"><h2>Contribution history</h2><span>@Model.ContributionHistory.Count</span></div>
                @foreach (var contribution in Model.ContributionHistory.OrderByDescending(c => c.CreatedAt))
                {
                    <a class="history-item @(contribution.Id == focus.Id ? "current" : null)" asp-action="Detail" asp-route-id="@contribution.Id"><time>@contribution.CreatedAt.ToString("MMM d, yyyy")</time><strong>@contribution.Title</strong></a>
                }
            </section>

            <section class="side-panel contribute-panel">
                <div class="panel-heading"><h2>Add perspective</h2></div>
                @await Html.PartialAsync("_InlineContribution", (ContextLabel: contextLabel, ContextType: "Proposition", ContextId: Model.Proposition.Id.ToString()))
            </section>
        </aside>
    </div>
</div>

@section Scripts {
    <script src="~/js/inline-contribution.js"></script>
}
