@model CommonUnderstanding.Models.Social.SocialArgument
@using CommonUnderstanding.Models.Social
@{
    ViewData["Title"] = Model.Title;
    var userVote = ViewBag.UserVote as ArgumentVote;
    var upActive = userVote?.Vote == VoteValue.Up ? " active-up" : "";
    var downActive = userVote?.Vote == VoteValue.Down ? " active-down" : "";
    var wilson = Math.Round((Model.WilsonScore) * 100);
}

@section Styles {
<style>
    .detail-card {
        border: 1px solid var(--bs-border-color);
        border-radius: 0.75rem;
        padding: 1.5rem;
        background: var(--bs-body-bg);
    }
    .detail-card .tags .badge { font-size: 0.72rem; }
    .vote-bar { display: flex; align-items: center; gap: 0.5rem; }
    .vote-bar .vote-count { font-weight: 600; min-width: 2.5rem; text-align: center; }
    .wilson-bar { height: 6px; border-radius: 3px; background: var(--bs-secondary-bg); margin-top: 8px; }
    .wilson-fill { height: 100%; border-radius: 3px; background: #198754; }
    .vote-trigger.active-up { box-shadow: 0 0 0 2px #198754; background: rgba(25,135,84,0.12); }
    .vote-trigger.active-down { box-shadow: 0 0 0 2px #dc3545; background: rgba(220,53,69,0.12); }
    .vote-modal-reason label { cursor: pointer; }
    .linked-arg-card {
        border: 1px solid var(--bs-border-color);
        border-radius: 0.5rem;
        padding: 0.75rem 1rem;
        transition: box-shadow 0.15s ease;
    }
    .linked-arg-card:hover { box-shadow: 0 2px 8px rgba(0,0,0,0.08); }
    .reply-thread {
        border-left: 2px solid var(--bs-border-color);
        padding-left: 8px;
        margin-bottom: 4px;
    }
    .reply-thread .reply-thread {
        border-left-color: var(--bs-secondary-bg);
    }
    .nested-replies {
        transition: all 0.2s ease;
    }
    .toggle-nested {
        transition: transform 0.15s ease;
    }
    .toggle-nested:hover {
        transform: scale(1.1);
    }
</style>
}

<!-- Breadcrumb -->
<nav aria-label="breadcrumb" class="cu-breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-controller="SocialView" asp-action="Feed">Feed</a></li>
        <li class="breadcrumb-item active" aria-current="page">@Model.Title</li>
    </ol>
</nav>

<!-- TempData alerts -->
@if (TempData["Success"] is string successMsg)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle me-1"></i>@successMsg
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["Error"] is string errorMsg)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="bi bi-exclamation-triangle me-1"></i>@errorMsg
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="detail-card">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-start mb-3">
        <div>
            <h1 class="cu-page-heading mb-1">@Model.Title</h1>
            <p class="text-muted small mb-0">
                Posted @Model.CreatedAt.ToString("MMM dd, yyyy 'at' h:mm tt") UTC
                @if (Model.UpdatedAt != Model.CreatedAt)
                {
                    <span>&middot; Updated @Model.UpdatedAt.ToString("MMM dd, yyyy 'at' h:mm tt") UTC</span>
                }
            </p>
        </div>
        <div class="d-flex gap-2">
            @if (Model.IsAIValidated)
            {
                <span class="badge @(Model.AIValidityScore >= 0.7 ? "bg-success" : Model.AIValidityScore >= 0.4 ? "bg-warning text-dark" : "bg-danger")">
                    <i class="bi bi-cpu"></i> AI: @(Math.Round((Model.AIValidityScore ?? 0) * 100))%
                </span>
            }
            @if (Model.IsShadowBanned)
            {
                <span class="badge bg-secondary"><i class="bi bi-eye-slash"></i> Shadow-banned</span>
            }
        </div>
    </div>

    <!-- Resolution -->
    @if (!string.IsNullOrWhiteSpace(Model.ResolutionText))
    {
        <div class="mb-3">
            <h6 class="text-uppercase text-muted small mb-1">Resolution</h6>
            <p class="mb-0">@Model.ResolutionText</p>
        </div>
    }

    <!-- Tags & Values -->
    <div class="d-flex flex-wrap gap-2 mb-3">
        @foreach (var tag in Model.Tags)
        {
            <span class="badge bg-secondary">@tag</span>
        }
        @foreach (var sv in Model.SchwartzValues)
        {
            <span class="badge bg-info text-dark"><i class="bi bi-compass me-1"></i>@sv</span>
        }
    </div>

    <!-- Voting -->
    <div class="d-flex align-items-center gap-3 mb-3">
        <div class="vote-bar">
            <button class="btn btn-outline-success vote-trigger@(upActive)" data-id="@Model.Id" data-vote="Up" title="Upvote">
                <i class="bi bi-hand-thumbs-up"></i>
                <span class="upvote-count vote-count">@Model.UpvoteCount</span>
            </button>
            <button class="btn btn-outline-danger vote-trigger@(downActive)" data-id="@Model.Id" data-vote="Down" title="Downvote">
                <i class="bi bi-hand-thumbs-down"></i>
                <span class="downvote-count vote-count">@Model.DownvoteCount</span>
            </button>
        </div>
        <div class="flex-grow-1">
            <div class="wilson-bar">
                <div class="wilson-fill" style="width:@(wilson)%"></div>
            </div>
        </div>
        <span class="text-muted small" title="Hot score">@Model.HotScore.ToString("F2") <i class="bi bi-fire"></i></span>
    </div>
</div>

<!-- Linked Arguments -->
@if (Model.OutboundLinks.Any() || Model.InboundLinks.Any())
{
    <div class="row mt-4">
        @if (Model.OutboundLinks.Any())
        {
            <div class="col-md-6 mb-3">
                <h6 class="text-uppercase text-muted small mb-2">
                    <i class="bi bi-arrow-right me-1"></i>This argument references
                </h6>
                @foreach (var link in Model.OutboundLinks)
                {
                    <a asp-action="Detail" asp-route-id="@link.TargetArgumentId"
                       class="linked-arg-card text-decoration-none text-reset d-block mb-2">
                        <strong>@link.TargetArgument?.Title</strong>
                        @if (link.TargetArgument?.ClaimProposition?.Text is not null)
                        {
                            var isTargetFollowUp = link.TargetArgument?.InboundLinks?.Any(l => l.LinkType == LinkType.Reply) == true;
                            var targetClaim = isTargetFollowUp ? link.TargetArgument?.Title : link.TargetArgument?.ClaimProposition?.Text;
                            <p class="text-muted small mb-0">@targetClaim</p>
                        }
                        <span class="badge bg-light text-dark mt-1">@link.LinkType</span>
                    </a>
                }
            </div>
        }
        @if (Model.InboundLinks.Any())
        {
            <div class="col-md-6 mb-3">
                <h6 class="text-uppercase text-muted small mb-2">
                    <i class="bi bi-arrow-left me-1"></i>Arguments referencing this
                </h6>
                @foreach (var link in Model.InboundLinks)
                {
                    <a asp-action="Detail" asp-route-id="@link.SourceArgumentId"
                       class="linked-arg-card text-decoration-none text-reset d-block mb-2">
                        <strong>@link.SourceArgument?.Title</strong>
                        @if (link.SourceArgument?.ClaimProposition?.Text is not null)
                        {
                            var isSourceFollowUp = link.SourceArgument?.InboundLinks?.Any(l => l.LinkType == LinkType.Reply) == true;
                            var sourceClaim = isSourceFollowUp ? link.SourceArgument?.Title : link.SourceArgument?.ClaimProposition?.Text;
                            <p class="text-muted small mb-0">@sourceClaim</p>
                        }
                        <span class="badge bg-light text-dark mt-1">@link.LinkType</span>
                    </a>
                }
            </div>
        }
    </div>
}

@{
    var sourceArg = ViewBag.SourceArgument as CommonUnderstanding.Models.Argument;
}

<!-- ── Manual Analysis Trigger (for follow-ups without analysis yet) ────── -->
@if (sourceArg == null && Model.InboundLinks.Any(l => l.LinkType == LinkType.Reply))
{
    <div class="mt-4">
        <div class="alert alert-info d-flex align-items-center justify-content-between">
            <div>
                <i class="bi bi-robot me-2"></i>
                <strong>AI Analysis</strong> — Run the full decomposition pipeline to see claims, premises, evidence, and adjudication for this argument.
            </div>
            <form asp-action="AnalyzeFollowUp" asp-controller="SocialView" method="post" style="display:inline">
                <input type="hidden" name="id" value="@Model.Id" />
                <button type="submit" class="btn btn-outline-primary btn-sm">
                    <i class="bi bi-play-fill me-1"></i>Run Analysis
                </button>
            </form>
        </div>
    </div>
}

<!-- ── Re-run Analysis Trigger (for follow-ups that already have analysis) ── -->
@if (sourceArg != null && Model.InboundLinks.Any(l => l.LinkType == LinkType.Reply))
{
    <div class="mt-2 mb-3">
        <div class="alert alert-warning d-flex align-items-center justify-content-between py-2">
            <div class="small">
                <i class="bi bi-arrow-repeat me-1"></i>
                <strong>Stale analysis?</strong> If the analysis doesn't look right, you can re-run it.
            </div>
            <form asp-action="ReanalyzeFollowUp" asp-controller="SocialView" method="post" style="display:inline">
                <input type="hidden" name="id" value="@Model.Id" />
                <button type="submit" class="btn btn-outline-warning btn-sm" onclick="return confirm('Re-run analysis? This will replace the current analysis data.');">
                    <i class="bi bi-arrow-repeat me-1"></i>Re-run Analysis
                </button>
            </form>
        </div>
    </div>
}

@if (sourceArg != null || ViewBag.ParentArgument != null)
{
    var claim = sourceArg?.Claims?.FirstOrDefault();
    var premises = claim?.Premises?.OrderBy(p => p.SortOrder).ToList() ?? new();
    var syllogisms = claim?.Syllogisms?.OrderBy(s => s.SortOrder).ToList() ?? new();
    var assumptions = claim?.Assumptions?.ToList() ?? new();
    var qualifiers = claim?.Qualifiers?.ToList() ?? new();
    var rebuttals = claim?.Rebuttals?.ToList() ?? new();
    var adjudication = sourceArg?.AdjudicationSummary;
    var stakeholderPositions = ViewBag.StakeholderPositions as List<CommonUnderstanding.Models.StakeholderPosition>;
    var stakeholderConsensus = ViewBag.StakeholderConsensus as CommonUnderstanding.Services.StakeholderConsensus;
    var ds = ViewBag.DecisionSupport as CommonUnderstanding.Services.DecisionSupportResult;

    static string ConfBadge(double c) => c >= 0.70 ? "success" : c >= 0.45 ? "warning" : "danger";
    static string StatusBadge(CommonUnderstanding.Models.PropositionStatus s) => s switch
    {
        CommonUnderstanding.Models.PropositionStatus.Settled   => "success",
        CommonUnderstanding.Models.PropositionStatus.Contested => "warning",
        CommonUnderstanding.Models.PropositionStatus.Unknown   => "secondary",
        _                                                      => "secondary"
    };
    static string RecClass(CommonUnderstanding.Models.DecisionRecommendation r) => r switch
    {
        CommonUnderstanding.Models.DecisionRecommendation.Proceed => "success",
        CommonUnderstanding.Models.DecisionRecommendation.Reject  => "danger",
        CommonUnderstanding.Models.DecisionRecommendation.Defer   => "warning",
        _                                                         => "info"
    };
    static string RecIcon(CommonUnderstanding.Models.DecisionRecommendation r) => r switch
    {
        CommonUnderstanding.Models.DecisionRecommendation.Proceed => "bi-check-circle-fill",
        CommonUnderstanding.Models.DecisionRecommendation.Reject  => "bi-x-circle-fill",
        CommonUnderstanding.Models.DecisionRecommendation.Defer   => "bi-pause-circle-fill",
        _                                                         => "bi-search"
    };

    int evidenceTotal = premises.Sum(p => p.EvidenceItems?.Count ?? 0);
    int stakeholderCount = stakeholderPositions?.Count ?? 0;

    <!-- ── View Analysis Section (read-only, no Publish button) ────────────── -->
    <div class="mt-5">
        <div class="d-flex align-items-center gap-2 mb-3">
            <h4 class="mb-0"><i class="bi bi-diagram-3 me-2"></i>Full Analysis</h4>
            <span class="badge bg-secondary">Read-only</span>
            @if (adjudication != null)
            {
                <span class="badge bg-@RecClass(adjudication.Recommendation) ms-auto">
                    <i class="bi @RecIcon(adjudication.Recommendation) me-1"></i>@adjudication.Recommendation
                </span>
            }
        </div>

        <ul class="nav nav-tabs mb-0" id="analysisTabs" role="tablist">
            <li class="nav-item" role="presentation">
                <button class="nav-link active" id="analysis-overview-tab" data-bs-toggle="tab"
                        data-bs-target="#analysis-tab-overview" type="button" role="tab" aria-selected="true">
                    <i class="bi bi-bullseye me-1"></i> Overview
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link" id="analysis-evidence-tab" data-bs-toggle="tab"
                        data-bs-target="#analysis-tab-evidence" type="button" role="tab" aria-selected="false">
                    <i class="bi bi-journal-text me-1"></i> Evidence
                    @if (evidenceTotal > 0) { <span class="badge bg-secondary ms-1">@evidenceTotal</span> }
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link" id="analysis-stakeholders-tab" data-bs-toggle="tab"
                        data-bs-target="#analysis-tab-stakeholders" type="button" role="tab" aria-selected="false">
                    <i class="bi bi-people me-1"></i> Stakeholders
                    @if (stakeholderCount > 0) { <span class="badge bg-secondary ms-1">@stakeholderCount</span> }
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link" id="analysis-decision-tab" data-bs-toggle="tab"
                        data-bs-target="#analysis-tab-decision" type="button" role="tab" aria-selected="false">
                    <i class="bi bi-clipboard2-check me-1"></i> Decision
                    @if (adjudication != null)
                    { <span class="badge bg-@RecClass(adjudication.Recommendation) ms-1">@adjudication.Recommendation</span> }
                </button>
            </li>
            @if (ViewBag.ParentArgument != null)
            {
                <li class="nav-item" role="presentation">
                    <button class="nav-link" id="analysis-followup-tab" data-bs-toggle="tab"
                            data-bs-target="#analysis-tab-followup" type="button" role="tab" aria-selected="false">
                        <i class="bi bi-chat-quote me-1"></i> Follow-up Relevance
                        @if (Model.FollowUpRelevanceScore.HasValue)
                        {
                            var relPct = Math.Round(Model.FollowUpRelevanceScore.Value * 100);
                            <span class="badge bg-@(relPct >= 70 ? "success" : relPct >= 40 ? "warning text-dark" : "danger") ms-1">@relPct%</span>
                        }
                    </button>
                </li>
            }
        </ul>

        <div class="tab-content border border-top-0 rounded-bottom bg-white p-4 mb-4" id="analysisTabsContent">

            <!-- ── Overview Tab ────────────────────────────────────────────── -->
            <div class="tab-pane fade show active" id="analysis-tab-overview" role="tabpanel"
                 aria-labelledby="analysis-overview-tab">
                @if (claim == null)
                {
                    <div class="alert alert-warning mb-0">
                        <i class="bi bi-exclamation-triangle me-1"></i>
                        No decomposition available for this argument.
                    </div>
                }
                else
                {
                    <!-- Central claim -->
                    <div class="cu-card mb-4 border-primary border-2">
                        <div class="cu-card-header bg-primary text-white">
                            <i class="bi bi-bullseye me-1"></i> Central Claim
                            @if (!string.IsNullOrWhiteSpace(claim.ClaimType))
                            {
                                <span class="badge bg-light text-dark ms-2">@claim.ClaimType</span>
                            }
                        </div>
                        <div class="cu-card-body">
                            <p class="lead mb-0">@claim.Text</p>
                        </div>
                    </div>

                    <!-- Premises summary (read-only) -->
                    @if (premises.Any())
                    {
                        <div class="cu-card mb-4">
                            <div class="cu-card-header">
                                <i class="bi bi-list-check me-1"></i> Premises
                                <span class="badge bg-secondary ms-1">@premises.Count</span>
                            </div>
                            <div class="list-group list-group-flush">
                                @foreach (var p in premises)
                                {
                                    <div class="list-group-item d-flex align-items-start gap-3 py-3">
                                        <div class="flex-grow-1">
                                            <p class="mb-1">@p.Text</p>
                                            @if (p.EvidenceItems?.Any() == true)
                                            {
                                                <div class="d-flex align-items-center gap-2 mt-1">
                                                    <div class="progress" style="height:5px;width:140px;">
                                                        <div class="progress-bar bg-@ConfBadge(p.ConfidenceScore)"
                                                             style="width:@((p.ConfidenceScore * 100).ToString("F0"))%"></div>
                                                    </div>
                                                    <small class="text-@ConfBadge(p.ConfidenceScore) fw-semibold">
                                                        @p.ConfidenceScore.ToString("P0")
                                                    </small>
                                                    <span class="badge bg-@StatusBadge(p.Status) small">@p.Status</span>
                                                    <small class="text-muted">@(p.EvidenceItems?.Count ?? 0) ev.</small>
                                                </div>
                                            }
                                            else
                                            {
                                                <small class="text-muted"><i class="bi bi-exclamation-circle me-1"></i>No evidence yet</small>
                                            }
                                            @if (!string.IsNullOrWhiteSpace(p.ProvisionalAssessment))
                                            {
                                                <div class="mt-2 p-2 bg-light rounded small">
                                                    <i class="bi bi-robot me-1 text-info"></i>
                                                    <strong>AI assessment</strong>
                                                    <span class="badge bg-@ConfBadge(p.ProvisionalConfidence ?? 0.5) ms-1">@((p.ProvisionalConfidence ?? 0.5).ToString("P0"))</span>
                                                    <span class="text-muted ms-1">—</span>
                                                    @p.ProvisionalAssessment
                                                </div>
                                            }
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    }

                    <!-- Syllogisms -->
                    @if (syllogisms.Any())
                    {
                        <div class="cu-card mb-4">
                            <div class="cu-card-header">
                                <i class="bi bi-arrow-down-right-square me-1"></i> Logical Structure
                                <span class="badge bg-secondary ms-1">@syllogisms.Count</span>
                            </div>
                            <div class="cu-card-body">
                                <div class="row">
                                    @foreach (var (s, idx) in syllogisms.Select((s, i) => (s, i + 1)))
                                    {
                                        <div class="col-lg-6 mb-3">
                                            <div class="card h-100 border-@(s.IsValidForm ? "success" : "danger")">
                                                <div class="card-header d-flex justify-content-between align-items-center py-2">
                                                    <span><strong>@idx</strong> — @s.InferenceType</span>
                                                    <span class="badge bg-@(s.IsValidForm ? "success" : "danger")">
                                                        <i class="bi bi-@(s.IsValidForm ? "check" : "x")-circle me-1"></i>
                                                        @(s.IsValidForm ? "Valid" : "Issue")
                                                    </span>
                                                </div>
                                                <div class="card-body small">
                                                    <div class="mb-2">
                                                        <span class="text-muted text-uppercase" style="font-size:.68rem;letter-spacing:.04em;">Major</span><br>@s.MajorPremise
                                                    </div>
                                                    <div class="mb-2">
                                                        <span class="text-muted text-uppercase" style="font-size:.68rem;letter-spacing:.04em;">Minor</span><br>@s.MinorPremise
                                                    </div>
                                                    <div class="pt-2 border-top">
                                                        <span class="text-muted text-uppercase" style="font-size:.68rem;letter-spacing:.04em;">∴ Conclusion</span><br>
                                                        <strong>@s.Conclusion</strong>
                                                    </div>
                                                    @if (!string.IsNullOrWhiteSpace(s.FallaciesDetected))
                                                    {
                                                        <div class="alert alert-warning mb-0 mt-2 py-1 small">
                                                            <i class="bi bi-exclamation-triangle me-1"></i>@s.FallaciesDetected
                                                        </div>
                                                    }
                                                </div>
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    }

                    <!-- Assumptions / Qualifiers / Rebuttals -->
                    @if (assumptions.Any() || qualifiers.Any() || rebuttals.Any())
                    {
                        <div class="row mb-4">
                            @if (assumptions.Any())
                            {
                                <div class="col-lg-4 mb-3">
                                    <div class="cu-card h-100">
                                        <div class="cu-card-header">
                                            <i class="bi bi-eye-slash me-1"></i> Hidden Assumptions
                                            <span class="badge bg-secondary ms-1">@assumptions.Count</span>
                                        </div>
                                        <ul class="list-group list-group-flush">
                                            @foreach (var a in assumptions)
                                            {
                                                <li class="list-group-item">
                                                    @if (a.IsCritical) { <span class="badge bg-danger me-1">Critical</span> }
                                                    @a.Text
                                                </li>
                                            }
                                        </ul>
                                    </div>
                                </div>
                            }
                            @if (qualifiers.Any())
                            {
                                <div class="col-lg-4 mb-3">
                                    <div class="cu-card h-100">
                                        <div class="cu-card-header">
                                            <i class="bi bi-funnel me-1"></i> Qualifiers &amp; Scope
                                            <span class="badge bg-secondary ms-1">@qualifiers.Count</span>
                                        </div>
                                        <ul class="list-group list-group-flush">
                                            @foreach (var q in qualifiers)
                                            {
                                                <li class="list-group-item">
                                                    @if (!string.IsNullOrWhiteSpace(q.QualifierType)) { <span class="badge bg-info text-dark me-1">@q.QualifierType</span> }
                                                    @q.Text
                                                </li>
                                            }
                                        </ul>
                                    </div>
                                </div>
                            }
                            @if (rebuttals.Any())
                            {
                                <div class="col-lg-4 mb-3">
                                    <div class="cu-card h-100">
                                        <div class="cu-card-header">
                                            <i class="bi bi-shield-exclamation me-1"></i> Rebuttals &amp; Defeaters
                                            <span class="badge bg-secondary ms-1">@rebuttals.Count</span>
                                        </div>
                                        <ul class="list-group list-group-flush">
                                            @foreach (var r in rebuttals)
                                            {
                                                var sc = r.Strength?.ToLower() switch { "high" => "danger", "medium" => "warning", _ => "secondary" };
                                                <li class="list-group-item">
                                                    @if (!string.IsNullOrWhiteSpace(r.Strength)) { <span class="badge bg-@sc me-1">@r.Strength</span> }
                                                    @r.Text
                                                </li>
                                            }
                                        </ul>
                                    </div>
                                </div>
                            }
                        </div>
                    }

                    <!-- Original text (collapsed) -->
                    <div class="cu-card">
                        <div class="cu-card-header d-flex justify-content-between">
                            <span><i class="bi bi-file-text me-1"></i> Original Argument Text</span>
                            <button class="btn btn-sm btn-outline-secondary"
                                    data-bs-toggle="collapse" data-bs-target="#analysisOriginalText">
                                <i class="bi bi-chevron-down"></i>
                            </button>
                        </div>
                        <div class="collapse" id="analysisOriginalText">
                            <div class="cu-card-body">
                                <p class="mb-1 text-muted small">
                                    Submitted @sourceArg.CreatedAt.ToString("MMMM d, yyyy")
                                    @if (!string.IsNullOrWhiteSpace(sourceArg.SubmittedBy))
                                    {
                                        <span>by <strong>@sourceArg.SubmittedBy</strong></span>
                                    }
                                </p>
                                <hr />
                                <p class="mb-0" style="white-space:pre-wrap;">@sourceArg.RawText</p>
                            </div>
                        </div>
                    </div>
                }
            </div>

            <!-- ── Evidence Tab (read-only) ────────────────────────────────── -->
            <div class="tab-pane fade" id="analysis-tab-evidence" role="tabpanel"
                 aria-labelledby="analysis-evidence-tab">
                @if (!premises.Any())
                {
                    <div class="text-center py-5">
                        <i class="bi bi-journal-text display-4 text-muted mb-3 d-block"></i>
                        <p class="text-muted">No premises available for this argument.</p>
                    </div>
                }
                else
                {
                    <p class="text-muted mb-4">
                        <i class="bi bi-info-circle me-1"></i> Read-only view of evidence attached to each premise.
                    </p>
                    @foreach (var p in premises)
                    {
                        var evCount = p.EvidenceItems?.Count ?? 0;
                        <div class="cu-card mb-4">
                            <div class="cu-card-header d-flex justify-content-between align-items-center">
                                <div class="flex-grow-1 me-3">
                                    <span class="fw-semibold">@p.Text</span>
                                    @if (evCount > 0)
                                    {
                                        <div class="d-flex align-items-center gap-2 mt-1">
                                            <div class="progress" style="height:5px;width:120px;">
                                                <div class="progress-bar bg-@ConfBadge(p.ConfidenceScore)"
                                                     style="width:@((p.ConfidenceScore * 100).ToString("F0"))%"></div>
                                            </div>
                                            <small class="text-@ConfBadge(p.ConfidenceScore) fw-semibold">@p.ConfidenceScore.ToString("P0")</small>
                                            <span class="badge bg-@StatusBadge(p.Status) small">@p.Status</span>
                                        </div>
                                    }
                                </div>
                            </div>
                            <div class="cu-card-body p-0">
                                @if (evCount > 0)
                                {
                                    <div class="table-responsive">
                                        <table class="table table-sm table-hover mb-0">
                                            <thead class="table-light">
                                                <tr>
                                                    <th style="width:30px;"></th>
                                                    <th>Citation</th>
                                                    <th>Tier</th>
                                                    <th>Year</th>
                                                    <th>n=</th>
                                                    <th>Replication</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @foreach (var ev in p.EvidenceItems!)
                                                {
                                                    var dirIcon = ev.Direction switch
                                                    {
                                                        CommonUnderstanding.Models.EvidenceDirection.Supports => "bi-arrow-up-circle-fill text-success",
                                                        CommonUnderstanding.Models.EvidenceDirection.Opposes  => "bi-arrow-down-circle-fill text-danger",
                                                        _ => "bi-dash-circle text-secondary"
                                                    };
                                                    <tr>
                                                        <td class="text-center"><i class="bi @dirIcon"></i></td>
                                                        <td>
                                                            @if (!string.IsNullOrWhiteSpace(ev.SourceUri))
                                                            {
                                                                <a href="@ev.SourceUri" target="_blank" rel="noopener noreferrer nofollow">@ev.Citation</a>
                                                            }
                                                            else { @ev.Citation }
                                                            @if (!string.IsNullOrWhiteSpace(ev.DOI))
                                                            {
                                                                <small class="text-muted d-block">DOI: @ev.DOI</small>
                                                            }
                                                        </td>
                                                        <td><span class="badge bg-light text-dark border">@ev.Tier</span></td>
                                                        <td>@ev.PublicationYear</td>
                                                        <td>@ev.SampleSize?.ToString("N0")</td>
                                                        <td><small class="text-muted">@ev.ReplicationStatus</small></td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                }
                                else
                                {
                                    <div class="p-3 text-muted small">
                                        <i class="bi bi-exclamation-circle me-1"></i> No evidence yet for this premise.
                                    </div>
                                }
                            </div>
                        </div>
                    }
                }
            </div>

            <!-- ── Stakeholders Tab (read-only) ───────────────────────────── -->
            <div class="tab-pane fade" id="analysis-tab-stakeholders" role="tabpanel"
                 aria-labelledby="analysis-stakeholders-tab">
                @if (stakeholderConsensus != null && stakeholderConsensus.TotalResponses > 0)
                {
                    var total = stakeholderConsensus.TotalResponses;
                    double suppPct = (double)stakeholderConsensus.SupportCount  / total * 100;
                    double oppPct  = (double)stakeholderConsensus.OpposeCount   / total * 100;
                    double undPct  = (double)stakeholderConsensus.UndecidedCount / total * 100;
                    <div class="cu-card mb-4">
                        <div class="cu-card-header"><i class="bi bi-bar-chart-horizontal me-1"></i> Stakeholder Consensus</div>
                        <div class="cu-card-body">
                            <div class="d-flex justify-content-between small mb-1">
                                <span><i class="bi bi-hand-thumbs-up-fill text-success me-1"></i>Support: @stakeholderConsensus.SupportCount</span>
                                <span><i class="bi bi-hand-thumbs-down-fill text-danger me-1"></i>Oppose: @stakeholderConsensus.OpposeCount</span>
                                <span><i class="bi bi-question-circle text-secondary me-1"></i>Undecided: @stakeholderConsensus.UndecidedCount</span>
                            </div>
                            <div class="progress mb-2" style="height:12px;">
                                <div class="progress-bar bg-success" style="width:@suppPct.ToString("F0")%"></div>
                                <div class="progress-bar bg-danger"  style="width:@oppPct.ToString("F0")%"></div>
                                <div class="progress-bar bg-secondary" style="width:@undPct.ToString("F0")%"></div>
                            </div>
                            @if (stakeholderConsensus.HasConsensus)
                            {
                                <span class="badge bg-success">Consensus: @stakeholderConsensus.MajorityPosition</span>
                            }
                            else
                            {
                                <span class="badge bg-warning text-dark">No consensus reached</span>
                            }
                        </div>
                    </div>
                }

                @if (stakeholderPositions?.Any() == true)
                {
                    <div class="cu-card mb-4">
                        <div class="cu-card-header">
                            <i class="bi bi-person-lines-fill me-1"></i> Registered Positions
                            <span class="badge bg-secondary ms-1">@stakeholderPositions.Count</span>
                        </div>
                        <div class="list-group list-group-flush">
                            @foreach (var pos in stakeholderPositions)
                            {
                                var pc = pos.Position switch
                                {
                                    CommonUnderstanding.Models.StakeholderPositionType.Support => "success",
                                    CommonUnderstanding.Models.StakeholderPositionType.Oppose  => "danger",
                                    _ => "secondary"
                                };
                                <div class="list-group-item py-2">
                                    <div class="d-flex align-items-start gap-2">
                                        <span class="badge bg-@pc mt-1 flex-shrink-0">@pos.Position</span>
                                        <div>
                                            <strong>
                                                @if (pos.IsAnonymous || pos.StakeholderRef == null)
                                                {
                                                    <span class="text-muted">Anonymous</span>
                                                }
                                                else
                                                {
                                                    @pos.StakeholderRef.Name
                                                    if (!string.IsNullOrWhiteSpace(pos.StakeholderRef.Role))
                                                    {
                                                        <span class="fw-normal text-muted">, @pos.StakeholderRef.Role</span>
                                                    }
                                                    if (!string.IsNullOrWhiteSpace(pos.StakeholderRef.Organization))
                                                    {
                                                        <span class="fw-normal text-muted"> (@pos.StakeholderRef.Organization)</span>
                                                    }
                                                }
                                            </strong>
                                            @if (!string.IsNullOrWhiteSpace(pos.Reasoning))
                                            {
                                                <p class="mb-0 text-muted small">@pos.Reasoning</p>
                                            }
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                }
                else
                {
                    <div class="text-center py-4 text-muted">
                        <i class="bi bi-people display-6 mb-2 d-block"></i>
                        <p class="mb-0">No stakeholder positions recorded for this argument.</p>
                    </div>
                }
            </div>

            <!-- ── Decision Tab (read-only) ────────────────────────────────── -->
            <div class="tab-pane fade" id="analysis-tab-decision" role="tabpanel"
                 aria-labelledby="analysis-decision-tab">
                @if (ds != null)
                {
                    <div class="cu-card mb-4 border-@RecClass(ds.FinalRecommendation) border-2">
                        <div class="cu-card-header bg-@RecClass(ds.FinalRecommendation) text-white fs-5">
                            <i class="bi @RecIcon(ds.FinalRecommendation) me-2"></i>
                            Recommendation: <strong>@ds.FinalRecommendation</strong>
                            <span class="badge bg-white text-@RecClass(ds.FinalRecommendation) ms-2">@ds.ConfidenceLevel Confidence</span>
                        </div>
                        <div class="cu-card-body">
                            <div class="row align-items-center mb-3">
                                <div class="col-auto">
                                    <div class="text-center">
                                        <div class="display-4 fw-bold text-@ConfBadge(ds.BaseConfidence)">@ds.BaseConfidence.ToString("P0")</div>
                                        <div class="text-muted small">Evidence Confidence</div>
                                    </div>
                                </div>
                                <div class="col">
                                    <div class="progress mb-2" style="height:14px;">
                                        <div class="progress-bar bg-@ConfBadge(ds.BaseConfidence)"
                                             style="width:@((ds.BaseConfidence * 100).ToString("F0"))%"></div>
                                    </div>
                                    <p class="text-muted small mb-0">@ds.ReasoningTrace</p>
                                </div>
                            </div>

                            @if (!string.IsNullOrWhiteSpace(adjudication?.DetailedNarrative))
                            {
                                <div class="mt-3 p-3 bg-light rounded">
                                    <h6 class="text-uppercase text-muted small mb-2"><i class="bi bi-chat-quote me-1"></i>Detailed Narrative</h6>
                                    <p class="mb-0 small">@adjudication.DetailedNarrative</p>
                                </div>
                            }

                            @if (!string.IsNullOrWhiteSpace(adjudication?.EvidenceGapsJson) || !string.IsNullOrWhiteSpace(adjudication?.ConflictingEvidenceJson))
                            {
                                <div class="row mt-3">
                                    @if (!string.IsNullOrWhiteSpace(adjudication.EvidenceGapsJson))
                                    {
                                        <div class="col-md-6 mb-2">
                                            <div class="p-3 bg-warning bg-opacity-10 rounded h-100">
                                                <h6 class="text-warning small text-uppercase mb-2"><i class="bi bi-exclamation-triangle me-1"></i>Evidence Gaps</h6>
                                                <p class="small mb-0">@adjudication.EvidenceGapsJson</p>
                                            </div>
                                        </div>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(adjudication.ConflictingEvidenceJson))
                                    {
                                        <div class="col-md-6 mb-2">
                                            <div class="p-3 bg-danger bg-opacity-10 rounded h-100">
                                                <h6 class="text-danger small text-uppercase mb-2"><i class="bi bi-shuffle me-1"></i>Conflicting Evidence</h6>
                                                <p class="small mb-0">@adjudication.ConflictingEvidenceJson</p>
                                            </div>
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    </div>
                }
                else
                {
                    <div class="text-center py-5">
                        <i class="bi bi-clipboard2-x display-4 text-muted mb-3 d-block"></i>
                        <p class="text-muted">Decision support not available for this argument.</p>
                    </div>
                }
            </div>

            <!-- ── Follow-up Relevance Tab ────────────────────────────────── -->
            @if (ViewBag.ParentArgument != null)
            {
                var parentArg = ViewBag.ParentArgument as CommonUnderstanding.Models.Social.SocialArgument;
                <div class="tab-pane fade" id="analysis-tab-followup" role="tabpanel"
                     aria-labelledby="analysis-followup-tab">
                    @if (parentArg != null)
                    {
                        <div class="cu-card mb-4 border-info border-2">
                            <div class="cu-card-header bg-info text-white">
                                <i class="bi bi-arrow-return-left me-1"></i> Reply to: @parentArg.Title
                            </div>
                            <div class="cu-card-body">
                                <p class="mb-0">
                                    <strong>Claim:</strong> @parentArg.ClaimProposition?.Text
                                </p>
                                @if (!string.IsNullOrWhiteSpace(parentArg.WarrantText))
                                {
                                    <p class="mb-0 mt-2 text-muted small">
                                        <strong>Warrant:</strong> @parentArg.WarrantText
                                    </p>
                                }
                                <a asp-action="Detail" asp-route-id="@parentArg.Id" class="btn btn-sm btn-outline-info mt-2">
                                    <i class="bi bi-box-arrow-up-right me-1"></i> View parent argument
                                </a>
                            </div>
                        </div>

                        @if (Model.FollowUpRelevanceScore.HasValue)
                        {
                            var relPct = Math.Round(Model.FollowUpRelevanceScore.Value * 100);
                            var relColor = relPct >= 70 ? "success" : relPct >= 40 ? "warning text-dark" : "danger";
                            <div class="cu-card mb-4">
                                <div class="cu-card-header">
                                    <i class="bi bi-graph-up-arrow me-1"></i> Relevance Assessment
                                </div>
                                <div class="cu-card-body">
                                    <div class="d-flex align-items-center gap-3 mb-3">
                                        <div class="text-center">
                                            <div class="display-3 fw-bold text-@relColor">@relPct%</div>
                                            <div class="text-muted small">Relevance Score</div>
                                        </div>
                                        <div class="flex-grow-1">
                                            <div class="progress" style="height:16px;">
                                                <div class="progress-bar bg-@relColor"
                                                     style="width:@relPct%"></div>
                                            </div>
                                        </div>
                                    </div>
                                    @if (!string.IsNullOrWhiteSpace(Model.FollowUpEffectivenessNotes))
                                    {
                                        <div class="mt-3 p-3 bg-light rounded">
                                            <h6 class="text-uppercase text-muted small mb-2">
                                                <i class="bi bi-chat-quote me-1"></i>AI Assessment Notes
                                            </h6>
                                            <p class="mb-0 small">@Model.FollowUpEffectivenessNotes</p>
                                        </div>
                                    }
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="text-center py-4 text-muted">
                                <i class="bi bi-hourglass-split display-6 mb-2 d-block"></i>
                                <p class="mb-0">Relevance assessment pending. The AI will evaluate this reply shortly.</p>
                            </div>
                        }
                    }
                </div>
            }
        </div>
    </div>
}

<div id="replies" class="mt-5">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h5 class="mb-0">
            <i class="bi bi-chat-left me-2"></i>Replies
            <span class="badge bg-secondary ms-2">@Model.ReplyCount</span>
        </h5>
        <button class="btn btn-sm btn-outline-primary" id="showReplyFormBtn">
            <i class="bi bi-plus-circle me-1"></i>Add Reply
        </button>
    </div>

    <!-- Reply Form (initially hidden) -->
    <div id="replyFormContainer" class="mb-4" style="display: none;">
        <div class="card">
            <div class="card-body">
                <h6 class="card-title mb-3">Add a Follow-up Argument</h6>
                <form id="replyForm">
                    <!-- Primary field: warrant/evidence text -->
                    <div class="mb-3">
                        <label for="replyWarrant" class="form-label">Your response *</label>
                        <textarea class="form-control" id="replyWarrant" rows="4" 
                                  placeholder="Write your reply argument here..." maxlength="5000" required></textarea>
                        <div class="d-flex justify-content-between mt-1">
                            <span class="form-text">This is the main content of your reply</span>
                            <span class="form-text"><span id="charCount">0</span> / 5000</span>
                        </div>
                    </div>

                    <!-- Collapsed optional fields -->
                    <div id="replyOptionalFields" style="display: none;">
                        <hr class="my-3">
                        <div class="mb-3">
                            <label for="replyTitle" class="form-label">Title</label>
                            <input type="text" class="form-control" id="replyTitle" 
                                   placeholder="Brief title for your reply" maxlength="300">
                            <div class="form-text">Summarize your response in a few words</div>
                        </div>
                        
                        <div class="mb-3">
                            <label for="replyClaim" class="form-label">Claim</label>
                            <textarea class="form-control" id="replyClaim" rows="2" 
                                      placeholder="The main claim of your reply argument" maxlength="500"></textarea>
                        </div>
                        
                        <div class="mb-3">
                            <label for="replyResolution" class="form-label">Resolution</label>
                            <textarea class="form-control" id="replyResolution" rows="2" 
                                      placeholder="Conclusion or resolution of your argument" maxlength="2000"></textarea>
                        </div>
                        
                        <div class="mb-3">
                            <label for="replyTags" class="form-label">Tags</label>
                            <input type="text" class="form-control" id="replyTags" 
                                   placeholder="comma,separated,tags">
                            <div class="form-text">Add relevant tags to categorize your reply</div>
                        </div>
                        
                        <div class="mb-3">
                            <label for="replyAnnotation" class="form-label">Annotation</label>
                            <textarea class="form-control" id="replyAnnotation" rows="2" 
                                      placeholder="Explain how this relates to the parent argument" maxlength="500"></textarea>
                        </div>
                    </div>
                    
                    <div class="d-flex justify-content-between align-items-center mt-3">
                        <button type="button" class="btn btn-sm btn-link text-decoration-none p-0" id="toggleDetailsBtn">
                            <i class="bi bi-plus-circle me-1"></i><span id="toggleDetailsText">Add details</span>
                        </button>
                        <div>
                            <button type="button" class="btn btn-outline-secondary me-2" id="cancelReplyBtn">
                                Cancel
                            </button>
                            <button type="submit" class="btn btn-primary" id="submitReplyBtn">
                                <span class="spinner-border spinner-border-sm d-none" role="status"></span>
                                Post Reply
                            </button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Replies List -->
    <div id="repliesList" class="mb-4">
        <div class="text-center py-4">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Loading replies...</span>
            </div>
        </div>
    </div>

    <!-- Load More Button -->
    <div class="text-center">
        <button id="loadMoreRepliesBtn" class="btn btn-outline-secondary btn-sm" style="display: none;">
            Load more replies
        </button>
    </div>
</div>

@section Scripts {
<!-- ── Vote Modal ─────────────────────────────────────────────────────────── -->
<div class="modal fade" id="voteModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-sm">
        <div class="modal-content">
            <div class="modal-header">
                <h6 class="modal-title" id="voteModalTitle">Cast Vote</h6>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p class="small text-muted mb-2">Select your rationale:</p>
                <div class="vote-modal-reason d-flex flex-column gap-2">
                    <label class="d-flex align-items-center gap-2">
                        <input type="radio" name="voteRationale" value="WellSourced" checked />
                        <span>Well Sourced</span>
                    </label>
                    <label class="d-flex align-items-center gap-2">
                        <input type="radio" name="voteRationale" value="LogicallyValid" />
                        <span>Logically Valid</span>
                    </label>
                    <label class="d-flex align-items-center gap-2">
                        <input type="radio" name="voteRationale" value="ChangedMyView" />
                        <span>Changed My View</span>
                    </label>
                    <label class="d-flex align-items-center gap-2">
                        <input type="radio" name="voteRationale" value="Fallacious" />
                        <span>Fallacious</span>
                    </label>
                    <label class="d-flex align-items-center gap-2">
                        <input type="radio" name="voteRationale" value="OffTopic" />
                        <span>Off Topic</span>
                    </label>
                </div>
                <textarea id="voteComment" class="form-control mt-3" rows="2"
                          placeholder="Optional comment…" maxlength="500"></textarea>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-sm btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                <button id="submitVoteBtn" class="btn btn-sm btn-success">
                    <i class="bi bi-hand-thumbs-up"></i> Submit Upvote
                </button>
            </div>
        </div>
    </div>
</div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.0/signalr.min.js"></script>
<script>
(function () {
    'use strict';

    const argId = '@Model.Id';

    // ── SignalR ───────────────────────────────────────────────────────────────
    const hubConn = new signalR.HubConnectionBuilder()
        .withUrl('/hubs/voting')
        .withAutomaticReconnect()
        .build();

    hubConn.on('VoteScoreUpdated', tally => {
        if (tally.argumentId !== argId) return;
        updateTally(tally);
    });

    hubConn.on('VoteCastConfirmed', data => {
        if (data.argumentId !== argId) return;
        updateTally(data.newTally, data.vote);
    });

    hubConn.on('VoteRejected', data => {
        alert('Vote rejected: ' + (data.reason || 'Unknown error'));
    });

    hubConn.on('ReplyCountUpdated', data => {
        if (data.argumentId !== argId) return;
        const badge = document.querySelector('#replies h5 .badge');
        if (badge) {
            badge.textContent = data.newCount;
        }
    });

    async function startHub() {
        try {
            await hubConn.start();
            await hubConn.invoke('SubscribeToArgument', argId);
        } catch (e) { console.warn('VotingHub unavailable:', e); }
    }
    startHub();

    function updateTally(tally, newVote) {
        const upEl   = document.querySelector('.upvote-count');
        const downEl = document.querySelector('.downvote-count');
        const fill   = document.querySelector('.wilson-fill');
        const upBtn  = document.querySelector('.btn-outline-success');
        const downBtn = document.querySelector('.btn-outline-danger');
        if (upEl)   upEl.textContent   = tally.upvotes ?? 0;
        if (downEl) downEl.textContent = tally.downvotes ?? 0;
        if (fill)   fill.style.width   = Math.round((tally.wilsonScore || 0) * 100) + '%';
        if (newVote !== undefined) {
            upBtn?.classList.toggle('active-up', newVote === 'Up');
            downBtn?.classList.toggle('active-down', newVote === 'Down');
        }
    }

    // ── Vote modal ────────────────────────────────────────────────────────────
    let pendingVoteValue = null;

    document.querySelectorAll('.vote-trigger').forEach(btn => {
        btn.addEventListener('click', () => {
            pendingVoteValue = btn.dataset.vote;

            const isUpvote = pendingVoteValue === 'Up';
            document.getElementById('voteModalTitle').textContent = isUpvote ? 'Upvote Argument' : 'Downvote Argument';
            document.getElementById('submitVoteBtn').innerHTML = isUpvote
                ? '<i class="bi bi-hand-thumbs-up"></i> Submit Upvote'
                : '<i class="bi bi-hand-thumbs-down"></i> Submit Downvote';
            document.getElementById('submitVoteBtn').className = isUpvote
                ? 'btn btn-sm btn-success'
                : 'btn btn-sm btn-outline-danger';

            const modal = new bootstrap.Modal(document.getElementById('voteModal'));
            modal.show();
        });
    });

    async function castVote() {
        if (!pendingVoteValue) return;
        const rationale = document.querySelector('input[name="voteRationale"]:checked')?.value || 'WellSourced';
        const comment   = document.getElementById('voteComment').value.trim();

        try {
            const res = await fetch('/api/votes', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    argumentId: argId,
                    vote: pendingVoteValue,
                    rationale: rationale,
                    comment: comment
                })
            });
            if (!res.ok) {
                const err = await res.json();
                alert('Vote failed: ' + (err.message || res.statusText));
            }
        } catch (e) {
            console.error('Vote failed:', e);
        }

        bootstrap.Modal.getInstance(document.getElementById('voteModal'))?.hide();
        pendingVoteValue = null;
    }

    document.getElementById('submitVoteBtn')?.addEventListener('click', () => castVote());

    // ── Reply functionality ──────────────────────────────────────────────────
    let replySkip = 0;
    const REPLY_PAGE_SIZE = 20;
    let totalReplies = @Model.ReplyCount;

    // Character counter for warrant text
    const warrantTextarea = document.getElementById('replyWarrant');
    const charCount = document.getElementById('charCount');
    
    if (warrantTextarea && charCount) {
        warrantTextarea.addEventListener('input', () => {
            charCount.textContent = warrantTextarea.value.length;
        });
    }

    // Show/hide reply form
    document.getElementById('showReplyFormBtn')?.addEventListener('click', () => {
        const formContainer = document.getElementById('replyFormContainer');
        formContainer.style.display = formContainer.style.display === 'none' ? 'block' : 'none';
    });

    document.getElementById('cancelReplyBtn')?.addEventListener('click', () => {
        document.getElementById('replyFormContainer').style.display = 'none';
        document.getElementById('replyForm').reset();
        charCount.textContent = '0';
        // Reset optional fields to collapsed
        document.getElementById('replyOptionalFields').style.display = 'none';
        document.getElementById('toggleDetailsText').textContent = 'Add details';
        document.querySelector('#toggleDetailsBtn i').className = 'bi bi-plus-circle me-1';
    });

    // Toggle optional details fields
    document.getElementById('toggleDetailsBtn')?.addEventListener('click', () => {
        const optionalFields = document.getElementById('replyOptionalFields');
        const isHidden = optionalFields.style.display === 'none';
        optionalFields.style.display = isHidden ? 'block' : 'none';
        document.getElementById('toggleDetailsText').textContent = isHidden ? 'Hide details' : 'Add details';
        document.querySelector('#toggleDetailsBtn i').className = isHidden ? 'bi bi-dash-circle me-1' : 'bi bi-plus-circle me-1';
    });

    // Load replies
    async function loadReplies(reset = false) {
        if (reset) {
            replySkip = 0;
            document.getElementById('repliesList').innerHTML = `
                <div class="text-center py-4">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">Loading replies...</span>
                    </div>
                </div>`;
        }

        try {
            const response = await fetch(`/api/arguments/${argId}/follow-ups?skip=${replySkip}&take=${REPLY_PAGE_SIZE}`);
            if (!response.ok) throw new Error('Failed to load replies');
            
            const data = await response.json();
            totalReplies = data.parentReplyCount || data.totalCount || 0;
            
            if (reset) {
                document.getElementById('repliesList').innerHTML = '';
            }
            
            if (data.arguments && data.arguments.length > 0) {
                data.arguments.forEach(reply => {
                    document.getElementById('repliesList').insertAdjacentHTML('beforeend', renderReply(reply));
                });
                
                replySkip += data.arguments.length;
                
                // Show/hide load more button
                const loadMoreBtn = document.getElementById('loadMoreRepliesBtn');
                if (replySkip < totalReplies) {
                    loadMoreBtn.style.display = 'block';
                } else {
                    loadMoreBtn.style.display = 'none';
                }
            } else if (replySkip === 0) {
                document.getElementById('repliesList').innerHTML = `
                    <div class="text-center py-4 text-muted">
                        <i class="bi bi-chat-left" style="font-size: 2rem;"></i>
                        <p class="mt-2">No replies yet. Be the first to respond!</p>
                    </div>`;
            }
        } catch (error) {
            console.error('Error loading replies:', error);
            document.getElementById('repliesList').innerHTML = `
                <div class="alert alert-danger">
                    Failed to load replies. Please try again.
                </div>`;
        }
    }

    // Render a single reply (with nested thread support)
    function renderReply(reply, depth = 0) {
        const wilson = Math.round((reply.wilsonScore || 0) * 100);
        const timeAgo = new Date(reply.createdAt).toLocaleDateString();
        const tagsHtml = (reply.tags || []).map(tag => 
            `<span class="badge bg-secondary me-1">${escapeHtml(tag)}</span>`
        ).join('');
        const hasReplies = (reply.replyCount || 0) > 0;
        
        // AI validation badge
        const aiBadge = reply.isAIValidated && reply.aiValidityScore != null
            ? `<span class="badge ${reply.aiValidityScore >= 0.7 ? 'bg-success' : reply.aiValidityScore >= 0.4 ? 'bg-warning text-dark' : 'bg-danger'} ms-2" style="font-size:0.65rem;">
                   <i class="bi bi-cpu"></i> ${Math.round(reply.aiValidityScore * 100)}%
               </span>`
            : '';
        
        // Follow-up relevance badge (only for replies that have been assessed)
        const relevanceBadge = reply.followUpRelevanceScore != null
            ? (() => {
                const pct = Math.round(reply.followUpRelevanceScore * 100);
                const color = pct >= 70 ? 'success' : pct >= 40 ? 'warning text-dark' : 'danger';
                return `<span class="badge bg-${color} ms-1" style="font-size:0.65rem;" title="${escapeHtml(reply.followUpEffectivenessNotes || '')}">
                           <i class="bi bi-chat-quote"></i> Rel: ${pct}%
                       </span>`;
              })()
            : '';
        const marginLeft = Math.min(depth * 24, 96); // Indent up to 4 levels
        
        return `
        <div class="reply-thread" style="margin-left: ${marginLeft}px;">
            <div class="card mb-2" id="reply-${reply.id}">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-start mb-2">
                        <h6 class="card-title mb-0">${escapeHtml(reply.title)}${aiBadge}${relevanceBadge}</h6>
                        <small class="text-muted">${timeAgo}</small>
                    </div>
                    
                    ${reply.claimProposition ? `
                    <div class="mb-2 p-2 bg-light rounded">
                        <strong>Claim:</strong> ${escapeHtml(reply.claimProposition.text)}
                    </div>` : ''}
                    
                    <p class="card-text">${escapeHtml(reply.warrantText || '')}</p>
                    
                    ${reply.resolutionText ? `
                    <div class="mt-2 p-2 bg-info bg-opacity-10 rounded">
                        <strong>Resolution:</strong> ${escapeHtml(reply.resolutionText)}
                    </div>` : ''}
                    
                    ${tagsHtml ? `<div class="mt-2">${tagsHtml}</div>` : ''}
                    
                    <div class="d-flex align-items-center gap-3 mt-3">
                        <div class="vote-bar">
                            <button class="btn btn-sm btn-outline-success vote-trigger" data-id="${reply.id}" data-vote="Up">
                                <i class="bi bi-hand-thumbs-up"></i>
                                <span class="upvote-count">${reply.upvoteCount || 0}</span>
                            </button>
                            <button class="btn btn-sm btn-outline-danger vote-trigger" data-id="${reply.id}" data-vote="Down">
                                <i class="bi bi-hand-thumbs-down"></i>
                                <span class="downvote-count">${reply.downvoteCount || 0}</span>
                            </button>
                            <a href="/SocialView/Detail/${reply.id}" class="btn btn-sm btn-outline-secondary">
                                <i class="bi bi-chat-left"></i>
                                <span class="reply-count">${reply.replyCount || 0}</span>
                            </a>
                            <a href="/SocialView/Detail/${reply.id}" class="btn btn-sm btn-outline-info" title="View full analysis">
                                <i class="bi bi-diagram-3"></i> View Analysis
                            </a>
                        </div>
                        <div class="flex-grow-1">
                            <div class="wilson-bar">
                                <div class="wilson-fill" style="width:${wilson}%"></div>
                            </div>
                        </div>
                        ${hasReplies ? `
                        <button class="btn btn-sm btn-outline-info toggle-nested" data-reply-id="${reply.id}" title="Toggle nested replies">
                            <i class="bi bi-arrows-collapse"></i>
                        </button>` : ''}
                    </div>
                </div>
            </div>
            ${hasReplies ? `
            <div class="nested-replies" id="nested-${reply.id}" style="display: none;">
                <div class="text-center py-2">
                    <div class="spinner-border spinner-border-sm text-primary" role="status">
                        <span class="visually-hidden">Loading nested replies...</span>
                    </div>
                </div>
            </div>` : ''}
        </div>`;
    }

    // Load nested replies for a specific reply
    async function loadNestedReplies(replyId, depth = 1) {
        const container = document.getElementById(`nested-${replyId}`);
        if (!container) return;
        
        // If already loaded, just toggle visibility
        if (container.dataset.loaded === 'true') {
            container.style.display = container.style.display === 'none' ? 'block' : 'none';
            const btn = document.querySelector(`.toggle-nested[data-reply-id="${replyId}"] i`);
            if (btn) {
                btn.className = container.style.display === 'none' 
                    ? 'bi bi-arrows-collapse' 
                    : 'bi bi-arrows-expand';
            }
            return;
        }
        
        try {
            const response = await fetch(`/api/arguments/${replyId}/follow-ups?skip=0&take=20`);
            if (!response.ok) throw new Error('Failed to load nested replies');
            
            const data = await response.json();
            
            if (data.arguments && data.arguments.length > 0) {
                container.innerHTML = '';
                data.arguments.forEach(nestedReply => {
                    container.insertAdjacentHTML('beforeend', renderReply(nestedReply, depth));
                });
            } else {
                container.innerHTML = '<div class="text-muted small py-1 ps-3">No further replies</div>';
            }
            
            container.dataset.loaded = 'true';
            container.style.display = 'block';
            
            const btn = document.querySelector(`.toggle-nested[data-reply-id="${replyId}"] i`);
            if (btn) btn.className = 'bi bi-arrows-expand';
            
        } catch (error) {
            console.error('Error loading nested replies:', error);
            container.innerHTML = '<div class="text-danger small py-1 ps-3">Failed to load replies</div>';
            container.style.display = 'block';
        }
    }

    // Delegate click events for nested reply toggles
    document.getElementById('repliesList')?.addEventListener('click', (e) => {
        const toggleBtn = e.target.closest('.toggle-nested');
        if (toggleBtn) {
            const replyId = toggleBtn.dataset.replyId;
            loadNestedReplies(replyId, 1);
        }
    });

    // Submit reply form
    document.getElementById('replyForm')?.addEventListener('submit', async (e) => {
        e.preventDefault();
        
        const submitBtn = document.getElementById('submitReplyBtn');
        const spinner = submitBtn.querySelector('.spinner-border');
        const originalText = submitBtn.textContent;
        
        submitBtn.disabled = true;
        spinner.classList.remove('d-none');
        
        try {
            const warrantText = document.getElementById('replyWarrant').value.trim();
            if (!warrantText) {
                alert('Please enter your reply text.');
                return;
            }
            
            // Auto-generate a title from the first few words of the warrant
            const titleInput = document.getElementById('replyTitle').value.trim();
            const title = titleInput || warrantText.split(/\s+/).slice(0, 8).join(' ') + (warrantText.split(/\s+/).length > 8 ? '...' : '');
            
            const tags = document.getElementById('replyTags').value
                .split(',')
                .map(tag => tag.trim())
                .filter(tag => tag.length > 0);
            
            const replyData = {
                title: title,
                warrantText: warrantText,
                claimText: document.getElementById('replyClaim').value || null,
                resolutionText: document.getElementById('replyResolution').value || null,
                tags: tags,
                annotation: document.getElementById('replyAnnotation').value || null
            };
            
            const response = await fetch(`/api/arguments/${argId}/follow-ups`, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify(replyData)
            });
            
            if (!response.ok) {
                const error = await response.json();
                throw new Error(error.detail || error.error || 'Failed to post reply');
            }
            
            const result = await response.json();
            
            // Reset form
            document.getElementById('replyForm').reset();
            charCount.textContent = '0';
            document.getElementById('replyFormContainer').style.display = 'none';
            // Reset optional fields to collapsed
            document.getElementById('replyOptionalFields').style.display = 'none';
            document.getElementById('toggleDetailsText').textContent = 'Add details';
            document.querySelector('#toggleDetailsBtn i').className = 'bi bi-plus-circle me-1';
            
            // Reload replies
            loadReplies(true);
            
            // Update reply count in header
            const replyCountBadge = document.querySelector('#replies h5 .badge');
            if (replyCountBadge) {
                replyCountBadge.textContent = totalReplies + 1;
            }
            
        } catch (error) {
            console.error('Error posting reply:', error);
            alert(`Error: ${error.message}`);
        } finally {
            submitBtn.disabled = false;
            spinner.classList.add('d-none');
        }
    });

    // Load more replies
    document.getElementById('loadMoreRepliesBtn')?.addEventListener('click', () => {
        loadReplies(false);
    });

    // Utility function to escape HTML
    function escapeHtml(text) {
        const div = document.createElement('div');
        div.textContent = text;
        return div.innerHTML;
    }

    // Initial load of replies
    loadReplies(true);
})();
</script>
}