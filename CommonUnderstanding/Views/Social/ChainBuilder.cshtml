@{
    ViewData["Title"] = "Chain Builder";
}

@section Styles {
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/vis-network/9.1.6/dist/vis-network.min.css" />
<style>
    .cb-wrap { display:flex; height:calc(100vh - 60px); gap:0; min-height:0; margin:-1rem; margin-top:0; }
    .cb-side { width:280px; min-width:280px; background:#fff; border-right:1px solid var(--cu-border-light); display:flex; flex-direction:column; overflow:hidden; }
    .cb-side-hd { padding:14px 16px; border-bottom:1px solid var(--cu-border-light); background:linear-gradient(135deg,rgba(15,118,110,0.06),rgba(192,122,63,0.04)); }
    .cb-side-hd h1 { font-size:16px; font-weight:600; color:var(--cu-primary-blue); margin:0; }
    .cb-side-hd p { font-size:11px; color:var(--cu-text-muted); margin:4px 0 0; }
    .cb-search { padding:10px 12px; border-bottom:1px solid var(--cu-border-light); }
    .cb-search input { font-size:13px; border-radius:6px; }
    .cb-search-results { max-height:200px; overflow-y:auto; }
    .cb-sr-item { padding:8px 12px; cursor:pointer; border-bottom:1px solid #f0f0f0; font-size:12px; transition:background .15s; }
    .cb-sr-item:hover { background:rgba(15,118,110,0.06); }
    .cb-sr-item strong { color:var(--cu-primary-blue); }
    .cb-sr-item small { color:var(--cu-text-muted); }
    .cb-chain-info { padding:10px 12px; border-bottom:1px solid var(--cu-border-light); }
    .cb-chain-info summary { font-size:13px; font-weight:600; color:var(--cu-secondary-blue); cursor:pointer; }
    .cb-chain-info .info-row { font-size:11px; color:var(--cu-text-muted); margin:3px 0; }
    .cb-links { flex:1; overflow-y:auto; padding:8px 12px; }
    .cb-links h3 { font-size:12px; font-weight:600; color:var(--cu-text-muted); text-transform:uppercase; letter-spacing:.5px; margin-bottom:8px; }
    .cb-link-item { display:flex; align-items:center; gap:6px; padding:6px 8px; margin-bottom:4px; border-radius:6px; background:#f8f9fa; font-size:11px; }
    .cb-link-item .badge { font-size:10px; }
    .cb-link-item .btn-sm { font-size:10px; padding:0 4px; }
    .cb-link-type-Supports { border-left:3px solid #198754; }
    .cb-link-type-Contradicts { border-left:3px solid #dc3545; }
    .cb-link-type-Refines { border-left:3px solid #fd7e14; }
    .cb-link-type-Extends { border-left:3px solid #0d6efd; }
    .cb-main { flex:1; display:flex; flex-direction:column; min-width:0; background:var(--cu-background); }
    .cb-toolbar { display:flex; align-items:center; gap:8px; padding:8px 12px; background:#fff; border-bottom:1px solid var(--cu-border-light); flex-wrap:wrap; }
    .cb-toolbar select { font-size:12px; width:130px; }
    .cb-tb-btn { font-size:11px; padding:4px 10px; border-radius:6px; border:1px solid var(--cu-border-light); background:#fff; cursor:pointer; transition:all .15s; white-space:nowrap; }
    .cb-tb-btn:hover { background:var(--cu-background); }
    .cb-tb-btn.on { background:var(--cu-secondary-blue); color:#fff; border-color:var(--cu-secondary-blue); }
    .cb-tb-btn.accent { background:var(--cu-accent); color:#fff; border-color:var(--cu-accent); }
    .cb-link-status { font-size:11px; padding:3px 8px; border-radius:10px; }
    .cb-link-status.off { background:#e9ecef; color:#6c757d; }
    .cb-link-status.on { background:#d1f2eb; color:#0f766e; font-weight:600; }
    .cb-graph { flex:1; min-height:0; }
    .cb-legend { display:flex; gap:12px; padding:6px 12px; background:#fff; border-top:1px solid var(--cu-border-light); font-size:10px; flex-wrap:wrap; }
    .cb-legend span { display:flex; align-items:center; gap:4px; }
    .cb-legend .dot { width:10px; height:10px; border-radius:50%; display:inline-block; }
    .cb-nodeinfo { padding:8px 12px; background:#fff; border-top:1px solid var(--cu-border-light); font-size:12px; color:var(--cu-text-muted); min-height:36px; display:none; }
    .cb-nodeinfo.active { display:block; }
    .cb-nodeinfo strong { color:var(--cu-primary-blue); }
    .cb-empty { display:flex; align-items:center; justify-content:center; height:100%; color:var(--cu-text-muted); font-size:14px; flex-direction:column; gap:8px; }
    .cb-empty i { font-size:48px; opacity:.3; }
    @@media (max-width:800px) { .cb-wrap { flex-direction:column; } .cb-side { width:100%; min-width:0; max-height:40vh; } }
</style>
}

<div class="cb-wrap">
    <div class="cb-side">
        <div class="cb-side-hd">
            <h1><i class="bi bi-diagram-3"></i> Chain Builder</h1>
            <p>Connect arguments into reasoning chains</p>
        </div>
        <div class="cb-search">
            <input type="text" id="searchInput" class="form-control" placeholder="Search arguments to add..." autocomplete="off">
            <div id="searchResults" class="cb-search-results mt-1"></div>
        </div>
        <details class="cb-chain-info" id="chainInfoBlock" open>
            <summary>Chain Info</summary>
            <div class="info-row"><strong>ID:</strong> <span id="chainIdDisplay">-</span></div>
            <div class="info-row"><strong>Nodes:</strong> <span id="chainNodeCount">0</span></div>
            <div class="info-row"><strong>Links:</strong> <span id="chainLinkCount">0</span></div>
            <div class="mt-2"><button class="btn btn-sm btn-outline-primary" id="saveChainBtn" disabled><i class="bi bi-save"></i> Save</button></div>
        </details>
        <div class="cb-links" id="linksList">
            <h3>Links</h3>
            <div id="linksTableBody" class="text-muted" style="font-size:11px">No links yet. Use Link Mode to connect nodes.</div>
        </div>
    </div>
    <div class="cb-main">
        <div class="cb-toolbar">
            <select id="linkTypeSelect" class="form-select form-select-sm">
                <option value="Supports">Supports</option>
                <option value="Contradicts">Contradicts</option>
                <option value="Refines">Refines</option>
                <option value="Extends">Extends</option>
            </select>
            <button id="linkModeBtn" class="cb-tb-btn" title="Toggle Link Mode: click two nodes to connect them">Link Mode</button>
            <span id="linkSelectionStatus" class="cb-link-status off">Select source node</span>
            <button id="physicsBtn" class="cb-tb-btn" title="Toggle physics simulation">Physics</button>
            <button id="layoutBtn" class="cb-tb-btn" title="Auto-arrange nodes">Layout</button>
            <button id="resetBtn" class="cb-tb-btn" title="Clear graph">Reset</button>
        </div>
        <div id="graphContainer" class="cb-graph"></div>
        <div class="cb-legend">
            <span><span class="dot" style="background:#198754"></span> Supports</span>
            <span><span class="dot" style="background:#dc3545"></span> Contradicts</span>
            <span><span class="dot" style="background:#fd7e14"></span> Refines</span>
            <span><span class="dot" style="background:#0d6efd"></span> Extends</span>
        </div>
        <div id="nodeInfoBar" class="cb-nodeinfo"></div>
    </div>
</div>

@section Scripts {
<script src="https://cdnjs.cloudflare.com/ajax/libs/vis-network/9.1.6/dist/vis-network.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.0/signalr.min.js"></script>
<script>
(function() {
    var nodes = new vis.DataSet([]);
    var edges = new vis.DataSet([]);
    var network = null;
    var linkModeActive = false;
    var selectedNodes = [];
    var linksData = [];
    var argMap = {};
    var existingChainId = null;
    var colorMap = { Supports: '#198754', Contradicts: '#dc3545', Refines: '#fd7e14', Extends: '#0d6efd' };

    var container = document.getElementById('graphContainer');
    var data = { nodes: nodes, edges: edges };
    var options = {
        physics: { solver: 'forceAtlas2Based', forceAtlas2Based: { gravitationalConstant: -40, centralGravity: 0.005, springLength: 150, springConstant: 0.08 } },
        edges: { arrows: { to: { enabled: true, scaleFactor: 0.8 } }, smooth: { type: 'curvedCW', roundness: 0.2 }, font: { size: 10, color: '#666' } },
        nodes: { shape: 'box', margin: 8, widthConstraint: { maximum: 180 }, font: { size: 12, face: 'system-ui' }, borderWidth: 2, shadow: { enabled: true, size: 3 } },
        interaction: { hover: true, tooltipDelay: 200 }
    };
    network = new vis.Network(container, data, options);

    network.on('click', function(params) {
        if (params.nodes.length === 1) {
            var nodeId = params.nodes[0];
            if (linkModeActive) {
                selectedNodes.push(nodeId);
                if (selectedNodes.length === 2) {
                    createLink(selectedNodes[0], selectedNodes[1]);
                    selectedNodes = [];
                    updateLinkUI();
                } else { updateLinkUI(); }
            } else { showNodeInfo(nodeId); }
        } else if (params.nodes.length === 0) {
            selectedNodes = [];
            updateLinkUI();
            document.getElementById('nodeInfoBar').classList.remove('active');
        }
    });

    network.on('doubleClick', function(params) {
        if (params.nodes.length === 1) {
            window.open('/Social/Argument/' + params.nodes[0], '_blank');
        }
    });

    document.getElementById('linkModeBtn').addEventListener('click', function() {
        linkModeActive = !linkModeActive;
        this.classList.toggle('on', linkModeActive);
        selectedNodes = [];
        updateLinkUI();
    });

    function updateLinkUI() {
        var s = document.getElementById('linkSelectionStatus');
        if (!linkModeActive) { s.className = 'cb-link-status off'; s.textContent = 'Link mode off'; }
        else if (selectedNodes.length === 0) { s.className = 'cb-link-status on'; s.textContent = 'Click source node'; }
        else { s.className = 'cb-link-status on'; s.textContent = 'Now click target node'; }
    }

    function createLink(from, to) {
        if (from === to) return;
        if (wouldCreateCycle(from, to)) { alert('Cannot create this link: it would create a circular chain.'); return; }
        var edgeId = from + '->' + to;
        if (edges.get(edgeId)) { alert('This link already exists.'); return; }
        var linkType = document.getElementById('linkTypeSelect').value;
        var color = colorMap[linkType] || '#888';
        edges.add({ id: edgeId, from: from, to: to, label: linkType, color: { color: color, highlight: color }, arrows: { to: { enabled: true } }, font: { size: 10, color: '#666' } });
        linksData.push({ from: from, to: to, type: linkType, edgeId: edgeId });
        renderLinksTable();
        updateStats();
        if (existingChainId) saveChain();
    }

    function wouldCreateCycle(from, to) {
        var adj = {};
        nodes.getIds().forEach(function(id) { adj[id] = []; });
        edges.get().forEach(function(e) { if (adj[e.from]) adj[e.from].push(e.to); });
        if (adj[from]) adj[from].push(to);
        var visited = {}, recStack = {};
        function dfs(v) {
            visited[v] = true; recStack[v] = true;
            for (var i = 0; i < (adj[v] || []).length; i++) {
                var w = adj[v][i];
                if (!visited[w] && dfs(w)) return true;
                if (recStack[w]) return true;
            }
            recStack[v] = false;
            return false;
        }
        for (var k in adj) { if (!visited[k] && dfs(k)) return true; }
        return false;
    }

    function showNodeInfo(nodeId) {
        var a = argMap[nodeId];
        var bar = document.getElementById('nodeInfoBar');
        bar.classList.add('active');
        bar.innerHTML = '<strong>' + escHtml(a.title || nodeId) + '</strong> &middot; ' + escHtml(a.type || 'argument') + ' &middot; <a href="/Social/Argument/' + nodeId + '" target="_blank">Open <i class="bi bi-box-arrow-up-right"></i></a>';
    }

    var searchTimer = null;
    document.getElementById('searchInput').addEventListener('input', function() {
        clearTimeout(searchTimer);
        var q = this.value.trim();
        if (q.length < 2) { document.getElementById('searchResults').innerHTML = ''; return; }
        searchTimer = setTimeout(function() { searchArguments(q); }, 300);
    });

    function searchArguments(q) {
        fetch('/api/arguments/search?q=' + encodeURIComponent(q))
            .then(function(r) { return r.json(); })
            .then(function(results) { renderSearchResults(results); })
            .catch(function(e) { console.error('Search error:', e); });
    }

    function renderSearchResults(results) {
        var div = document.getElementById('searchResults');
        if (!results || results.length === 0) { div.innerHTML = '<div class="cb-sr-item text-muted">No results</div>'; return; }
        div.innerHTML = results.map(function(a) {
            return '<div class="cb-sr-item" data-id="' + escAttr(a.id) + '" data-title="' + escAttr(a.title) + '" data-type="' + escAttr(a.type || '') + '">' +
                '<strong>' + escHtml(a.title || a.id) + '</strong><br><small>' + escHtml(a.type || 'argument') + '</small></div>';
        }).join('');
        div.querySelectorAll('.cb-sr-item').forEach(function(el) {
            el.addEventListener('click', function() {
                addArgToGraph(this.dataset.id, this.dataset.title, this.dataset.type);
                div.innerHTML = '';
                document.getElementById('searchInput').value = '';
            });
        });
    }

    function addArgToGraph(id, title, type) {
        if (nodes.get(id)) return;
        var color = type === 'premise' ? '#c07a3f' : type === 'conclusion' ? '#0f766e' : '#162131';
        nodes.add({ id: id, label: truncate(title || id, 40), color: { background: '#fff', border: color, highlight: { background: '#f8f9fa', border: color } }, title: title });
        argMap[id] = { title: title, type: type };
        updateStats();
        if (existingChainId) saveChain();
    }

    function renderLinksTable() {
        var div = document.getElementById('linksTableBody');
        if (linksData.length === 0) { div.innerHTML = '<span class="text-muted" style="font-size:11px">No links yet. Use Link Mode to connect nodes.</span>'; return; }
        div.innerHTML = linksData.map(function(l, i) {
            var fromTitle = (argMap[l.from] && argMap[l.from].title) || l.from;
            var toTitle = (argMap[l.to] && argMap[l.to].title) || l.to;
            return '<div class="cb-link-item cb-link-type-' + escAttr(l.type) + '">' +
                '<span class="badge bg-' + (l.type === 'Supports' ? 'success' : l.type === 'Contradicts' ? 'danger' : l.type === 'Refines' ? 'warning' : 'primary') + '">' + escHtml(l.type) + '</span>' +
                '<span>' + escHtml(truncate(fromTitle, 20)) + ' <i class="bi bi-arrow-right"></i> ' + escHtml(truncate(toTitle, 20)) + '</span>' +
                '<button class="btn btn-sm btn-outline-danger ms-auto" data-edge="' + escAttr(l.edgeId) + '" title="Remove link"><i class="bi bi-x"></i></button>' +
                '</div>';
        }).join('');
        div.querySelectorAll('button[data-edge]').forEach(function(btn) {
            btn.addEventListener('click', function() {
                var edgeId = this.dataset.edge;
                edges.remove(edgeId);
                linksData = linksData.filter(function(l) { return l.edgeId !== edgeId; });
                renderLinksTable();
                updateStats();
                if (existingChainId) saveChain();
            });
        });
    }

    function updateStats() {
        document.getElementById('chainNodeCount').textContent = nodes.getIds().length;
        document.getElementById('chainLinkCount').textContent = linksData.length;
        document.getElementById('saveChainBtn').disabled = (nodes.getIds().length === 0);
    }

    // --- Save ---
    document.getElementById('saveChainBtn').addEventListener('click', saveChain);

    function saveChain() {
        var ids = nodes.getIds();
        if (ids.length === 0) return;
        if (existingChainId) {
            // Update existing chain: add any missing arguments
            var promises = ids.map(function(argId) {
                return fetch('/api/argumentchains/' + existingChainId + '/arguments', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ argumentId: argId })
                });
            });
            Promise.all(promises).then(function() {
                document.getElementById('chainIdDisplay').textContent = existingChainId;
            }).catch(function(e) { console.error('Save error:', e); });
        } else {
            // Create new chain
            fetch('/api/argumentchains', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    title: 'Untitled Chain',
                    rootArgumentId: ids[0],
                    argumentIds: ids,
                    isPublic: false
                })
            })
            .then(function(r) { return r.json(); })
            .then(function(data) {
                if (data.id) {
                    existingChainId = data.id;
                    document.getElementById('chainIdDisplay').textContent = data.id;
                }
            })
            .catch(function(e) { console.error('Save error:', e); });
        }
    }

    // --- Toolbar buttons ---
    document.getElementById('physicsBtn').addEventListener('click', function() {
        var enabled = network.physics.options.enabled;
        network.setOptions({ physics: { enabled: !enabled } });
        this.classList.toggle('on', !enabled);
    });

    document.getElementById('layoutBtn').addEventListener('click', function() {
        network.fit({ animation: { duration: 500, easingFunction: 'easeInOutQuad' } });
    });

    document.getElementById('resetBtn').addEventListener('click', function() {
        if (confirm('Clear all nodes and links from the graph?')) {
            nodes.clear();
            edges.clear();
            linksData = [];
            argMap = {};
            existingChainId = null;
            document.getElementById('chainIdDisplay').textContent = '-';
            renderLinksTable();
            updateStats();
            document.getElementById('nodeInfoBar').classList.remove('active');
        }
    });

    // --- SignalR ---
    var hub = new signalR.HubConnectionBuilder().withUrl('/hubs/chains').build();
    hub.on('ChainUpdated', function(chainId, data) {
        if (chainId !== existingChainId) return;
        nodes.clear(); edges.clear(); linksData = []; argMap = {};
        (data.arguments || []).forEach(function(a) { addArgToGraph(a.id, a.title, a.type); });
        (data.links || []).forEach(function(l) {
            var edgeId = l.sourceArgumentId + '->' + l.targetArgumentId;
            var color = colorMap[l.linkType] || '#888';
            edges.add({ id: edgeId, from: l.sourceArgumentId, to: l.targetArgumentId, label: l.linkType, color: { color: color, highlight: color }, arrows: { to: { enabled: true } }, font: { size: 10, color: '#666' } });
            linksData.push({ from: l.sourceArgumentId, to: l.targetArgumentId, type: l.linkType, edgeId: edgeId });
        });
        renderLinksTable();
        updateStats();
    });
    hub.start().catch(function(err) { console.error('SignalR connection failed:', err); });

    // --- Helpers ---
    function escHtml(s) { var d = document.createElement('div'); d.textContent = s || ''; return d.innerHTML; }
    function escAttr(s) { return (s || '').replace(/&/g, '&amp;').replace(/"/g, '&quot;').replace(/</g, '&lt;').replace(/>/g, '&gt;'); }
    function truncate(s, n) { return (s || '').length > n ? s.substring(0, n) + '...' : s; }

    // --- Load existing chain if ID in URL ---
    var urlParams = new URLSearchParams(window.location.search);
    var chainIdFromUrl = urlParams.get('id');
    if (chainIdFromUrl) {
        fetch('/api/argumentchains/' + encodeURIComponent(chainIdFromUrl))
            .then(function(r) { return r.json(); })
            .then(function(data) {
                if (data && data.id) {
                    existingChainId = data.id;
                    document.getElementById('chainIdDisplay').textContent = data.id;
                    (data.arguments || []).forEach(function(a) { addArgToGraph(a.id, a.title, a.type || 'argument'); });
                    // Load links for this chain's arguments
                    var ids = (data.arguments || []).map(function(a) { return a.id; });
                    if (ids.length > 0) {
                        ids.forEach(function(sourceId) {
                            fetch('/api/argumentlinks?sourceId=' + sourceId)
                                .then(function(r) { return r.json(); })
                                .then(function(linkData) {
                                    (linkData.items || []).forEach(function(l) {
                                        if (ids.indexOf(l.targetArgumentId) === -1) return;
                                        var edgeId = l.sourceArgumentId + '->' + l.targetArgumentId;
                                        var color = colorMap[l.linkType] || '#888';
                                        if (!edges.get(edgeId)) {
                                            edges.add({ id: edgeId, from: l.sourceArgumentId, to: l.targetArgumentId, label: l.linkType, color: { color: color, highlight: color }, arrows: { to: { enabled: true } }, font: { size: 10, color: '#666' } });
                                            linksData.push({ from: l.sourceArgumentId, to: l.targetArgumentId, type: l.linkType, edgeId: edgeId });
                                        }
                                    });
                                    renderLinksTable();
                                    updateStats();
                                })
                                .catch(function() {});
                        });
                    }
                    renderLinksTable();
                    updateStats();
                }
            })
            .catch(function(e) { console.error('Load chain error:', e); });
    }

    updateStats();
})();</script>
}
