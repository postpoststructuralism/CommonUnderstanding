@{
    ViewData["Title"] = "Latest Contributions";
}

@section Styles {
<style>
    .argument-card {
        border: 1px solid var(--bs-border-color);
        border-radius: 0.75rem;
        margin-bottom: 1rem;
        background: var(--bs-body-bg);
        transition: box-shadow 0.15s ease;
        overflow: hidden;
    }
    .argument-card:hover { box-shadow: 0 2px 12px rgba(0,0,0,0.1); }
    .argument-card .tags .badge { font-size: 0.72rem; }
    .argument-card-body {
        padding: 1.25rem 1.25rem 0.75rem;
        cursor: pointer;
    }
    .argument-card-body:hover { text-decoration: none; }
    .argument-card-actions {
        padding: 0.5rem 1.25rem 1rem;
        border-top: 1px solid var(--bs-border-color);
        background: rgba(0,0,0,0.02);
    }
    .vote-bar { display: flex; align-items: center; gap: 0.5rem; }
    .vote-bar .vote-count { font-weight: 600; min-width: 2.5rem; text-align: center; }
    .validity-badge { font-size: 0.72rem; }
    #feedSpinner { display: none; }
    .sort-btn.active { font-weight: 700; }
    .vote-modal-reason label { cursor: pointer; }
    .wilson-bar { height: 4px; border-radius: 2px; background: var(--bs-secondary-bg); margin-top: 6px; }
    .wilson-fill { height: 100%; border-radius: 2px; background: #198754; }
    .vote-trigger.active-up { box-shadow: 0 0 0 2px #198754; background: rgba(25,135,84,0.12); }
    .vote-trigger.active-down { box-shadow: 0 0 0 2px #dc3545; background: rgba(220,53,69,0.12); }
    .recommendation-reason { color: var(--bs-secondary-color); font-size: 0.78rem; }
    .feed-tuner { border-block: 1px solid var(--bs-border-color); padding: 1rem 0; }
    .feed-tuner-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(170px, 1fr)); gap: 1rem; }
    .feed-tuner output { min-width: 2.5rem; text-align: right; font-variant-numeric: tabular-nums; }
</style>
}

<header class="mb-4">
    <h1 class="h2 mb-1">Latest Contributions</h1>
    <p class="text-muted mb-0">A chronological and structural view of recent additions to the map.</p>
</header>

<!-- Sort + filter toolbar -->
<div class="d-flex align-items-center gap-2 mb-3 flex-wrap">
    <span class="text-muted small me-1">Show:</span>
    <button class="btn btn-sm btn-outline-secondary sort-btn active" data-sort="recommended">
        <i class="bi bi-compass"></i> For you
    </button>
    <button class="btn btn-sm btn-outline-secondary sort-btn" data-sort="recent">
        <i class="bi bi-clock"></i> New
    </button>
    <button class="btn btn-sm btn-outline-secondary sort-btn" data-sort="updated">
        <i class="bi bi-arrow-repeat"></i> Recently updated on the map
    </button>
    <button class="btn btn-sm btn-outline-secondary sort-btn" data-sort="underrepresented">
        <i class="bi bi-balance-scale"></i> Underrepresented views
    </button>
    <a asp-controller="SocialView" asp-action="Ranking" class="btn btn-sm btn-link text-muted px-1"
       aria-label="How contributions are ordered" title="How contributions are ordered">
        <i class="bi bi-info-circle"></i>
    </a>
    <label for="tagFilter" class="visually-hidden">Filter contributions by tag</label>
    <input id="tagFilter" class="form-control form-control-sm ms-auto" style="max-width:180px"
           placeholder="Filter by tag…" />
    @if (User.Identity?.IsAuthenticated == true)
    {
        <button class="btn btn-sm btn-outline-secondary" type="button" data-bs-toggle="collapse"
                data-bs-target="#feedTuner" aria-expanded="false" aria-controls="feedTuner" title="Tune your feed">
            <i class="bi bi-sliders"></i>
        </button>
    }
</div>

@if (User.Identity?.IsAuthenticated == true)
{
    <section id="feedTuner" class="feed-tuner collapse mb-3" aria-label="Tune your feed">
        <div class="d-flex justify-content-between align-items-center gap-2 mb-3 flex-wrap">
            <h2 class="h6 mb-0">Tune your feed</h2>
            <div class="btn-group btn-group-sm" role="group" aria-label="Feed presets">
                <button class="btn btn-outline-secondary preset-btn" data-preset="Focus">Focus</button>
                <button class="btn btn-outline-secondary preset-btn" data-preset="Balanced">Balanced</button>
                <button class="btn btn-outline-secondary preset-btn" data-preset="Bridge-builder">Bridge-builder</button>
            </div>
        </div>
        <div class="feed-tuner-grid">
            <label>Interest <span class="d-flex gap-2"><input id="interestWeight" class="form-range" type="range" min="0" max="1" step="0.05"><output></output></span></label>
            <label>Growth <span class="d-flex gap-2"><input id="growthWeight" class="form-range" type="range" min="0" max="1" step="0.05"><output></output></span></label>
            <label>Collective <span class="d-flex gap-2"><input id="collectiveWeight" class="form-range" type="range" min="0" max="1" step="0.05"><output></output></span></label>
            <label>Adventure <span class="d-flex gap-2"><input id="adventureRate" class="form-range" type="range" min="0" max="0.5" step="0.05"><output></output></span></label>
            <label>Challenge me <span class="d-flex gap-2"><input id="challengeRate" class="form-range" type="range" min="0" max="0.5" step="0.05"><output></output></span></label>
            <label>Recent history <span class="d-flex gap-2"><input id="recencyBias" class="form-range" type="range" min="0" max="1" step="0.05"><output></output></span></label>
        </div>
        <div class="d-flex align-items-center gap-3 mt-3 flex-wrap">
            <div class="form-check form-switch"><input id="includeAI" class="form-check-input" type="checkbox"><label class="form-check-label" for="includeAI">AI-generated</label></div>
            <div class="form-check form-switch"><input id="evidencePreferred" class="form-check-input" type="checkbox"><label class="form-check-label" for="evidencePreferred">Prefer cited evidence</label></div>
            <button id="savePreferencesBtn" class="btn btn-sm btn-primary ms-auto"><i class="bi bi-check2"></i> Apply</button>
        </div>
    </section>
}

<div id="feedSpinner" class="text-center py-4">
    <div class="spinner-border text-primary" role="status"></div>
</div>

<div id="feedContainer"></div>

<div class="text-center mt-3">
    <button id="loadMoreBtn" class="btn btn-outline-secondary btn-sm" style="display:none">
        Load more
    </button>
</div>

<!-- ── Vote Modal ─────────────────────────────────────────────────────────── -->
<div class="modal fade" id="voteModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-sm">
        <div class="modal-content">
            <div class="modal-header">
                <h6 class="modal-title" id="voteModalTitle">Cast Vote</h6>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p class="small text-muted mb-2">Select your rationale:</p>
                <div class="vote-modal-reason d-flex flex-column gap-2">
                    <label class="d-flex align-items-center gap-2">
                        <input type="radio" name="voteRationale" value="WellSourced" checked />
                        <span>Well Sourced</span>
                    </label>
                    <label class="d-flex align-items-center gap-2">
                        <input type="radio" name="voteRationale" value="LogicallyValid" />
                        <span>Logically Valid</span>
                    </label>
                    <label class="d-flex align-items-center gap-2">
                        <input type="radio" name="voteRationale" value="ChangedMyView" />
                        <span>Changed My View</span>
                    </label>
                    <label class="d-flex align-items-center gap-2">
                        <input type="radio" name="voteRationale" value="Fallacious" />
                        <span>Fallacious</span>
                    </label>
                    <label class="d-flex align-items-center gap-2">
                        <input type="radio" name="voteRationale" value="OffTopic" />
                        <span>Off Topic</span>
                    </label>
                </div>
                <textarea id="voteComment" class="form-control mt-3" rows="2"
                          placeholder="Optional comment…" maxlength="500"></textarea>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-sm btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                <button id="submitVoteBtn" class="btn btn-sm btn-success">
                    <i class="bi bi-hand-thumbs-up"></i> Submit Upvote
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.0/signalr.min.js"></script>
<script>
(function () {
    'use strict';

    let currentSort = 'recommended';
    let currentTag  = '';
    let currentOffset = 0;
    const PAGE_SIZE = 20;
    let loadedIds = new Set();
    let pendingVoteArgId = null;
    const viewedAt = new Map();

    // ── SignalR ───────────────────────────────────────────────────────────────
    const hubConn = new signalR.HubConnectionBuilder()
        .withUrl('/hubs/voting')
        .withAutomaticReconnect()
        .build();

    hubConn.on('VoteScoreUpdated', tally => {
        updateCardTally(tally.argumentId, tally);
    });

    hubConn.on('VoteCastConfirmed', data => {
        updateCardTally(data.argumentId, data.newTally, data.vote);
        // Flash the card to show success
        const card = document.getElementById(`arg-${data.argumentId}`);
        if (card) {
            card.style.transition = 'box-shadow 0.3s ease';
            card.style.boxShadow = '0 0 0 3px #198754';
            setTimeout(() => { card.style.boxShadow = ''; }, 1500);
        }
    });

    hubConn.on('VoteRejected', data => {
        alert('Vote rejected: ' + (data.reason || 'Unknown error'));
    });

    hubConn.on('ReplyCountUpdated', data => {
        const card = document.getElementById(`arg-${data.argumentId}`);
        if (!card) return;
        const replyEl = card.querySelector('.reply-count');
        if (replyEl) {
            replyEl.textContent = data.newCount;
            pulseElement(replyEl);
        }
    });

    async function startHub() {
        try { await hubConn.start(); } catch (e) { console.warn('VotingHub unavailable:', e); }
    }
    startHub();

    // ── Feed loading ──────────────────────────────────────────────────────────
    async function loadFeed(reset = false) {
        if (reset) {
            currentOffset = 0;
            loadedIds.clear();
            document.getElementById('feedContainer').innerHTML = '';
        }

        document.getElementById('feedSpinner').style.display = 'block';
        document.getElementById('loadMoreBtn').style.display = 'none';

        const tags = currentTag ? `&tags=${encodeURIComponent(currentTag)}` : '';
        const url = currentSort === 'recommended'
            ? `/api/feed/recommended?offset=${currentOffset}&limit=${PAGE_SIZE}${tags}`
            : `/api/feed?sort=${currentSort}&limit=${PAGE_SIZE + currentOffset}${tags}`;

        try {
            const res  = await fetch(url);
            const data = await res.json();
            let items = data.items || [];
            if (currentSort !== 'recommended') items = items.slice(currentOffset);

            const container = document.getElementById('feedContainer');
            items.forEach(item => {
                const arg = item.argument || item;
                if (loadedIds.has(arg.id)) return;
                loadedIds.add(arg.id);
                container.insertAdjacentHTML('beforeend', renderCard(arg, item.argument ? item : null));
                // Subscribe for live updates
                if (hubConn.state === 'Connected') {
                    hubConn.invoke('SubscribeToArgument', arg.id).catch(() => {});
                }
            });

            if (items.length === PAGE_SIZE)
                document.getElementById('loadMoreBtn').style.display = '';
            currentOffset += items.length;
        } catch (err) {
            console.error('Feed load failed:', err);
        }

        document.getElementById('feedSpinner').style.display = 'none';
    }

    function renderCard(arg, recommendation) {
        const wilson = Math.round((arg.wilsonScore || 0) * 100);
        const tagHtml = (arg.tags || []).map(t =>
            `<span class="badge bg-secondary me-1">${escHtml(t)}</span>`).join('');
        // Phase 1: AI confidence badge removed from card views per spec 4.5
        const aiLabel = '';
        const reasonHtml = recommendation
            ? `<div class="recommendation-reason mb-2"><span class="badge text-bg-light border me-1">${escHtml(recommendation.lane)}</span>${escHtml(recommendation.reason)}</div>`
            : '';
        const userVote = arg.userVote?.vote?.toLowerCase() || '';
        const upActive   = userVote === 'up'   ? ' active-up' : '';
        const downActive = userVote === 'down' ? ' active-down' : '';
        return `
        <div class="argument-card" id="arg-${arg.id}" data-id="${arg.id}">
            <div class="argument-card-body" onclick="openArgument('${arg.id}')">
                ${reasonHtml}
                <div class="d-flex justify-content-between align-items-start mb-1">
                    <h5 class="mb-0">${escHtml(arg.title)}</h5>
                    <span class="text-muted small ms-2 text-nowrap">${timeAgo(arg.createdAt)}</span>
                </div>
                <p class="mb-1 fw-semibold">${escHtml(arg.claimText || '')}</p>
                ${arg.warrantText ? `<p class="text-muted small mb-2">${escHtml(truncate(arg.warrantText, 200))}</p>` : ''}
                <div class="tags mb-1">${tagHtml}${aiLabel}</div>
            </div>
            <div class="argument-card-actions">
                <div class="d-flex align-items-center gap-3">
                    <div class="vote-bar">
                        <button class="btn btn-sm btn-outline-success vote-trigger${upActive}" data-id="${arg.id}" data-vote="Up" title="Upvote">
                            <i class="bi bi-hand-thumbs-up"></i>
                            <span class="upvote-count vote-count">${arg.upvotes ?? 0}</span>
                        </button>
                        <button class="btn btn-sm btn-outline-danger vote-trigger${downActive}" data-id="${arg.id}" data-vote="Down" title="Downvote">
                            <i class="bi bi-hand-thumbs-down"></i>
                            <span class="downvote-count vote-count">${arg.downvotes ?? 0}</span>
                        </button>
                        <a href="/SocialView/Detail/${arg.id}#replies" class="btn btn-sm btn-outline-secondary" title="Replies">
                            <i class="bi bi-chat-left"></i>
                            <span class="reply-count vote-count">${arg.replyCount ?? 0}</span>
                        </a>
                    </div>
                    <div class="flex-grow-1">
                        <div class="wilson-bar">
                            <div class="wilson-fill" style="width:${wilson}%"></div>
                        </div>
                    </div>
                    <span class="text-muted small">Added ${timeAgo(arg.createdAt)}</span>
                </div>
            </div>
        </div>`;
    }

    function updateCardTally(argId, tally, newVote) {
        const card = document.getElementById(`arg-${argId}`);
        if (!card) return;
        const upEl   = card.querySelector('.upvote-count');
        const downEl = card.querySelector('.downvote-count');
        const replyEl = card.querySelector('.reply-count');
        const fill   = card.querySelector('.wilson-fill');
        const upBtn  = card.querySelector('.btn-outline-success');
        const downBtn = card.querySelector('.btn-outline-danger');
        if (upEl)   { upEl.textContent   = tally.upvotes ?? 0; pulseElement(upEl); }
        if (downEl) { downEl.textContent = tally.downvotes ?? 0; pulseElement(downEl); }
        if (replyEl && tally.replyCount !== undefined) { 
            replyEl.textContent = tally.replyCount; 
            pulseElement(replyEl); 
        }
        if (fill)   { fill.style.width   = Math.round((tally.wilsonScore || 0) * 100) + '%'; }
        // Update active button state
        if (newVote !== undefined) {
            upBtn?.classList.toggle('active-up', newVote === 'Up');
            downBtn?.classList.toggle('active-down', newVote === 'Down');
        }
    }

    window.openArgument = argId => {
        recordEngagement(argId, { clicked: true });
        window.location = `/SocialView/Detail/${argId}`;
    };

    function recordEngagement(argumentId, values = {}) {
        if (!document.getElementById('feedTuner')) return;
        fetch('/api/feed/engagement', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            keepalive: true,
            body: JSON.stringify({ argumentId, clicked: false, voted: false, commented: false, dwellMs: 0, ...values })
        }).catch(() => {});
    }

    const dwellObserver = new IntersectionObserver(entries => entries.forEach(entry => {
        const argumentId = entry.target.dataset.id;
        if (entry.isIntersecting) {
            viewedAt.set(argumentId, Date.now());
        } else if (viewedAt.has(argumentId)) {
            recordEngagement(argumentId, { dwellMs: Date.now() - viewedAt.get(argumentId) });
            viewedAt.delete(argumentId);
        }
    }), { threshold: 0.6 });

    new MutationObserver(mutations => mutations.forEach(mutation => mutation.addedNodes.forEach(node => {
        if (node.nodeType === Node.ELEMENT_NODE && node.classList.contains('argument-card')) dwellObserver.observe(node);
    }))).observe(document.getElementById('feedContainer'), { childList: true });

    function pulseElement(el) {
        el.style.transition = 'transform 0.15s ease';
        el.style.transform = 'scale(1.3)';
        setTimeout(() => { el.style.transform = 'scale(1)'; }, 150);
    }

    // ── Sort buttons ──────────────────────────────────────────────────────────
    document.querySelectorAll('.sort-btn').forEach(btn => {
        btn.addEventListener('click', () => {
            document.querySelectorAll('.sort-btn').forEach(b => b.classList.remove('active'));
            btn.classList.add('active');
            currentSort = btn.dataset.sort;
            loadFeed(true);
        });
    });

    // ── Tag filter ────────────────────────────────────────────────────────────
    let tagDebounce;
    document.getElementById('tagFilter').addEventListener('input', e => {
        clearTimeout(tagDebounce);
        tagDebounce = setTimeout(() => {
            currentTag = e.target.value.trim();
            loadFeed(true);
        }, 400);
    });

    // ── Load more ─────────────────────────────────────────────────────────────
    document.getElementById('loadMoreBtn').addEventListener('click', loadFeed);

    // ── Feed preferences ─────────────────────────────────────────────────────
    const preferenceInputs = ['interestWeight', 'growthWeight', 'collectiveWeight', 'adventureRate', 'challengeRate', 'recencyBias'];
    const presets = {
        'Focus': { interestWeight: .75, growthWeight: .15, collectiveWeight: .10, adventureRate: .05, challengeRate: .05, recencyBias: .7 },
        'Balanced': { interestWeight: .5, growthWeight: .25, collectiveWeight: .25, adventureRate: .1, challengeRate: .1, recencyBias: .5 },
        'Bridge-builder': { interestWeight: .2, growthWeight: .25, collectiveWeight: .55, adventureRate: .15, challengeRate: .2, recencyBias: .35 }
    };
    let activePresetName = 'Balanced';

    function setPreferences(preferences) {
        preferenceInputs.forEach(id => {
            const input = document.getElementById(id);
            if (!input) return;
            input.value = preferences[id];
            input.nextElementSibling.textContent = Math.round(preferences[id] * 100) + '%';
        });
        if (document.getElementById('includeAI')) document.getElementById('includeAI').checked = preferences.includeAIGenerated;
        if (document.getElementById('evidencePreferred')) document.getElementById('evidencePreferred').checked = preferences.evidencePreferred;
        activePresetName = preferences.activePresetName || activePresetName;
    }

    preferenceInputs.forEach(id => document.getElementById(id)?.addEventListener('input', e => {
        e.target.nextElementSibling.textContent = Math.round(e.target.value * 100) + '%';
        activePresetName = 'Custom';
    }));
    document.querySelectorAll('.preset-btn').forEach(button => button.addEventListener('click', () => {
        activePresetName = button.dataset.preset;
        setPreferences({ ...presets[activePresetName], activePresetName, includeAIGenerated: true, evidencePreferred: false });
    }));
    document.getElementById('savePreferencesBtn')?.addEventListener('click', async () => {
        const body = Object.fromEntries(preferenceInputs.map(id => [id, Number(document.getElementById(id).value)]));
        body.includeAIGenerated = document.getElementById('includeAI').checked;
        body.evidencePreferred = document.getElementById('evidencePreferred').checked;
        body.activePresetName = activePresetName;
        const response = await fetch('/api/feed/preferences', { method: 'PUT', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body) });
        if (response.ok) {
            setPreferences(await response.json());
            currentSort = 'recommended';
            document.querySelectorAll('.sort-btn').forEach(button => button.classList.toggle('active', button.dataset.sort === currentSort));
            loadFeed(true);
        }
    });

    if (document.getElementById('feedTuner')) {
        fetch('/api/feed/preferences').then(response => response.ok ? response.json() : null).then(preferences => preferences && setPreferences(preferences));
    }

    // ── Vote modal ────────────────────────────────────────────────────────────
    let pendingVoteValue = null;

    document.getElementById('feedContainer').addEventListener('click', e => {
        const trigger = e.target.closest('.vote-trigger');
        if (!trigger) return;

        // Prevent the parent <a> link from navigating
        e.preventDefault();
        e.stopPropagation();

        pendingVoteArgId = trigger.dataset.id;
        pendingVoteValue = trigger.dataset.vote;

        // Update modal title and button
        const isUpvote = pendingVoteValue === 'Up';
        document.getElementById('voteModalTitle').textContent = isUpvote ? 'Upvote Argument' : 'Downvote Argument';
        document.getElementById('submitVoteBtn').innerHTML = isUpvote
            ? '<i class="bi bi-hand-thumbs-up"></i> Submit Upvote'
            : '<i class="bi bi-hand-thumbs-down"></i> Submit Downvote';
        document.getElementById('submitVoteBtn').className = isUpvote
            ? 'btn btn-sm btn-success'
            : 'btn btn-sm btn-outline-danger';

        const modal = new bootstrap.Modal(document.getElementById('voteModal'));
        modal.show();
    });

    async function castVote() {
        if (!pendingVoteArgId || !pendingVoteValue) return;
        const rationale = document.querySelector('input[name="voteRationale"]:checked')?.value || 'WellSourced';
        const comment   = document.getElementById('voteComment').value.trim();

        if (hubConn.state === 'Connected') {
            try {
                await hubConn.invoke('CastVote', pendingVoteArgId, pendingVoteValue, rationale, comment);
            } catch (e) {
                console.error('Vote via SignalR failed, trying REST:', e);
                await restVote(pendingVoteArgId, pendingVoteValue, rationale, comment);
            }
        } else {
            await restVote(pendingVoteArgId, pendingVoteValue, rationale, comment);
        }

        bootstrap.Modal.getInstance(document.getElementById('voteModal'))?.hide();
        recordEngagement(pendingVoteArgId, { voted: true });
        pendingVoteArgId = null;
        pendingVoteValue = null;
    }

    async function restVote(argId, voteValue, rationale, comment) {
        try {
            const res = await fetch(`/api/arguments/${argId}/votes`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ vote: voteValue, rationale, comment })
            });
            if (res.ok) {
                const tally = await res.json();
                // Update UI immediately with the returned tally
                updateCardTally(argId, tally, voteValue);
            } else if (res.status === 401) {
                alert('Please log in to vote.');
            } else {
                const err = await res.json().catch(() => ({}));
                alert('Vote failed: ' + (err.detail || err.title || 'Unknown error'));
            }
        } catch (e) {
            console.error('REST vote failed:', e);
        }
    }

    document.getElementById('submitVoteBtn').addEventListener('click', () => castVote());

    // ── Helpers ───────────────────────────────────────────────────────────────
    function escHtml(str) {
        return String(str ?? '').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');
    }
    function truncate(str, n) {
        return str.length > n ? str.slice(0, n) + '…' : str;
    }
    function timeAgo(iso) {
        const ms = Date.now() - new Date(iso).getTime();
        const mins = Math.floor(ms / 60000);
        if (mins < 1)  return 'just now';
        if (mins < 60) return `${mins}m ago`;
        const hrs = Math.floor(mins / 60);
        if (hrs < 24)  return `${hrs}h ago`;
        return `${Math.floor(hrs/24)}d ago`;
    }

    // Initial load
    loadFeed(true);
})();
</script>
}
