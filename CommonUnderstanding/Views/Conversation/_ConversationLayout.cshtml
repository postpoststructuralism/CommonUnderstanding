@inject Microsoft.FeatureManagement.IFeatureManager FeatureManager
@using Microsoft.AspNetCore.Mvc.TagHelpers
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    Layout = null; // This is the new root layout — it replaces _Layout when conversation shell is active
    var isGraphEnabled = await FeatureManager.IsEnabledAsync("UnderstandingGraph");
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - A Common Understanding</title>

    <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin />
    <link rel="preconnect" href="https://cdnjs.cloudflare.com" crossorigin />

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css">

    <link rel="stylesheet" href="~/css/portal.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/conversation.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/CommonUnderstanding.styles.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="cu-conversation-shell">
    <!-- Minimal header — just identity and graph toggle -->
    <header class="cu-conversation-header">
        <div class="cu-conversation-header-left">
            <img src="~/images/app-logo.svg" alt="A Common Understanding" class="cu-logo-sm" />
            <span class="cu-conversation-title">Common Understanding</span>
        </div>
        <div class="cu-conversation-header-right">
            @if (isGraphEnabled)
            {
                <button id="graphToggleBtn" class="cu-btn-ghost" title="Toggle Understanding Graph" onclick="toggleGraph()">
                    <i class="bi bi-diagram-3"></i>
                    <span class="d-none d-md-inline ms-1">Graph</span>
                </button>
            }
            @if (User.Identity?.IsAuthenticated == true)
            {
                var displayName = User.FindFirst(System.Security.Claims.ClaimTypes.Name)?.Value ?? "User";
                <span class="cu-user-badge">
                    <i class="bi bi-person-circle"></i>
                    <span class="d-none d-md-inline ms-1">@displayName</span>
                </span>
                <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="cu-btn-ghost text-danger" title="Sign Out">
                        <i class="bi bi-box-arrow-right"></i>
                    </button>
                </form>
            }
            else
            {
                <a class="cu-btn-ghost" asp-controller="Account" asp-action="Login">
                    <i class="bi bi-box-arrow-in-right me-1"></i>Sign In
                </a>
            }
        </div>
    </header>

    <!-- Main conversation area -->
    <main class="cu-conversation-main" role="main">
        @RenderBody()
    </main>

    <!-- Graph overlay (toggleable) -->
    @if (isGraphEnabled)
    {
        <aside id="graphOverlay" class="cu-graph-overlay" style="display:none">
            <div class="cu-graph-overlay-header">
                <h2><i class="bi bi-diagram-3"></i> Understanding Graph</h2>
                <button class="cu-btn-ghost" onclick="toggleGraph()" title="Close">
                    <i class="bi bi-x-lg"></i>
                </button>
            </div>
            <div class="cu-graph-overlay-body" id="graphOverlayBody">
                            <iframe id="graphFrame" src="" style="width:100%;height:100%;border:none;" title="Understanding Graph"></iframe>
            </div>
        </aside>
    }

    <script src="https://code.jquery.com/jquery-3.7.1.min.js" defer></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" defer></script>
    <script src="~/js/conversation.js" asp-append-version="true" defer></script>

    <script>
        @if (isGraphEnabled)
        {
            <text>
        let graphVisible = false;
        let graphLoaded = false;

        async function toggleGraph() {
            graphVisible = !graphVisible;
            const overlay = document.getElementById('graphOverlay');
            overlay.style.display = graphVisible ? 'flex' : 'none';

            if (graphVisible && !graphLoaded) {
                graphLoaded = true;
                            document.getElementById('graphFrame').src = '/UnderstandingGraph';
            }
        }
            </text>
        }
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>