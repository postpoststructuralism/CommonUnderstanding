@model List<CommonUnderstanding.Models.CanonicalBeliefSystem>

@{
    ViewData["Title"] = "Explore Belief Systems";
    var categories = ViewBag.Categories as List<string>;
    var cultures = ViewBag.Cultures as List<string>;
    var selectedCategory = ViewBag.SelectedCategory as string;
    var selectedCulture = ViewBag.SelectedCulture as string;
    var searchTerm = ViewBag.SearchTerm as string;
}

<nav aria-label="breadcrumb" class="cu-breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-controller="Dashboard" asp-action="Index">Dashboard</a></li>
        <li class="breadcrumb-item active" aria-current="page">Explore</li>
    </ol>
</nav>

<section class="cu-workspace-hero cu-explore-hero mb-4">
    <div class="cu-workspace-hero-content">
        <div>
            <span class="cu-workspace-tag">
                <i class="bi bi-compass"></i>
                Knowledge Discovery
            </span>
            <h1 class="cu-page-heading mt-3 mb-2">Explore Belief Systems</h1>
            <p class="cu-workspace-lead mb-0">
                Discover worldviews, philosophies, and traditions across cultures and time, then compare how their
                principles shape values, institutions, and decision-making.
            </p>
        </div>
        <div class="cu-explore-hero-meta">
            <div class="cu-explore-hero-stat">
                <strong>@Model.Count</strong>
                <span>systems currently visible</span>
            </div>
            <div class="cu-explore-hero-stat">
                <strong>@(categories?.Count ?? 0)</strong>
                <span>categories to browse</span>
            </div>
        </div>
    </div>
</section>

<section class="row g-3 mb-4">
    <div class="col-md-6 col-xl-3">
        <a asp-action="Categories" class="cu-explore-nav-card">
            <span class="cu-explore-nav-icon"><i class="bi bi-grid-3x3-gap"></i></span>
            <div>
                <strong>By Category</strong>
                <p>Religion, philosophy, politics, and worldview clusters.</p>
            </div>
        </a>
    </div>
    <div class="col-md-6 col-xl-3">
        <a asp-action="Map" class="cu-explore-nav-card">
            <span class="cu-explore-nav-icon"><i class="bi bi-globe"></i></span>
            <div>
                <strong>World Map</strong>
                <p>View belief systems through place of origin and spread.</p>
            </div>
        </a>
    </div>
    <div class="col-md-6 col-xl-3">
        <a asp-action="Timeline" class="cu-explore-nav-card">
            <span class="cu-explore-nav-icon"><i class="bi bi-clock-history"></i></span>
            <div>
                <strong>Timeline</strong>
                <p>Trace how traditions developed across eras.</p>
            </div>
        </a>
    </div>
    <div class="col-md-6 col-xl-3">
        <a asp-action="Compare" class="cu-explore-nav-card">
            <span class="cu-explore-nav-icon"><i class="bi bi-arrows-angle-expand"></i></span>
            <div>
                <strong>Compare</strong>
                <p>Review systems side by side across shared dimensions.</p>
            </div>
        </a>
    </div>
</section>

<div class="cu-filter-bar mb-4">
    <form asp-action="Index" method="get" class="row g-3 align-items-end mb-0">
        <div class="col-lg-4">
            <label class="form-label small fw-semibold mb-1">Search</label>
            <input type="text" class="form-control" name="search"
                   value="@searchTerm" placeholder="Search by name, description, or principles..." />
        </div>
        <div class="col-lg-3">
            <label class="form-label small fw-semibold mb-1">Category</label>
            <select class="form-select" name="category">
                <option value="">All Categories</option>
                @foreach (var cat in categories!)
                {
                    <option value="@cat" selected="@(cat == selectedCategory)">@cat</option>
                }
            </select>
        </div>
        <div class="col-lg-3">
            <label class="form-label small fw-semibold mb-1">Culture</label>
            <select class="form-select" name="culture">
                <option value="">All Cultures</option>
                @foreach (var cult in cultures!)
                {
                    <option value="@cult" selected="@(cult == selectedCulture)">@cult</option>
                }
            </select>
        </div>
        <div class="col-lg-2 d-flex gap-2">
            <button type="submit" class="btn btn-primary w-100">
                <i class="bi bi-search"></i> Filter
            </button>
            @if (!string.IsNullOrEmpty(selectedCategory) || !string.IsNullOrEmpty(selectedCulture) || !string.IsNullOrEmpty(searchTerm))
            {
                <a asp-action="Index" class="btn btn-outline-secondary">Clear</a>
            }
        </div>
    </form>
</div>

<section class="cu-explore-summary mb-4">
    <div>
        <h2 class="cu-section-heading mb-1">@Model.Count belief system@(Model.Count != 1 ? "s" : "") found</h2>
        <p class="text-muted mb-0">Use filters to narrow the library by category, culture, or search intent.</p>
    </div>
    <div class="cu-explore-summary-chips">
        @if (!string.IsNullOrEmpty(selectedCategory))
        {
            <span class="cu-badge">Category: @selectedCategory</span>
        }
        @if (!string.IsNullOrEmpty(selectedCulture))
        {
            <span class="cu-badge">Culture: @selectedCulture</span>
        }
        @if (!string.IsNullOrEmpty(searchTerm))
        {
            <span class="cu-badge">Search: @searchTerm</span>
        }
    </div>
</section>

@if (!Model.Any())
{
    <div class="cu-card cu-empty-state text-center py-5">
        <div class="cu-home-feature-icon mx-auto"><i class="bi bi-search"></i></div>
        <h2 class="cu-section-heading">No belief systems found</h2>
        <p class="text-muted mb-4">Try broadening your filters or removing the current search terms.</p>
        <a asp-action="Index" class="cu-btn-primary">Clear Filters</a>
    </div>
}
else
{
    <div class="row g-4">
        @foreach (var system in Model)
        {
            <div class="col-md-6 col-xl-4">
                <article class="cu-card cu-system-card h-100">
                    <div class="cu-system-card-header @GetCategoryColor(system.Category)">
                        <span class="cu-system-card-category">@system.Category</span>
                        <h3>@system.Name</h3>
                        <p>@system.Culture • @system.Era</p>
                    </div>
                    <div class="cu-system-card-body">
                        <div class="cu-system-card-tags mb-3">
                            <span class="cu-badge">@system.Category</span>
                            @if (system.Regions.Any())
                            {
                                <span class="cu-badge cu-system-card-region">@system.Regions.First()</span>
                            }
                        </div>

                        <p class="text-muted mb-3">
                            @(system.Description.Length > 150
                                ? system.Description.Substring(0, 150) + "..."
                                : system.Description)
                        </p>

                        @if (system.CorePrinciples.Any())
                        {
                            <div class="cu-system-card-principles">
                                <strong>Core Principles</strong>
                                <ul>
                                    @foreach (var principle in system.CorePrinciples.Take(2))
                                    {
                                        <li>@principle</li>
                                    }
                                    @if (system.CorePrinciples.Count > 2)
                                    {
                                        <li class="text-muted">+@(system.CorePrinciples.Count - 2) more...</li>
                                    }
                                </ul>
                            </div>
                        }
                    </div>
                    <div class="cu-system-card-footer">
                        <a asp-action="System" asp-route-slug="@system.Slug" class="cu-btn-secondary w-100">
                            <i class="bi bi-book"></i> Learn More
                        </a>
                    </div>
                </article>
            </div>
        }
    </div>
}

@functions {
    string GetCategoryColor(string category)
    {
        return category switch
        {
            "Religion" => "cu-system-theme-religion",
            "Philosophy" => "cu-system-theme-philosophy",
            "Political" => "cu-system-theme-political",
            "Worldview" => "cu-system-theme-worldview",
            _ => "cu-system-theme-default"
        };
    }
}
