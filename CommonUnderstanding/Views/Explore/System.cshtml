@model CommonUnderstanding.Models.CanonicalBeliefSystem

@{
    ViewData["Title"] = Model.Name;
    var relatedSystems = ViewBag.RelatedSystems as List<CommonUnderstanding.Models.CanonicalBeliefSystem>;
}

<div class="container mt-4">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-action="Index">Explore</a></li>
            <li class="breadcrumb-item active">@Model.Name</li>
        </ol>
    </nav>

    <div class="row">
        <div class="col-lg-8">
            <!-- Main Content -->
            <div class="card mb-4 shadow">
                <div class="card-header bg-gradient text-white @GetCategoryColor(Model.Category) py-4">
                    <h1 class="display-5 mb-2">@Model.Name</h1>
                    <p class="lead mb-0">
                        <i class="bi bi-geo-alt"></i> @Model.Culture • 
                        <i class="bi bi-calendar"></i> @Model.Era
                    </p>
                </div>
                <div class="card-body p-4">
                    <div class="mb-3">
                        <span class="badge bg-primary fs-6">@Model.Category</span>
                        @foreach (var region in Model.Regions.Take(3))
                        {
                            <span class="badge bg-info fs-6">@region</span>
                        }
                    </div>

                    <h5 class="border-bottom pb-2 mb-3">Overview</h5>
                    <p class="lead">@Model.Description</p>

                    @if (!string.IsNullOrEmpty(Model.CreationMyth))
                    {
                        <h5 class="border-bottom pb-2 mb-3 mt-4">
                            <i class="bi bi-book"></i> Creation Myth / Origin Story
                        </h5>
                        <div class="bg-light p-3 rounded">
                            <p class="mb-0 text-justify">@Model.CreationMyth</p>
                        </div>
                    }

                    @if (Model.CorePrinciples.Any())
                    {
                        <h5 class="border-bottom pb-2 mb-3 mt-4">
                            <i class="bi bi-list-check"></i> Core Principles
                        </h5>
                        <div class="row">
                            @foreach (var principle in Model.CorePrinciples)
                            {
                                <div class="col-md-6 mb-2">
                                    <div class="d-flex align-items-start">
                                        <i class="bi bi-check-circle-fill text-success me-2 mt-1"></i>
                                        <span>@principle</span>
                                    </div>
                                </div>
                            }
                        </div>
                    }

                    @if (Model.Sources.Any())
                    {
                        <h5 class="border-bottom pb-2 mb-3 mt-4">
                            <i class="bi bi-journal-text"></i> Key Texts & Sources
                        </h5>
                        <ul class="list-unstyled">
                            @foreach (var source in Model.Sources)
                            {
                                <li class="mb-1">
                                    <i class="bi bi-book-half text-primary"></i> @source
                                </li>
                            }
                        </ul>
                    }

                    @if (Model.NotableFigures.Any())
                    {
                        <h5 class="border-bottom pb-2 mb-3 mt-4">
                            <i class="bi bi-people"></i> Notable Figures
                        </h5>
                        <div class="d-flex flex-wrap gap-2">
                            @foreach (var figure in Model.NotableFigures)
                            {
                                <span class="badge bg-secondary fs-6">@figure</span>
                            }
                        </div>
                    }

                    @if (Model.Regions.Any())
                    {
                        <h5 class="border-bottom pb-2 mb-3 mt-4">
                            <i class="bi bi-globe"></i> Geographic Regions
                        </h5>
                        <div class="d-flex flex-wrap gap-2">
                            @foreach (var region in Model.Regions)
                            {
                                <span class="badge bg-info fs-6">@region</span>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <!-- Actions Card -->
            <div class="card mb-4 shadow-sm">
                <div class="card-header bg-light">
                    <h5 class="mb-0"><i class="bi bi-tools"></i> Actions</h5>
                </div>
                <div class="card-body">
                    <a asp-action="Compare" asp-route-system1="@Uri.EscapeDataString(Model.Name)" 
                       class="btn btn-outline-primary w-100 mb-2">
                        <i class="bi bi-arrows-angle-expand"></i> Compare with Another
                    </a>
                    <a asp-controller="Discovery" asp-action="Start" 
                       class="btn btn-success w-100 mb-2">
                        <i class="bi bi-compass"></i> Find Your Alignment
                    </a>
                    <button class="btn btn-outline-secondary w-100" onclick="window.print()">
                        <i class="bi bi-printer"></i> Print / Save
                    </button>
                </div>
            </div>

            <!-- Related Systems -->
            @if (relatedSystems?.Any() == true)
            {
                <div class="card shadow-sm">
                    <div class="card-header bg-light">
                        <h5 class="mb-0"><i class="bi bi-link-45deg"></i> Related Belief Systems</h5>
                    </div>
                    <div class="list-group list-group-flush">
                        @foreach (var related in relatedSystems.Take(5))
                        {
                            <a asp-action="System" asp-route-name="@Uri.EscapeDataString(related.Name)" 
                               class="list-group-item list-group-item-action">
                                <div class="d-flex w-100 justify-content-between">
                                    <h6 class="mb-1">@related.Name</h6>
                                    <small class="badge bg-secondary">@related.Category</small>
                                </div>
                                <p class="mb-1 small text-muted">@related.Culture</p>
                            </a>
                        }
                    </div>
                </div>
            }

            <!-- Quick Stats -->
            <div class="card mt-4 shadow-sm">
                <div class="card-header bg-light">
                    <h6 class="mb-0"><i class="bi bi-info-circle"></i> Quick Facts</h6>
                </div>
                <div class="card-body">
                    <dl class="row mb-0 small">
                        <dt class="col-sm-6">Category:</dt>
                        <dd class="col-sm-6">@Model.Category</dd>
                        
                        <dt class="col-sm-6">Era:</dt>
                        <dd class="col-sm-6">@Model.Era</dd>
                        
                        <dt class="col-sm-6">Culture:</dt>
                        <dd class="col-sm-6">@Model.Culture</dd>
                        
                        <dt class="col-sm-6">Principles:</dt>
                        <dd class="col-sm-6">@Model.CorePrinciples.Count</dd>
                        
                        <dt class="col-sm-6">Key Texts:</dt>
                        <dd class="col-sm-6">@Model.Sources.Count</dd>
                        
                        <dt class="col-sm-6">Regions:</dt>
                        <dd class="col-sm-6">@Model.Regions.Count</dd>
                    </dl>
                </div>
            </div>
        </div>
    </div>
</div>

@functions {
    string GetCategoryColor(string category)
    {
        return category switch
        {
            "Religion" => "bg-purple",
            "Philosophy" => "bg-indigo",
            "Political" => "bg-blue",
            "Worldview" => "bg-teal",
            _ => "bg-secondary"
        };
    }
}

<style>
    .bg-purple { background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); }
    .bg-indigo { background: linear-gradient(135deg, #5e72e4 0%, #825ee4 100%); }
    .bg-blue { background: linear-gradient(135deg, #2dce89 0%, #2dcecc 100%); }
    .bg-teal { background: linear-gradient(135deg, #11cdef 0%, #1171ef 100%); }
    
    .text-justify {
        text-align: justify;
        line-height: 1.6;
    }

    @@media print {
        .breadcrumb, .card:has(.btn), nav, .btn {
            display: none;
        }
    }
</style>
