@model CommonUnderstanding.Models.BeliefSystemComparison?
@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor

@{
    ViewData["Title"] = "Compare Belief Systems";
    var allSystems = ViewBag.AllSystems as List<CommonUnderstanding.Models.CanonicalBeliefSystem>;
    var request = HttpContextAccessor.HttpContext?.Request;
}

<div class="container mt-4">
    <div class="text-center mb-4">
        <h1 class="display-5">
            <i class="bi bi-arrows-angle-expand"></i> Compare Belief Systems
        </h1>
        <p class="lead text-muted">Explore similarities and differences between worldviews</p>
    </div>

    <!-- Selection Form -->
    <div class="card mb-4 shadow">
        <div class="card-body">
            <form asp-action="Compare" method="get">
                <div class="row g-3">
                    <div class="col-md-5">
                        <label class="form-label fw-bold">First Belief System</label>
                        <select class="form-select form-select-lg" name="system1" required>
                            <option value="">-- Select a belief system --</option>
                            @foreach (var system in allSystems!)
                            {
                                var isSelected1 = request?.Query["system1"].ToString() == system.Slug;
                                    <option value="@system.Slug" selected="@isSelected1">
                                    @system.Name (@system.Category)
                                </option>
                            }
                        </select>
                    </div>
                    <div class="col-md-2 d-flex align-items-end justify-content-center">
                        <button type="submit" class="btn btn-primary btn-lg">
                            <i class="bi bi-arrow-left-right"></i>
                        </button>
                    </div>
                    <div class="col-md-5">
                        <label class="form-label fw-bold">Second Belief System</label>
                        <select class="form-select form-select-lg" name="system2" required>
                            <option value="">-- Select a belief system --</option>
                            @foreach (var system in allSystems!)
                            {
                                var isSelected2 = request?.Query["system2"].ToString() == system.Slug;
                                <option value="@system.Slug" selected="@isSelected2">
                                    @system.Name (@system.Category)
                                </option>
                            }
                        </select>
                    </div>
                </div>
            </form>
        </div>
    </div>

    @if (Model != null)
    {
        var system1 = allSystems!.FirstOrDefault(s => s.Slug == Model.System1) ?? allSystems!.FirstOrDefault(s => s.Name == Model.System1);
        var system2 = allSystems!.FirstOrDefault(s => s.Slug == Model.System2) ?? allSystems!.FirstOrDefault(s => s.Name == Model.System2);

        <!-- Comparison Results -->
        <div class="row mb-4">
            <div class="col-12">
                <div class="card shadow">
                    <div class="card-header bg-primary text-white">
                        <h4 class="mb-0">
                            <i class="bi bi-bar-chart"></i> Overall Similarity: 
                            <span class="badge bg-light text-dark">@((Model.OverallSimilarity * 100).ToString("F0"))%</span>
                        </h4>
                    </div>
                    <div class="card-body">
                        <div class="progress mb-3" style="height: 30px;">
                            <div class="progress-bar @GetSimilarityColor(Model.OverallSimilarity)" 
                                 role="progressbar" 
                                 style="width: @((Model.OverallSimilarity * 100).ToString("F0"))%">
                                @((Model.OverallSimilarity * 100).ToString("F0"))% Match
                            </div>
                        </div>
                        <p class="text-muted mb-0">
                            @GetSimilarityDescription(Model.OverallSimilarity)
                        </p>
                    </div>
                </div>
            </div>
        </div>

        <!-- Side-by-Side Comparison -->
        <div class="row mb-4">
            <!-- System 1 -->
            <div class="col-md-6">
                <div class="card h-100 shadow-sm">
                    <div class="card-header bg-info text-white">
                        <h4 class="mb-0">@Model.System1</h4>
                        @if (system1 != null)
                        {
                            <small>@system1.Culture • @system1.Era</small>
                        }
                    </div>
                    <div class="card-body">
                        @if (system1 != null)
                        {
                            <p><strong>Category:</strong> @system1.Category</p>
                            <p class="text-muted">@system1.Description</p>
                            
                            @if (system1.CorePrinciples.Any())
                            {
                                <h6 class="mt-3 border-bottom pb-2">Core Principles:</h6>
                                <ul class="small">
                                    @foreach (var principle in system1.CorePrinciples.Take(5))
                                    {
                                        <li>@principle</li>
                                    }
                                </ul>
                            }
                        }
                                          <a asp-action="System" asp-route-slug="@system1?.Slug" 
                           class="btn btn-sm btn-outline-info mt-2">
                            <i class="bi bi-book"></i> Full Details
                        </a>
                    </div>
                </div>
            </div>

            <!-- System 2 -->
            <div class="col-md-6">
                <div class="card h-100 shadow-sm">
                    <div class="card-header bg-success text-white">
                        <h4 class="mb-0">@Model.System2</h4>
                        @if (system2 != null)
                        {
                            <small>@system2.Culture • @system2.Era</small>
                        }
                    </div>
                    <div class="card-body">
                        @if (system2 != null)
                        {
                            <p><strong>Category:</strong> @system2.Category</p>
                            <p class="text-muted">@system2.Description</p>
                            
                            @if (system2.CorePrinciples.Any())
                            {
                                <h6 class="mt-3 border-bottom pb-2">Core Principles:</h6>
                                <ul class="small">
                                    @foreach (var principle in system2.CorePrinciples.Take(5))
                                    {
                                        <li>@principle</li>
                                    }
                                </ul>
                            }
                        }
                                                                <a asp-action="System" asp-route-slug="@system2?.Slug" 
                           class="btn btn-sm btn-outline-success mt-2">
                            <i class="bi bi-book"></i> Full Details
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <!-- Shared Values -->
        @if (Model.SharedValues.Any())
        {
            <div class="card mb-4 shadow-sm">
                <div class="card-header bg-success text-white">
                    <h5 class="mb-0">
                        <i class="bi bi-check-circle"></i> Common Ground (@Model.SharedValues.Count)
                    </h5>
                </div>
                <div class="card-body">
                    <div class="row">
                        @foreach (var shared in Model.SharedValues)
                        {
                            <div class="col-md-6 mb-2">
                                <div class="d-flex align-items-start">
                                    <i class="bi bi-check2-circle text-success me-2 mt-1"></i>
                                    <span>@shared</span>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        }

        <!-- Differences -->
        @if (Model.DifferingValues.Any())
        {
            <div class="card mb-4 shadow-sm">
                <div class="card-header bg-warning">
                    <h5 class="mb-0">
                        <i class="bi bi-exclamation-triangle"></i> Key Differences (@Model.DifferingValues.Count)
                    </h5>
                </div>
                <div class="card-body">
                    <div class="row">
                        @foreach (var difference in Model.DifferingValues)
                        {
                            <div class="col-md-6 mb-2">
                                <div class="d-flex align-items-start">
                                    <i class="bi bi-arrow-left-right text-warning me-2 mt-1"></i>
                                    <span>@difference</span>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        }

        <!-- Potential Synergies -->
        @if (Model.PotentialSynergies.Any())
        {
            <div class="card mb-4 shadow-sm">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0">
                        <i class="bi bi-lightbulb"></i> Potential Synergies
                    </h5>
                </div>
                <div class="card-body">
                    <ul>
                        @foreach (var synergy in Model.PotentialSynergies)
                        {
                            <li>@synergy</li>
                        }
                    </ul>
                </div>
            </div>
        }
    }
    else
    {
        <div class="text-center py-5">
            <i class="bi bi-arrow-left-right display-1 text-muted"></i>
            <h3 class="mt-3">Select two belief systems to compare</h3>
            <p class="text-muted">Use the dropdowns above to choose systems for comparison</p>
        </div>
    }
</div>

@functions {
    string GetSimilarityColor(double similarity)
    {
        return similarity switch
        {
            >= 0.8 => "bg-success",
            >= 0.6 => "bg-info",
            >= 0.4 => "bg-warning",
            _ => "bg-danger"
        };
    }

    string GetSimilarityDescription(double similarity)
    {
        return similarity switch
        {
            >= 0.8 => "These belief systems are highly aligned with significant overlap in core values and principles.",
            >= 0.6 => "These systems share considerable common ground while maintaining distinct characteristics.",
            >= 0.4 => "These systems have some shared values but differ in many important respects.",
            _ => "These belief systems represent fundamentally different worldviews with minimal overlap."
        };
    }
}
