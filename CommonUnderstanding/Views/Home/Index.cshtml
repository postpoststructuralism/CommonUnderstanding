@{
    ViewData["Title"] = "A Common Understanding";
}

<section class="cu-home-hero mb-4">
    <div class="row g-4 align-items-stretch">
        <div class="col-xl-7">
            <span class="cu-home-kicker">
                <i class="bi bi-stars"></i>
                See what the world actually believes, and why
            </span>
            <h1>Every perspective belongs on the map.</h1>
            <p>
                A Common Understanding is the first platform where every discussion builds a living map
                of what people believe, why they believe it, and where real alignment is possible —
                grounded in a validated scientific framework of universal human values.
            </p>

            <div class="cu-home-meta">
                <span><i class="bi bi-shield-check"></i> See exactly where you agree — and why you don't</span>
                <span><i class="bi bi-diagram-3"></i> Think together, in real time</span>
                <span><i class="bi bi-lightning-charge"></i> Your worldview, mapped — in a space you control</span>
            </div>

            <div class="cu-home-actions">
                <a asp-controller="UnderstandingGraph" asp-action="Index" class="cu-btn-primary">
                    <i class="fas fa-map"></i> Explore The Live Map
                </a>
                <a asp-controller="Discovery" asp-action="Start" class="cu-btn-secondary">
                    <i class="fas fa-compass"></i> Map Your Own View
                </a>
            </div>

            <div class="cu-home-stats">
                <div class="cu-stat-card">
                    <strong>See the synthesis first</strong>
                    <span>AI-written summaries show where contributors agree, disagree, and what evidence drives each position.</span>
                </div>
                <div class="cu-stat-card">
                    <strong>Understand the why</strong>
                    <span>Schwartz values analysis reveals the motivational architecture underneath every perspective.</span>
                </div>
                <div class="cu-stat-card">
                    <strong>Add your voice</strong>
                    <span>Your contribution becomes part of a permanent, improving record of human understanding.</span>
                </div>
            </div>
        </div>

        <div class="col-xl-5">
            <div class="cu-home-panel h-100">
                <div class="cu-home-panel-label">The Live Map</div>
                <h2>Not another debate. A growing record.</h2>
                <p>
                    Most social media is a conversation where everything disappears. Here, every structured
                    discussion builds a permanent, navigable map of what people believe — and the values
                    that drive those beliefs.
                </p>

                <div class="cu-home-stack">
                    <div class="cu-home-stack-item">
                        <span class="cu-home-stack-icon"><i class="bi bi-person-vcard"></i></span>
                        <div>
                            <strong>Your perspective, analyzed</strong>
                            <p class="mb-0 text-muted small">Submit your view and the system maps its logic, evidence, and underlying values.</p>
                        </div>
                    </div>
                    <div class="cu-home-stack-item">
                        <span class="cu-home-stack-icon"><i class="bi bi-globe-americas"></i></span>
                        <div>
                            <strong>See how you connect</strong>
                            <p class="mb-0 text-muted small">Discover where your worldview overlaps with others — and where the real differences lie.</p>
                        </div>
                    </div>
                    <div class="cu-home-stack-item">
                        <span class="cu-home-stack-icon"><i class="bi bi-people"></i></span>
                        <div>
                            <strong>Watch understanding grow</strong>
                            <p class="mb-0 text-muted small">As more perspectives are added, the map becomes richer, not noisier.</p>
                        </div>
                    </div>
                </div>

                <div class="cu-home-proof">
                    <span class="cu-badge"><i class="bi bi-lock"></i> Private by Design</span>
                    <span class="cu-badge"><i class="bi bi-intersect"></i> Values-Based Mapping</span>
                    <span class="cu-badge"><i class="bi bi-broadcast"></i> Structured Debate</span>
                </div>
            </div>
        </div>
    </div>
</section>

<div class="row g-4 mb-4">
    <div class="col-lg-4">
        <div class="cu-card h-100">
            <div class="cu-home-feature-icon"><i class="bi bi-compass"></i></div>
            <h2 class="cu-section-heading">Map your worldview</h2>
            <p class="text-muted mb-0">
                An adaptive conversation surfaces your beliefs, priorities, and the values that drive them — no rigid surveys.
            </p>
        </div>
    </div>
    <div class="col-lg-4">
        <div class="cu-card h-100">
            <div class="cu-home-feature-icon"><i class="bi bi-diagram-2"></i></div>
            <h2 class="cu-section-heading">See where you align</h2>
            <p class="text-muted mb-0">
                Structured comparison reveals real overlap between worldviews — not just vague similarities.
            </p>
        </div>
    </div>
    <div class="col-lg-4">
        <div class="cu-card h-100">
            <div class="cu-home-feature-icon"><i class="bi bi-graph-up-arrow"></i></div>
            <h2 class="cu-section-heading">Make better decisions</h2>
            <p class="text-muted mb-0">
                Turn mapped understanding into clearer action for facilitation, research, and consensus-building.
            </p>
        </div>
    </div>
</div>

<section class="cu-home-insight-bar mb-4">
    <div class="row g-4 align-items-center">
        <div class="col-lg-8">
            <div class="cu-home-panel-label">How People Use It</div>
            <h2 class="cu-section-heading mb-2">Move from assumptions to grounded understanding.</h2>
            <p class="mb-0 text-muted">
                Instead of debating from abstractions, see real patterns of agreement, tension,
                and unexplored territory — whether you're in a facilitated workshop or exploring on your own.
            </p>
        </div>
        <div class="col-lg-4 text-lg-end">
            <a asp-controller="SocialView" asp-action="Feed" class="cu-btn-primary">
                <i class="fas fa-map"></i> See The Live Map
            </a>
        </div>
    </div>
</section>

<div class="row g-4 mb-4">
    <div class="col-lg-8">
        <div class="cu-card h-100">
            <div class="cu-card-header">
                <i class="bi bi-diagram-3"></i> How It Works
            </div>
            <div class="row g-4">
                <div class="col-md-4">
                    <div class="cu-home-step">
                        <span class="cu-home-step-number">1</span>
                        <strong>Share your perspective</strong>
                        <p class="text-muted small mb-0">
                            Write what you believe and why — as naturally as posting. The system handles the rest.
                        </p>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="cu-home-step">
                        <span class="cu-home-step-number">2</span>
                        <strong>See the structure</strong>
                        <p class="text-muted small mb-0">
                            Your view is mapped against its logic, evidence, and the universal values it draws on.
                        </p>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="cu-home-step">
                        <span class="cu-home-step-number">3</span>
                        <strong>Watch the map grow</strong>
                        <p class="text-muted small mb-0">
                            As others contribute, see where understanding converges — and where it genuinely doesn't.
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-lg-4">
        <div class="cu-card h-100">
            <div class="cu-card-header">
                <i class="bi bi-shield-check"></i> Why People Use It
            </div>
            <ul class="cu-home-trust-list">
                <li>
                    <i class="bi bi-check2-circle"></i>
                    <div>
                        <strong>Your worldview, mapped</strong>
                        <p class="mb-0 text-muted small">See your own beliefs reflected back with clarity — and discover what drives them.</p>
                    </div>
                </li>
                <li>
                    <i class="bi bi-check2-circle"></i>
                    <div>
                        <strong>Understand others, deeply</strong>
                        <p class="mb-0 text-muted small">Not just what someone thinks, but the values and reasoning underneath.</p>
                    </div>
                </li>
                <li>
                    <i class="bi bi-check2-circle"></i>
                    <div>
                        <strong>Contribute to the record</strong>
                        <p class="mb-0 text-muted small">Every perspective makes the map more complete — including yours.</p>
                    </div>
                </li>
            </ul>
        </div>
    </div>
</div>

<div class="row g-4 align-items-start">
    <div class="col-xl-7">
        <div class="cu-card h-100">
            <div class="cu-card-header">
                <i class="bi bi-activity"></i> Recent Activity
            </div>
            <table class="cu-table">
                <thead>
                    <tr>
                        <th>Category</th>
                        <th>System</th>
                        <th>Engagement</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td>Philosophy</td>
                        <td>Stoicism</td>
                        <td>125 users</td>
                        <td><span class="cu-badge">Active</span></td>
                    </tr>
                    <tr>
                        <td>Religion</td>
                        <td>Buddhism</td>
                        <td>98 users</td>
                        <td><span class="cu-badge">Active</span></td>
                    </tr>
                    <tr>
                        <td>Political</td>
                        <td>Liberalism</td>
                        <td>87 users</td>
                        <td><span class="cu-badge">Active</span></td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>

    <div class="col-xl-5">
        <div class="cu-card h-100">
            <div class="cu-card-header">
                <i class="bi bi-lightbulb"></i> Grounded in Universal Values
            </div>
            <p class="text-muted">
                Every perspective is analyzed against the Schwartz Theory of Basic Values — a validated scientific
                framework of 20 universal motivations that transcend culture, politics, and ideology. This isn't
                opinion-matching. It's understanding at the values level.
            </p>
            <div class="d-flex flex-wrap gap-2 mt-4">
                <a asp-controller="SocialView" asp-action="Feed" class="cu-btn-primary">
                    <i class="fas fa-map"></i> See The Live Map
                </a>
                <a asp-controller="Explore" asp-action="Index" class="cu-btn-secondary">
                    <i class="fas fa-book"></i> Explore Knowledge Base
                </a>
            </div>
        </div>
    </div>
</div>
