@{
    ViewData["Title"] = "A Common Understanding";
}

<section class="cu-home-hero mb-4">
    <div class="row g-4 align-items-stretch">
        <div class="col-xl-7">
            <span class="cu-home-kicker">
                <i class="bi bi-stars"></i>
                Belief Intelligence Platform
            </span>
            <h1>Find common ground without flattening what makes people different.</h1>
            <p>
                Map values, compare worldviews, and surface where alignment is real. A Common Understanding
                turns complex belief data into clearer, more actionable insight for individuals, facilitators,
                and teams.
            </p>

            <div class="cu-home-meta">
                <span><i class="bi bi-shield-check"></i> Private by design</span>
                <span><i class="bi bi-diagram-3"></i> Structured comparison</span>
                <span><i class="bi bi-lightning-charge"></i> AI-guided discovery</span>
            </div>

            <div class="cu-home-actions">
                <a asp-controller="Discovery" asp-action="Start" class="cu-btn-primary">
                    <i class="fas fa-play-circle"></i> Start Discovery
                </a>
                <a asp-controller="Explore" asp-action="Index" class="cu-btn-secondary">
                    <i class="fas fa-book"></i> Explore Knowledge Base
                </a>
            </div>

            <div class="cu-home-stats">
                <div class="cu-stat-card">
                    <strong>Adaptive</strong>
                    <span>Question paths adjust in real time to the nuance of each response.</span>
                </div>
                <div class="cu-stat-card">
                    <strong>Comparative</strong>
                    <span>See where perspectives converge, conflict, or still need exploration.</span>
                </div>
                <div class="cu-stat-card">
                    <strong>Actionable</strong>
                    <span>Turn worldview analysis into better facilitation and stronger decisions.</span>
                </div>
            </div>
        </div>

        <div class="col-xl-5">
            <div class="cu-home-panel h-100">
                <div class="cu-home-panel-label">Platform Snapshot</div>
                <h2>Built for insight, not noise.</h2>
                <p>
                    Use one system to understand individual belief profiles, explore canonical traditions,
                    and evaluate where meaningful consensus is actually possible.
                </p>

                <div class="cu-home-stack">
                    <div class="cu-home-stack-item">
                        <span class="cu-home-stack-icon"><i class="bi bi-person-vcard"></i></span>
                        <div>
                            <strong>Profile discovery</strong>
                            <p class="mb-0 text-muted small">Generate a nuanced map of values, priorities, and worldview structure.</p>
                        </div>
                    </div>
                    <div class="cu-home-stack-item">
                        <span class="cu-home-stack-icon"><i class="bi bi-globe-americas"></i></span>
                        <div>
                            <strong>Canonical comparison</strong>
                            <p class="mb-0 text-muted small">Benchmark against established systems from religion, philosophy, and politics.</p>
                        </div>
                    </div>
                    <div class="cu-home-stack-item">
                        <span class="cu-home-stack-icon"><i class="bi bi-people"></i></span>
                        <div>
                            <strong>Shared-ground analysis</strong>
                            <p class="mb-0 text-muted small">Reveal overlaps between users, groups, and live collaborative sessions.</p>
                        </div>
                    </div>
                </div>

                <div class="cu-home-proof">
                    <span class="cu-badge"><i class="bi bi-lock"></i> Private Sessions</span>
                    <span class="cu-badge"><i class="bi bi-intersect"></i> Semantic Comparison</span>
                    <span class="cu-badge"><i class="bi bi-broadcast"></i> Live Collaboration</span>
                </div>
            </div>
        </div>
    </div>
</section>

<div class="row g-4 mb-4">
    <div class="col-lg-4">
        <div class="cu-card h-100">
            <div class="cu-home-feature-icon"><i class="bi bi-compass"></i></div>
            <h2 class="cu-section-heading">Discover belief profiles</h2>
            <p class="text-muted mb-0">
                Guide users through adaptive conversations that surface priorities, beliefs, and hidden tradeoffs.
            </p>
        </div>
    </div>
    <div class="col-lg-4">
        <div class="cu-card h-100">
            <div class="cu-home-feature-icon"><i class="bi bi-diagram-2"></i></div>
            <h2 class="cu-section-heading">Compare systems clearly</h2>
            <p class="text-muted mb-0">
                Move beyond vague similarities with structured analysis across canonical and user-generated worldviews.
            </p>
        </div>
    </div>
    <div class="col-lg-4">
        <div class="cu-card h-100">
            <div class="cu-home-feature-icon"><i class="bi bi-graph-up-arrow"></i></div>
            <h2 class="cu-section-heading">Support better decisions</h2>
            <p class="text-muted mb-0">
                Turn insight into action for facilitation, research, debate prep, and consensus-building work.
            </p>
        </div>
    </div>
</div>

<section class="cu-home-insight-bar mb-4">
    <div class="row g-4 align-items-center">
        <div class="col-lg-8">
            <div class="cu-home-panel-label">How Teams Use It</div>
            <h2 class="cu-section-heading mb-2">Move from assumptions to grounded comparisons.</h2>
            <p class="mb-0 text-muted">
                Instead of debating from abstractions, teams can inspect real patterns of agreement, tension,
                and unexplored territory before making high-stakes decisions.
            </p>
        </div>
        <div class="col-lg-4 text-lg-end">
            <a asp-controller="Explore" asp-action="Compare" class="cu-btn-primary">
                <i class="fas fa-arrows-left-right"></i> Compare Systems
            </a>
        </div>
    </div>
</section>

<div class="row g-4 mb-4">
    <div class="col-lg-8">
        <div class="cu-card h-100">
            <div class="cu-card-header">
                <i class="bi bi-diagram-3"></i> How It Works
            </div>
            <div class="row g-4">
                <div class="col-md-4">
                    <div class="cu-home-step">
                        <span class="cu-home-step-number">1</span>
                        <strong>Adaptive discovery</strong>
                        <p class="text-muted small mb-0">
                            AI-led questioning follows the structure of each answer rather than forcing a static survey.
                        </p>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="cu-home-step">
                        <span class="cu-home-step-number">2</span>
                        <strong>Probabilistic modeling</strong>
                        <p class="text-muted small mb-0">
                            Statistical inference builds a more complete picture of underlying beliefs and tradeoffs.
                        </p>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="cu-home-step">
                        <span class="cu-home-step-number">3</span>
                        <strong>Common-ground analysis</strong>
                        <p class="text-muted small mb-0">
                            Compare people and systems to identify durable overlap, friction points, and useful next steps.
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-lg-4">
        <div class="cu-card h-100">
            <div class="cu-card-header">
                <i class="bi bi-shield-check"></i> Why Organizations Choose It
            </div>
            <ul class="cu-home-trust-list">
                <li>
                    <i class="bi bi-check2-circle"></i>
                    <div>
                        <strong>Private by design</strong>
                        <p class="mb-0 text-muted small">Sensitive comparisons stay controlled and contextual.</p>
                    </div>
                </li>
                <li>
                    <i class="bi bi-check2-circle"></i>
                    <div>
                        <strong>Transparent knowledge base</strong>
                        <p class="mb-0 text-muted small">Reference the traditions, principles, and systems behind each comparison.</p>
                    </div>
                </li>
                <li>
                    <i class="bi bi-check2-circle"></i>
                    <div>
                        <strong>Built for collaboration</strong>
                        <p class="mb-0 text-muted small">Support shared sessions, connection graphs, and live debate workflows.</p>
                    </div>
                </li>
            </ul>
        </div>
    </div>
</div>

<div class="row g-4 align-items-start">
    <div class="col-xl-7">
        <div class="cu-card h-100">
            <div class="cu-card-header">
                <i class="bi bi-activity"></i> Recent Activity
            </div>
            <table class="cu-table">
                <thead>
                    <tr>
                        <th>Category</th>
                        <th>System</th>
                        <th>Engagement</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td>Philosophy</td>
                        <td>Stoicism</td>
                        <td>125 users</td>
                        <td><span class="cu-badge">Active</span></td>
                    </tr>
                    <tr>
                        <td>Religion</td>
                        <td>Buddhism</td>
                        <td>98 users</td>
                        <td><span class="cu-badge">Active</span></td>
                    </tr>
                    <tr>
                        <td>Political</td>
                        <td>Liberalism</td>
                        <td>87 users</td>
                        <td><span class="cu-badge">Active</span></td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>

    <div class="col-xl-5">
        <div class="cu-card h-100">
            <div class="cu-card-header">
                <i class="bi bi-lightbulb"></i> Why Build on Existing Knowledge?
            </div>
            <p class="text-muted">
                Humanity has already built rich systems of meaning, ethics, and governance. Instead of starting from
                a blank page, compare personal beliefs against that accumulated knowledge and identify where it still applies.
            </p>
            <div class="d-flex flex-wrap gap-2 mt-4">
                <a asp-controller="Explore" asp-action="Index" class="cu-btn-primary">
                    <i class="fas fa-arrow-right"></i> Explore Canonical Systems
                </a>
                <a asp-controller="BeliefSystems" asp-action="Index" class="cu-btn-secondary">
                    <i class="fas fa-list"></i> View All Systems
                </a>
            </div>
        </div>
    </div>
</div>
