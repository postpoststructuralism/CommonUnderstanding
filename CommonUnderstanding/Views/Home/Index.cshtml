@{
    ViewData["Title"] = "Common Understanding";
}

<div class="container mt-5">
    <div class="row">
        <div class="col-lg-8 offset-lg-2 text-center">
            <h1 class="display-3 mb-4">
                <i class="bi bi-peace text-primary"></i><br />
                Common Understanding
            </h1>
            <p class="lead mb-5">
                An AI-powered journey to discover your belief system and find common ground with others
            </p>

            <div class="row mb-5">
                <div class="col-md-4 mb-3">
                    <div class="card h-100 shadow hover-card">
                        <div class="card-body text-center">
                            <div class="mb-3">
                                <i class="bi bi-compass display-4 text-primary"></i>
                            </div>
                            <h3>Discover Yourself</h3>
                            <p class="text-muted">
                                Interactive AI conversation to map your unique values and worldview
                            </p>
                            <a asp-controller="Discovery" asp-action="Start" class="btn btn-primary btn-lg">
                                Begin Journey <i class="bi bi-arrow-right"></i>
                            </a>
                        </div>
                    </div>
                </div>
                <div class="col-md-4 mb-3">
                    <div class="card h-100 shadow hover-card">
                        <div class="card-body text-center">
                            <div class="mb-3">
                                <i class="bi bi-globe display-4 text-success"></i>
                            </div>
                            <h3>Explore Beliefs</h3>
                            <p class="text-muted">
                                Browse canonical belief systems from across cultures and history
                            </p>
                            <a asp-controller="Explore" asp-action="Index" class="btn btn-success btn-lg">
                                Explore Canon <i class="bi bi-book"></i>
                            </a>
                        </div>
                    </div>
                </div>
                <div class="col-md-4 mb-3">
                    <div class="card h-100 shadow hover-card">
                        <div class="card-body text-center">
                            <div class="mb-3">
                                <i class="bi bi-arrows-angle-expand display-4 text-warning"></i>
                            </div>
                            <h3>Compare Systems</h3>
                            <p class="text-muted">
                                Analyze similarities and differences between worldviews
                            </p>
                            <a asp-controller="Explore" asp-action="Compare" class="btn btn-warning btn-lg">
                                Compare <i class="bi bi-arrow-left-right"></i>
                            </a>
                        </div>
                    </div>
                </div>
            </div>

            <div class="alert alert-light border">
                <h5 class="mb-3"><i class="bi bi-lightbulb"></i> Why Build on Existing Knowledge?</h5>
                <p class="text-muted mb-2">
                    <strong>Don't reinvent the wheel.</strong> Humanity has spent millennia developing rich belief systems, 
                    philosophies, and worldviews. Our knowledge base includes creation myths, core principles, and historical 
                    context from religions, philosophies, and political systems worldwide.
                </p>
                <p class="text-muted mb-0">
                    <strong>Find your place.</strong> Instead of starting from scratch, discover how your personal beliefs 
                    align with established traditions. You might find unexpected resonance with systems you've never explored.
                </p>
            </div>

            <div class="alert alert-info border mt-3">
                <h5 class="mb-3"><i class="bi bi-diagram-3"></i> How It Works</h5>
                <div class="row text-start">
                    <div class="col-md-4 mb-2">
                        <strong>1. Interactive Discovery</strong><br />
                        <small class="text-muted">AI asks adaptive questions tailored to your responses</small>
                    </div>
                    <div class="col-md-4 mb-2">
                        <strong>2. Statistical Modeling</strong><br />
                        <small class="text-muted">Bayesian inference builds a probabilistic model of your beliefs</small>
                    </div>
                    <div class="col-md-4 mb-2">
                        <strong>3. Find Common Ground</strong><br />
                        <small class="text-muted">Compare your profile with canonical systems and other users</small>
                    </div>
                </div>
            </div>

            <p class="text-muted mt-5">
                <i class="bi bi-shield-check"></i> Privacy-focused • Locally processed • Open source
            </p>
        </div>
    </div>
</div>

<style>
    .hover-card {
        transition: transform 0.2s ease-in-out, box-shadow 0.2s ease-in-out;
    }

    .hover-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 10px 25px rgba(0,0,0,0.15) !important;
    }
</style>
