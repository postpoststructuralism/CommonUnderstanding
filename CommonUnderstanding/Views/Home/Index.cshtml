@{
    ViewData["Title"] = "Commmon Understanding";
}

<!-- Breadcrumb -->
<nav aria-label="breadcrumb" class="cu-breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item active" aria-current="page">
            <i class="fas fa-home"></i> Home
        </li>
    </ol>
</nav>

<!-- Page Heading -->
<h1 class="cu-page-heading">
    <i class="bi bi-peace"></i> Common Understanding
</h1>

<div class="row mb-4">
    <div class="col-lg-8">
        <!-- Welcome Section -->
        <div class="cu-card mb-4">
         @*    <div class="cu-card-header">
                <i class="fas fa-info-circle"></i> Welcome to A Common Understanding
            </div> *@
            <div class="cu-card-body">
                <p class="lead mb-3">
                    An AI-powered journey to discover your belief system and find common ground with others
                </p>
                <p>
                    This platform helps you explore personal beliefs, canonical worldviews, and connections 
                    between different systems of understanding. Our knowledge base includes creation myths, 
                    core principles, and historical context from religions, philosophies, and political systems worldwide.
                </p>
            </div>
        </div>

        <!-- Feature Cards -->
        <div class="row mb-4">
            <div class="col-md-6 mb-3">
                <div class="cu-card h-100">
                    <div class="text-center mb-3">
                        <i class="fas fa-compass fa-3x" style="color: var(--cu-primary-blue);"></i>
                    </div>
                    <h3 class="cu-section-heading text-center">Discover Yourself</h3>
                    <p class="text-muted">
                        Interactive AI conversation to map your unique values and worldview through 
                        adaptive questioning and statistical modeling.
                    </p>
                    <div class="text-center mt-3">
                        <a asp-controller="Discovery" asp-action="Start" class="cu-btn-primary">
                            <i class="fas fa-play-circle"></i> Begin Journey
                        </a>
                    </div>
                </div>
            </div>
            <div class="col-md-6 mb-3">
                <div class="cu-card h-100">
                    <div class="text-center mb-3">
                        <i class="fas fa-globe fa-3x" style="color: var(--cu-secondary-blue);"></i>
                    </div>
                    <h3 class="cu-section-heading text-center">Explore Beliefs</h3>
                    <p class="text-muted">
                        Browse canonical belief systems from across cultures and history, understanding 
                        their core principles and teachings.
                    </p>
                    <div class="text-center mt-3">
                        <a asp-controller="Explore" asp-action="Index" class="cu-btn-secondary">
                            <i class="fas fa-book"></i> Explore Canon
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <!-- How It Works -->
        <div class="cu-card">
            <div class="cu-card-header">
                <i class="fas fa-diagram-project"></i> How It Works
            </div>
            <div class="cu-card-body">
                <div class="row">
                    <div class="col-md-4 mb-3">
                        <div class="text-center">
                            <div class="cu-badge mb-2">Step 1</div>
                        </div>
                        <strong>Interactive Discovery</strong>
                        <p class="text-muted small">
                            AI asks adaptive questions tailored to your responses using Semantic Kernel
                        </p>
                    </div>
                    <div class="col-md-4 mb-3">
                        <div class="text-center">
                            <div class="cu-badge mb-2">Step 2</div>
                        </div>
                        <strong>Statistical Modeling</strong>
                        <p class="text-muted small">
                            Bayesian inference builds a probabilistic model of your beliefs
                        </p>
                    </div>
                    <div class="col-md-4 mb-3">
                        <div class="text-center">
                            <div class="cu-badge mb-2">Step 3</div>
                        </div>
                        <strong>Find Common Ground</strong>
                        <p class="text-muted small">
                            Compare your profile with canonical systems and other users
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Sidebar -->
    <div class="col-lg-4">
        <!-- Quick Links -->
        <div class="cu-filter-panel mb-4">
            <h3 class="cu-section-heading">
                <i class="fas fa-bolt"></i> Quick Actions
            </h3>
            <div class="d-grid gap-2">
                <a asp-controller="Discovery" asp-action="Start" class="cu-btn-primary">
                    <i class="fas fa-compass"></i> Start Discovery
                </a>
                <a asp-controller="Explore" asp-action="Compare" class="cu-btn-secondary">
                    <i class="fas fa-arrows-left-right"></i> Compare Systems
                </a>
                <a asp-controller="BeliefSystems" asp-action="Index" class="cu-btn-secondary">
                    <i class="fas fa-list"></i> View All Systems
                </a>
            </div>
        </div>

        <!-- Key Features -->
        <div class="cu-card">
            <div class="cu-card-header">
                <i class="fas fa-star"></i> Key Features
            </div>
            <div class="cu-card-body">
                <ul class="list-unstyled">
                    <li class="mb-2">
                        <i class="fas fa-check-circle text-success"></i>
                        <strong>Privacy-focused</strong><br/>
                        <small class="text-muted">Your data stays secure</small>
                    </li>
                    <li class="mb-2">
                        <i class="fas fa-check-circle text-success"></i>
                        <strong>Locally processed</strong><br/>
                        <small class="text-muted">Powered by Ollama</small>
                    </li>
                    <li class="mb-2">
                        <i class="fas fa-check-circle text-success"></i>
                        <strong>Open source</strong><br/>
                        <small class="text-muted">Transparent algorithms</small>
                    </li>
                    <li class="mb-2">
                        <i class="fas fa-check-circle text-success"></i>
                        <strong>Adaptive AI</strong><br/>
                        <small class="text-muted">Questions tailored to you</small>
                    </li>
                </ul>
            </div>
        </div>
    </div>
</div>

<!-- Information Banner -->
<div class="row">
    <div class="col-12">
        <div class="alert alert-light border-gc shadow-gc-sm">
            <div class="row align-items-center">
                <div class="col-md-8">
                    <h5 class="mb-2">
                        <i class="fas fa-lightbulb text-warning"></i> 
                        Why Build on Existing Knowledge?
                    </h5>
                    <p class="mb-0 text-muted">
                        <strong>Don't reinvent the wheel.</strong> Humanity has spent millennia developing rich 
                        belief systems, philosophies, and worldviews. Instead of starting from scratch, discover 
                        how your personal beliefs align with established traditions.
                    </p>
                </div>
                <div class="col-md-4 text-center">
                    <a asp-controller="Explore" asp-action="Index" class="cu-btn-primary">
                        <i class="fas fa-arrow-right"></i> Learn More
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Demo Table (GC Design System) -->
<div class="row mt-4">
    <div class="col-12">
        <h2 class="cu-section-heading">
            <i class="fas fa-table"></i> Recent Activity
        </h2>
        <table class="cu-table">
            <thead>
                <tr>
                    <th>Category</th>
                    <th>System</th>
                    <th>Engagement</th>
                    <th>Status</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td>Philosophy</td>
                    <td>Stoicism</td>
                    <td>125 users</td>
                    <td><span class="cu-badge">Active</span></td>
                </tr>
                <tr>
                    <td>Religion</td>
                    <td>Buddhism</td>
                    <td>98 users</td>
                    <td><span class="cu-badge">Active</span></td>
                </tr>
                <tr>
                    <td>Political</td>
                    <td>Liberalism</td>
                    <td>87 users</td>
                    <td><span class="cu-badge">Active</span></td>
                </tr>
            </tbody>
        </table>
    </div>
</div>

<style>
    /* Page-specific enhancements */
    .alert {
        border-radius: var(--cu-border-radius);
    }
    
    .list-unstyled li {
        padding-left: 0.5rem;
    }
</style>
