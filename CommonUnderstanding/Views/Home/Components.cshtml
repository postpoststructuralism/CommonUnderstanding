@{
    ViewData["Title"] = "GC Design Components - ILRS Portal";
}

<!-- Breadcrumb -->
<nav aria-label="breadcrumb" class="gc-breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item">
            <a asp-controller="Home" asp-action="Index">
                <i class="fas fa-home"></i> Home
            </a>
        </li>
        <li class="breadcrumb-item active" aria-current="page">Component Showcase</li>
    </ol>
</nav>

<!-- Page Heading -->
<h1 class="gc-page-heading">
    <i class="fas fa-palette"></i> GC Design System Components
</h1>

<p class="lead text-muted mb-4">
    A comprehensive showcase of Government of Canada Design System components implemented in this application.
</p>

<!-- Typography -->
<div class="gc-card mb-4">
    <div class="gc-card-header">
        <i class="fas fa-font"></i> Typography
    </div>
    <div class="gc-card-body">
        <h1 class="gc-page-heading">Page Heading (H1)</h1>
        <h2 class="gc-section-heading">Section Heading (H2)</h2>
        <h3>Subsection Heading (H3)</h3>
        <p class="lead">Lead paragraph - larger text for introductions and emphasis.</p>
        <p>Regular paragraph text with <strong>bold text</strong>, <em>italic text</em>, and <a href="#">links</a>.</p>
        <p class="text-muted">Muted text for secondary information.</p>
    </div>
</div>

<!-- Buttons -->
<div class="gc-card mb-4">
    <div class="gc-card-header">
        <i class="fas fa-hand-pointer"></i> Buttons
    </div>
    <div class="gc-card-body">
        <h3 class="gc-section-heading">Primary Buttons</h3>
        <div class="mb-4">
            <button class="gc-btn-primary me-2">
                <i class="fas fa-check"></i> Primary Action
            </button>
            <button class="gc-btn-primary me-2" disabled>
                <i class="fas fa-spinner fa-spin"></i> Loading...
            </button>
            <button class="gc-btn-primary">
                Submit <i class="fas fa-arrow-right"></i>
            </button>
        </div>

        <h3 class="gc-section-heading">Secondary Buttons</h3>
        <div class="mb-4">
            <button class="gc-btn-secondary me-2">
                <i class="fas fa-times"></i> Cancel
            </button>
            <button class="gc-btn-secondary me-2">
                Reset
            </button>
            <button class="gc-btn-secondary" disabled>
                Disabled
            </button>
        </div>

        <h3 class="gc-section-heading">Button Sizes</h3>
        <div>
            <button class="gc-btn-primary me-2" style="padding: 0.375rem 1rem; font-size: 0.875rem;">
                Small
            </button>
            <button class="gc-btn-primary me-2">
                Medium (Default)
            </button>
            <button class="gc-btn-primary" style="padding: 0.75rem 2rem; font-size: 1.125rem;">
                Large
            </button>
        </div>
    </div>
</div>

<!-- Cards -->
<div class="row mb-4">
    <div class="col-md-6">
        <div class="gc-card mb-3">
            <div class="gc-card-header">
                <i class="fas fa-square"></i> Standard Card
            </div>
            <div class="gc-card-body">
                <p>Cards are the primary container for content in the GC Design System.</p>
                <p class="mb-0">They have white backgrounds, light borders, and subtle shadows on hover.</p>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="gc-card mb-3">
            <div class="gc-card-header">
                <i class="fas fa-chart-bar"></i> Card with Stats
            </div>
            <div class="gc-card-body">
                <div class="row text-center">
                    <div class="col-4">
                        <h3 class="text-primary mb-0">125</h3>
                        <small class="text-muted">Users</small>
                    </div>
                    <div class="col-4">
                        <h3 class="text-success mb-0">98%</h3>
                        <small class="text-muted">Uptime</small>
                    </div>
                    <div class="col-4">
                        <h3 class="text-info mb-0">24/7</h3>
                        <small class="text-muted">Support</small>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Badges -->
<div class="gc-card mb-4">
    <div class="gc-card-header">
        <i class="fas fa-tags"></i> Badges
    </div>
    <div class="gc-card-body">
        <h3 class="gc-section-heading">Standard Badges</h3>
        <div class="mb-4">
            <span class="gc-badge me-2">Default</span>
            <span class="gc-badge me-2"><i class="fas fa-check"></i> With Icon</span>
            <span class="gc-badge me-2">Status: Active</span>
            <span class="gc-badge">125</span>
        </div>

        <h3 class="gc-section-heading">Removable Badges</h3>
        <div>
            <span class="gc-badge gc-badge-removable me-2">
                Philosophy
                <button class="gc-badge-remove" onclick="this.parentElement.remove()">×</button>
            </span>
            <span class="gc-badge gc-badge-removable me-2">
                Religion
                <button class="gc-badge-remove" onclick="this.parentElement.remove()">×</button>
            </span>
            <span class="gc-badge gc-badge-removable">
                Politics
                <button class="gc-badge-remove" onclick="this.parentElement.remove()">×</button>
            </span>
        </div>
    </div>
</div>

<!-- Forms -->
<div class="gc-card mb-4">
    <div class="gc-card-header">
        <i class="fas fa-edit"></i> Form Elements
    </div>
    <div class="gc-card-body">
        <form>
            <div class="row">
                <div class="col-md-6">
                    <div class="gc-form-group">
                        <label class="gc-form-label" for="textInput">Text Input</label>
                        <input type="text" class="gc-form-control" id="textInput" placeholder="Enter text...">
                    </div>

                    <div class="gc-form-group">
                        <label class="gc-form-label" for="emailInput">Email Input</label>
                        <input type="email" class="gc-form-control" id="emailInput" placeholder="email@example.com">
                    </div>

                    <div class="gc-form-group">
                        <label class="gc-form-label" for="selectInput">Select Dropdown</label>
                        <select class="gc-form-control" id="selectInput">
                            <option>Choose an option...</option>
                            <option>Option 1</option>
                            <option>Option 2</option>
                            <option>Option 3</option>
                        </select>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="gc-form-group">
                        <label class="gc-form-label" for="textareaInput">Textarea</label>
                        <textarea class="gc-form-control" id="textareaInput" rows="4" placeholder="Enter longer text..."></textarea>
                    </div>

                    <div class="gc-form-group">
                        <label class="gc-form-label">Checkboxes</label>
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" id="check1" checked>
                            <label class="form-check-label" for="check1">
                                Option 1 (checked)
                            </label>
                        </div>
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" id="check2">
                            <label class="form-check-label" for="check2">
                                Option 2
                            </label>
                        </div>
                    </div>

                    <div class="gc-form-group">
                        <label class="gc-form-label">Radio Buttons</label>
                        <div class="form-check">
                            <input class="form-check-input" type="radio" name="radioGroup" id="radio1" checked>
                            <label class="form-check-label" for="radio1">
                                Choice 1
                            </label>
                        </div>
                        <div class="form-check">
                            <input class="form-check-input" type="radio" name="radioGroup" id="radio2">
                            <label class="form-check-label" for="radio2">
                                Choice 2
                            </label>
                        </div>
                    </div>
                </div>
            </div>

            <div class="mt-3">
                <button type="submit" class="gc-btn-primary me-2">
                    <i class="fas fa-save"></i> Submit Form
                </button>
                <button type="reset" class="gc-btn-secondary">
                    Reset
                </button>
            </div>
        </form>
    </div>
</div>

<!-- Tables -->
<div class="gc-card mb-4">
    <div class="gc-card-header">
        <i class="fas fa-table"></i> Tables
    </div>
    <div class="gc-card-body">
        <table class="gc-table">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Category</th>
                    <th>Status</th>
                    <th>Users</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td><strong>Stoicism</strong></td>
                    <td>Philosophy</td>
                    <td><span class="gc-badge">Active</span></td>
                    <td>125</td>
                    <td>
                        <button class="btn btn-sm btn-outline-primary">View</button>
                    </td>
                </tr>
                <tr>
                    <td><strong>Buddhism</strong></td>
                    <td>Religion</td>
                    <td><span class="gc-badge">Active</span></td>
                    <td>98</td>
                    <td>
                        <button class="btn btn-sm btn-outline-primary">View</button>
                    </td>
                </tr>
                <tr>
                    <td><strong>Liberalism</strong></td>
                    <td>Political</td>
                    <td><span class="gc-badge">Active</span></td>
                    <td>87</td>
                    <td>
                        <button class="btn btn-sm btn-outline-primary">View</button>
                    </td>
                </tr>
            </tbody>
        </table>
    </div>
</div>

<!-- Alerts -->
<div class="gc-card mb-4">
    <div class="gc-card-header">
        <i class="fas fa-bell"></i> Alerts & Notifications
    </div>
    <div class="gc-card-body">
        <div class="alert alert-success mb-3">
            <i class="fas fa-check-circle"></i>
            <strong>Success!</strong> Your action was completed successfully.
        </div>
        <div class="alert alert-info mb-3">
            <i class="fas fa-info-circle"></i>
            <strong>Information:</strong> Here's some helpful information.
        </div>
        <div class="alert alert-warning mb-3">
            <i class="fas fa-exclamation-triangle"></i>
            <strong>Warning:</strong> Please review this carefully.
        </div>
        <div class="alert alert-danger mb-0">
            <i class="fas fa-exclamation-circle"></i>
            <strong>Error:</strong> Something went wrong.
        </div>
    </div>
</div>

<!-- Icons -->
<div class="gc-card mb-4">
    <div class="gc-card-header">
        <i class="fas fa-icons"></i> Icon Libraries
    </div>
    <div class="gc-card-body">
        <h3 class="gc-section-heading">FontAwesome Icons</h3>
        <div class="mb-4" style="font-size: 2rem;">
            <i class="fas fa-home me-3"></i>
            <i class="fas fa-user me-3"></i>
            <i class="fas fa-cog me-3"></i>
            <i class="fas fa-search me-3"></i>
            <i class="fas fa-envelope me-3"></i>
            <i class="fas fa-heart me-3"></i>
            <i class="fas fa-star me-3"></i>
            <i class="fas fa-globe me-3"></i>
        </div>

        <h3 class="gc-section-heading">Bootstrap Icons</h3>
        <div style="font-size: 2rem;">
            <i class="bi bi-house me-3"></i>
            <i class="bi bi-person me-3"></i>
            <i class="bi bi-gear me-3"></i>
            <i class="bi bi-search me-3"></i>
            <i class="bi bi-envelope me-3"></i>
            <i class="bi bi-heart me-3"></i>
            <i class="bi bi-star me-3"></i>
            <i class="bi bi-globe me-3"></i>
        </div>
    </div>
</div>

<!-- Collapsible Section Demo -->
<div class="gc-card mb-4">
    <div class="gc-card-header">
        <i class="fas fa-layer-group"></i> Collapsible Sections
    </div>
    <div class="gc-card-body">
        <div class="gc-collapsible-header" data-bs-toggle="collapse" data-bs-target="#collapse1">
            <span><i class="fas fa-folder"></i> Section 1: Click to Expand</span>
            <i class="fas fa-chevron-down gc-collapsible-icon"></i>
        </div>
        <div id="collapse1" class="collapse show mt-2">
            <div class="p-3 bg-light rounded">
                <p class="mb-0">This is the content of the collapsible section. It can contain any HTML content.</p>
            </div>
        </div>

        <div class="gc-collapsible-header mt-3 collapsed" data-bs-toggle="collapse" data-bs-target="#collapse2">
            <span><i class="fas fa-folder"></i> Section 2: Currently Collapsed</span>
            <i class="fas fa-chevron-down gc-collapsible-icon"></i>
        </div>
        <div id="collapse2" class="collapse mt-2">
            <div class="p-3 bg-light rounded">
                <p class="mb-0">Another collapsible section with different content.</p>
            </div>
        </div>
    </div>
</div>

<!-- Loading States -->
<div class="gc-card mb-4">
    <div class="gc-card-header">
        <i class="fas fa-spinner"></i> Loading States
    </div>
    <div class="gc-card-body">
        <h3 class="gc-section-heading">Button Loading</h3>
        <button class="gc-btn-primary mb-4">
            <i class="fas fa-spinner fa-spin"></i> Processing...
        </button>

        <h3 class="gc-section-heading">Inline Spinners</h3>
        <div class="mb-4">
            <div class="spinner-border text-primary me-3" role="status">
                <span class="sr-only">Loading...</span>
            </div>
            <div class="spinner-grow text-primary" role="status">
                <span class="sr-only">Loading...</span>
            </div>
        </div>

        <h3 class="gc-section-heading">Full Overlay (Demo)</h3>
        <button class="gc-btn-secondary" onclick="showLoadingOverlay()">
            <i class="fas fa-eye"></i> Show Loading Overlay
        </button>
    </div>
</div>

<!-- Filter Panel Demo -->
<div class="row">
    <div class="col-lg-8">
        <div class="gc-card">
            <div class="gc-card-header">
                <i class="fas fa-newspaper"></i> Main Content Area
            </div>
            <div class="gc-card-body">
                <p>This demonstrates the sticky filter panel behavior. When you scroll down, the filter panel on the right stays in view (on desktop).</p>
                <p>The main content area uses standard cards and components.</p>
                <p class="mb-0">Try scrolling to see the sticky behavior in action.</p>
            </div>
        </div>
    </div>

    <div class="col-lg-4">
        <div class="gc-filter-panel">
            <h3 class="gc-section-heading">
                <i class="fas fa-filter"></i> Sticky Filter Panel
            </h3>
            <div class="gc-form-group">
                <label class="gc-form-label">Category</label>
                <select class="gc-form-control">
                    <option>All Categories</option>
                    <option>Philosophy</option>
                    <option>Religion</option>
                    <option>Political</option>
                </select>
            </div>
            <div class="gc-form-group">
                <label class="gc-form-label">Status</label>
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" id="filterActive" checked>
                    <label class="form-check-label" for="filterActive">Active</label>
                </div>
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" id="filterArchived">
                    <label class="form-check-label" for="filterArchived">Archived</label>
                </div>
            </div>
            <button class="gc-btn-primary w-100">
                <i class="fas fa-search"></i> Apply Filters
            </button>
        </div>
    </div>
</div>

<script>
    function showLoadingOverlay() {
        const overlay = document.createElement('div');
        overlay.className = 'gc-loading-overlay';
        overlay.innerHTML = '<div class="gc-loading-spinner"></div>';
        document.body.appendChild(overlay);
        
        setTimeout(() => {
            overlay.remove();
        }, 2000);
    }
</script>
